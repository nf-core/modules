{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Meta yaml",
    "description": "Validate the meta yaml file for an nf-core module",
    "type": "object",
    "properties": {
        "name": {
            "type": "string",
            "description": "Name of the module"
        },
        "description": {
            "type": "string",
            "description": "Description of the module"
        },
        "deprecated": {
            "type": "boolean",
            "description": "Whether the module is deprecated and should not be used in new pipelines"
        },
        "deprecation_date": {
            "type": "string",
            "format": "date",
            "description": "Date the module was deprecated (YYYY-MM-DD), used to plan its removal"
        },
        "deprecation_pr": {
            "type": "string",
            "pattern": "^https://github\\.com/nf-core/modules/pull/[0-9]+$",
            "description": "Pull request that deprecated the module"
        },
        "keywords": {
            "type": "array",
            "description": "Keywords for the module",
            "items": {
                "type": "string",
                "not": {
                    "const": "example"
                }
            },
            "uniqueItems": true,
            "minItems": 3
        },
        "tools": {
            "type": "array",
            "description": "Tools used by the module",
            "items": {
                "type": "object",
                "patternProperties": {
                    ".*": {
                        "type": "object",
                        "properties": {
                            "description": {
                                "type": "string",
                                "description": "Description of the output channel"
                            },
                            "homepage": {
                                "type": "string",
                                "description": "Homepage of the tool",
                                "pattern": "^https?://.*$"
                            },
                            "documentation": {
                                "type": "string",
                                "description": "Documentation of the tool",
                                "pattern": "^(https?|ftp)://.*$"
                            },
                            "tool_dev_url": {
                                "type": "string",
                                "description": "URL of the development version of the tool's documentation",
                                "pattern": "^https?://.*$"
                            },
                            "doi": {
                                "type": "string",
                                "description": "DOI to cite for the tool, without prefix: the publication's DOI if the tool has one, otherwise the DOI of the software archive (e.g. Zenodo); empty when there is none",
                                "pattern": "^(10\\.\\d{4,9}\\/[^,\\s]+)?$"
                            },
                            "licence": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "Licence of the tool",
                                "minItems": 1,
                                "uniqueItems": true,
                                "message": "Licence must be an array of one or more entries, e.g. [\"MIT\"]"
                            },
                            "identifier": {
                                "type": "string",
                                "description": "bio.tools identifier of the tool",
                                "pattern": "^(biotools:.*)?$"
                            },
                            "publication": {
                                "type": "object",
                                "description": "Publication metadata for citation",
                                "properties": {
                                    "title": {
                                        "type": "string",
                                        "description": "Title of the publication"
                                    },
                                    "author": {
                                        "type": "string",
                                        "description": "Author(s) of the publication in Harvard style: 'Last, F. M.' separated by commas, with '& ' before the final author, e.g. 'Einstein, A., Feynman, R. P. & Hawking, S.'. Group authors are written as is, e.g. '1000 Genome Project Data Processing Subgroup'",
                                        "pattern": "^(?:(?:[^,&]+, [^\\s,.&]\\.(?:[ -][^\\s,.&]\\.)*|[^,&]*[^\\s,.&]{3})(?:, (?=.* & )| & (?=[^&]+$)|$))+$",
                                        "message": "Author must be in Harvard style, e.g. 'Einstein, A., Feynman, R. P. & Hawking, S.'"
                                    },
                                    "source": {
                                        "type": "string",
                                        "description": "Journal, conference, workshop, or preprint server name"
                                    },
                                    "year": {
                                        "type": "integer",
                                        "description": "Publication year",
                                        "minimum": 1900
                                    },
                                    "volume": {
                                        "type": "string",
                                        "description": "Volume of the publication"
                                    },
                                    "issue": {
                                        "type": "string",
                                        "description": "Issue of the publication"
                                    },
                                    "pages": {
                                        "type": "string",
                                        "description": "Page range or article number of the publication"
                                    }
                                },
                                "additionalProperties": false,
                                "if": {
                                    "anyOf": [
                                        { "required": ["title"] },
                                        { "required": ["author"] },
                                        { "required": ["source"] },
                                        { "required": ["year"] }
                                    ]
                                },
                                "then": {
                                    "required": ["title", "author", "source", "year"]
                                }
                            }
                        },
                        "required": ["description"],
                        "anyOf": [
                            {
                                "required": ["homepage"]
                            },
                            {
                                "required": ["documentation"]
                            },
                            {
                                "required": ["tool_dev_url"]
                            },
                            {
                                "required": ["doi"]
                            }
                        ]
                    }
                }
            }
        },
        "extra_args": {
            "type": "array",
            "description": "Extra arguments for the module",
            "items": {
                "type": "object",
                "properties": {
                    "description": {
                        "type": "string",
                        "description": "Description of the argument"
                    }
                }
            }
        },
        "input": {
            "description": "Input channels for the module, or the input record of a module that uses static types",
            "if": {
                "$ref": "#/$defs/recordLayout"
            },
            "then": {
                "$ref": "#/$defs/inputRecordArray"
            },
            "else": {
                "$ref": "#/$defs/channelArray"
            }
        },
        "output": {
            "description": "Output channels for the module, or the output record of a module that uses static types",
            "if": {
                "$ref": "#/$defs/recordLayout"
            },
            "then": {
                "$ref": "#/$defs/outputRecordArray"
            },
            "else": {
                "$ref": "#/$defs/channelMap"
            }
        },
        "topics": {
            "type": "object",
            "description": "Topics of the module",
            "properties": {
                "versions": {
                    "if": {
                        "$ref": "#/$defs/recordLayout"
                    },
                    "then": {
                        "items": {
                            "properties": {
                                "fields": {
                                    "required": ["process", "tool", "version"],
                                    "propertyNames": {
                                        "enum": ["process", "tool", "version"]
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "patternProperties": {
                ".*": {
                    "if": {
                        "$ref": "#/$defs/recordLayout"
                    },
                    "then": {
                        "$ref": "#/$defs/topicRecordArray"
                    },
                    "else": {
                        "$ref": "#/$defs/channelArray"
                    }
                }
            }
        },
        "authors": {
            "type": "array",
            "description": "Authors of the module",
            "items": {
                "type": "string"
            }
        },
        "maintainers": {
            "type": "array",
            "description": "Maintainers of the module",
            "items": {
                "type": "string"
            }
        },
        "containers": {
            "type": "object",
            "description": "Container images for the module",
            "properties": {
                "docker": {
                    "type": "object",
                    "description": "Docker containers for different architectures",
                    "additionalProperties": {
                        "$ref": "#/$defs/container"
                    }
                },
                "singularity": {
                    "type": "object",
                    "description": "Singularity containers for different architectures",
                    "additionalProperties": {
                        "$ref": "#/$defs/container",
                        "properties": {
                            "name": {
                                "pattern": "^oras://.*$"
                            }
                        },
                        "required": ["https"]
                    }
                },
                "conda": {
                    "type": "object",
                    "description": "Conda lock files for different architectures",
                    "additionalProperties": {
                        "type": "object",
                        "description": "Conda lock file information",
                        "properties": {
                            "lock_file": {
                                "type": "string",
                                "description": "Path to the conda lock file, relative to the repository root",
                                "pattern": "^.*\\.conda-lock/.*\\.txt$"
                            }
                        },
                        "required": ["lock_file"]
                    }
                }
            }
        }
    },
    "$defs": {
        "channelMap": {
            "type": "object",
            "patternProperties": {
                ".*": {
                    "$ref": "#/$defs/channelArray"
                }
            }
        },
        "channelElement": {
            "type": "object",
            "patternProperties": {
                ".*": {
                    "$ref": "#/$defs/elementProperties"
                }
            }
        },
        "channelArray": {
            "type": "array",
            "items": {
                "oneOf": [
                    {
                        "$ref": "#/$defs/channelElement"
                    },
                    {
                        "type": "array",
                        "items": {
                            "$ref": "#/$defs/channelElement"
                        }
                    }
                ]
            }
        },
        "elementProperties": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "description": "Type of the channel element",
                    "enum": ["map", "file", "directory", "string", "integer", "float", "boolean", "list", "eval"]
                },
                "description": {
                    "type": "string",
                    "description": "Description of the channel"
                },
                "pattern": {
                    "type": "string",
                    "description": "Pattern of the channel, given in Java glob syntax"
                },
                "enum": {
                    "type": "array",
                    "description": "List of allowed values for the channel",
                    "items": {
                        "type": ["string", "number", "boolean", "array", "object"]
                    },
                    "uniqueItems": true
                },
                "ontologies": {
                    "type": "array",
                    "description": "List of ontologies for the channel",
                    "uniqueItems": true,
                    "items": {
                        "type": "object",
                        "patternProperties": {
                            ".*": {
                                "type": "string",
                                "pattern": "^https?://.*"
                            }
                        }
                    }
                }
            },
            "required": ["type", "description"]
        },
        "recordLayout": {
            "type": "array",
            "contains": {
                "type": "object",
                "required": ["type"],
                "properties": {
                    "type": {
                        "const": "record"
                    }
                }
            }
        },
        "inputRecordArray": {
            "type": "array",
            "description": "The single input record of the process",
            "minItems": 1,
            "maxItems": 1,
            "items": {
                "$ref": "#/$defs/record",
                "required": ["description"],
                "properties": {
                    "fields": {
                        "required": ["id"],
                        "additionalProperties": {
                            "$ref": "#/$defs/recordField",
                            "unevaluatedProperties": false
                        }
                    }
                }
            }
        },
        "outputRecordArray": {
            "type": "array",
            "description": "The single output record of the process",
            "minItems": 1,
            "maxItems": 1,
            "items": {
                "$ref": "#/$defs/record",
                "required": ["description"],
                "properties": {
                    "fields": {
                        "required": ["id", "meta"],
                        "additionalProperties": {
                            "$ref": "#/$defs/recordOutputField"
                        }
                    }
                }
            }
        },
        "topicRecordArray": {
            "type": "array",
            "description": "Records that the process sends to the topic",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/record",
                "properties": {
                    "fields": {
                        "additionalProperties": {
                            "$ref": "#/$defs/recordOutputField"
                        }
                    }
                }
            }
        },
        "record": {
            "type": "object",
            "properties": {
                "type": {
                    "const": "record"
                },
                "description": {
                    "type": "string",
                    "description": "Description of the record"
                },
                "fields": {
                    "type": "object",
                    "description": "Fields of the record, keyed by field name",
                    "minProperties": 1,
                    "propertyNames": {
                        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                    }
                }
            },
            "required": ["type", "fields"],
            "additionalProperties": false
        },
        "recordField": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "description": "Nextflow type of the field. Mark an optional field with `optional: true`, not with `?`",
                    "pattern": "^(Boolean|Integer|Float|String|Path|Record|Duration|MemoryUnit|(List|Set|Bag)<.+>|Map<.+,.+>)$"
                },
                "description": {
                    "type": "string",
                    "description": "Description of the field"
                },
                "optional": {
                    "type": "boolean",
                    "description": "Whether the field can be null"
                },
                "pattern": {
                    "$ref": "#/$defs/elementProperties/properties/pattern"
                },
                "enum": {
                    "$ref": "#/$defs/elementProperties/properties/enum"
                },
                "ontologies": {
                    "$ref": "#/$defs/elementProperties/properties/ontologies"
                }
            },
            "required": ["type", "description"]
        },
        "recordOutputField": {
            "$ref": "#/$defs/recordField",
            "properties": {
                "value": {
                    "type": "string",
                    "description": "Expression that sets the field in main.nf, e.g. `id` or `file(\"*.bam\")`",
                    "minLength": 1
                }
            },
            "required": ["value"],
            "unevaluatedProperties": false
        },
        "container": {
            "type": "object",
            "description": "Container information for Docker or Singularity",
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Container name/URI"
                },
                "https": {
                    "type": "string",
                    "description": "HTTPS URL to download the container (only for Singularity)",
                    "pattern": "^https://.*$"
                },
                "build_id": {
                    "type": "string",
                    "description": "Build ID of the container"
                },
                "scan_id": {
                    "type": "string",
                    "description": "Security scan ID of the container (only for Docker)"
                }
            },
            "required": ["name", "build_id"]
        }
    },
    "required": ["name", "description", "keywords", "authors", "output", "tools"]
}
