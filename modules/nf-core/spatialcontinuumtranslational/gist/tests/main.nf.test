nextflow_process {

    name "Test Process SPATIALCONTINUUMTRANSLATIONAL_GIST"
    script "../main.nf"
    process "SPATIALCONTINUUMTRANSLATIONAL_GIST"

    tag "modules"
    tag "modules_nfcore"
    tag "spatialcontinuumtranslational"
    tag "spatialcontinuumtranslational/gist"

    test("homosapiens - tsv - json") {

        when {
            process {
                """
                def test_file = file("\${workDir}/gist_input.tsv")
                test_file.text = "sample_id\\tmitoses_per_50_hpf\\tsite\\ttumor_rupture\\tmutation\\ttumor_size_cm\\nsample1\\t3.5\\tgastric\\tfalse\\tkit_exon11\\t4.2\\n"

                input[0] = [
                    [ id:'test_sample' ],
                    test_file
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

    test("homosapiens - tsv - json - stub") {

        options "-stub"

        when {
            process {
                """
                def test_file = file("\${workDir}/gist_input.tsv")
                test_file.text = "sample_id\\tmitoses_per_50_hpf\\tsite\\ttumor_rupture\\tmutation\\ttumor_size_cm\\nsample1\\t3.5\\tgastric\\tfalse\\tkit_exon11\\t4.2\\n"

                input[0] = [
                    [ id:'test_sample' ],
                    test_file
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

}
