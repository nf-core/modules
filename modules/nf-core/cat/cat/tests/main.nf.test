nextflow_process {

    name "Test Process CAT_CAT"
    script "../main.nf"
    process "CAT_CAT"

    tag "modules"
    tag "modules_nfcore"
    tag "cat"
    tag "cat/cat"

    test("deprecated") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ], file('files_in') ]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("WARNING: This module has been deprecated. Please use nf-core/modules/find/concatenate") }
            )
        }
    }
}
