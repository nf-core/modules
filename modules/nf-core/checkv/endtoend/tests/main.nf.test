nextflow_process {

    name "Test Process CHECKV_ENDTOEND"
    script "../main.nf"
    process "CHECKV_ENDTOEND"

    tag "modules"
    tag "modules_nfcore"
    tag "checkv"
    tag "checkv/endtoend"
    tag "gunzip"

    test("bacteroides_fragilis - illumina - test1_contigs_fa_gz") {
        def checkv_db
        setup {
            checkv_db = extract('https://github.com/nf-core/test-datasets/raw/phageannotator/modules/nfcore/checkv/endtoend/checkv_minimal_db.tar').resolve('checkv_minimal_db')
            run("GUNZIP") {
                script "../../../gunzip/main.nf"
                process {
                    """
                    input[0] = channel.of(
                        [
                            [ id:'test' ],
                            file(params.modules_testdata_base_path + 'genomics/prokaryotes/bacteroides_fragilis/illumina/fasta/test1.contigs.fa.gz', checkIfExists: true)
                        ]
                    )
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = GUNZIP.out.gunzip
                input[1] = file('${checkv_db}')
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.quality_summary,
                    process.out.completeness,
                    process.out.contamination,
                    process.out.complete_genomes,
                    process.out.viruses,
                    file(process.out.proviruses[0][1]).name, // Empty file
                    process.out.findAll { key, val -> key.startsWith("versions")}
                ).match() },
            )
        }
    }

    test("bacteroides_fragilis - illumina - test1_contigs_fa_gz - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'test' ], [] ]
                input[1] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }
}
