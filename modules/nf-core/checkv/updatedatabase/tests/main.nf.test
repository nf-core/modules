nextflow_process {

    name "Test Process CHECKV_UPDATEDATABASE"
    script "../main.nf"
    process "CHECKV_UPDATEDATABASE"

    tag "modules"
    tag "modules_nfcore"
    tag "checkv"
    tag "checkv/updatedatabase"

    test("sarscov2 - genome - genome_fasta") {
        def checkv_db
        setup {
            checkv_db = extract('https://github.com/nf-core/test-datasets/raw/phageannotator/modules/nfcore/checkv/endtoend/checkv_minimal_db.tar').resolve('checkv_minimal_db')
        }

        when {
            process {
                """
                input[0] = [
                    [ id: 'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                ]
                input[1] = file('${checkv_db}')
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.checkv_db.collect { meta, folder ->
                        [
                            meta,
                            folder[0],  // README.txt
                            file(folder[1]).listFiles().sort().findAll { !it.name.endsWith(".log") },  // genome_db files without logs
                            folder[2]   // hmm_db
                        ]
                    },
                    process.out.findAll { key, val -> key.startsWith("versions")}
                ).match()},
            )
        }
    }

    test("sarscov2 - genome - genome_fasta - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id: 'test' ],
                    []
                ]
                input[1] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match()}
            )
        }
    }
}
