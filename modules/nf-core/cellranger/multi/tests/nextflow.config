//Otherwise, cellranger will start running and run out of time after $TIME, whatever you set there.
//
// Memory is capped well below the default 15.GB test allocation: cellranger's Martian
// scheduler gates stage launches on host-free memory (not the container's cgroup limit),
// so requesting close to a runner's full RAM causes it to wait forever for memory that
// never becomes free, until the 2h nf-test timeout kills it.
process {

    withName: 'CELLRANGER_MKREF.*' {
        memory = '6.GB'
    }

    withName: CELLRANGER_MULTI {
        stageInMode = 'copy'
        memory      = '6.GB'
    }

}
