// #12402 bumped the repo default to 15.GB, more than runners actually have free.
// cellranger's Martian scheduler then waits forever for memory that never frees up
// instead of failing, until the 2h nf-test timeout kills it. Capped lower here.
process {

    resourceLimits = [
        memory: 6.GB
    ]

    // Match nf-core/tools pipeline template's bash options, so tests catch failures
    // that only happen under pipefail
    shell = [
        "bash",
        "-C",         // No clobber - prevent output redirection from overwriting files.
        "-e",         // Exit if a tool returns a non-zero status/exit code
        "-u",         // Treat unset variables and parameters as an error
        "-o",         // Returns the status of the last command to exit..
        "pipefail"    //   ..with a non-zero status or zero if all successfully execute
	]
}
