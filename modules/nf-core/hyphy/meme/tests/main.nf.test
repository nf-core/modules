nextflow_process {

    name "Test Process HYPHY_MEME"
    script "../main.nf"
    process "HYPHY_MEME"

    tag "modules"
    tag "modules_nfcore"
    tag "hyphy"
    tag "hyphy/meme"

    test("meme - fasta + nwk") {
        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file('/home/l/lea-picard/CD2.fasta', checkIfExists: true),
                    file('/home/l/lea-picard/CD2.nwk', checkIfExists: true),
                ]
                """
            }
        }

        then {
        def json = path(process.out.json[0][1])
        def meme = json.json

        assertAll(
            { assert process.success },
            { assert json.exists() },
            { assert json.size() > 0 },

            { assert meme.analysis.info.contains("MEME") },
            { assert meme.MLE.content."0".size() == 187 },

            { assert snapshot(
                process.out.json.collect { entry -> [entry[0], file(entry[1]).name] },
                process.out.versions).match() }
            )
        }
    }

    test("meme - fasta + nwk - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file('/home/l/lea-picard/CD2.fasta', checkIfExists: true),
                    file('/home/l/lea-picard/CD2.nwk', checkIfExists: true),
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
