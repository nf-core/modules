// The real download is 3.9 GB, too large to run in CI, so only the stub is tested
nextflow_process {

    name "Test Process VARNET_GETREF"
    script "../main.nf"
    process "VARNET_GETREF"

    tag "modules"
    tag "modules_nfcore"
    tag "varnet"
    tag "varnet/getref"

    test("download - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ id:'varnet_resources' ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
