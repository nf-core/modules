nextflow_process {

    name "Test Process SOURMASH_SKETCH"
    script "../main.nf"
    process "SOURMASH_SKETCH"
    tag "sourmash"
    tag "sourmash/sketch"
    tag "modules"
    tag "modules_nfcore"
    tag "temp"

    test("sarscov2 - genome single fasta") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] =  [
                                [ id:'test', single_end:false ], // meta map
                                file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                            ]
                input[1] =  false // merge_sigs
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    path(process.out.signatures[0][1]).text.contains('library/genome.fasta'),
                    process.out.findAll { key, val -> key.startsWith('versions') },
                ).match()}
            )
        }

    }

    test("sarscov2 - genome multiple fasta separate signatures") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] =  [
                                [ id:'test', single_end:false ], // meta map
                                [
                                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                                    file(params.modules_testdata_base_path + 'genomics/prokaryotes/haemophilus_influenzae/genome/genome.fna.gz', checkIfExists: true)
                                ]
                            ]
                input[1] =  false // merge_sigs
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    path(process.out.signatures[0][1]).text.contains('library/genome.fasta'),
                    path(process.out.signatures[0][1]).text.contains('library/genome.fna.gz'),
                    process.out.findAll { key, val -> key.startsWith('versions') },
                ).match()}
            )
        }

    }

    test("sarscov2 - genome multiple fasta merge signatures") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] =  [
                                [ id:'test', single_end:false ], // meta map
                                [
                                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                                    file(params.modules_testdata_base_path + 'genomics/prokaryotes/haemophilus_influenzae/genome/genome.fna.gz', checkIfExists: true)
                                ]
                            ]
                input[1] =  true // merge_sigs
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    path(process.out.signatures[0][1]).text.contains('library/genome.f'),
                    process.out.findAll { key, val -> key.startsWith('versions') },
                ).match()}
            )
        }

    }

    test("sarscov2 - genome fasta - stub") {

        options '-stub'

        when {
            process {
                """
                input[0] =  [
                                [ id:'test', single_end:false ], // meta map
                                file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                            ]
                input[1] =  false // merge_sigs
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
