    test("sarscov2 - fastq_1 - names_file - fastq.gz") {

        when {
            process {
                """
                input[0] = channel.of("ERR5069949.576388", "ERR5069949.501486")
                    .collectFile(name: 'names.txt', newLine: true)
                    .map { names -> tuple(
                        [ id:'test', single_end:true ],
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                        names
                    ) }
                input[1] = ""
                input[2] = "fastq.gz"
                input[3] = false
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    sanitizeOutput(process.out, unstableKeys: ["log"]),
                    path(process.out.log[0][1]).readLines().find { line -> line.startsWith('Reads Out:') }
                ).match() }
            )
        }
    }

    test("sarscov2 - fastq_1 - names_to_filter full header - fasta") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:true ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                    []
                ]
                input[1] = "ERR5069949.2151832 NS500628:121:HK3MMAFX2:2:21208:10793:15304/1"
                input[2] = "fasta"
                input[3] = false
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    sanitizeOutput(process.out, unstableKeys: ["log"]),
                    path(process.out.log[0][1]).readLines().find { line -> line.startsWith('Reads Out:') }
                ).match() }
            )
        }
    }

    test("sarscov2 - [ fastq_1, fastq_2 ] - names_file fastq - names_to_filter - fasta") {

        when {
            process {
                """
                input[0] = channel.of([
                        "@ERR5069949.576388 NS500628:121:HK3MMAFX2:4:11501:11167:14939/1", "A", "+", "I",
                        "@ERR5069949.501486 NS500628:121:HK3MMAFX2:1:21305:3080:7962/1", "A", "+", "I"
                    ].join("\\n"))
                    .collectFile(name: 'names.fastq', newLine: true)
                    .map { names -> tuple(
                        [ id:'test', single_end:false ],
                        [
                            file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                            file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                        ],
                        names
                    ) }
                input[1] = "ERR5069949.2151832"
                input[2] = "fasta"
                input[3] = false
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    sanitizeOutput(process.out, unstableKeys: ["log"]),
                    path(process.out.log[0][1]).readLines().find { line -> line.startsWith('Reads Out:') }
                ).match() }
            )
        }
    }

