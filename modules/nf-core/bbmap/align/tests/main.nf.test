nextflow_process {

    name "Test Process BBMAP_ALIGN"
    script "../main.nf"
    process "BBMAP_ALIGN"

    tag "modules"
    tag "modules_nfcore"
    tag "bbmap"
    tag "bbmap/align"
    tag "bbmap/index"

    setup {
        run("BBMAP_INDEX") {
            script "../../index/main.nf"
            process {
                """
                input[0] = file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true)
                """
            }
        }
    }

    test("paired_end - fasta") {

        when {
            process {
                """
                input[0] = [ [ id:'test', single_end:false ], // meta map
                        [
                            file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                            file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                        ]
                    ]
                input[1] = file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true)
                input[2] = [ [], [], false ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out, readsMD5Keys: ["bam"], unstableKeys: ["log", "reads"])).match() }
            )
        }

    }

    test("paired_end - index") {

        when {
            process {
                """
                input[0] = [ [ id:'test', single_end:false ], // meta map
                        [
                            file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                            file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                        ]
                    ]
                input[1] = BBMAP_INDEX.out.index
                input[2] = [ 'bam', 'all', false ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out, readsMD5Keys: ["bam"], unstableKeys: ["log", "reads"])).match() }
            )
        }

    }

    test("single_end - index") {

        when {
            process {
                """
                input[0] = [ [ id:'test', single_end:true ], // meta map
                        [
                            file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true)
                        ]
                    ]
                input[1] = BBMAP_INDEX.out.index
                input[2] = [ 'bam', 'all', false ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out, readsMD5Keys: ["bam"], unstableKeys: ["log", "reads"])).match() }
            )
        }

    }

    test("paired_end - index - pigz") {
        config "./nextflow.config"
        when {
            params {
                module_args = 'unpigz=t'
            }
            process {
                """
                input[0] = [ [ id:'test', single_end:false ], // meta map
                        [
                            file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                            file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                        ]
                    ]
                input[1] = BBMAP_INDEX.out.index
                input[2] = [ 'bam', 'all', false ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out, readsMD5Keys: ["bam"], unstableKeys: ["log", "reads"])).match() }
            )
        }

    }

    test("paired_end - index - stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = [ [ id:'test', single_end:false ], // meta map
                        [
                            file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                            file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                        ]
                    ]
                input[1] = BBMAP_INDEX.out.index
                input[2] = [ 'bam', 'all', false ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

    test("sarscov2 - [fastq1, fastq2] - transcriptome - all - fastq.gz") {

        when {
            process {
                """
                input[0] = [ [ id:'test', single_end:false ], // meta map
                        [
                            file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                            file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                        ]
                    ]
                input[1] = file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/transcriptome.fasta', checkIfExists: true)
                input[2] = [ 'fastq.gz', 'all', false ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    sanitizeOutput(process.out, readsMD5Keys: ["bam"], unstableKeys: ["log", "reads"]),
                    process.out.reads.collect { meta, reads -> [ reads ].flatten().collect { fastq ->
                        [ file(fastq).name, path(fastq).linesGzip.size(), path(fastq).linesGzip.sort().join('\n').md5() ]
                    } }
                    ).match() }
            )
        }

    }

    test("sarscov2 - [fastq1, fastq2] - transcriptome - unmapped - fastq.gz") {

        when {
            process {
                """
                input[0] = [ [ id:'test', single_end:false ], // meta map
                        [
                            file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                            file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                        ]
                    ]
                input[1] = file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/transcriptome.fasta', checkIfExists: true)
                input[2] = [ 'fastq.gz', 'unmapped', false ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    sanitizeOutput(process.out, readsMD5Keys: ["bam"], unstableKeys: ["log", "reads"]),
                    process.out.reads.collect { meta, reads -> [ reads ].flatten().collect { fastq ->
                        [ file(fastq).name, path(fastq).linesGzip.size(), path(fastq).linesGzip.sort().join('\n').md5() ]
                    } }
                    ).match() }
            )
        }

    }

    test("sarscov2 - [fastq1, fastq2] - transcriptome - mapped - fastq.gz - interleaved_output") {

        when {
            process {
                """
                input[0] = [ [ id:'test', single_end:false ], // meta map
                        [
                            file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                            file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                        ]
                    ]
                input[1] = file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/transcriptome.fasta', checkIfExists: true)
                input[2] = [ 'fastq.gz', 'mapped', true ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    sanitizeOutput(process.out, readsMD5Keys: ["bam"], unstableKeys: ["log", "reads"]),
                    process.out.reads.collect { meta, reads -> [ reads ].flatten().collect { fastq ->
                        [ file(fastq).name, path(fastq).linesGzip.size(), path(fastq).linesGzip.sort().join('\n').md5() ]
                    } }
                    ).match() }
            )
        }

    }

    test("sarscov2 - interleaved fastq - transcriptome - unmapped - fastq.gz") {

        when {
            process {
                """
                input[0] = [ [ id:'test', single_end:false ], // meta map
                        [
                            file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_interleaved.fastq.gz', checkIfExists: true)
                        ]
                    ]
                input[1] = file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/transcriptome.fasta', checkIfExists: true)
                input[2] = [ 'fastq.gz', 'unmapped', false ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    sanitizeOutput(process.out, readsMD5Keys: ["bam"], unstableKeys: ["log", "reads"]),
                    process.out.reads.collect { meta, reads -> [ reads ].flatten().collect { fastq ->
                        [ file(fastq).name, path(fastq).linesGzip.size(), path(fastq).linesGzip.sort().join('\n').md5() ]
                    } }
                    ).match() }
            )
        }

    }

    test("sarscov2 - fastq - transcriptome - mapped - bam") {

        when {
            process {
                """
                input[0] = [ [ id:'test', single_end:true ], // meta map
                        [
                            file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true)
                        ]
                    ]
                input[1] = file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/transcriptome.fasta', checkIfExists: true)
                input[2] = [ 'bam', 'mapped', false ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out, readsMD5Keys: ["bam"], unstableKeys: ["log", "reads"])).match() }
            )
        }

    }

    test("sarscov2 - [fastq1, fastq2] - transcriptome - unmapped - fastq.gz - stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = [ [ id:'test', single_end:false ], // meta map
                        [
                            file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                            file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                        ]
                    ]
                input[1] = file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/transcriptome.fasta', checkIfExists: true)
                input[2] = [ 'fastq.gz', 'unmapped', false ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

}
