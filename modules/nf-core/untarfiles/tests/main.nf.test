nextflow_process {

    name "Test Process UNTARFILES"
    script "../main.nf"
    process "UNTARFILES"

    tag "modules"
    tag "modules_nfcore"
    tag "untarfiles"

    test("deprecated") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ], file('archive') ]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("WARNING: This module has been deprecated.") }
            )
        }
    }
}
