    test("test prerender - stub - r") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    file(params.modules_testdata_base_path + 'generic/notebooks/quarto/quarto_r.qmd', checkIfExists: true) // Notebook
                ]
                input[1] = [:] // Parameters
                input[2] = []  // Input files
                """
