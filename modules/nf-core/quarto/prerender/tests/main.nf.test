nextflow_process {

    name "Test Process QUARTO_PRERENDER"
    script "../main.nf"
    process "QUARTO_PRERENDER"

    tag "modules"
    tag "modules_nfcore"
    tag "quarto"
    tag "quarto/prerender"

    test("test prerender - r") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    file(params.modules_testdata_base_path + 'generic/notebooks/quarto/quarto_r.qmd', checkIfExists: true) // Notebook
                ]
                input[1] = [:] // Parameters
                input[2] = []  // Input files
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.findAll { key, val -> key.startsWith('versions') },
                    process.out.artifacts,
                    process.out.params_yaml,
                    process.out.rendered[0][1].find { it.toString().endsWith('.md') }
                ).match() },
                // Explicitly check that output contains executed code. The
                // `rendered` output contains both a markdown file and any
                // associated files in a `_files/` directory, but only if the
                // output contains figures or other required resources, hence
                // the explicit `endsWith` statement.
                {
                    def md = process.out.rendered[0][1].find { it.toString().endsWith('.md') }
                    assert path(md).readLines().any { it.contains('Hello World 1') }
                },
                { assert process.out.rendered[0][1].find { it.toString().endsWith('_files') } != null }
            )
        }

    }

