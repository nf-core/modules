nextflow_process {

    name "Test Process GFFREAD"
    script "../main.nf"
    process "GFFREAD"
    config "./nextflow.config"

    tag "gffread"
    tag "modules_nfcore"
    tag "modules"

    test("sarscov2-gff3-gtf") {

        when {
            params {
                outdir = "$outputDir"
                module_args = '-T'
            }
            process {
                """
                input[0] = [
                    [id: 'test'],
                    file(params.modules_testdata_base_path + "genomics/sarscov2/genome/genome.gff3", checkIfExists: true)
                ]
                input[1] = []

                """
            }
        }

        then {
            assertAll (
                { assert process.success },
                { assert snapshot(process.out).match() },
                { assert process.out.gffread_gff == [] },
                { assert process.out.gffread_fasta == [] }
            )
        }

    }

    test("sarscov2-gff3-gtf-stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
                module_args = '-T'
            }
            process {
                """
                input[0] = [
                    [id: 'test'],
                    file(params.modules_testdata_base_path + "genomics/sarscov2/genome/genome.gff3", checkIfExists: true)
                ]
                input[1] = []
                """
            }
        }

        then {
            assertAll (
                { assert process.success },
                { assert snapshot(process.out).match() },
                { assert process.out.gffread_gff == [] },
                { assert process.out.gffread_fasta == [] }
            )
        }

    }

    test("sarscov2-gff3-gff3") {

        when {
            params {
                outdir = "$outputDir"
