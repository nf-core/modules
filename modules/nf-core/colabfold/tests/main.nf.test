nextflow_process {

    name "Test Process COLABFOLD"
    script "../main.nf"
    process "COLABFOLD"

    tag "modules"
    tag "modules_nfcore"
    tag "colabfold"

    // A real prediction needs the ~4 GB AlphaFold2 weights, which no CI runner
    // has. What can run for real is the empty-input path, where the module
    // must succeed and emit no structure.
    test("empty fasta") {

        when {
            process {
                """
                def empty = File.createTempFile('empty', '.faa')
                empty.deleteOnExit()
                input[0] = [ [ id:'test' ], file(empty.absolutePath) ]
                input[1] = [ [:], [] ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }

    test("proteomics - faa - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'proteomics/interproscan/l_arginase.faa', checkIfExists: true)
                ]
                input[1] = [ [:], [] ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }
}
