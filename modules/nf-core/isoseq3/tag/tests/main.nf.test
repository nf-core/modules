nextflow_process {

    name "Test Process ISOSEQ3_TAG"
    script "../main.nf"
    process "ISOSEQ3_TAG"

    tag "modules"
    tag "modules_nfcore"
    tag "isoseq3"
    tag "isoseq3/tag"

    test("deprecated") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ], file('bam') ]
                input[1] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("WARNING: This module has been deprecated. Please use nf-core/modules/isoseq/tag") }
            )
        }
    }
}
