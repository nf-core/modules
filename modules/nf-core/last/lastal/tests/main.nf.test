nextflow_process {

    name "Test Process LAST_LASTAL"
    script "../main.nf"
    process "LAST_LASTAL"
    config "./nextflow.config"

    tag "modules"
    tag "modules_nfcore"
    tag "last"
    tag "last/lastal"

    test("sarscov2 - contigs - genome") {

        def lastdb
        setup {
            // params.modules_testdata_base_path is null outside the process string, so use the same env var and default as tests/config/nf-test.config
            def modules_testdata_base_path = System.getenv('NXF_MODULES_TESTDATA_BASE') ?: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
            lastdb = extract(modules_testdata_base_path + 'genomics/sarscov2/genome/alignment/last/lastdb.tar.gz').resolve('lastdb')
        }

        when {
            process {
                """
                input[0] = [
                    [ id:'contigs', single_end:false ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fasta/contigs.fasta', checkIfExists: true),
                    []
                ]
                input[1] = file('${lastdb}')
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("sarscov2 - contigs - genome - withparams") {

        def lastdb
        setup {
            // params.modules_testdata_base_path is null outside the process string, so use the same env var and default as tests/config/nf-test.config
            def modules_testdata_base_path = System.getenv('NXF_MODULES_TESTDATA_BASE') ?: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
            lastdb = extract(modules_testdata_base_path + 'genomics/sarscov2/genome/alignment/last/lastdb.tar.gz').resolve('lastdb')
        }

        when {
            process {
                """
                input[0] = [
                    [ id:'contigs', single_end:false ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fasta/contigs.fasta', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/alignment/last/contigs.genome.par', checkIfExists: true)
                ]
                input[1] = file('${lastdb}')
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("sarscov2 - contigs - genome - stub") {

        options "-stub"


        when {
            process {
                """
                input[0] = [
                    [ id:'contigs', single_end:false ], // meta map
                    [],
                    []
                ]
                input[1] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
