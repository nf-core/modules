nextflow_process {

    name "Test Process SNIFFLES_GENOTYPEVCF"
    script "../main.nf"
    process "SNIFFLES_GENOTYPEVCF"
    config "./nextflow.config"

    tag "modules"
    tag "modules_nfcore"
    tag "sniffles"
    tag "sniffles/genotypevcf"
    tag "gunzip"

    setup {
        run("GUNZIP") {
            script "../../../gunzip/main.nf"
            process {
                """
                input[0] = [
                    [ id:'sites' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/nanopore/bam/HG002_ont_sv_genotype/HG002_ont_sv_sites.vcf.gz', checkIfExists: true)
                ]
                """
            }
        }
    }

    test("homo_sapiens - nanopore [bam, bai], [], vcf.gz") {

        when {
            process {
                """
                input[0] = [
                    [ id:'hg002' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/nanopore/bam/HG002_ont_sv_genotype/HG002_ont_sv_genotype.bam', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/nanopore/bam/HG002_ont_sv_genotype/HG002_ont_sv_genotype.bam.bai', checkIfExists: true)
                ]
                input[1] = [[], []]
                input[2] = [
                    [ id:'sites' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/nanopore/bam/HG002_ont_sv_genotype/HG002_ont_sv_sites.vcf.gz', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.findAll { key, val -> key.startsWith("versions") },
                    file(process.out.tbi.get(0).get(1)).name,
                    path(process.out.vcf.get(0).get(1)).linesGzip.findAll { line -> !line.startsWith("##genotype") },
                ).match() }
            )
        }

    }

    test("homo_sapiens - nanopore [bam, bai], [], vcf") {

        when {
            process {
                """
                input[0] = [
                    [ id:'hg002' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/nanopore/bam/HG002_ont_sv_genotype/HG002_ont_sv_genotype.bam', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/nanopore/bam/HG002_ont_sv_genotype/HG002_ont_sv_genotype.bam.bai', checkIfExists: true)
                ]
                input[1] = [[], []]
                input[2] = GUNZIP.out.gunzip
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.findAll { key, val -> key.startsWith("versions") },
                    file(process.out.tbi.get(0).get(1)).name,
                    path(process.out.vcf.get(0).get(1)).linesGzip.findAll { line -> !line.startsWith("##genotype") },
                ).match() }
            )
        }

    }

    test("homo_sapiens - nanopore [bam, bai], [], vcf.gz - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'hg002' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/nanopore/bam/HG002_ont_sv_genotype/HG002_ont_sv_genotype.bam', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/nanopore/bam/HG002_ont_sv_genotype/HG002_ont_sv_genotype.bam.bai', checkIfExists: true)
                ]
                input[1] = [[], []]
                input[2] = [
                    [ id:'sites' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/nanopore/bam/HG002_ont_sv_genotype/HG002_ont_sv_sites.vcf.gz', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

}
