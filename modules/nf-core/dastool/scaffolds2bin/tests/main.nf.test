nextflow_process {

    name "Test Process DASTOOL_SCAFFOLDS2BIN"
    script "../main.nf"
    process "DASTOOL_SCAFFOLDS2BIN"

    tag "modules"
    tag "modules_nfcore"
    tag "dastool"
    tag "dastool/scaffolds2bin"

    test("deprecated") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ], file('fasta') ]
                input[1] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("WARNING: This module has been deprecated.") }
            )
        }
    }
}
