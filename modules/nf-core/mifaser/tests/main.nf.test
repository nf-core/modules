nextflow_process {

    name "Test Process MIFASER"
    script "../main.nf"
    process "MIFASER"
    tag "modules"
    tag "modules_nfcore"
    tag "mifaser"

    test("sarscov2 - single-end fastq") {
        def db
        setup {
            db = extract('https://github.com/nf-core/test-datasets/raw/refs/heads/funcprofiler/data/database/mifaser/GS-24-all.tar.gz').resolve('GS-24-all')
        }

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:true ],
                    [ file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true) ]
                ]
                input[1] = file('${db}')
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.multi_ec,
                    process.out.analysis,
                    process.out.ec_counts,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }
    }

    test("sarscov2 - single-end fastq - stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:true ],
                    [ file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true) ]
                ]
                input[1] = []
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
