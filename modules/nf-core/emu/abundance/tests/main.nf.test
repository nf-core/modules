nextflow_process {
    name "Test Process EMU_ABUNDANCE"
    script "../main.nf"
    process "EMU_ABUNDANCE"

    tag "modules"
    tag "modules_nfcore"
    tag "emu"
    tag "emu/abundance"

    config "./nextflow.config"

    test("sarscov2 nanopore [fastq_gz]") {
        def db
        setup {
            // params.modules_testdata_base_path is null outside the process string, so use the same env var and default as tests/config/nf-test.config
            def modules_testdata_base_path = System.getenv('NXF_MODULES_TESTDATA_BASE') ?: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
            db = extract(modules_testdata_base_path + 'genomics/prokaryotes/streptococcus_agalactiae/genome/emu.tar.gz').resolve('emu')
        }

        when {
            params {
                module_args = "--keep-files --keep-read-assignments --output-unclassified"
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/prokaryotes/streptococcus_agalactiae/nanopore/fastq/test.fastq.gz', checkIfExists: true)
                ]
                input[1] = file('${db}')
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.report,
                    process.out.assignment_report,
                    process.out.samfile,
                    file(process.out.unclassified[0][1]).name,
                    file(process.out.unmapped[0][1]).name,
                    process.out.versions_emu,
                ).match() }
            )
        }
    }

    test("sarscov2 nanopore [fastq_gz] - stub") {
        options "-stub"
        when {
            params {
                module_args = ""
            }
            process {
                """
                input[0] = [ [ id:'test' ], // meta map
                            file(params.modules_testdata_base_path + 'genomics/prokaryotes/streptococcus_agalactiae/nanopore/fastq/test.fastq.gz', checkIfExists: true)
                        ]
                input[1] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
