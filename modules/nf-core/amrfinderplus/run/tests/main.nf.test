nextflow_process {

    name "Test Process AMRFINDERPLUS_RUN"
    script "../main.nf"
    process "AMRFINDERPLUS_RUN"

    tag "modules"
    tag "modules_nfcore"
    tag "amrfinderplus"
    tag "amrfinderplus/run"
    tag "amrfinderplus/update"

    setup {

        run("AMRFINDERPLUS_UPDATE") {
            script "modules/nf-core/amrfinderplus/update/main.nf"
            process {
                """
                input[0] = '2026-08-07.1'
                """
            }
        }
    }

    test("amrfinderplus/run - haemophilus_influenzae - genome_fna_gz") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/prokaryotes/haemophilus_influenzae/genome/genome.fna.gz', checkIfExists: true),
                    '',
                    false
                ]
                input[1] = AMRFINDERPLUS_UPDATE.out.db
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }

    test("amrfinderplus/run - haemophilus_influenzae - genome_fna_gz - organism") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/prokaryotes/haemophilus_influenzae/genome/genome.fna.gz', checkIfExists: true),
                    'Haemophilus_influenzae',
                    false
                ]
                input[1] = AMRFINDERPLUS_UPDATE.out.db
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }

    test("amrfinderplus/run - bacteroides_fragilis - region_faa_gz - proteins") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/prokaryotes/bacteroides_fragilis/genome/region_2500000-3000000.faa.gz', checkIfExists: true),
                    '',
                    true
                ]
                input[1] = AMRFINDERPLUS_UPDATE.out.db
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }

    test("amrfinderplus/run - haemophilus_influenzae - genome_fna_gz - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/prokaryotes/haemophilus_influenzae/genome/genome.fna.gz', checkIfExists: true),
                    '',
                    false
                ]
                input[1] = AMRFINDERPLUS_UPDATE.out.db
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }

    test("amrfinderplus/run - haemophilus_influenzae - genome_fna_gz - organism - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/prokaryotes/haemophilus_influenzae/genome/genome.fna.gz', checkIfExists: true),
                    'Haemophilus_influenzae',
                    false
                ]
                input[1] = AMRFINDERPLUS_UPDATE.out.db
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }
}
