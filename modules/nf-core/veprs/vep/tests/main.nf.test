nextflow_process {

    name "Test Process VEPRS_VEP"
    script "../main.nf"
    process "VEPRS_VEP"
    config "./nextflow.config"

    tag "modules"
    tag "modules_nfcore"
    tag "veprs"
    tag "veprs/vep"
    tag "veprs/cachebuilder"

    setup {
        run("VEPRS_CACHEBUILDER") {
            script "../../cachebuilder/main.nf"
            process {
                """
                input[0] = [
                    [ id:'cache' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.gtf', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta.fai', checkIfExists: true)
                ]
                input[1] = params.veprs_species
                input[2] = params.veprs_genome
                input[3] = params.veprs_cache_version
                """
            }
        }
    }

    test("homo_sapiens - vcf") {

        config "./vcf.config"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gvcf/test.genome.vcf', checkIfExists: true),
                    []
                ]
                input[1] = params.veprs_genome
                input[2] = params.veprs_species
                input[3] = params.veprs_cache_version
                input[4] = VEPRS_CACHEBUILDER.out.cache
                input[5] = [
                    [ id:'fasta' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta.fai', checkIfExists: true)
                ]
                input[6] = []
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    file(process.out.vcf[0][1]).name + ",variantsMD5:" + path(process.out.vcf[0][1]).vcf.variantsMD5,
                    file(process.out.tbi[0][1]).name,
                    file(process.out.report[0][3]).name,
                    process.out.findAll { key, val -> key.startsWith("versions") }
                ).match() }
            )
        }
    }

    test("homo_sapiens - tab") {

        config "./tab.config"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gvcf/test.genome.vcf', checkIfExists: true),
                    []
                ]
                input[1] = params.veprs_genome
                input[2] = params.veprs_species
                input[3] = params.veprs_cache_version
                input[4] = VEPRS_CACHEBUILDER.out.cache
                input[5] = [
                    [ id:'fasta' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta.fai', checkIfExists: true)
                ]
                input[6] = []
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    file(process.out.tab[0][1]).name,
                    path(process.out.tab[0][1]).linesGzip.findAll { !it.startsWith("#") },
                    process.out.findAll { key, val -> key.startsWith("versions") }
                ).match() },
                { assert path(process.out.tab[0][1]).linesGzip.any { it.startsWith("## ENSEMBL VARIANT EFFECT PREDICTOR") } }
            )
        }
    }

    test("homo_sapiens - vcf - stub") {

        config "./vcf.config"
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gvcf/test.genome.vcf', checkIfExists: true),
                    []
                ]
                input[1] = params.veprs_genome
                input[2] = params.veprs_species
                input[3] = params.veprs_cache_version
                input[4] = VEPRS_CACHEBUILDER.out.cache
                input[5] = [
                    [ id:'fasta' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta.fai', checkIfExists: true)
                ]
                input[6] = []
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }
    }
}
