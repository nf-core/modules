nextflow_process {

    name "Test Process HASHEDDROPS"
    script "../main.nf"
    process "HASHEDDROPS"

    tag "modules"
    tag "modules_nfcore"
    tag "hasheddrops"

    def hto
    def rna
    setup {
        // params.modules_testdata_base_path is null outside the process string, so use the same env var and default as tests/config/nf-test.config
        def modules_testdata_base_path = System.getenv('NXF_MODULES_TESTDATA_BASE') ?: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
        hto = extract(modules_testdata_base_path + 'genomics/homo_sapiens/10xgenomics/cellranger/hashing_demultiplexing/hto.tar.gz').resolve('hto')
        rna = extract(modules_testdata_base_path + 'genomics/homo_sapiens/10xgenomics/cellranger/hashing_demultiplexing/rna.tar.gz').resolve('rna')
    }

    test("hto_matrix - runEmptyDrops:false - rna_matrix") {

        when {
            process {
                """
                input[0] = [ [id: 'test'], file('${hto}'), "FALSE", file('${rna}') ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    sanitizeOutput(process.out),
                    path(process.out.versions[0]).yaml
                ).match() }
            )
        }
    }

    test("hto_matrix - runEmptyDrops:true - rna_matrix - stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = [ [id: 'test'], file('${hto}'), "TRUE", file('${rna}') ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    sanitizeOutput(process.out),
                    path(process.out.versions[0]).yaml
                ).match() }
            )
        }
    }

}
