nextflow_process {

    name "Test Process ANTISMASH_ANTISMASHLITEDOWNLOADDATABASES"
    script "../main.nf"
    process "ANTISMASH_ANTISMASHLITEDOWNLOADDATABASES"
    config './nextflow.config'

    tag "modules"
    tag "modules_nfcore"
    tag "antismash"
    tag "antismash/antismashlitedownloaddatabases"

    test("antiSMASH-lite downloaddatabases") {
        tag "test"
        when {
            process {
                """
                input[0] = []
                input[1] = []
                input[2] = []
                """
            }
        }

        then {
            assertAll(
                /*{ assert process.success },
                { assert snapshot(
                    file(process.out.database[0]).list().sort(),
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match()}*/
                { assert process.failed },
                { assert process.errorReport.contains("WARNING: This module has been deprecated.")}
            )
        }
    }

    test("antiSMASH-lite downloaddatabases - stub") {
        options "-stub"

        when {
            process {
                """
                input[0] = []
                input[1] = []
                input[2] = []
                """
            }
        }

        then {
            assertAll(
                /*{ assert process.success },
                { assert snapshot(
                    file(process.out.database.get(0)).list().sort(),
                    file(process.out.antismash_dir.get(0)).list().sort(),
                    process.out.findAll { key, val -> key.startsWith("versions") }
                ).match()}*/
                { assert process.failed },
                { assert process.errorReport.contains("WARNING: This module has been deprecated.")}
            )
        }
    }
}
