nextflow_process {

    name "Test Process T2PMHC_PREDICTBINDING"
    script "../main.nf"
    process "T2PMHC_PREDICTBINDING"
    config "./nextflow.config"

    tag "modules"
    tag "modules_nfcore"
    tag "t2pmhc"
    tag "t2pmhc/predictbinding"
    tag "t2pmhc/creategraphs"

    test("homo_sapiens - [tsv, pt] - t2pmhc-gat") {

        setup {
            run("T2PMHC_CREATEGRAPHS") {
                script "../../creategraphs/main.nf"
                process {
                    """
                    def samplesheet = file('https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/tcrpmhcbinding/testdata-default/tcrpmhc_sample.tsv', checkIfExists: true)
                    def lines = samplesheet.readLines()
                    def header = lines[0].split('\\t')
                    def pdb_column_index = header.findIndexOf { it == 'pdb_file_path' }
                    def structure_files = lines[1..-1].collectMany { line ->
                        def columns = line.split('\\t')
                        def pdb_path = columns[pdb_column_index]
                        def npy_path = pdb_path.replaceAll(/\\.pdb\$/, '_predicted_aligned_error.npy')
                        return [file(pdb_path, checkIfExists: true), file(npy_path, checkIfExists: true)]
                    }.findAll { it && it.toString().trim() }

                    input[0] = Channel.of([
                        [ id:'test' ],
                        samplesheet,
                        structure_files
                    ])
                    input[1] = 't2pmhc-gat'
                    """
                }
            }
        }

        when {
            params {
                module_args = ''
            }
            process {
                """
                def ch_samplesheet = Channel.of([
                    [ id:'test' ],
                    file('https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/tcrpmhcbinding/testdata-default/tcrpmhc_sample.tsv', checkIfExists: true)
                ])
                input[0] = ch_samplesheet.join(T2PMHC_CREATEGRAPHS.out.graphs)
                input[1] = 't2pmhc-gat'
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out.pred,
                    process.out.versions_t2pmhc
                ).match() },
                {
                    def rows = path(process.out.pred.get(0)[1]).readLines()
                    assert rows[0].split('\t').contains('binder_prob')
                },
                {
                    // the exact row count is pinned by the snapshot; this guards the pairing
                    // key itself, which a silent drop or duplication would corrupt
                    def rows = path(process.out.pred.get(0)[1]).readLines()
                    def id_column = rows[0].split('\t').findIndexOf { it == 'identifier' }
                    assert id_column >= 0 : "output lost the identifier column"
                    def ids = rows[1..-1].collect { it.split('\t')[id_column] }
                    assert ids.unique().size() == ids.size() : "duplicate identifiers in output"
                }
            )
        }

    }

    test("homo_sapiens - [tsv, pt] - t2pmhc-gcn") {

        setup {
            // graphs are built once with t2pmhc-gat and reused by both models, matching
            // how the graphs are shared between the gcn and gat predictions in practice
            run("T2PMHC_CREATEGRAPHS") {
                script "../../creategraphs/main.nf"
                process {
                    """
                    def samplesheet = file('https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/tcrpmhcbinding/testdata-default/tcrpmhc_sample.tsv', checkIfExists: true)
                    def lines = samplesheet.readLines()
                    def header = lines[0].split('\\t')
                    def pdb_column_index = header.findIndexOf { it == 'pdb_file_path' }
                    def structure_files = lines[1..-1].collectMany { line ->
                        def columns = line.split('\\t')
                        def pdb_path = columns[pdb_column_index]
                        def npy_path = pdb_path.replaceAll(/\\.pdb\$/, '_predicted_aligned_error.npy')
                        return [file(pdb_path, checkIfExists: true), file(npy_path, checkIfExists: true)]
                    }.findAll { it && it.toString().trim() }

                    input[0] = Channel.of([
                        [ id:'test' ],
                        samplesheet,
                        structure_files
                    ])
                    input[1] = 't2pmhc-gat'
                    """
                }
            }
        }

        when {
            params {
                module_args = ''
            }
            process {
                """
                def ch_samplesheet = Channel.of([
                    [ id:'test' ],
                    file('https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/tcrpmhcbinding/testdata-default/tcrpmhc_sample.tsv', checkIfExists: true)
                ])
                input[0] = ch_samplesheet.join(T2PMHC_CREATEGRAPHS.out.graphs)
                input[1] = 't2pmhc-gcn'
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out.pred,
                    process.out.versions_t2pmhc
                ).match() },
                {
                    def rows = path(process.out.pred.get(0)[1]).readLines()
                    assert rows[0].split('\t').contains('binder_prob')
                },
                {
                    // the exact row count is pinned by the snapshot; this guards the pairing
                    // key itself, which a silent drop or duplication would corrupt
                    def rows = path(process.out.pred.get(0)[1]).readLines()
                    def id_column = rows[0].split('\t').findIndexOf { it == 'identifier' }
                    assert id_column >= 0 : "output lost the identifier column"
                    def ids = rows[1..-1].collect { it.split('\t')[id_column] }
                    assert ids.unique().size() == ids.size() : "duplicate identifiers in output"
                }
            )
        }

    }

    test("homo_sapiens - [tsv, pt] - sample score pairing independent of input row order") {

        setup {
            run("T2PMHC_CREATEGRAPHS") {
                script "../../creategraphs/main.nf"
                process {
                    """
                    def samplesheet = file('https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/tcrpmhcbinding/testdata-default/tcrpmhc_sample.tsv', checkIfExists: true)
                    def lines = samplesheet.readLines()
                    def header = lines[0].split('\\t')
                    def pdb_column_index = header.findIndexOf { it == 'pdb_file_path' }
                    def structure_files = lines[1..-1].collectMany { line ->
                        def columns = line.split('\\t')
                        def pdb_path = columns[pdb_column_index]
                        def npy_path = pdb_path.replaceAll(/\\.pdb\$/, '_predicted_aligned_error.npy')
                        return [file(pdb_path, checkIfExists: true), file(npy_path, checkIfExists: true)]
                    }.findAll { it && it.toString().trim() }

                    def reversed_sheet = file("\${workDir}/reversed_samplesheet.tsv")
                    reversed_sheet.text = ([lines[0]] + lines[1..-1].reverse()).join(System.lineSeparator()) + System.lineSeparator()

                    input[0] = Channel.of(
                        [ [ id:'forward' ], samplesheet, structure_files ],
                        [ [ id:'reverse' ], reversed_sheet, structure_files ]
                    )
                    input[1] = 't2pmhc-gat'
                    """
                }
            }
        }

        when {
            params {
                module_args = ''
            }
            process {
                """
                // samplesheet and reversed_sheet come from the setup block, which nf-test
                // folds into this same script scope
                def ch_samplesheet = Channel.of(
                    [ [ id:'forward' ], samplesheet ],
                    [ [ id:'reverse' ], reversed_sheet ]
                )
                input[0] = ch_samplesheet.join(T2PMHC_CREATEGRAPHS.out.graphs)
                input[1] = 't2pmhc-gat'
                """
            }
        }

        then {
            assert process.success
            assertAll(
                {
                    // scores must follow their sample, not its position in the input table
                    def scores_by_identifier = { output_file ->
                        def rows = path(output_file).readLines()
                        def headers = rows[0].split('\t')
                        def id_column = headers.findIndexOf { it == 'identifier' }
                        def score_column = headers.findIndexOf { it == 'binder_prob' }
                        assert id_column >= 0 && score_column >= 0
                        return rows[1..-1].collectEntries { row ->
                            def values = row.split('\t')
                            [ values[id_column], values[score_column] ]
                        }
                    }

                    def forward = process.out.pred.find { it[0].id == 'forward' }[1]
                    def reverse = process.out.pred.find { it[0].id == 'reverse' }[1]

                    def forward_scores = scores_by_identifier(forward)
                    def reverse_scores = scores_by_identifier(reverse)

                    assert forward_scores.keySet() == reverse_scores.keySet() : "different samples scored between the two orderings"
                    // Scores carry order-dependent float noise, so compare numerically rather
                    // than exactly. The tolerance is only meaningful for samples further apart
                    // than it: a swap between two samples whose scores differ by less than the
                    // tolerance cannot be detected. Assert that at least one sample is separable,
                    // so this never degenerates into a check that cannot fail.
                    def tolerance = 1e-5
                    def all_scores = forward_scores.values().collect { it as double }
                    def indistinguishable = forward_scores.count { sample, score ->
                        all_scores.count { Math.abs(it - (score as double)) <= tolerance } > 1
                    }
                    assert indistinguishable < forward_scores.size() : "every sample sits within ${tolerance} of another, so a swapped pairing could not be detected"
                    forward_scores.each { identifier, score ->
                        def drift = Math.abs((reverse_scores[identifier] as double) - (score as double))
                        assert drift <= tolerance : "sample ${identifier} scored ${score} forward but ${reverse_scores[identifier]} reversed (drift ${drift})"
                    }
                }
            )
        }

    }

    test("homo_sapiens - [tsv, []] - t2pmhc-gat - stub") {

        options "-stub"

        when {
            params {
                module_args = ''
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file('https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/tcrpmhcbinding/testdata-default/tcrpmhc_sample.tsv', checkIfExists: true),
                    []
                ]
                input[1] = 't2pmhc-gat'
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

}
