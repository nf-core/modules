    test("saccharomyces_cerevisiae - salmon - gtf - mismatched_transcripts") {
        def salmon
        setup {
            // params.modules_testdata_base_path is null outside the process string, so use the same env var and default as tests/config/nf-test.config
            def modules_testdata_base_path = System.getenv('NXF_MODULES_TESTDATA_BASE') ?: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
            salmon = extract(modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/salmon_results.tar.gz')
            run("CUSTOM_TX2GENE") {
                script "../../../custom/tx2gene/main.nf"
                process {
                    """
                    input[0] = channel.of([
                        [ id:'test'], // meta map
                        file(params.modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/genome_gfp.gtf', checkIfExists: true)
                    ])
                    input[1] = [ [ id:'test' ], file('${salmon}').listFiles().collect() ]
                    input[2] = 'salmon'
                    input[3] = 'gene_id'
                    input[4] = 'gene_name'
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = [ [ id:'test' ], file('${salmon}').listFiles().collect() ]
                // Remove half the entries from tx2gene to simulate FASTA/GTF mismatch
                input[1] = CUSTOM_TX2GENE.out.tx2gene.map { meta, tx2gene ->
                    def lines = tx2gene.readLines()
                    def header = lines[0]
                    def kept = lines[1..Math.max(1, lines.size().intdiv(2))]
                    def modified = file("\${workDir}/truncated_tx2gene.tsv")
                    modified.text = ([header] + kept).join('\\n') + '\\n'
                    [meta, modified]
                }
                input[2] = 'salmon'
                """
            }
        }

        then {
            // The truncated tx2gene covers only a subset of transcripts.
            // Without filtering, unmapped transcripts would appear as fake
            // genes (gene_id = transcript_id), inflating the gene count to
            // match the transcript count (yeast has ~1:1 gene:transcript).
            // With filtering, gene rows should be strictly fewer.
            def gene_counts = path(process.out.counts_gene[0][1])
            def gene_lines = gene_counts.readLines()
            def tx_lines = path(process.out.counts_transcript[0][1]).readLines()
            def aug_lines = path(process.out.tx2gene_augmented[0][1]).readLines()
            def n_genes = gene_lines.size() - 1        // subtract header
            def n_transcripts = tx_lines.size() - 1
            def n_aug = aug_lines.size() - 1

            // Read .command.err from the work directory to check for warning
            def commandErr = gene_counts.parent.resolve('.command.err').text

            assertAll(
                { assert process.success },
                { assert n_genes > 0 },
                { assert n_genes < n_transcripts :
                    "Gene count rows ($n_genes) should be fewer than transcript rows ($n_transcripts) after filtering unmapped transcripts" },
                { assert n_aug == n_transcripts :
                    "Augmented tx2gene rows ($n_aug) should equal transcript count ($n_transcripts) - one mapping per quantified transcript" },
                { assert commandErr.contains("transcripts found in quantification output but missing from") :
                    "Expected warning about unmapped transcripts in .command.err" }
            )
        }
    }

    test("saccharomyces_cerevisiae - salmon - gtf - numeric_gene_ids") {
        def salmon
        setup {
            // params.modules_testdata_base_path is null outside the process string, so use the same env var and default as tests/config/nf-test.config
            def modules_testdata_base_path = System.getenv('NXF_MODULES_TESTDATA_BASE') ?: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
            salmon = extract(modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/salmon_results.tar.gz')
            run("CUSTOM_TX2GENE") {
                script "../../../custom/tx2gene/main.nf"
                process {
                    """
                    input[0] = channel.of([
                        [ id:'test'], // meta map
                        file(params.modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/genome_gfp.gtf', checkIfExists: true)
                    ])
                    input[1] = [ [ id:'test' ], file('${salmon}').listFiles().collect() ]
                    input[2] = 'salmon'
                    input[3] = 'gene_id'
                    input[4] = 'gene_name'
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = [ [ id:'test' ], file('${salmon}').listFiles().collect() ]
                // Replace gene IDs with numbers, as in Entrez/NCBI annotations
                input[1] = CUSTOM_TX2GENE.out.tx2gene.map { meta, tx2gene ->
                    def lines = tx2gene.readLines()
                    def numeric_ids = [:]
                    def renamed = lines.drop(1).collect { line ->
                        def fields = line.split('\\t', -1)
                        fields[1] = numeric_ids.computeIfAbsent(fields[1]) { 100000 + numeric_ids.size() }.toString()
                        fields.join('\\t')
                    }
                    def modified = file("\${workDir}/numeric_tx2gene.tsv")
                    modified.text = ([lines[0]] + renamed).join('\\n') + '\\n'
                    [meta, modified]
                }
                input[2] = 'salmon'
                """
            }
        }

        then {
            def dtu_lines = path(process.out.counts_transcript_dtu_scaled[0][1]).readLines()

            assertAll(
                { assert process.success },
                { assert dtu_lines.size() > 1 },
                { assert !dtu_lines.drop(1).any { line -> line.split('\t').contains('NA') } },
                { assert snapshot(
                    process.out.counts_transcript_dtu_scaled,
                    process.out.counts_transcript_scaled,
                    process.out.versions).match()
                }
            )
        }
    }

    test("saccharomyces_cerevisiae - salmon - gtf - ignore_tx_version") {

        def salmon
        setup {
            // params.modules_testdata_base_path is null outside the process string, so use the same env var and default as tests/config/nf-test.config
            def modules_testdata_base_path = System.getenv('NXF_MODULES_TESTDATA_BASE') ?: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
            salmon = extract(modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/salmon_results.tar.gz')
            run("CUSTOM_TX2GENE") {
                script "../../../custom/tx2gene/main.nf"
                process {
                    """
                    input[0] = channel.of([
                        [ id:'test'], // meta map
                        file(params.modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/genome_gfp.gtf', checkIfExists: true)
                    ])
                    input[1] = [ [ id:'test' ], file('${salmon}').listFiles().collect() ]
                    input[2] = 'salmon'
                    input[3] = 'gene_id'
                    input[4] = 'gene_name'
                    """
                }
            }
        }

        when {
            params {
                module_args = '--ignore_tx_version true'
            }
            process {
                """
                // Append a '.1' version to every transcript in the quantifications, leaving the tx2gene unversioned,
                // and add a '_PAR_Y' copy of the first transcript, which has to stay distinct from it
                input[0] = [ [ id:'test' ], file('${salmon}').listFiles().collect { sample ->
                    def versioned = file("\${workDir}/versioned_quants/\${sample.name}")
                    versioned.mkdirs()
                    def lines = sample.resolve('quant.sf').readLines()
                    def renamed = lines.drop(1).collect { line ->
                        def fields = line.split('\\t', 2)
                        fields[0] + '.1\\t' + fields[1]
                    }
                    def first = lines[1].split('\\t', 2)
                    renamed << first[0] + '.1_PAR_Y\\t' + first[1]
                    versioned.resolve('quant.sf').text = ([lines[0]] + renamed).join('\\n') + '\\n'
                    versioned
                } ]
                input[1] = CUSTOM_TX2GENE.out.tx2gene
                input[2] = 'salmon'
                """
            }
        }

        then {
            def gene_counts = path(process.out.counts_gene[0][1])
            def tx_ids = path(process.out.counts_transcript[0][1]).readLines().drop(1).collect { line -> line.split('\t')[0] }
            def commandErr = gene_counts.parent.resolve('.command.err').text

            assertAll(
                { assert process.success },
                { assert !tx_ids.any { tx -> tx.endsWith('.1') } },
                { assert tx_ids.count { tx -> tx.endsWith('.1_PAR_Y') } == 1 },
                { assert commandErr.contains("1 transcripts found in quantification output but missing from") },
                { assert snapshot(
                    process.out.counts_gene,
                    process.out.counts_gene_length_scaled,
                    process.out.counts_gene_scaled,
                    process.out.counts_transcript,
                    process.out.counts_transcript_dtu_scaled,
                    process.out.counts_transcript_scaled,
                    process.out.lengths_gene,
                    process.out.lengths_transcript,
                    process.out.tpm_gene,
                    process.out.tpm_transcript,
                    process.out.tx2gene_augmented,
                    process.out.versions).match()
                }
            )
        }
    }

