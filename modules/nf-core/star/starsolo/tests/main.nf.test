nextflow_process {

    name "Test Process STAR_STARSOLO"
    script "../main.nf"
    process "STAR_STARSOLO"

    tag "modules"
    tag "modules_nfcore"
    tag "star"
    tag "star/starsolo"
    tag "star/genomegenerate"

    test("homo_sapiens - CB_UMI_Simple") {
        config "./nextflow.config"

        setup {
            run("STAR_GENOMEGENERATE") {
                script "../../../star/genomegenerate/main.nf"
                process {
                    """
                    input[0] = channel.of([
                        [ id:'test_fasta' ],
                        [ file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true) ]
                    ])
                    input[1] = channel.of([
                        [ id:'test_gtf' ],
                        [ file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.gtf', checkIfExists: true) ]
                    ])
                    """
                }
            }
        }

        when {
            params {
                module_args = "--soloUMIlen 12 --outSAMtype BAM SortedByCoordinate --soloBarcodeReadLength 0 --limitBAMsortRAM 5000000000"
            }

            process {
                """
                file('NO_FILE').text = ''

                input[0] = channel.of([
                    [ id:'test'],
                    'CB_UMI_Simple',
                    [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/10xgenomics/cellranger/5k_cmvpos_tcells/fastqs/gex_1/subsampled_5k_human_antiCMV_T_TBNK_connect_GEX_1_S1_L001_R1_001.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/10xgenomics/cellranger/5k_cmvpos_tcells/fastqs/gex_1/subsampled_5k_human_antiCMV_T_TBNK_connect_GEX_1_S1_L001_R2_001.fastq.gz', checkIfExists: true)
                    ],
                    [ ]
                ])
                input[1] = file('NO_FILE')
                input[2] = STAR_GENOMEGENERATE.out.index
                input[3] = channel.of([
                    [ id:'test_gtf' ],
                    [ ]
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    sanitizeOutput(process.out, unstableKeys: ["log_final", "log_out", "log_progress", "bam_sorted"]),
                    file(process.out.log_final[0][1]).name,
                    file(process.out.log_out[0][1]).name,
                    file(process.out.log_progress[0][1]).name,
                    file(process.out.bam_sorted[0][1]).name,
                    bam(process.out.bam_sorted[0][1]).getStatistics(),
                    ).match() }
            )
        }

    }

    test("homo_sapiens - CB_UMI_Complex") {
        config "./nextflow.config"

        setup {
            run("STAR_GENOMEGENERATE") {
                script "../../../star/genomegenerate/main.nf"
                process {
                    """
                    input[0] = channel.of([
                        [ id:'test_fasta' ],
                        [ file('test.fa', checkIfExists: true) ]
                    ])
                    input[1] = channel.of([
                        [ id:'test_gtf' ],
                        [ file('test.gtf', checkIfExists: true) ]
                    ])
                    """
                }
            }
        }

        when {
            params {
                module_args = "--soloAdapterSequence GAGTGATTGCTTGTGACGCCTT --soloAdapterMismatchesNmax 3 --soloCBmatchWLtype 1MM --soloCBposition 0_0_2_-1 3_1_3_8 --soloUMIposition 3_9_3_14 --soloFeatures Gene GeneFull"
            }

            process {
                """
                input[0] = channel.of([
                    [ id:'test'],
                    'CB_UMI_Complex',
                    [
                        file('IND1_1.fastq.gz', checkIfExists: true),
                        file('IND1_2.fastq.gz', checkIfExists: true)
                    ],
                    [ ]
                ])
                input[1] = [
                        file('inDrops_Ambrose_bc1.txt', checkIfExists: true),
                        file('inDrops_Ambrose_bc2.txt', checkIfExists: true)
                    ]
                input[2] = STAR_GENOMEGENERATE.out.index
                input[3] = channel.of([
                    [ id:'test_gtf' ],
                    [ ]
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    sanitizeOutput(process.out, unstableKeys: ["log_final", "log_out", "log_progress"], ignorePatterns: ["**/UMIperCellSorted.txt"]),
                    file(process.out.log_final[0][1]).name,
                    file(process.out.log_out[0][1]).name,
                    file(process.out.log_progress[0][1]).name,
                    ).match() }
            )
        }

    }

    test("homo_sapiens - SmartSeq") {
        config "./nextflow.config"

        setup {
            run("STAR_GENOMEGENERATE") {
                script "../../../star/genomegenerate/main.nf"
                process {
                    """
                    input[0] = channel.of([
                        [ id:'test_fasta' ],
                        [ file('test.fa', checkIfExists: true) ]
                    ])
                    input[1] = channel.of([
                        [ id:'test_gtf' ],
                        [ file('test.gtf', checkIfExists: true) ]
                    ])
                    """
                }
            }
        }

        when {
            params {
                module_args = "--readFilesCommand zcat --soloUMIdedup Exact --soloStrand Unstranded --limitOutSJcollapsed 10000000 --soloCellFilter None --soloFeatures Gene GeneFull"
            }

            process {
                """
                file('NO_FILE').text = ''

                input[0] = channel.of([
                    [ id:'test'],
                    'SmartSeq',
                    [ ],
                    [ file('smartseq_example.manifest.tsv', checkIfExists: true) ]
                ])
                input[1] = file('NO_FILE', checkIfExists: true)
                input[2] = STAR_GENOMEGENERATE.out.index
                input[3] = channel.of([
                    [ id:'test_gtf' ],
                    [ ]
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    sanitizeOutput(process.out, unstableKeys: ["log_final", "log_out", "log_progress"]),
                    file(process.out.log_final[0][1]).name,
                    file(process.out.log_out[0][1]).name,
                    file(process.out.log_progress[0][1]).name,
                    ).match() }
            )
        }

    }

    test("homo_sapiens - SmartSeq - failure") {
        setup {
            run("STAR_GENOMEGENERATE") {
                script "../../../star/genomegenerate/main.nf"
                process {
                    """
                    input[0] = channel.of([
                        [ id:'test_fasta' ],
                        [ file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true) ]
                    ])
                    input[1] = channel.of([
                        [ id:'test_gtf' ],
                        [ file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.gtf', checkIfExists: true) ]
                    ])
                    """
                }
            }
        }

        when {
            process {
                """
                file('NO_FILE').text = ''

                input[0] = channel.of([
                    [ id:'test'],
                    'SmartSeq',
                    [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/10xgenomics/cellranger/5k_cmvpos_tcells/fastqs/gex_1/subsampled_5k_human_antiCMV_T_TBNK_connect_GEX_1_S1_L001_R1_001.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/10xgenomics/cellranger/5k_cmvpos_tcells/fastqs/gex_1/subsampled_5k_human_antiCMV_T_TBNK_connect_GEX_1_S1_L001_R2_001.fastq.gz', checkIfExists: true)
                    ],
                    [ ]
                ])
                input[1] = file('NO_FILE')
                input[2] = STAR_GENOMEGENERATE.out.index
                input[3] = channel.of([
                    [ id:'test_gtf' ],
                    [ ]
                ])
                """
            }
        }

        then {
            assertAll(
                { assert !process.success },
                { assert process.stdout.toString().contains("EXITING: FATAL INPUT ERROR: empty value for parameter \"readFilesManifest\" in input \"Command-Line\"")}
            )
        }

    }

    test("homo_sapiens - CB_UMI_Simple - gtf - whitelist") {
        config "./nextflow.config"

        setup {
            run("STAR_GENOMEGENERATE") {
                script "../../../star/genomegenerate/main.nf"
                process {
                    """
                    input[0] = channel.of([
                        [ id:'test_fasta' ],
                        [ file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true) ]
                    ])
                    input[1] = channel.of([
                        [ id:'test_gtf' ],
                        [ file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.gtf', checkIfExists: true) ]
                    ])
                    """
                }
            }

            new File("${launchDir}/whitelist.txt").text = """
            AAACCCAAGAAACACT
            AAACCCAAGAAACCAT
            AAACCCAAGAAACCCA
            AAACCCAAGAAACCCG
            AAACCCAAGAAACCTG
            AAACCCAAGAAACGAA
            AAACCCAAGAAACGAG
            AAACCCAAGAAACGAT
            AAACCCAAGAAACGCC
            AAACCCAAGAAACGGT
            """.stripIndent().trim()
        }

        when {
            params {
                module_args = "--soloUMIlen 12 --outSAMtype BAM SortedByCoordinate --soloBarcodeReadLength 0 --limitBAMsortRAM 5000000000"
            }

            process {
                """
                input[0] = channel.of([
                    [ id:'test'],
                    'CB_UMI_Simple',
                    [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/10xgenomics/cellranger/5k_cmvpos_tcells/fastqs/gex_1/subsampled_5k_human_antiCMV_T_TBNK_connect_GEX_1_S1_L001_R1_001.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/10xgenomics/cellranger/5k_cmvpos_tcells/fastqs/gex_1/subsampled_5k_human_antiCMV_T_TBNK_connect_GEX_1_S1_L001_R2_001.fastq.gz', checkIfExists: true)
                    ],
                    [ ]
                ])
                input[1] = file("${launchDir}/whitelist.txt")
                input[2] = STAR_GENOMEGENERATE.out.index
                input[3] = channel.of([
                    [ id:'test_gtf' ],
                    [ file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.gtf', checkIfExists: true) ]
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    sanitizeOutput(process.out, unstableKeys: ["log_final", "log_out", "log_progress", "bam_sorted"], ignorePatterns: ["**/UMIperCellSorted.txt"]),
                    file(process.out.log_final[0][1]).name,
                    file(process.out.log_out[0][1]).name,
                    file(process.out.log_progress[0][1]).name,
                    file(process.out.bam_sorted[0][1]).name,
                    bam(process.out.bam_sorted[0][1]).getStatistics(),
                    ).match() }
            )
        }

    }

