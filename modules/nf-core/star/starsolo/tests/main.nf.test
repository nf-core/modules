nextflow_process {

    name "Test Process STAR_STARSOLO"
    script "../main.nf"
    process "STAR_STARSOLO"

    tag "modules"
    tag "modules_nfcore"
    tag "star"
    tag "star/starsolo"
    tag "star/genomegenerate"

    test("homo_sapiens - CB_UMI_Simple") {
        config "./nextflow.config"

        setup {
            run("STAR_GENOMEGENERATE") {
                script "../../../star/genomegenerate/main.nf"
                process {
                    """
                    input[0] = Channel.of([
                        [ id:'test_fasta' ],
                        [ file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true) ]
                    ])
                    input[1] = Channel.of([
                        [ id:'test_gtf' ],
                        [ file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.gtf', checkIfExists: true) ]
                    ])
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test'],
                    'CB_UMI_Simple',
                    [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/10xgenomics/cellranger/5k_cmvpos_tcells/fastqs/gex_1/subsampled_5k_human_antiCMV_T_TBNK_connect_GEX_1_S1_L001_R1_001.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/10xgenomics/cellranger/5k_cmvpos_tcells/fastqs/gex_1/subsampled_5k_human_antiCMV_T_TBNK_connect_GEX_1_S1_L001_R2_001.fastq.gz', checkIfExists: true)
                    ],
                    [ ]
                ])
                input[1] = file('./NO_FILE')
                input[2] = STAR_GENOMEGENERATE.out.index
                input[3] = Channel.of([
                    [ id:'test_gtf' ],
                    [ ]
                ])
                input[4] = true
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ["log_final", "log_out", "log_progress"])).match() }
            )
        }

    }

    test("homo_sapiens - SmartSeq") {
        setup {
            run("STAR_GENOMEGENERATE") {
                script "../../../star/genomegenerate/main.nf"
                process {
                    """
                    input[0] = Channel.of([
                        [ id:'test_fasta' ],
                        [ file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true) ]
                    ])
                    input[1] = Channel.of([
                        [ id:'test_gtf' ],
                        [ file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.gtf', checkIfExists: true) ]
                    ])
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test'],
                    'SmartSeq',
                    [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/10xgenomics/cellranger/5k_cmvpos_tcells/fastqs/gex_1/subsampled_5k_human_antiCMV_T_TBNK_connect_GEX_1_S1_L001_R1_001.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/10xgenomics/cellranger/5k_cmvpos_tcells/fastqs/gex_1/subsampled_5k_human_antiCMV_T_TBNK_connect_GEX_1_S1_L001_R2_001.fastq.gz', checkIfExists: true)
                    ],
                    [ ]
                ])
                input[1] = file('./NO_FILE')
                input[2] = STAR_GENOMEGENERATE.out.index
                input[3] = Channel.of([
                    [ id:'test_gtf' ],
                    [ ]
                ])
                input[4] = true
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains ("empty value for parameter \"readFilesManifest\" in input \"Command-Line\"")}
            )
        }

    }

