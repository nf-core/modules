nextflow_process {

    name "Test Process TANTAN"
    script "../main.nf"
    process "TANTAN"
    config "./nextflow.config"

    tag "modules"
    tag "modules_nfcore"
    tag "tantan"

    test("sarscov2 - fasta.gz - output format 0 - masked fasta") {
        when {
            process {
                """
                input[0] = [
                    [ id: 'test' ], // meta map
                    file(
                        params.modules_testdata_base_path +
                        'genomics/sarscov2/genome/genome.fasta.gz',
                        checkIfExists: true
                    ),
                ]
                input[1] = '0'
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("sarscov2 - fasta.gz - output format 1 - probabilities") {
        when {
            process {
                """
                input[0] = [
                    [ id: 'test' ], // meta map
                    file(
                        params.modules_testdata_base_path +
                        'genomics/sarscov2/genome/genome.fasta.gz',
                        checkIfExists: true
                    ),
                ]
                input[1] = '1'
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

