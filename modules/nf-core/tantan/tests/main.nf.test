    }

    test("sarscov2 - fasta.gz - output format 4 - tandem repeats") {
        when {
            process {
                """
                input[0] = [
                    [ id: 'test' ], // meta map
                    file(
                        params.modules_testdata_base_path +
                        'genomics/sarscov2/genome/genome.fasta.gz',
                        checkIfExists: true
                    ),
                ]
                input[1] = '4'
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("sarscov2 - fasta.gz - stub - output format 0") {
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id: 'test' ], // meta map
                    file(
                        params.modules_testdata_base_path +
                        'genomics/sarscov2/genome/genome.fasta.gz',
                        checkIfExists: true
                    ),
                ]
                input[1] = '0'
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
