nextflow_process {

    name "Test Process TCOFFEE_IRMSD"
    script "../main.nf"
    process "TCOFFEE_IRMSD"
    tag "modules"
    tag "modules_nfcore"
    tag "tcoffee"
    tag "tcoffee/irmsd"
    tag "pigz/compress"

    test("seatoxin") {

        def structures
        setup {
            // params.modules_testdata_base_path is null outside the process string, so use the same env var and default as tests/config/nf-test.config
            def modules_testdata_base_path = System.getenv('NXF_MODULES_TESTDATA_BASE') ?: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
            structures = extract(modules_testdata_base_path + '../../multiplesequencealign/testdata/structures/seatoxin-ref.tar.gz').resolve('seatoxin-ref')
        }

        when {
            process {
                """
                input[0] = [
                                [ id:'test' ], // meta map
                                file(params.modules_testdata_base_path + "../../multiplesequencealign/testdata/setoxin.ref", checkIfExists: true)
                            ]
                input[1] = [ [ id:'test' ], file(params.modules_testdata_base_path + "../../multiplesequencealign/testdata/templates/seatoxin-ref_template.txt", checkIfExists: true), file('${structures}').listFiles().collect() ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.irmsd.get(0).get(1)).getText().contains("1ahl") },
                { assert snapshot(process.out.findAll { key, val -> key.startsWith('versions') }).match() }
            )
        }
    }

    test("seatoxin - compressed") {

        def structures
        setup {
            // params.modules_testdata_base_path is null outside the process string, so use the same env var and default as tests/config/nf-test.config
            def modules_testdata_base_path = System.getenv('NXF_MODULES_TESTDATA_BASE') ?: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
            structures = extract(modules_testdata_base_path + '../../multiplesequencealign/testdata/structures/seatoxin-ref.tar.gz').resolve('seatoxin-ref')

            run("PIGZ_COMPRESS") {
                script "../../../pigz/compress/main.nf"
                process {
                    """
                    input[0] = [ [ id:'test' ],
                                file(params.modules_testdata_base_path + "../../multiplesequencealign/testdata/setoxin.ref", checkIfExists: true)
                                ]
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = PIGZ_COMPRESS.out.archive
                input[1] = [ [ id:'test' ], file(params.modules_testdata_base_path + "../../multiplesequencealign/testdata/templates/seatoxin-ref_template.txt", checkIfExists: true), file('${structures}').listFiles().collect() ]
                """
            }

        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.irmsd.get(0).get(1)).getText().contains("1ahl") },
                { assert snapshot(process.out.findAll { key, val -> key.startsWith('versions') }).match() }
            )
        }

    }

    test("seatoxin - uncompressed - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                                [ id:'test' ], // meta map
                                file(params.modules_testdata_base_path + "../../multiplesequencealign/testdata/setoxin.ref", checkIfExists: true)
                            ]
                input[1] = [ [ id:'test' ], [], [] ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match()}
            )
        }
    }
}
