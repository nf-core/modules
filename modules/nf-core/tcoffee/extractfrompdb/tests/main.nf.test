nextflow_process {

    name "Test Process TCOFFEE_EXTRACTFROMPDB"
    script "../main.nf"
    process "TCOFFEE_EXTRACTFROMPDB"

    tag "modules"
    tag "modules_nfcore"
    tag "tcoffee"
    tag "tcoffee/extractfrompdb"

    test("seatoxin") {

        def structures
        setup {
            // params.modules_testdata_base_path is null outside the process string, so use the same env var and default as tests/config/nf-test.config
            def modules_testdata_base_path = System.getenv('NXF_MODULES_TESTDATA_BASE') ?: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
            structures = extract(modules_testdata_base_path + '../../multiplesequencealign/testdata/structures/seatoxin-ref.tar.gz').resolve('seatoxin-ref')
        }

        when {
            process {
                """
                input[0] = [ [ id:'test' ], file('${structures}').listFiles().sort{ pdb -> pdb.name }.first() ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }

    test("seatoxin - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = channel.fromPath('empty_file.pdb').map{ pdb -> [[ id: 'test'], pdb]}
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }
}
