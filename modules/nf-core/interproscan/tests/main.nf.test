nextflow_process {

    name "Test Process INTERPROSCAN"
    script "../main.nf"
    process "INTERPROSCAN"

    tag "modules"
    tag "modules_nfcore"
    tag "interproscan"

    test("l_asparaginase - faa - test database") {
        config "./nextflow_database.config"
        def db
        setup {
            // params.modules_testdata_base_path is null outside the process string, so use the same env var and default as tests/config/nf-test.config
            def modules_testdata_base_path = System.getenv('NXF_MODULES_TESTDATA_BASE') ?: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
            db = extract(modules_testdata_base_path + 'proteomics/interproscan/interproscan_test.tar.gz').resolve('data')
        }

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'proteomics/interproscan/l_arginase.faa', checkIfExists: true)
                ]
                input[1] = file('${db}')
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    path(process.out.tsv[0][1]).readLines()[0]
                        .contains("GI|225038609|EFDID|719595|FULL	079fff43a0270e432d339ea71b6f0acf	350	SFLD	SFLDS00057	Glutaminase/Asparaginase	17	347	0.0	T"),
                    process.out.xml,
                    process.out.json,
                    path(process.out.gff3[0][1]).readLines()[0..4,6..-1],
                    process.out.findAll { key, val -> key.startsWith("versions")}
                ).match()}
            )
        }

    }

    test("sarscov2 - proteome_fasta") {
        config "./nextflow.config"
        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/proteome.fasta', checkIfExists: true)
                ]
                input[1] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    path(process.out.tsv[0][1]).readLines()[0]
                        .contains("ENSSASP00005000004.1	4c35f09aac2f7be4f3cffd30c6aecac8	1273	Coils	Coil	Coil	1176	1203	-	T"),
                    process.out.xml,
                    process.out.json,
                    path(process.out.gff3[0][1]).readLines()[0..4,6..-1],
                    process.out.findAll { key, val -> key.startsWith("versions")}
                ).match()}
            )
        }

    }

    test("sarscov2 - proteome_fasta_gz") {
        config "./nextflow.config"
        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/proteome.fasta.gz', checkIfExists: true)
                ]
                input[1] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    path(process.out.tsv[0][1]).readLines()[0]
                        .contains("ENSSASP00005000004.1	4c35f09aac2f7be4f3cffd30c6aecac8	1273	Coils	Coil	Coil	1176	1203	-	T"),
                    process.out.xml,
                    process.out.json,
                    path(process.out.gff3[0][1]).readLines()[0..4,6..-1],
                    process.out.findAll { key, val -> key.startsWith("versions")}
                ).match()}
            )
        }

    }

    test("sarscov2 - proteome_fasta with stop codons") {
        config "./nextflow.config"
        when {
            process {
                """
                input[0] = channel.fromPath(params.modules_testdata_base_path + 'genomics/sarscov2/genome/proteome.fasta', checkIfExists: true)
                    .splitFasta(record: [header: true, seqString: true])
                    .collectFile(name: 'proteome_with_stops.fasta', newLine: true, sort: 'index') { r -> ">\${r.header}\\n\${r.seqString}*" }
                    .map { f -> [ [ id:'test' ], f ] }
                input[1] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                // Same md5 and length as the plain proteome test: exactly the '*' was removed
                { assert path(process.out.tsv[0][1]).readLines()[0]
                    .contains("ENSSASP00005000004.1	4c35f09aac2f7be4f3cffd30c6aecac8	1273	Coils	Coil	Coil	1176	1203	-	T") }
            )
        }
    }

    test("sarscov2 - proteome_fasta_gz - stub") {
        config "./nextflow.config"
        options '-stub'

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/proteome.fasta.gz', checkIfExists: true)
                ]
                input[1] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }
}
