nextflow_process {

    name "Test Process KOFAMSCAN"
    config "./nextflow.config"
    script "../main.nf"
    process "KOFAMSCAN"

    tag "modules"
    tag "modules_nfcore"
    tag "untar"
    tag "gunzip"
    tag "kofamscan"

    setup {
        run("UNTAR") {
            script "../../untar/main.nf"

            process {
                """
                input[0] = [[],file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/db/kofamscan/profiles.tar.gz',checkIfExists:true)]
                """
            }
        }

        run("GUNZIP") {
            script "../../gunzip/main.nf"

            process {
                """
                input[0] = [[],file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/db/kofamscan/ko_list.gz',checkIfExists:true)]
                """
            }
        }
    }

    test("kofamscan - txt") {

        when {
            params {
                module_args = ''
            }
            process {
                """
                input[0] = [[id:'test'], file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/proteome.fasta',checkIfExists: true)]
                input[1] = UNTAR.out.untar.map{it[1]}
                input[2] = GUNZIP.out.gunzip.map{it[1]}
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert process.out.tsv.isEmpty() },
                { assert path(process.out.txt[0][1]).linesGzip.any { l -> l.startsWith('* ENSSASP00005000002.1 K24149') } },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }

    test("kofamscan - tsv") {

        when {
            params {
                module_args = '--format detail-tsv'
            }
            process {
                """
                input[0] = [[id:'test'], file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/proteome.fasta',checkIfExists: true)]
                input[1] = UNTAR.out.untar.map{it[1]}
                input[2] = GUNZIP.out.gunzip.map{it[1]}
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert process.out.txt.isEmpty() },
                { assert path(process.out.tsv[0][1]).linesGzip.any { l -> l.startsWith("*\tENSSASP00005000002.1\tK24149\t15566.27\t16515.5") } },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }

    test("kofamscan - tsv - gzipped fasta") {

        when {
            params {
                module_args = '--format detail-tsv'
            }
            process {
                """
                input[0] = [[id:'test'], file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/proteome.fasta.gz',checkIfExists: true)]
                input[1] = UNTAR.out.untar.map{it[1]}
                input[2] = GUNZIP.out.gunzip.map{it[1]}
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert process.out.txt.isEmpty() },
                { assert path(process.out.tsv[0][1]).linesGzip.any { l -> l.startsWith("*\tENSSASP00005000002.1\tK24149\t15566.27\t16515.5") } },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }

    test("kofamscan - txt - stub") {

        options "-stub"

        when {
            params {
                module_args = ''
            }
            process {
                """
                input[0] = [[id:'test'], file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/proteome.fasta',checkIfExists: true)]
                input[1] = UNTAR.out.untar.map{it[1]}
                input[2] = GUNZIP.out.gunzip.map{it[1]}
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert process.out.tsv.isEmpty() },
                { assert process.out.txt[0][1].endsWith('test.kofamscan.txt.gz') },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }

    test("kofamscan - tsv - stub") {

        options "-stub"

        when {
            params {
                module_args = '--format detail-tsv'
            }
            process {
                """
                input[0] = [[id:'test'], file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/proteome.fasta',checkIfExists: true)]
                input[1] = UNTAR.out.untar.map{it[1]}
                input[2] = GUNZIP.out.gunzip.map{it[1]}
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert process.out.txt.isEmpty() },
                { assert process.out.tsv[0][1].endsWith('test.kofamscan.tsv.gz') },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }
}
