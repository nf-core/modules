                ]
                input[3] = file(params.modules_testdata_base_path + 'genomics/eukaryotes/caenorhabditis_elegans/sa/worm.osa2', checkIfExists: true)
                input[4] = [
                    [ id:'115_WBcel235' ],
                    file('s3://annotation-cache/vep_cache/115_WBcel235/caenorhabditis_elegans/115_WBcel235/')
                ]
                input[5] = 'vcf'
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    file(process.out.vcf[0][1]).name,
                    path(process.out.vcf[0][1]).vcf.variantsMD5,
                    process.out.transcript_cache.collect { file(it[1]).name },
