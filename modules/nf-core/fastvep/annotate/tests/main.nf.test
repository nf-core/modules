nextflow_process {

    name "Test Process FASTVEP_ANNOTATE"
    script "../main.nf"
    process "FASTVEP_ANNOTATE"
    config "./nextflow.config"

    tag "modules"
    tag "modules_nfcore"
    tag "fastvep"
    tag "fastvep/annotate"

    test("caenorhabditis_elegans - vcf.gz") {

        when {
            params {
                module_args = ''
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/eukaryotes/caenorhabditis_elegans/illumina/vcf/c_elegans_caendr_X.vcf.gz', checkIfExists: true),
                    []
                ]
                input[1] = [
                    [ id:'genome' ],
                    file(params.modules_testdata_base_path + 'genomics/eukaryotes/caenorhabditis_elegans/genome/c_elegans_X1-58063.gff3', checkIfExists: true)
                ]
                input[2] = [
                    [ id:'genome' ],
                    file(params.modules_testdata_base_path + 'genomics/eukaryotes/caenorhabditis_elegans/genome/c_elegans_X1-58063.fa', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/eukaryotes/caenorhabditis_elegans/genome/c_elegans_X1-58063.fa.fai', checkIfExists: true)
                ]
                input[3] = file(params.modules_testdata_base_path + 'genomics/eukaryotes/caenorhabditis_elegans/sa/worm.osa2', checkIfExists: true)
                input[4] = [ [:], [] ]
                input[5] = 'vcf'
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    file(process.out.vcf[0][1]).name,
                    path(process.out.vcf[0][1]).vcf.variantsMD5,
                    process.out.transcript_cache.collect { file(it[1]).name },
                    process.out.findAll { key, val -> key.startsWith("versions") }
                ).match() }
            )
        }

    }

    test("caenorhabditis_elegans - vcf.gz - tab") {

        when {
            params {
                module_args = ''
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/eukaryotes/caenorhabditis_elegans/illumina/vcf/c_elegans_caendr_X.vcf.gz', checkIfExists: true),
                    []
                ]
                input[1] = [
                    [ id:'genome' ],
                    file(params.modules_testdata_base_path + 'genomics/eukaryotes/caenorhabditis_elegans/genome/c_elegans_X1-58063.gff3', checkIfExists: true)
                ]
                input[2] = [
                    [ id:'genome' ],
                    file(params.modules_testdata_base_path + 'genomics/eukaryotes/caenorhabditis_elegans/genome/c_elegans_X1-58063.fa', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/eukaryotes/caenorhabditis_elegans/genome/c_elegans_X1-58063.fa.fai', checkIfExists: true)
                ]
                input[3] = file(params.modules_testdata_base_path + 'genomics/eukaryotes/caenorhabditis_elegans/sa/worm.osa2', checkIfExists: true)
                input[4] = [ [:], [] ]
                input[5] = 'tab'
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    file(process.out.tab[0][1]).name,
                    path(process.out.tab[0][1]).linesGzip.findAll { !it.startsWith('#') }.join('\n').md5(),
                    process.out.transcript_cache.collect { file(it[1]).name },
                    process.out.findAll { key, val -> key.startsWith("versions") }
                ).match() }
            )
        }

    }

