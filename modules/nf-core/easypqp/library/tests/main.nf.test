nextflow_process {

    name "Test Process EASYPQP_LIBRARY"
    script "../main.nf"
    process "EASYPQP_LIBRARY"
    config "./nextflow.config"

    tag "modules"
    tag "modules_nfcore"
    tag "easypqp"
    tag "easypqp/library"

    test("proteomics - psmpkl - peakpkl") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    file(params.modules_testdata_base_path + 'proteomics/easypqp/HepG2_rep1_small.psmpkl', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'proteomics/easypqp/HepG2_rep1_small.peakpkl', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    path(process.out.tsv[0][1]).readLines().take(5),
                    file(process.out.run_peaks[0][1]).name,
                    process.out.versions_easypqp
                ).match() }
            )
        }
    }

    test("proteomics - psmpkl - peakpkl - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    file(params.modules_testdata_base_path + 'proteomics/easypqp/HepG2_rep1_small.psmpkl', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'proteomics/easypqp/HepG2_rep1_small.peakpkl', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
