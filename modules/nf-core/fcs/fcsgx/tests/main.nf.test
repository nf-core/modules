nextflow_process {

    name "Test Process FCS_FCSGX"
    script "../main.nf"
    process "FCS_FCSGX"

    tag "modules"
    tag "modules_nfcore"
    tag "fcs"
    tag "fcs/fcsgx"

    test("deprecated") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ], file('assembly'), [] ]
                input[1] = file('gxdb')
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("WARNING: This module has been deprecated.") }
            )
        }
    }
}
