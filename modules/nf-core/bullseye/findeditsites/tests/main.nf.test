nextflow_process {

    name "Test Process BULLSEYE_FINDEDITSITES"
    script "../main.nf"
    process "BULLSEYE_FINDEDITSITES"
    config "./nextflow.config"

    tag "modules"
    tag "modules_nfcore"
    tag "bullseye"
    tag "bullseye/findeditsites"
    tag "bullseye/parsebam"
    tag "htslib/bgziptabix"
    tag "ucsc/gtftogenepred"

    setup {
        run("BULLSEYE_PARSEBAM", alias: "BULLSEYE_PARSEBAM_EDITED") {
            script "../../parsebam/main.nf"
            process {
                """
                input[0] = Channel.of([
                    [ id:'edited' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/dart.chr22_test.bam', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/dart.chr22_test.bam.bai', checkIfExists: true),
                ])
                input[1] = 1
                """
            }
        }
        run("BULLSEYE_PARSEBAM", alias: "BULLSEYE_PARSEBAM_CONTROL") {
            script "../../parsebam/main.nf"
            process {
                """
                input[0] = Channel.of([
                    [ id:'control' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/control.chr22_test.bam', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/control.chr22_test.bam.bai', checkIfExists: true),
                ])
                input[1] = 1
                """
            }
        }
        run("HTSLIB_BGZIPTABIX", alias: "HTSLIB_BGZIPTABIX_EDITED") {
            script "../../../htslib/bgziptabix/main.nf"
            process {
                """
                input[0] = BULLSEYE_PARSEBAM_EDITED.out.matrix.map { meta, matrix -> [ meta, matrix, [], [] ] }
                input[1] = "compress"
                input[2] = true
                input[3] = []
                """
            }
        }
        run("HTSLIB_BGZIPTABIX", alias: "HTSLIB_BGZIPTABIX_CONTROL") {
            script "../../../htslib/bgziptabix/main.nf"
            process {
                """
                input[0] = BULLSEYE_PARSEBAM_CONTROL.out.matrix.map { meta, matrix -> [ meta, matrix, [], [] ] }
                input[1] = "compress"
                input[2] = true
                input[3] = []
                """
            }
        }
        run("UCSC_GTFTOGENEPRED") {
            script "../../../ucsc/gtftogenepred/main.nf"
            process {
                """
                // the genome.gtf fixture annotates 'chr22', but the dart/control
                // bams here use the contig name 'chr22_test' - rename so sites
                // can actually be matched to a gene instead of silently finding none
                def gtf_src   = file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.gtf', checkIfExists: true)
                def gtf_stage = new File(workDir.toString(), 'chr22_test.gtf')
                gtf_stage.text = gtf_src.text.replaceAll('(?m)^chr22\\t', 'chr22_test\\t')

                input[0] = Channel.of([
                    [ id:'genome' ],
                    file(gtf_stage.getAbsolutePath(), checkIfExists: true)
                ])
                """
            }
        }
    }

    test("bullseye - dart bam vs control") {

        when {
            process {
                """
                def ch_edited  = HTSLIB_BGZIPTABIX_EDITED.out.output.join(HTSLIB_BGZIPTABIX_EDITED.out.index)
                def ch_control = HTSLIB_BGZIPTABIX_CONTROL.out.output.join(HTSLIB_BGZIPTABIX_CONTROL.out.index)

                input[0] = ch_edited.combine(ch_control)
                    .map { meta, matrix, tbi, control_meta, control_matrix, control_tbi ->
                        [ meta, matrix, tbi, control_meta, control_matrix, control_tbi ]
                    }
                input[1] = UCSC_GTFTOGENEPRED.out.refflat.map { it[1] }
                input[2] = 'C2U'
                input[3] = 0
                input[4] = 100
                input[5] = 1
                input[6] = 1
                input[7] = 1
                input[8] = 1
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }

    test("bullseye - dart bam vs control - stub") {

        options "-stub"

        when {
            process {
                """
                def ch_edited  = HTSLIB_BGZIPTABIX_EDITED.out.output.join(HTSLIB_BGZIPTABIX_EDITED.out.index)
                def ch_control = HTSLIB_BGZIPTABIX_CONTROL.out.output.join(HTSLIB_BGZIPTABIX_CONTROL.out.index)

                input[0] = ch_edited.combine(ch_control)
                    .map { meta, matrix, tbi, control_meta, control_matrix, control_tbi ->
                        [ meta, matrix, tbi, control_meta, control_matrix, control_tbi ]
                    }
                input[1] = UCSC_GTFTOGENEPRED.out.refflat.map { it[1] }
                input[2] = 'C2U'
                input[3] = 0
                input[4] = 100
                input[5] = 1
                input[6] = 1
                input[7] = 1
                input[8] = 1
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }
}
