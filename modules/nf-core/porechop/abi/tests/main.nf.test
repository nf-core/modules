nextflow_process {

    name "Test Process PORECHOP_ABI"
    script "../main.nf"
    process "PORECHOP_ABI"
    tag "modules"
    tag "modules_nfcore"
    tag "porechop"
    tag "porechop/abi"

    test("sarscov2-nanopore") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test'],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/nanopore/fastq/test.fastq.gz', checkIfExists: true)
                ]
		        input[1] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out, unstableKeys:["log"])).match() }
            )
        }
    }

    test("sarscov2-nanopore - stub") {
        options "-stub"
        when {

            process {
                """
                input[0] = [
                    [ id:'test'],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/nanopore/fastq/test.fastq.gz', checkIfExists: true)
                ]
		        input[1] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }
}
