nextflow_process {

    name "Test Process RASTAIR2_CALL"
    script "../main.nf"
    process "RASTAIR2_CALL"

    tag "modules"
    tag "modules_nfcore"
    tag "rastair2"
    tag "rastair2/call"

    // NOTE The VCF header records the command line (including --threads), so only the #CHROM line
    // and records are snapshotted. They are hashed as text because rastair declares Number=M
    // FORMAT fields (VCF 4.4+ base modifications), which the htsjdk-based nft-vcf parser rejects.

    test("sarscov2 - paired-end methylated bam") {

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:false ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.methylated.sorted.bam', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.methylated.sorted.bam.bai', checkIfExists: true)
                ])
                input[1] = Channel.of([
                    [ id:'genome' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.fai', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.vcf[0][1]).linesGzip.any { it.startsWith('##rastairVersion=') } },
                { assert snapshot(
                    path(process.out.vcf[0][1]).linesGzip.findAll { !it.startsWith('##') }.join('\n').md5(),
                    process.out.tbi.collect { meta, tbi -> file(tbi).name },
                    process.out.bed,
                    process.out.bed_tbi.collect { meta, tbi -> file(tbi).name },
                    process.out.findAll { key, val -> key.startsWith("versions") }
                ).match() }
            )
        }
    }

    test("sarscov2 - single-end bam") {

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:true ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.single_end.sorted.bam', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.single_end.sorted.bam.bai', checkIfExists: true)
                ])
                input[1] = Channel.of([
                    [ id:'genome' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.fai', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.vcf[0][1]).linesGzip.any { it.startsWith('##rastairCommand=') && it.contains('--unpaired') } },
                { assert snapshot(
                    path(process.out.vcf[0][1]).linesGzip.findAll { !it.startsWith('##') }.join('\n').md5(),
                    process.out.tbi.collect { meta, tbi -> file(tbi).name },
                    process.out.bed,
                    process.out.bed_tbi.collect { meta, tbi -> file(tbi).name },
                    process.out.findAll { key, val -> key.startsWith("versions") }
                ).match() }
            )
        }
    }

    test("homo_sapiens - paired-end cram") {

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:false ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/cram/test.paired_end.sorted.cram', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/cram/test.paired_end.sorted.cram.crai', checkIfExists: true)
                ])
                input[1] = Channel.of([
                    [ id:'genome' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta.fai', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.vcf[0][1]).linesGzip.any { !it.startsWith('#') } },
                { assert snapshot(
                    path(process.out.vcf[0][1]).linesGzip.findAll { !it.startsWith('##') }.join('\n').md5(),
                    process.out.tbi.collect { meta, tbi -> file(tbi).name },
                    process.out.bed,
                    process.out.bed_tbi.collect { meta, tbi -> file(tbi).name },
                    process.out.findAll { key, val -> key.startsWith("versions") }
                ).match() }
            )
        }
    }

    test("sarscov2 - paired-end methylated bam - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:false ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.methylated.sorted.bam', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.methylated.sorted.bam.bai', checkIfExists: true)
                ])
                input[1] = Channel.of([
                    [ id:'genome' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.fai', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }

}
