nextflow_process {

    name "Test Process TAXONKIT_LCA"
    script "../main.nf"
    process "TAXONKIT_LCA"

    tag "modules"
    tag "modules_nfcore"
    tag "taxonkit"
    tag "taxonkit/lca"

    test("haemophilus - taxids") {

        def taxdump
        setup {
            // params.modules_testdata_base_path is null outside the process string, so use the same env var and default as tests/config/nf-test.config
            def modules_testdata_base_path = System.getenv('NXF_MODULES_TESTDATA_BASE') ?: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
            taxdump = extract(modules_testdata_base_path + 'genomics/prokaryotes/metagenome/taxonomy/taxdump/taxdump.tar.gz').resolve('taxdump')
        }

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ], // meta map
                    "712 724",
                    []
                ]
                input[1] = file('${taxdump}')
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

    test("haemophilus - file") {

        def taxdump
        setup {
            // params.modules_testdata_base_path is null outside the process string, so use the same env var and default as tests/config/nf-test.config
            def modules_testdata_base_path = System.getenv('NXF_MODULES_TESTDATA_BASE') ?: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
            taxdump = extract(modules_testdata_base_path + 'genomics/prokaryotes/metagenome/taxonomy/taxdump/taxdump.tar.gz').resolve('taxdump')
        }

        when {
            process {
                """
                input[0] = channel.of( [
                    [ id:'test', single_end:false ], // meta map
                    ''
                ] ).combine( channel.of("712 724").collectFile( name:'taxids.txt', newLine: true ) )
                input[1] = file('${taxdump}')
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

    test("no_input_passed-fail_with_error") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ], // meta map
                    [],
                    []
                ]
                input[1] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("Error: Neither taxids nor taxidsfile provided") }
            )
        }

    }

    test("both_inputs_passed-fail_with_error") {

        when {
            process {
                """
                input[0] = channel.of( [
                    [ id:'test', single_end:false ], // meta map
                    "712 724"
                ] ).combine( channel.of("712 724").collectFile( name:'taxids.txt', newLine: true ) )
                input[1] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("Error: Both taxids and taxidsfile provided, and only one should be passed") }
            )
        }

    }

    test("haemophilus - taxids - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ], // meta map
                    "712 724",
                    []
                ]
                input[1] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

}
