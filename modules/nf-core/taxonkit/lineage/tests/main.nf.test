nextflow_process {

    name "Test Process TAXONKIT_LINEAGE"
    script "../main.nf"
    process "TAXONKIT_LINEAGE"

    tag "modules"
    tag "modules_nfcore"
    tag "taxonkit"
    tag "taxonkit/lineage"

    test("sarscov2 - taxonid") {

        def taxdump
        setup {
            taxdump = extract('ftp://ftp.ncbi.nih.gov/pub/taxonomy/taxdump.tar.gz')
        }

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ], // meta map
                    "2697049",
                    []
                ]
                input[1] = file('${taxdump}')
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

    test("sarscov2 - taxid list") {

        def taxdump
        setup {
            taxdump = extract('ftp://ftp.ncbi.nih.gov/pub/taxonomy/taxdump.tar.gz')
        }

        when {
            process {
                """
                input[0] = Channel.of( [
                    [ id:'test', single_end:false ], // meta map
                    ''
                ] ).combine( Channel.of("2697049").collectFile( name:'taxids.txt', newLine: true ) )
                input[1] = file('${taxdump}')
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

    test("sarscov2 - taxid - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ], // meta map
                    "2697049",
                    []
                ]
                input[1] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }


}
