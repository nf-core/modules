nextflow_process {

    name "Test Process TAXONKIT_NAME2TAXID"
    script "../main.nf"
    process "TAXONKIT_NAME2TAXID"

    tag "modules"
    tag "modules_nfcore"
    tag "taxonkit"
    tag "taxonkit/name2taxid"

    test("sarscov2 - name") {

        def taxdump
        setup {
            taxdump = extract('ftp://ftp.ncbi.nih.gov/pub/taxonomy/taxdump.tar.gz')
        }

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ], // meta map
                    "SARS-CoV-2",
                    []
                ]
                input[1] = file('${taxdump}')
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

    test("sarscov2 - list") {

        def taxdump
        setup {
            taxdump = extract('ftp://ftp.ncbi.nih.gov/pub/taxonomy/taxdump.tar.gz')
        }

        when {
            process {
                """
                input[0] = Channel.of( [
                    [ id:'test', single_end:false ], // meta map
                    ''
                ] ).combine( Channel.of("SARS-CoV-2").collectFile( name:'names.txt', newLine: true ) )
                input[1] = file('${taxdump}')
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

    test("sarscov2 - name - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ], // meta map
                    "SARS-CoV-2",
                    []
                ]
                input[1] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

}
