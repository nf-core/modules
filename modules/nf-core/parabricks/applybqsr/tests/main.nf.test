nextflow_process {

    name "Test Process PARABRICKS_APPLYBQSR"
    script "../main.nf"
    process "PARABRICKS_APPLYBQSR"

    tag "modules"
    tag "modules_nfcore"
    tag "parabricks"
    tag "parabricks/applybqsr"
    tag "gpu"

    config './nextflow.config'

    test("sarscov2 | paired-end | [bam]") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test'],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                    []
                ]
                input[1] = [
                    [ id:'bqsr_table'],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/gatk/test.baserecalibrator.table', checkIfExists: true)
                ]
                input[2] = [
                    [], []  // no intervals
                ]
                input[3] = [
                    [ id:'reference'],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                ]
                input[4] = 'bam'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    bam(process.out.bam[0][1]).getReadsMD5(),
                    file(process.out.bai[0][1]).name,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("sarscov2 | paired-end | [bam] | cram out") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test'],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                    []
                ]
                input[1] = [
                    [ id:'bqsr_table'],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/gatk/test.baserecalibrator.table', checkIfExists: true)
                ]
                input[2] = [
                    [], []  // no intervals
                ]
                input[3] = [
                    [ id:'reference'],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                ]
                input[4] = 'cram'
                """
            }
        }

        then {
            def fasta = "https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/modules/data/genomics/sarscov2/genome/genome.fasta"
            assertAll(
                { assert process.success },
                { assert snapshot(
                    cram(process.out.cram[0][1],fasta).getReadsMD5(),
                    file(process.out.crai[0][1]).name,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("sarscov2 | paired-end | [bam] | intervals") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test'],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam.bai', checkIfExists: true)
                ]
                input[1] = [
                    [ id:'bqsr_table'],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/gatk/test.baserecalibrator.table', checkIfExists: true)
                ]
                input[2] = [
                    [ id:'intervals'],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/bed/test.bed', checkIfExists: true)
                ]
                input[3] = [
                    [ id:'reference'],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                   ]
                input[4] = 'bam'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    bam(process.out.bam[0][1]).getReadsMD5(),
                    file(process.out.bai[0][1]).name,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }
    }

