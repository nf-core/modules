process {

    withName: PARABRICKS_MUTECTCALLER {
        ext.args = { params.module_args }
    }

    withName: 'BCFTOOLS_REHEADER' {
        ext.args2 = '--output-type z --write-index=tbi --no-version'
    }

    withName: 'SAMTOOLS_ADDREPLACERG' {
        ext.args = '-m overwrite_all --write-index -O bam'
    }

}
