nextflow_process {

    name "Test Process PARABRICKS_MUTECTCALLER"
    script "../main.nf"
    process "PARABRICKS_MUTECTCALLER"

    tag "modules"
    tag "parabricks/mutectcaller"
    tag "bcftools/reheader"
    tag "samtools/addreplacerg"
    tag "modules_nfcore"
    tag "parabricks"
    tag "gpu"

    config "./nextflow.config"

    test("human - bam") {

        when {
            params {
                module_args = "--tumor-name tumour --mutect-low-memory"
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test2.paired_end.recalibrated.sorted.bam', checkIfExists: true),
                    [], // index only needed if using intervals or tumor-normal calling
                    [],
                    [],
                    []
                ]
                input[1] = [ // fasta + fasta_fai
                    [ id: 'reference' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta.fai', checkIfExists: true)
                    ]
                input[2] = [] // pon
                input[3] = [] // pon index
                """
            }
        }

        then {
            def variants = path(process.out.vcf[0][1]).vcf.variants
            // Calls overlapping PON deletions in the PON test; they must disappear when --pon is used
            def pon_overlapping = [44145050, 44145051, 46156071, 46156077]
            // Gaps between the intervals in the intervals test
            def interval_gaps = [23354001..24132499, 24910999..25689497]
            assertAll(
                { assert process.success },
                { assert variants.count { variant -> variant.start in pon_overlapping } == 4 },
                { assert variants.count { variant -> interval_gaps.any { gap -> variant.start in gap } } == 17 },
                { assert snapshot(sanitizeOutput(process.out, variantsMD5Keys: ["vcf"])).match() }
            )
        }

    }

    test("human - bam - intervals") {

        when {
            params {
                module_args = "--tumor-name tumour --mutect-low-memory"
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test2.paired_end.recalibrated.sorted.bam', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test2.paired_end.recalibrated.sorted.bam.bai', checkIfExists: true),
                    [],
                    [],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/multi_intervals.bed', checkIfExists: true)
                ]
                input[1] = [ // fasta + fasta_fai
                    [ id: 'reference' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta.fai', checkIfExists: true)
                    ]
                input[2] = [] // pon
                input[3] = [] // pon index
                """
            }
        }

        then {
            def variants = path(process.out.vcf[0][1]).vcf.variants
            def interval_gaps = [23354001..24132499, 24910999..25689497]
            assertAll(
                { assert process.success },
                { assert variants.count { variant -> interval_gaps.any { gap -> variant.start in gap } } == 0 },
                { assert snapshot(sanitizeOutput(process.out, variantsMD5Keys: ["vcf"])).match() }
            )
        }

    }

    test("human - bam - tn") {

        setup {
            // Both test BAMs share read group ID and PU, which Parabricks rejects in tumour-normal mode
            run("SAMTOOLS_ADDREPLACERG") {
                script "../../../samtools/addreplacerg/main.nf"
                process {
                    """
                    input[0] = [
                        [ id:'normal' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test.paired_end.recalibrated.sorted.bam', checkIfExists: true),
                        [],
                        "\'@RG\\\\tID:normal01\\\\tPU:normal01\\\\tSM:normal\\\\tLB:normal\\\\tPL:illumina\'"
                    ]
                    input[1] = [[],[],[],[]]
                    """
                }
            }
        }

        when {
            params {
                module_args = "--tumor-name tumour --normal-name normal --mutect-low-memory"
            }
            process {
                """
                input[0] = SAMTOOLS_ADDREPLACERG.out.bam
                    .join(SAMTOOLS_ADDREPLACERG.out.index)
                    .map { meta, bam, index -> [
                        [ id:'test' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test2.paired_end.recalibrated.sorted.bam', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test2.paired_end.recalibrated.sorted.bam.bai', checkIfExists: true),
                        bam,
                        index,
                        []
                    ] }
                input[1] = [ // fasta + fasta_fai
                    [ id: 'reference' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta.fai', checkIfExists: true)
                    ]
                input[2] = [] // pon
                input[3] = [] // pon index
                """
            }
        }

        then {
            def vcf = path(process.out.vcf[0][1]).vcf
            assertAll(
                { assert process.success },
                { assert vcf.header.genotypeSamples.sort() == ['normal', 'tumour'] },
                { assert snapshot(sanitizeOutput(process.out, variantsMD5Keys: ["vcf"])).match() }
            )
        }

    }

    test("human - bam - pon") {

        setup {
            run("BCFTOOLS_REHEADER") {
                script "../../../bcftools/reheader/main.nf"
                process {
                    """
                    input[0] = [
                        [ id:'pon' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/germlineresources/mills_and_1000G.indels.hg38.vcf.gz', checkIfExists: true),
                        [],
                        []
                    ]
                    input[1] = [
                        [ id:'reference' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta.fai', checkIfExists: true)
                    ]
                    """
                }
            }
        }

        when {
            params {
                module_args = "--tumor-name tumour --mutect-low-memory"
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test2.paired_end.recalibrated.sorted.bam', checkIfExists: true),
                    [],
                    [],
                    [],
                    []
                ]
                input[1] = [ // fasta + fasta_fai
                    [ id: 'reference' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta.fai', checkIfExists: true)
                    ]
                input[2] = BCFTOOLS_REHEADER.out.vcf.map { meta, vcf -> vcf }
                input[3] = BCFTOOLS_REHEADER.out.index.map { meta, tbi -> tbi }
                """
            }
        }

        then {
            def vcf = path(process.out.vcf[0][1]).vcf
            def variants = vcf.variants
            def mutect_command = vcf.header.otherHeaderLines.find { line -> line.key == 'GATKCommandLine' && line.value.contains('ID=mutectcaller,') }
            def pon_overlapping = [44145050, 44145051, 46156071, 46156077]
            assertAll(
                { assert process.success },
                { assert mutect_command.value.contains('--pon ') },
                { assert variants.count { variant -> variant.start in pon_overlapping } == 0 },
                // postpon flags calls at PON positions
                { assert variants.find { variant -> variant.start == 45495715 }.hasAttribute('PON') },
                { assert snapshot(sanitizeOutput(process.out, variantsMD5Keys: ["vcf"])).match() }
            )
        }

    }

    test("human - bam - stub") {

        options '-stub'

        when {
            params {
                module_args = "--tumor-name tumour --mutect-low-memory"
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test2.paired_end.recalibrated.sorted.bam', checkIfExists: true),
                    [], // index only needed if using intervals or tumor-normal calling
                    [],
                    [],
                    []
                ]
                input[1] = [ // fasta + fasta_fai
                    [ id: 'reference' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta.fai', checkIfExists: true)
                    ]
                input[2] = [] // pon
                input[3] = [] // pon index
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    sanitizeOutput(process.out),
                    path(process.out.compatible_versions.get(0)).yaml
                    ).match() }
            )
        }

    }

    test("human - bam - intervals - stub") {

        options '-stub'

        when {
            params {
                module_args = "--tumor-name tumour --mutect-low-memory"
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test2.paired_end.recalibrated.sorted.bam', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test2.paired_end.recalibrated.sorted.bam.bai', checkIfExists: true),
                    [],
                    [],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/multi_intervals.bed', checkIfExists: true)
                ]
                input[1] = [ // fasta + fasta_fai
                    [ id: 'reference' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta.fai', checkIfExists: true)
                    ]
                input[2] = [] // pon
                input[3] = [] // pon index
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

    test("human - bam - tn - stub") {

        options '-stub'

        when {
            params {
                module_args = "--tumor-name tumour --normal-name normal --mutect-low-memory"
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test2.paired_end.recalibrated.sorted.bam', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test2.paired_end.recalibrated.sorted.bam.bai', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test.paired_end.recalibrated.sorted.bam', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test.paired_end.recalibrated.sorted.bam.bai', checkIfExists: true),
                    []
                ]
                input[1] = [ // fasta + fasta_fai
                    [ id: 'reference' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta.fai', checkIfExists: true)
                    ]
                input[2] = [] // pon
                input[3] = [] // pon index
