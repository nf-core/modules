nextflow_process {

    name "Test Process VCF2ZARR_EXPLODE"
    script "../main.nf"
    process "VCF2ZARR_EXPLODE"

    tag "modules"
    tag "modules_nfcore"
    tag "vcf2zarr"
    tag "vcf2zarr/explode"

    test("deprecated") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ], file('vcf') ]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("WARNING: This module has been deprecated. Please use nf-core/modules/bio2zarr/vcf2zarrexplode") }
            )
        }
    }
}
