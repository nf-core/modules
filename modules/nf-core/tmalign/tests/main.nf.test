nextflow_process {

    name "Test Process TMALIGN"
    script "../main.nf"
    process "TMALIGN"

    tag "modules"
    tag "modules_nfcore"
    tag "tmalign"

    test("proteomics - pdb - tsv") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'proteomics/pdb/1tim.pdb', checkIfExists: true)
                ]
                input[1] = [
                    [ id:'reference' ],
                    file(params.modules_testdata_base_path + 'proteomics/pdb/8tim.pdb', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }

    test("proteomics - pdb - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'proteomics/pdb/1tim.pdb', checkIfExists: true)
                ]
                input[1] = [
                    [ id:'reference' ],
                    file(params.modules_testdata_base_path + 'proteomics/pdb/8tim.pdb', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }
}
