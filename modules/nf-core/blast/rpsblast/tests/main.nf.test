nextflow_process {

    name "Test Process BLAST_RPSBLAST"
    script "../main.nf"
    process "BLAST_RPSBLAST"

    tag "modules"
    tag "modules_nfcore"
    tag "blast"
    tag "blast/rpsblast"

    // A real search needs the pre-formatted CDD profiles (410 MB for the Pfam
    // subset, 1.7 GB for the full set), which is too heavy for a unit test.
    // The real test below covers the empty-input path (header-only table, tool
    // version resolved inside the container); the stub checks the full
    // channel contract.

    test("empty fasta - header-only table") {

        when {
            process {
                """
                def empty = File.createTempFile('empty', '.faa')
                empty.deleteOnExit()
                input[0] = [ [ id:'test' ], file(empty.absolutePath) ]
                input[1] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.hits.get(0).get(1)).readLines().size() == 1 },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("conserved domain search - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'proteomics/interproscan/l_arginase.faa', checkIfExists: true)
                ]
                input[1] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.hits.get(0).get(1)).readLines().first().startsWith('qseqid\tsseqid') },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
