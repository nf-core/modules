nextflow_process {

    name "Test Process SGDEMUX"
    script "../main.nf"
    process "SGDEMUX"

    tag "modules"
    tag "modules_nfcore"
    tag "sgdemux"

    test("test_sgdemux") {
        def fastq_dir
        setup {
            // sgdemux writes its output into the input dir, named after meta.id
            fastq_dir = extract('https://raw.githubusercontent.com/nf-core/test-datasets/demultiplex/testdata/sim-data/fastq.tar.gz', extractDir: "${launchDir}/sim-data")
        }
        when {
            process {
                """
                input[0] = [
                    [id:'sim-data'],
                    file("https://raw.githubusercontent.com/nf-core/test-datasets/demultiplex/testdata/sim-data/out.sample_meta.csv", checkIfExists:true),
                    file('${fastq_dir}')
                ]
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.sample_fastq[0][1].collect{ file(it).name },
                    process.out.metrics,
                    file(process.out.most_frequent_unmatched[0][1]).name, // Unstable
                    process.out.per_project_metrics,
                    process.out.per_sample_metrics,
                    file(process.out.sample_barcode_hop_metrics[0][1]).name, // Empty file
                    process.out.findAll { key, val -> key.startsWith("versions")}
                ).match() }
            )
        }
    }

    test("test_sgdemux -- stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = channel.of([
                    [id:'sim-data'],
                    file("https://raw.githubusercontent.com/nf-core/test-datasets/demultiplex/testdata/sim-data/out.sample_meta.csv", checkIfExists:true),
                    []
                ])
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
