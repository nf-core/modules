process {
  withName: 'MODKIT_PILEUP' {
    // --modified-bases 5mC 5hmC (matching modkit/pileup's own phased test): if this BAM's
    // basecalling calls both, requesting only one leaves the other counted as "other" in
    // modkit's bedMethyl output, which MODKIT_DMR's internal consistency check rejects.
    ext.args = '--phased --modified-bases 5mC 5hmC'
  }
  withName: 'HTSLIB_BGZIPTABIX' {
    ext.args2 = '-p bed'
  }
  withName: 'MODKIT_DMR' {
    ext.args = params.module_args
  }
}
