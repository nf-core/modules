nextflow_process {

    name "Test Process RPSBLAST"
    script "../main.nf"
    process "RPSBLAST"

    tag "modules"
    tag "modules_local"
    tag "rpsblast"

    // A real run needs the pre-formatted CDD profiles (410 MB for the Pfam
    // subset, 1.7 GB for the full set), which is too heavy for a unit test.
    // The stub checks the channel contract; the database path is exercised by
    // the pipeline-level test profile.

    test("conserved domain search - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("\${projectDir}/assets/testdata/pet_db_test.fasta", checkIfExists: true)
                ]
                input[1] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.hits.get(0).get(1)).readLines().first().startsWith('qseqid\tsseqid') },
                { assert snapshot(process.out.versions).match('versions') }
            )
        }
    }
}
