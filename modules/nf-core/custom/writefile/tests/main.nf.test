nextflow_process {

    name "Test Process CUSTOM_WRITEFILE"
    script "../main.nf"
    process "CUSTOM_WRITEFILE"

    tag "modules"
    tag "modules_nfcore"
    tag "custom"
    tag "custom/writefile"

    test("items - newLine") {

        when {
            process {
                """
                input[0] = record(id: 'versions', meta: record(id: 'test'), extension: 'yml', items: ['b: 2', 'a: 1'], newLine: true)
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }

    test("items - no newLine") {

        when {
            process {
                """
                input[0] = record(id: 'methods_description_mqc', extension: 'yaml', items: ['id: methods', 'section_name: Methods'])
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }

    test("items - output_prefix") {

        when {
            process {
                """
                input[0] = record(id: 'test', output_prefix: 'citations', extension: 'bib', items: ['@article{a}', '@article{b}'], newLine: true)
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }

    test("items - sorted upstream") {

        when {
            process {
                """
                input[0] = channel.of('c: 3', 'a: 1', 'b: 2')
                    .collect(sort: true)
                    .map { lines -> record(id: 'sorted', extension: 'yml', items: lines, newLine: true) }
                """
            }
        }

        then {
            assert process.success
            assert path(process.out[0][0].file).readLines() == ['a: 1', 'b: 2', 'c: 3']
            assert snapshot(process.out).match()
        }
    }

    test("items - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = record(id: 'versions', meta: record(id: 'test'), extension: 'yml', items: ['b: 2', 'a: 1'], newLine: true)
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
