nextflow_process {

    name "Test Process CUSTOM_DUMPSOFTWAREVERSIONS"
    script "../main.nf"
    process "CUSTOM_DUMPSOFTWAREVERSIONS"

    tag "modules"
    tag "modules_nfcore"
    tag "custom"
    tag "custom/dumpsoftwareversions"

    test("deprecated") {

        when {
            process {
                """
                input[0] = file('versions')
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("WARNING: This module has been deprecated.") }
            )
        }
    }
}
