nextflow_process {

    name "Test Process CUSTOM_MTX2H5AD"
    script "../main.nf"
    process "CUSTOM_MTX2H5AD"

    tag "modules"
    tag "modules_nfcore"
    tag "custom"
    tag "custom/mtx2h5ad"
    tag "kallistobustools/count"
    tag "simpleaf/quant"
    tag "simpleaf/index"
    tag "kallistobustools/ref"

    test("kallisto - raw") {

        setup {
            run("KALLISTOBUSTOOLS_REF") {
                script "../../../kallistobustools/ref/main.nf"
                process {
                    """
                    input[0] = [
                        [id: 'genome'],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true)
                    ]
                    input[1] = [
                        [id: 'genome'],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.gtf', checkIfExists: true)
                    ]
                    input[2] = 'standard'
                    """
                }
            }

            run("KALLISTOBUSTOOLS_COUNT") {
                script "../../../kallistobustools/count/main.nf"
                process {
                    """
                    input[0] = Channel.of(
                        [
                            [id:'test'], // meta map
                            [
                            file(params.modules_testdata_base_path + 'genomics/homo_sapiens/10xgenomics/cellranger/10k_pbmc_cmo/fastqs/gex_1/subsampled_SC3_v3_NextGem_DI_CellPlex_Human_PBMC_10K_1_gex_S2_L001_R1_001.fastq.gz', checkIfExists: true),
                            file(params.modules_testdata_base_path + 'genomics/homo_sapiens/10xgenomics/cellranger/10k_pbmc_cmo/fastqs/gex_1/subsampled_SC3_v3_NextGem_DI_CellPlex_Human_PBMC_10K_1_gex_S2_L001_R2_001.fastq.gz', checkIfExists: true)
                            ]
                        ]
                    )
                    input[1] = KALLISTOBUSTOOLS_REF.out.index
                    input[2] = KALLISTOBUSTOOLS_REF.out.t2g
                    input[3] = KALLISTOBUSTOOLS_REF.out.cdna_t2c.ifEmpty { [] }
                    input[4] = KALLISTOBUSTOOLS_REF.out.intron_t2c.ifEmpty { [] }
                    input[5] = "10XV3"
                    input[6] = "standard"
                    """
                }
            }
        }

        when {
            process {
                """
                kallisto_raw = KALLISTOBUSTOOLS_COUNT.out.count.map { meta, kb_dir ->
                    def counts = kb_dir.resolve('counts_unfiltered')
                    [meta, counts, "raw"]
                    }
                input[0] = kallisto_raw
                input[1] = KALLISTOBUSTOOLS_REF.out.t2g
                input[2] = "kallisto"
                input[3] = "standard"
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out,
                    process.out.versions
                ).match() }
            )
        }

    }

    test("simpleaf - raw") {
        setup {
            run("SIMPLEAF_INDEX") {
                script "../../../simpleaf/index/main.nf"
                process {
                    """
                    genome_fasta = file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true)
                    gtf = file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.gtf', checkIfExists: true)

                    input[0] = Channel.of([[ 'id': 'human'], genome_fasta, gtf])
                    input[1] = Channel.of([[],[]])
                    input[2] = Channel.of([[],[]])
                    input[3] = Channel.of([[],[]])
                    """
                }
            }

            run("SIMPLEAF_QUANT") {
                script "../../../simpleaf/quant/main.nf"
                process {
                    """
                    files = [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/10xgenomics/cellranger/5k_cmvpos_tcells/fastqs/gex_1/subsampled_5k_human_antiCMV_T_TBNK_connect_GEX_1_S1_L001_R1_001.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/10xgenomics/cellranger/5k_cmvpos_tcells/fastqs/gex_1/subsampled_5k_human_antiCMV_T_TBNK_connect_GEX_1_S1_L001_R2_001.fastq.gz', checkIfExists: true)
                    ]
                    input[0] = Channel.of([[id:'test_10x', single_end:false, strandedness:'auto'], '10xv3', files])
                    input[1] = SIMPLEAF_INDEX.out.index.combine(SIMPLEAF_INDEX.out.t2g, by: 0)
                    input[2] = [[],"knee",[],[]]
                    input[3] = Channel.of('cr-like')
                    input[4] = Channel.of([[],[]])
                    """
                }
            }
        }

        when {
            process {
                """
                ch_simpleaf = SIMPLEAF_QUANT.out.quant.map { _meta, file ->
                    [[id:'test_10x'], file, "raw"]
                }

                input[0] = ch_simpleaf
                input[1] = []
                input[2] = "simpleaf"
                input[3] = []
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out,
                    process.out.versions
                ).match() }
            )
        }
    }

    test("cellranger - filtered") {
        setup {
            config "./nextflow.config"

            run("CELLRANGER_MKGTF") {
                script "../../../cellranger/mkgtf/main.nf"
                process {
                    """
                    input[0] = [
                        [id: 'homo_sapiens'],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.gtf', checkIfExists: true)
                    ]
                    """
                }
            }
            run("CELLRANGER_MKREF") {
                script "../../../cellranger/mkref/main.nf"
                process {
                    """
                    input[0] = channel.of([
                        [id: 'homo_sapiens'],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true)
                    ])
                    input[1] = CELLRANGER_MKGTF.out.gtf
                    input[2] = 'homo_sapiens_reference'
                    """
                }
            }

            run("CELLRANGER_COUNT") {
                script "../../../cellranger/count/main.nf"
                process {
                    """
                    input[0] =  [
                        [ id:'test_10x', single_end:false, strandedness:'auto'  ], // meta map
                        [
                            file(params.modules_testdata_base_path + 'genomics/homo_sapiens/10xgenomics/cellranger/5k_cmvpos_tcells/fastqs/gex_1/subsampled_5k_human_antiCMV_T_TBNK_connect_GEX_1_S1_L001_R1_001.fastq.gz', checkIfExists: true),
                            file(params.modules_testdata_base_path + 'genomics/homo_sapiens/10xgenomics/cellranger/5k_cmvpos_tcells/fastqs/gex_1/subsampled_5k_human_antiCMV_T_TBNK_connect_GEX_1_S1_L001_R2_001.fastq.gz', checkIfExists: true)
                        ]
                    ]
                    input[1] = CELLRANGER_MKREF.out.reference
                    """
                }
            }
        }

        when {
            process {
                """
                filtered_matrix = CELLRANGER_COUNT.out.outs.map { meta, mtx_files ->
                    def desired_files = []
                    mtx_files.each{ path ->
                        if ( path.toString().contains("filtered_feature_bc_matrix") ) { desired_files.add( path ) }
                    }
                    [ meta, desired_files, "filtered" ]
                }
                input[0] = filtered_matrix
                input[1] = []
                input[2] = "cellranger"
                input[3] = []
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out,
                    process.out.versions
                ).match() }
            )
        }
    }


    test("kallisto - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [[id: 'test'], [], []]
                input[1] = []
                input[2] = "kallisto"
                input[3] = "standard"
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }
    }
}
