nextflow_process {

    name "Test Process CUSTOM_COLLECTFEATURECOUNTS"
    script "../main.nf"
    process "CUSTOM_COLLECTFEATURECOUNTS"

    tag "modules"
    tag "modules_nfcore"
    tag "custom"
    tag "custom/collectfeaturecounts"

    test("two samples") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    [
                        file(params.modules_testdata_base_path + 'generic/tsv/sample1.subread.featureCounts.tsv', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'generic/tsv/sample2.subread.featureCounts.tsv', checkIfExists: true)
                    ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    path(process.out.counts.get(0).get(1)).linesGzip,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }
    }

    test("sample name containing sorted and bam") {

        when {
            process {
                """
                def fc = file("\${workDir}/rawsorted_bam.featureCounts.tsv")
                fc.text = [
                    '# Program:featureCounts',
                    ['Geneid', 'Chr', 'Start', 'End', 'Strand', 'Length', 'rawsorted_bam.sorted.bam'].join('\\t'),
                    ['gene1', 'contig1', '1', '300', '+', '300', '10'].join('\\t')
                ].join('\\n') + '\\n'

                input[0] = [ [ id:'test' ], [ fc ] ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.counts.get(0).get(1)).linesGzip[1].split('\t')[6] == 'rawsorted_bam' }
            )
        }
    }

    test("two samples - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    [
                        file(params.modules_testdata_base_path + 'generic/tsv/sample1.subread.featureCounts.tsv', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'generic/tsv/sample2.subread.featureCounts.tsv', checkIfExists: true)
                    ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
