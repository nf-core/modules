nextflow_process {

    name "Test Process CUSTOM_COLLECTFEATURECOUNTS"
    script "../main.nf"
    process "CUSTOM_COLLECTFEATURECOUNTS"

    tag "modules"
    tag "modules_nfcore"
    tag "custom"
    tag "custom/collectfeaturecounts"

    test("two samples") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    [
                        file(params.modules_testdata_base_path + 'generic/tsv/sample1.subread.featureCounts.tsv', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'generic/tsv/sample2.subread.featureCounts.tsv', checkIfExists: true)
                    ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    path(process.out.counts.get(0).get(1)).linesGzip,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }
    }

    test("sample name containing sorted and bam") {

        when {
            process {
                """
                def fc = file("\${workDir}/rawsorted_bam.featureCounts.tsv")
                fc.text = [
                    '# Program:featureCounts',
                    ['Geneid', 'Chr', 'Start', 'End', 'Strand', 'Length', 'rawsorted_bam.sorted.bam'].join('\\t'),
                    ['gene1', 'contig1', '1', '300', '+', '300', '10'].join('\\t')
                ].join('\\n') + '\\n'

                input[0] = [ [ id:'test' ], [ fc ] ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.counts.get(0).get(1)).linesGzip[1].split('\t')[6] == 'rawsorted_bam' }
            )
        }
    }

    test("first sample without counts") {

        when {
            process {
                """
                def dir = java.nio.file.Files.createTempDirectory('collectfeaturecounts')
                def header = "# Program:featureCounts\\nGeneid\\tChr\\tStart\\tEnd\\tStrand\\tLength\\t"
                def a = dir.resolve('a.featureCounts.tsv')
                def b = dir.resolve('b.featureCounts.tsv')
                a.text = header + "A.sorted.bam\\ng1\\tc\\t1\\t100\\t+\\t100\\t0\\ng2\\tc\\t200\\t399\\t+\\t200\\t0\\n"
                b.text = header + "B.sorted.bam\\ng1\\tc\\t1\\t100\\t+\\t100\\t3\\ng2\\tc\\t200\\t399\\t+\\t200\\t0\\n"
                input[0] = [ [ id:'test' ], [ a, b ] ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.counts.get(0).get(1)).linesGzip == [
                    "orf\tchr\tstart\tend\tstrand\tlength\tsample\tcount\ttpm",
                    "g1\tc\t1\t100\t+\t100\tB\t3\t1000000"
                ] }
            )
        }
    }

    test("two samples - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    [
                        file(params.modules_testdata_base_path + 'generic/tsv/sample1.subread.featureCounts.tsv', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'generic/tsv/sample2.subread.featureCounts.tsv', checkIfExists: true)
                    ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
