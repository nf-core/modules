nextflow_process {

    name "Test Process CUSTOM_GETCHROMSIZES"
    script "../main.nf"
    process "CUSTOM_GETCHROMSIZES"

    tag "modules"
    tag "modules_nfcore"
    tag "custom"
    tag "custom/getchromsizes"

    test("deprecated") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ], file('fasta') ]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("WARNING: This module has been deprecated.") }
            )
        }
    }
}
