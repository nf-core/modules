nextflow_process {

    name "Test Process GATK4_UNMARKDUPLICATES"
    script "../main.nf"
    process "GATK4_UNMARKDUPLICATES"

    tag "modules"
    tag "modules_nfcore"
    tag "gatk4"
    tag "gatk4/unmarkduplicates"

    test("homo sapiens - bam") {
        when {
            process {
                """
                    input[0] = [
                        [ id:'test', single_end:false ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test.paired_end.markduplicates.sorted.bam', checkIfExists: true)
                    ]
                """
            }
        }


        then {
            assert process.success
            assertAll(
                { assert snapshot(

                    bam(process.out.bam[0][1]).getReadsMD5(),
                    process.out.bai,
                    process.out.findAll { key, val -> key.startsWith("versions") }
                ).match() }
            )
        }
    }

    test("homo_sapiens - multiple bam") {
        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ],
                    [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test.paired_end.markduplicates.sorted.bam', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test2.paired_end.markduplicates.sorted.bam', checkIfExists: true)
                    ]
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    bam(process.out.bam[0][1]).getReadsMD5(),
                    process.out.bai,
                    process.out.findAll { key, val -> key.startsWith("versions") }
                ).match() }
            )
        }
    }

    test("homo_sapiens - bam - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test.paired_end.markduplicates.sorted.bam', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }
    }
}
