nextflow_process {

    name "Test Process GATK4_CREATESOMATICPANELOFNORMALS"
    script "../main.nf"
    process "GATK4_CREATESOMATICPANELOFNORMALS"

    tag "modules"
    tag "modules_nfcore"
    tag "gatk4"
    tag "gatk4/createsomaticpanelofnormals"

    test("homo sapiens - genomicsdb") {
        def genomicsdb
        setup {
            // params.modules_testdata_base_path is null outside the process string, so use the same env var and default as tests/config/nf-test.config
            def modules_testdata_base_path = System.getenv('NXF_MODULES_TESTDATA_BASE') ?: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
            genomicsdb = extract(modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gatk/test_genomicsdb.tar.gz').resolve('test_genomicsdb')
        }


        when {
            process {
                """
                input[0] = [ [id:'test'], file('${genomicsdb}') ]
                input[1] = [ [ id:'genome' ], // meta map
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/genome/genome.fasta", checkIfExists: true)
                ]
                input[2] = [ [ id:'genome' ], // meta map
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/genome/genome.fasta.fai", checkIfExists: true)
                ]
                input[3] = [ [ id:'genome' ], // meta map
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/genome/genome.dict", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    file(process.out.vcf[0][1]).name,
                    file(process.out.tbi[0][1]).name,
                    process.out.findAll { key, val -> key.startsWith("versions") }
                ).match() }
            )
        }
    }

    test("homo sapiens - genomicsdb - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ [id:'test'], [] ]
                input[1] = [ [ id:'genome' ], // meta map
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/genome/genome.fasta", checkIfExists: true)
                    ]
                input[2] = [ [ id:'genome' ], // meta map
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/genome/genome.fasta.fai", checkIfExists: true)
                    ]
                input[3] = [ [ id:'genome' ], // meta map
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/genome/genome.dict", checkIfExists: true)
                    ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    file(process.out.vcf[0][1]).name,
                    file(process.out.tbi[0][1]).name,
                    process.out.findAll { key, val -> key.startsWith("versions") }
                ).match() }
            )
        }
    }
}
