// nf-core modules test semibin/concatenatefasta
nextflow_process {

    name "Test Process SEMIBIN_CONCATENATEFASTA"
    script "../main.nf"
    process "SEMIBIN_CONCATENATEFASTA"

    tag "modules"
    tag "modules_nfcore"
    tag "semibin"
    tag "semibin/concatenatefasta"

    test("concatenate_fasta - genomes") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr1/genome.fasta.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'delete_me/metator/assembly.fa.gz', checkIfExists: true)
                    ]
                ]
                input[1] = true
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("concatenate_fasta - genomes - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr1/genome.fasta.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/prokaryotes/escherichia_coli/genome/genome.fa.gz', checkIfExists: true)
                    ]
                ]
                input[1] = true
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
