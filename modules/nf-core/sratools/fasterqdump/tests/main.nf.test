nextflow_process {
    name "Test Process SRATOOLS_FASTERQDUMP"
    script "../main.nf"
    process "SRATOOLS_FASTERQDUMP"
    tag "modules"
    tag "modules_nfcore"
    tag "sratools"
    tag "sratools/fasterqdump"

    test("Single-end") {

        def sra
        setup {
            // params.modules_testdata_base_path is null outside the process string, so use the same env var and default as tests/config/nf-test.config
            def modules_testdata_base_path = System.getenv('NXF_MODULES_TESTDATA_BASE') ?: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
            sra = extract(modules_testdata_base_path + 'genomics/sarscov2/illumina/sra/SRR13255544.tar.gz').resolve('SRR13255544')
        }

        when {
            process {
                """
                input[0] = [ [ id:'test_single_end', single_end:true ], file('${sra}') ]
                input[1] = file(params.modules_testdata_base_path + 'generic/config/ncbi_user_settings.mkfg', checkIfExists: true)
                input[2] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }

    test("Paired-end") {

        def sra
        setup {
            // params.modules_testdata_base_path is null outside the process string, so use the same env var and default as tests/config/nf-test.config
            def modules_testdata_base_path = System.getenv('NXF_MODULES_TESTDATA_BASE') ?: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
            sra = extract(modules_testdata_base_path + 'genomics/sarscov2/illumina/sra/SRR11140744.tar.gz').resolve('SRR11140744')
        }

        when {
            process {
                """
                input[0] = [ [ id:'test_paired_end', single_end:false ], file('${sra}') ]
                input[1] = file(params.modules_testdata_base_path + 'generic/config/ncbi_user_settings.mkfg', checkIfExists: true)
                input[2] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }

    test("Single-end - stub") {

        options '-stub'

        when {
            process {
                """
                input[0] = [
                    [ id:'test_single_end', single_end:true ],
                    []
                ]
                input[1] = []
                input[2] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }

    test("Paired-end - stub") {

        options '-stub'

        when {
            process {
                """
                input[0] = [
                    [ id:'test_paired_end', single_end:false ],
                    []
                ]
                input[1] = []
                input[2] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }
}
