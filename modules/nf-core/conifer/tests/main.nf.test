nextflow_process {

    name "Test Process CONIFER"

    script "../main.nf"
    process "CONIFER"

    tag "modules"
    tag "modules_nfcore"
    tag "conifer"
    tag "kraken2/kraken2"

    test("sarscov2 - kraken2 - k2d") {
        def db
        setup {
            // params.modules_testdata_base_path is null outside the process string, so use the same env var and default as tests/config/nf-test.config
            def modules_testdata_base_path = System.getenv('NXF_MODULES_TESTDATA_BASE') ?: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
            db = extract(modules_testdata_base_path + 'genomics/sarscov2/genome/db/kraken2.tar.gz').resolve('kraken2')
            run("KRAKEN2_KRAKEN2") {
                script "../../kraken2/kraken2/main.nf"
                process {
                    """
                    input[0] = [
                        [ id:'test', single_end:true ], // meta map
                        [ file(
                            params.modules_testdata_base_path + "genomics/sarscov2/illumina/fastq/test_1.fastq.gz",
                            checkIfExists: true
                        )]
                    ]
                    input[1] = file('${db}')
                    input[2] = true
                    input[3] = false
                    """
                }
            }
        }


        when {

            process {
                """
                input[0] = KRAKEN2_KRAKEN2.out.report
                input[1] = file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/db/kraken2/taxo.k2d', checkIfExists:true)
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }


    test("sarscov2 - kraken2 - k2d -- stub") {
        options '-stub'
        when {

            process {
                """
                input[0] = [ [ id:'test', single_end:true ], [] ]
                input[1] = file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/db/kraken2/taxo.k2d', checkIfExists:true)
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }
}
