nextflow_process {

    name "Test Process HOMER_FINDPEAKS"
    script "../main.nf"
    process "HOMER_FINDPEAKS"
    config "./nextflow.config"

    tag "modules"
    tag "modules_nfcore"
    tag "homer"
    tag "homer/findpeaks"
    tag "homer/maketagdirectory"

    test("sarscov2 - tagdir") {
        setup {
            run("HOMER_MAKETAGDIRECTORY") {
                script "../../maketagdirectory/main.nf"
                process {
                    """
                    input[0] = [
                        [ id:'test' ],
                        [
                            file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/bed/test.bed', checkIfExists: true),
                            file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/bed/test2.bed', checkIfExists: true)
                        ]
                    ]
                    input[1] = file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = HOMER_MAKETAGDIRECTORY.out.tagdir
                input[1] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match()}
            )
        }

    }

    test("sarscov2 - tagdir - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'test' ], [] ]
                input[1] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match()}
            )
        }
    }

    test("sarscov2 - tagdir - uniqmap") {
        def uniqmap
        setup {
            run("HOMER_MAKETAGDIRECTORY") {
                script "../../maketagdirectory/main.nf"
                process {
                    """
                    input[0] = [
                        [ id:'test' ],
                        [
                            file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/bed/test.bed', checkIfExists: true),
                            file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/bed/test2.bed', checkIfExists: true)
                        ]
                    ]
                    input[1] = file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                    """
                }
            }
            // HOMER names the peaks file after the uniqmap directory
            uniqmap = extract('https://raw.githubusercontent.com/nf-core/test-datasets/nascent/reference/uniqmap.GRCh38_chr21.50nt.zip', extractDir: "${launchDir}/uniqmap.GRCh38_chr21.50nt")
        }

        when {
            process {
                """
                input[0] = HOMER_MAKETAGDIRECTORY.out.tagdir
                input[1] = file('${uniqmap}')
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
               { assert snapshot(sanitizeOutput(process.out)).match()}
            )
        }
    }
}
