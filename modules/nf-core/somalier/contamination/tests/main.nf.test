nextflow_process {

    name "Test Process SOMALIER_CONTAMINATION"
    script "../main.nf"
    process "SOMALIER_CONTAMINATION"

    tag "modules"
    tag "modules_nfcore"
    tag "somalier"
    tag "somalier/contamination"

    test("homo_sapiens - [ normal.somalier, tumour.somalier ], sites") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    [
                        file(params.modules_testdata_base_path + 'delete_me/somalier/normal.somalier', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'delete_me/somalier/tumour.somalier', checkIfExists: true)
                    ]
                ]
                input[1] = [
                    [ id:'hg38' ],
                    file(params.modules_testdata_base_path + 'delete_me/somalier/sites_chr21.hg38.vcf.gz', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("homo_sapiens - [ normal.somalier, tumour.somalier ], sites - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    [
                        file(params.modules_testdata_base_path + 'delete_me/somalier/normal.somalier', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'delete_me/somalier/tumour.somalier', checkIfExists: true)
                    ]
                ]
                input[1] = [
                    [ id:'hg38' ],
                    file(params.modules_testdata_base_path + 'delete_me/somalier/sites_chr21.hg38.vcf.gz', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
