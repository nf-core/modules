nextflow_process {

    name "Test Process BFF"
    script "../main.nf"
    process "BFF"

    tag "modules"
    tag "modules_nfcore"
    tag "bff"


    test("hto_matrix - combined - preprocessing") {

        def hto_matrix
        setup {
            // params.modules_testdata_base_path is null outside the process string, so use the same env var and default as tests/config/nf-test.config
            def modules_testdata_base_path = System.getenv('NXF_MODULES_TESTDATA_BASE') ?: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
            hto_matrix = extract(modules_testdata_base_path + 'genomics/homo_sapiens/10xgenomics/cellranger/hashing_demultiplexing/hto.tar.gz').resolve('hto')
        }
        when {
            params {
                doTSNE = false
            }
            process {
                """
                input[0] = [ [ id:'test' ], file('${hto_matrix}'), "COMBINED", "TRUE" ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("hto_matrix - combined - preprocessing - test ext.args") {
        config "./nextflow.config"

        def hto_matrix
        setup {
            // params.modules_testdata_base_path is null outside the process string, so use the same env var and default as tests/config/nf-test.config
            def modules_testdata_base_path = System.getenv('NXF_MODULES_TESTDATA_BASE') ?: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
            hto_matrix = extract(modules_testdata_base_path + 'genomics/homo_sapiens/10xgenomics/cellranger/hashing_demultiplexing/hto.tar.gz').resolve('hto')
        }
        when {
            params {
                module_args = "--doHeatmap false"
            }
            process {
                """
                input[0] = [ [ id:'test' ], file('${hto_matrix}'), "COMBINED", "TRUE" ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }


    test("hto_matrix - raw - preprocessing") {
        def hto_matrix
        setup {
            // params.modules_testdata_base_path is null outside the process string, so use the same env var and default as tests/config/nf-test.config
            def modules_testdata_base_path = System.getenv('NXF_MODULES_TESTDATA_BASE') ?: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
            hto_matrix = extract(modules_testdata_base_path + 'genomics/homo_sapiens/10xgenomics/cellranger/hashing_demultiplexing/hto.tar.gz').resolve('hto')
        }
        when {
            process {
                """
                input[0] = [ [ id:'test' ], file('${hto_matrix}'), "RAW", "TRUE" ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }


    test("hto_matrix - combined - no preprocessing") {
        def hto_matrix
        setup {
            // params.modules_testdata_base_path is null outside the process string, so use the same env var and default as tests/config/nf-test.config
            def modules_testdata_base_path = System.getenv('NXF_MODULES_TESTDATA_BASE') ?: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
            hto_matrix = extract(modules_testdata_base_path + 'genomics/homo_sapiens/10xgenomics/cellranger/hashing_demultiplexing/hto.tar.gz').resolve('hto')
        }
        when {
            process {
                """
                input[0] = [ [ id:'test' ], file('${hto_matrix}'), "COMBINED", "FALSE" ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }



    test("hto_matrix - combined - preprocessing - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'test' ], [], "COMBINED", "TRUE" ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

}
