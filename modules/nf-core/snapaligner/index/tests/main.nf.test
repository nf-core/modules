
nextflow_process {

    name "Test Process SNAPALIGNER_INDEX"
    script "../main.nf"
    process "SNAPALIGNER_INDEX"

    tag "modules"
    tag "modules_nfcore"
    tag "snapaligner"
    tag "snapaligner/index"

    test("test-snapaligner-index") {

        when {
            process {
                """
                input[0] = [
                    [id:"test"],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                    [],
                    [],
                    []
				]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                {
                    assert snapshot(sanitizeOutput(process.out).collectEntries { key, val ->
                        if (key == 'index' && val instanceof List && val.size() == 1 && val[0] instanceof List) {
                            [key, [val[0][0], val[0][1].collect { it.toString().contains('OverflowTable') ? 'OverflowTable' : it }]]
                        } else {
                            [key, val]
                        }
                    }).match()
                }
            )
        }
    }

    test("test-snapaligner-index-stub") {
        options '-stub'
        when {
            process {
                """
                input[0] = [
                    [id:"test"],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                    [],
                    [],
                    []
				]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }
}
