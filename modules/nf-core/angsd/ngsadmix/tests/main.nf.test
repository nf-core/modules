nextflow_process {

    name "Test Process ANGSD_NGSADMIX"
    script "../main.nf"
    process "ANGSD_NGSADMIX"

    tag "modules"
    tag "modules_nfcore"
    tag "angsd"
    tag "angsd/ngsadmix"

    test("ngsadmix - beagle - K2") {

        when {
            process {
                """
                input[0] = [
                    [ id: "FIN", samples: ["HG00349", "HG00358", "HG00350", "HG00351"] ],
                    file(params.modules_testdata_base_path + 'delete_me/pcangsd/FIN.beagle.gz', checkIfExists: true),
                    2
                ]
                """
            }
        }

        then {
            assert process.success
            // Converged estimates vary in the final decimal places, so check shape not md5
            def qopt = path(process.out.qopt[0][1]).readLines()
            assertAll(
                { assert snapshot(
                    process.out.qopt.collect { meta, f -> [ meta, file(f).name ] },
                    process.out.fopt.collect { meta, f -> [ meta, file(f).name ] },
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() },
                { assert qopt.size() == 4 },
                { assert qopt.every { row -> row.trim().split(/\s+/).size() == 2 } },
                { assert path(process.out.log[0][1]).text.contains('best like=') }
            )
        }

    }

    test("ngsadmix - beagle - K2 - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id: "FIN", samples: ["HG00349", "HG00358", "HG00350", "HG00351"] ],
                    file(params.modules_testdata_base_path + 'delete_me/pcangsd/FIN.beagle.gz', checkIfExists: true),
                    2
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
