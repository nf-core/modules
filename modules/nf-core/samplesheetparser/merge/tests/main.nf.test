nextflow_process {

    name "Test Process SAMPLESHEETPARSER_MERGE"
    script "../main.nf"
    process "SAMPLESHEETPARSER_MERGE"

    tag "samplesheetparser"
    tag "samplesheetparser/merge"
    tag "modules"
    tag "modules_nfcore"

    test("Merge two V1 sheets into V1") {

        when {
            process {
                """
                input[0] = [
                    [ id: 'test_merge_v1' ],
                    [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bcl/flowcell_samplesheet.v1.csv', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bcl/flowcell_samplesheet_b.v1.csv', checkIfExists: true)
                    ]
                ]
                input[1] = 'v1'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    [
                        samplesheet: process.out.samplesheet,
                        // The JSON report echoes the output path; snapshot it with the
                        // path reduced to a basename so the report is reproducible
                        // regardless of the (volatile) work directory.
                        json: process.out.json.collect { meta, jsonFile ->
                            def text = file(jsonFile).text
                            def report = text ? new groovy.json.JsonSlurper().parseText(text) : text
                            if (report instanceof Map && report.output_path) {
                                report.output_path = file(report.output_path).name
                            }
                            [ meta, report ]
                        },
                        versions: process.out.versions_samplesheetparser
                    ]
                ).match() }
            )
        }
    }

