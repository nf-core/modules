    test("Split V1 sheet by project - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id: 'test_stub' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bcl/flowcell_samplesheet.v1.csv', checkIfExists: true)
                ]
                input[1] = 'project'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    [
                        samplesheets: process.out.samplesheets,
                        // The JSON report echoes the split output file paths; snapshot
                        // them as basenames so the report is reproducible regardless
                        // of the (volatile) work directory.
                        json: process.out.json.collect { meta, jsonFile ->
                            def text = file(jsonFile).text
                            def report = text ? new groovy.json.JsonSlurper().parseText(text) : text
                            if (report instanceof Map && report.files) {
                                report.files = report.files.collectEntries { k, v -> [ k, file(v).name ] }
                            }
                            [ meta, report ]
                        },
                        versions: process.out.versions_samplesheetparser
                    ]
