    test("download nested file - demo1 - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test_dataset' ],
                    "lhoestq/demo1",
                    "data/train.csv"
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert file(process.out.output[0][1]).isFile() },
                { assert snapshot(
                    process.out.output.size(),
