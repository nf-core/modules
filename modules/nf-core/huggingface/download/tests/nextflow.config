params {
    module_args = ''
    module_prefix = ''
}

process {
    withName: 'HUGGINGFACE_DOWNLOAD' {
        ext.args = { params.module_args }
        ext.prefix = { params.module_prefix ?: null }
    }
}

profiles {
    native_arm64 {
        docker.runOptions = '-u $(id -u):$(id -g) --platform=linux/arm64'
        process {
            withName: 'HUGGINGFACE_DOWNLOAD' {
                // Keep the image aligned with containers.docker.linux/arm64 in meta.yml.
                container = 'community.wave.seqera.io/library/huggingface_hub:1.18.0--5f10f5c90bd896e0'
            }
        }
    }
}
