nextflow_process {

    name "Test Process METABINNER_METABINNER"
    script "../main.nf"
    process "METABINNER_METABINNER"
    config "./nextflow.config"

    tag "gunzip"
    tag "modules"
    tag "modules_nfcore"
    tag "metabinner"
    tag "metabinner/metabinner"

    test("MetaBinner") {
        // Decompressed copies of depth, to test the module can take decompressed files
        setup {
            run("GUNZIP") {
                script "../../../gunzip/main.nf"
                process {
                    """
                    input[0] = channel.of(
                        [ [id:'test'], file(params.modules_testdata_base_path + 'genomics/prokaryotes/metagenome/binning/metabinner/depth.txt.gz', checkIfExists: true) ]
                    )
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = GUNZIP.out.gunzip.map { meta, depth ->
                    [
                        meta,
                        file(params.modules_testdata_base_path + 'genomics/prokaryotes/metagenome/binning/contigs.fasta.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/prokaryotes/metagenome/binning/metabinner/kmer_4_f1000.csv.gz', checkIfExists: true),
                        depth
                    ]
                }
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    sanitizeOutput(
                        process.out, unstableKeys: ["log"]
                        )
                  ).match() }
            )
        }
    }

    test("MetaBinner - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/prokaryotes/metagenome/binning/contigs.fasta.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/prokaryotes/metagenome/binning/metabinner/kmer_4_f1000.csv.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/prokaryotes/metagenome/binning/metabinner/depth.txt.gz', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }
}
