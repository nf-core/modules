nextflow_process {

    name "Test Process HAPPY_REPORT"
    script "../main.nf"
    process "HAPPY_REPORT"

    tag "modules"
    tag "modules_nfcore"
    tag "happy"
    tag "happy/report"
    tag "happy/happy"

    setup {
        run("HAPPY_HAPPY") {
            script "../../happy/main.nf"
            process {
                """
                input[0] = [
                        [ id:'test' ], // meta map
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gatk/haplotypecaller_calls/test2_haplotc.vcf.gz', checkIfExists:true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gatk/haplotypecaller_calls/test2_haplotc.ann.vcf.gz', checkIfExists:true),
                        [],
                        []
                        ]
                input[1] = [
                        [ id:'test2' ], // meta map
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta', checkIfExists: true)
                        ]
                input[2] = [
                        [ id:'test3' ], // meta map
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta.fai', checkIfExists: true)
                        ]
                input[3] = [[],[]]
                input[4] = [[],[]]
                input[5] = [[],[]]
                """
            }
        }

        run("HAPPY_HAPPY", alias: "HAPPY_HAPPY_FP") {
            script "../../happy/main.nf"
            process {
                """
                input[0] = [
                        [ id:'test_fp' ], // meta map
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gatk/haplotypecaller_calls/test2_haplotc.vcf.gz', checkIfExists:true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gatk/haplotypecaller_calls/test2_haplotc.ann.vcf.gz', checkIfExists:true),
                        [],
                        []
                        ]
                input[1] = [
                        [ id:'test2' ], // meta map
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta', checkIfExists: true)
                        ]
                input[2] = [
                        [ id:'test3' ], // meta map
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta.fai', checkIfExists: true)
                        ]
                input[3] = [[id: 'false_positives'], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/multi_intervals.bed', checkIfExists:true)]
                input[4] = [[],[]]
                input[5] = [[],[]]
                """
            }
        }
    }

    test("homo_sapiens - single roc csv") {

        when {
            process {
                """
                input[0] = HAPPY_HAPPY.out.roc_all_csv.map { meta, csv -> [ meta, [ method:'gatk4', comparison_method:'vcfeval' ], csv ] }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert file(process.out.html.get(0).get(1)).name == "test.html" },
                { assert snapshot(
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("homo_sapiens - multiple labelled roc csv") {

        when {
            process {
                """
                csv_a = HAPPY_HAPPY.out.roc_all_csv.map { meta, csv -> csv }
                csv_b = HAPPY_HAPPY_FP.out.roc_all_csv.map { meta, csv -> csv }

                input[0] = csv_a.combine(csv_b).map { a, b ->
                    [
                        [ id:'compare' ],
                        [
                            [ method:'gatk4', comparison_method:'vcfeval' ],
                            [ method:'gatk4', comparison_method:'happy' ]
                        ],
                        [a, b]
                    ]
                }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert file(process.out.html.get(0).get(1)).name == "compare.html" },
                { assert snapshot(
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("homo_sapiens - single roc csv - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = HAPPY_HAPPY.out.roc_all_csv.map { meta, csv -> [ meta, [ method:'gatk4', comparison_method:'vcfeval' ], csv ] }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
