process {
    withName: "DEEPVARIANT_MAKEEXAMPLES" {
        ext.args = '--checkpoint "/opt/models/ont_r104" --checkpoint_json "/opt/models/ont_r104/model.example_info.json" --call_small_model_examples --trained_small_model_path "/opt/smallmodels/ont/model.keras"'
    }
    withName: "DEEPVARIANT_CALLVARIANTS" {
        ext.args = '--checkpoint "/opt/models/ont_r104"'
    }
}
