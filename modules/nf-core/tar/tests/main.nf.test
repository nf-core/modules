// nf-core modules test tar
nextflow_process {

    name "Test Process TAR"
    script "../main.nf"
    process "TAR"

    tag "modules"
    tag "modules_nfcore"
    tag "tar"

    test("sarscov2 - genome - db - kraken2 - none") {

        def db
        setup {
            // params.modules_testdata_base_path is null outside the process string, so use the same env var and default as tests/config/nf-test.config
            def modules_testdata_base_path = System.getenv('NXF_MODULES_TESTDATA_BASE') ?: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
            db = extract(modules_testdata_base_path + 'genomics/sarscov2/genome/db/kraken2.tar.gz').resolve('kraken2')
        }

        when {
            process {
                """
                input[0] = [ [ id:'test' ], file('${db}') ]
                input[1] = ''
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    sanitizeOutput(process.out, unstableKeys: ['archive'])
                ).match() }
            )
        }

    }

