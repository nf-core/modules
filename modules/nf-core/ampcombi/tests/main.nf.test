nextflow_process {

    name "Test Process AMPCOMBI"
    script "../main.nf"
    process "AMPCOMBI"

    tag "modules"
    tag "modules_nfcore"
    tag "ampcombi"

    test("deprecated") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ], file('amp_input') ]
                input[1] = file('faa_input')
                input[2] = file('opt_amp_db')
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("WARNING: This module has been deprecated.") }
            )
        }
    }
}
