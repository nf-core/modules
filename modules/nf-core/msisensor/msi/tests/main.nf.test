nextflow_process {

    name "Test Process MSISENSOR_MSI"
    script "../main.nf"
    process "MSISENSOR_MSI"

    tag "modules"
    tag "modules_nfcore"
    tag "msisensor"
    tag "msisensor/msi"

    test("deprecated") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ], file('normal_bam'), file('normal_bai'), file('tumor_bam'), file('tumor_bai'), [], file('homopolymers') ]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("WARNING: This module has been deprecated. Please use nf-core/modules/msisensor2/msi or nf-core/modules/msisensorpro/msisomatic") }
            )
        }
    }
}
