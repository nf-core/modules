nextflow_process {

    name "Test Process MSISENSOR_SCAN"
    script "../main.nf"
    process "MSISENSOR_SCAN"

    tag "modules"
    tag "modules_nfcore"
    tag "msisensor"
    tag "msisensor/scan"

    test("deprecated") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ], file('fasta') ]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("WARNING: This module has been deprecated.") }
            )
        }
    }
}
