process {
    withName: BWAMEM3_INDEX_METH {
        ext.args = '--meth'
    }
    withName: FGUMI_RUNALL {
        ext.args = { [
            "--extract::read-structures ${meta.single_end ? '8M+T' : '8M+T 8M+T'}",
            "--aligner::command \"bwa-mem3 mem --bam=0 ${meta.meth ? '--meth' : ''} ${meta.single_end ? '' : '-p'} -K 150000000 -t {threads} {ref} /dev/stdin\"",
        ].join(' ') }
    }
}
