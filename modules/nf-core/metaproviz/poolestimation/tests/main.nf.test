nextflow_process {

    name "Test Process METAPROVIZ_POOLESTIMATION"
    script "../main.nf"
    process "METAPROVIZ_POOLESTIMATION"
    config "./nextflow.config"

    tag "modules"
    tag "modules_nfcore"
    tag "metaproviz"
    tag "metaproviz/poolestimation"

    test("pool estimation - cellular se rds") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'metabolomics/raw_annotation_data/cellline/intracell/SE.RData', checkIfExists: true),
                    [], [], []
                ]
                input[1] = ''
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.se[0][1]).exists() },
                { assert path(process.out.plots[0][1]).exists() },
                { assert path(process.out.pools[0][1]).readLines().size() == 10 },
                { assert path(process.out.report[0][1]).text.contains("10 pool samples were found by pattern <code>--pool_pattern pool|qc</code>") },
                { assert path(process.out.report[0][1]).text.contains("48 samples, 10 pool samples") },
                { assert path(process.out.report[0][1]).text.contains("182 features, 2 flagged as HighVar") },
                { assert path(process.out.report[0][1]).text.contains("TRUE, total of 180 features kept") },
                { assert path(process.out.log[0][1]).text.contains("Pool detection strategy: pattern 'pool|qc'") },
                { assert !path(process.out.log[0][1]).text.contains("WARN") },
                { assert snapshot(
                    cv_table: process.out.cv_table,
                    versions: process.out.findAll { key, val -> key.startsWith('versions') }
                  ).match() }
            )
        }
    }

    test("pool estimation - cellular csv matrices") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    [],
                    file(params.modules_testdata_base_path + 'metabolomics/raw_annotation_data/cellline/intracell/csv/data_matrix.csv', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'metabolomics/raw_annotation_data/cellline/intracell/csv/feature_matrix.csv', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'metabolomics/raw_annotation_data/cellline/intracell/csv/sample_matrix.csv', checkIfExists: true)
                ]
                input[1] = 'se'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.se[0][1]).exists() },
                { assert path(process.out.pools[0][1]).readLines().size() == 10 },
                { assert snapshot(
                    cv_table: process.out.cv_table,
                    versions: process.out.findAll { key, val -> key.startsWith('versions') }
                  ).match() }
            )
        }
    }

    test("pool estimation - explicit list of pool samples") {

        when {
            params {
                module_args = "--pool_samples POOL0,POOL1,POOL2"
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'metabolomics/raw_annotation_data/cellline/intracell/SE.RData', checkIfExists: true),
                    [], [], []
                ]
                input[1] = ''
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.pools[0][1]).readLines() == ["POOL0", "POOL1", "POOL2"] },
                { assert path(process.out.log[0][1]).text.contains("Pool detection strategy: explicit_list") },
                { assert path(process.out.log[0][1]).text.contains("7 sample(s) match the pool pattern 'pool|qc' as well, but are not part of the given explicit list: POOL3, POOL4, POOL5, POOL6, POOL7, POOL8, POOL9") },
                { assert path(process.out.report[0][1]).text.contains("55 samples, 3 pool samples") },
                { assert snapshot(
                    cv_table: process.out.cv_table,
                    versions: process.out.findAll { key, val -> key.startsWith('versions') }
                  ).match() }
            )
        }
    }

    test("pool estimation - metadata column") {

        when {
            params {
                module_args = "--pool_metadata_col Conditions --pool_metadata_value pool"
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'metabolomics/raw_annotation_data/cellline/intracell/SE.RData', checkIfExists: true),
                    [], [], []
                ]
                input[1] = ''
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.pools[0][1]).readLines().size() == 10 },
                { assert path(process.out.log[0][1]).text.contains("Pool detection strategy: metadata_column") },
                { assert !path(process.out.log[0][1]).text.contains("WARN") },
                { assert path(process.out.report[0][1]).text.contains("48 samples, 10 pool samples") }
            )
        }
    }

    test("pool estimation - list not found falls back to the pattern") {

        when {
            params {
                module_args = "--pool_samples not_a_sample_a,not_a_sample_b"
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'metabolomics/raw_annotation_data/cellline/intracell/SE.RData', checkIfExists: true),
                    [], [], []
                ]
                input[1] = ''
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.pools[0][1]).readLines().size() == 10 },
                { assert path(process.out.log[0][1]).text.contains("Pool sample(s) not found in SE: not_a_sample_a, not_a_sample_b") },
                { assert path(process.out.log[0][1]).text.contains("The pool detection falls back to the pattern 'pool|qc'.") },
                { assert path(process.out.report[0][1]).text.contains("fallback, since no pool samples were found by the explicit list") }
            )
        }
    }

    test("pool estimation - cutoff_cv 5 and filter_high_var FALSE") {

        when {
            params {
                module_args = "--cutoff_cv 5 --filter_high_var FALSE"
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'metabolomics/raw_annotation_data/cellline/intracell/SE.RData', checkIfExists: true),
                    [], [], []
                ]
                input[1] = 'csv'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.filtered_matrices[0][1].find { it.toString().endsWith("data_matrix.csv") }).text.readLines().size() == 183 },
                { assert path(process.out.report[0][1]).text.contains("182 features, 70 flagged as HighVar") },
                { assert path(process.out.report[0][1]).text.contains("FALSE, total of 182 features kept") }
            )
        }
    }

    test("pool estimation - no pool samples found stops the run") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'metabolomics/raw_annotation_data/patient/tissue/SE.RData', checkIfExists: true),
                    [], [], []
                ]
                input[1] = ''
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("No pool samples were found") }
            )
        }
    }

    test("pool estimation - only one pool sample stops the run") {

        when {
            params {
                module_args = "--pool_samples POOL0"
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'metabolomics/raw_annotation_data/cellline/intracell/SE.RData', checkIfExists: true),
                    [], [], []
                ]
                input[1] = ''
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("Only 1 pool sample found (POOL0, found by explicit list)") }
            )
        }
    }

    test("pool estimation - output format csv") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'metabolomics/raw_annotation_data/cellline/intracell/SE.RData', checkIfExists: true),
                    [], [], []
                ]
                input[1] = 'csv'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.se.isEmpty() },
                { assert process.out.filtered_matrices[0][1].size() == 3 },
                { assert path(process.out.filtered_matrices[0][1].find { it.toString().endsWith("data_matrix.csv") }).text.readLines().size() == 181 },
                { assert path(process.out.filtered_matrices[0][1].find { it.toString().endsWith("sample_matrix.csv") }).text.readLines().size() == 49 },
                { assert path(process.out.pools[0][1]).readLines().size() == 10 },
                { assert path(process.out.report[0][1]).text.contains("test.pool_filtered.data_matrix.csv") },
                { assert path(process.out.filtered_matrices[0][1].find { it.toString().endsWith("feature_matrix.csv") }).text.readLines().size() == 181 },
                { assert snapshot(
                    filtered_matrices: process.out.filtered_matrices,
                    cv_table: process.out.cv_table,
                    versions: process.out.findAll { key, val -> key.startsWith('versions') }
                  ).match() }
            )
        }
    }

    test("pool estimation - output format tsv") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'metabolomics/raw_annotation_data/cellline/intracell/SE.RData', checkIfExists: true),
                    [], [], []
                ]
                input[1] = 'tsv'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.se.isEmpty() },
                { assert process.out.filtered_matrices[0][1].every { it.toString().endsWith(".tsv") } },
                { assert snapshot(
                    filtered_matrices: process.out.filtered_matrices,
                    versions: process.out.findAll { key, val -> key.startsWith('versions') }
                  ).match() }
            )
        }
    }

    test("pool estimation - unknown output format fails") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'metabolomics/raw_annotation_data/cellline/intracell/SE.RData', checkIfExists: true),
                    [], [], []
                ]
                input[1] = 'xlsx'
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("output_format must be se, tsv or csv") }
            )
        }
    }

    test("pool estimation - cellular se rds - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'metabolomics/raw_annotation_data/cellline/intracell/SE.RData', checkIfExists: true),
                    [], [], []
                ]
                input[1] = ''
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
