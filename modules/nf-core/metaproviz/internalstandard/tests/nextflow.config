// Lets Nextflow find the "internal_standard.R" script and run it just by
// name (instead of needing its full file path). Required because the
// script lives in this module's resources/usr/bin/ folder, not inline in
// main.nf.
nextflow.enable.moduleBinaries = true

// NOTE on Docker: by default these tests use R on your own machine, not the
// Docker image from ../../Dockerfile. The block below switches that on —
// build the image locally first (tagged exactly as the container line in
// main.nf expects, see ../../Dockerfile), then run:
//   nf-test test main.nf.test --profile docker
// Docker resolves the tag from the local image store before ever trying the
// real ghcr.io registry, so this never pushes anything.
profiles {
    docker {
        docker.enabled = true
    }
}
