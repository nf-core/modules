nextflow_process {

    name "Test Process SEGEMEHL_ALIGN"
    script "../main.nf"
    config "./nextflow.config"

    process "SEGEMEHL_ALIGN"
    tag "modules"
    tag "modules_nfcore"
    tag "segemehl"
    tag "segemehl/align"
    tag "segemehl/index"

    setup {
        run("SEGEMEHL_INDEX") {
            script "../../../segemehl/index/main.nf"
            process {
                """
                input[0] = [
                    [id: "genome"],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true)
                ]
                """
            }
        }
    }

    test("homo_sapiens - single_end") {
        when {
            params {
                module_args = ""
            }
            process {
                """
                input[0] = [
                    [ id:'test', single_end:true ],
                    [ file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/fastq/test_rnaseq_1.fastq.gz', checkIfExists: true) ]
                ]
                input[1] = Channel.of([
                    [id: "genome"],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true)
                ]).join(SEGEMEHL_INDEX.out.index)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.alignment[0][1]).exists() },
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ["alignment"])).match() }
            )
        }
    }

    test("homo_sapiens - paired_end") {
        when {
            params {
                module_args = ""
            }
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ],
                    [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/fastq/test_rnaseq_1.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/fastq/test_rnaseq_2.fastq.gz', checkIfExists: true)
                    ]
                ]
                input[1] = Channel.of([
                    [id: "genome"],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true)
                ]).join(SEGEMEHL_INDEX.out.index)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.alignment[0][1]).exists() },
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ["alignment"])).match() }
            )
        }
    }

    test("homo_sapiens - split - single_end") {
        when {
            params {
                module_args = "-S"
            }
            process {
                """
                input[0] = [
                    [ id:'test', single_end:true ],
                    [ file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/fastq/test_rnaseq_1.fastq.gz', checkIfExists: true) ]
                ]
                input[1] = Channel.of([
                    [id: "genome"],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true)
                ]).join(SEGEMEHL_INDEX.out.index)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.alignment[0][1]).exists() },
                { assert path(process.out.trans_alignments[0][1]).exists() },
                { assert path(process.out.multi_bed[0][1]).exists() },
                { assert path(process.out.single_bed[0][1]).exists() },
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ["alignment", "trans_alignments", "multi_bed", "single_bed"])).match() }
            )
        }
    }

    test("homo_sapiens - split - paired_end") {
        when {
            params {
                module_args = "-S"
            }
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ],
                    [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/fastq/test_rnaseq_1.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/fastq/test_rnaseq_2.fastq.gz', checkIfExists: true)
                    ]
                ]
                input[1] = Channel.of([
                    [id: "genome"],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true)
                ]).join(SEGEMEHL_INDEX.out.index)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.alignment[0][1]).exists() },
                { assert path(process.out.trans_alignments[0][1]).exists() },
                { assert path(process.out.multi_bed[0][1]).exists() },
                { assert path(process.out.single_bed[0][1]).exists() },
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ["alignment", "trans_alignments", "multi_bed", "single_bed"])).match() }
            )
        }
    }

    test("homo_sapiens - split - paired_end -- stub") {
        options "-stub"
        when {
            params {
                module_args = "--bamabafixoida"
            }
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ],
                    [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/fastq/test_rnaseq_1.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/fastq/test_rnaseq_2.fastq.gz', checkIfExists: true)
                    ]
                ]
                input[1] = Channel.of([
                    [id: "genome"],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true)
                ]).join(SEGEMEHL_INDEX.out.index)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }
}
