                ])
                input[1] = [
                    [ id:'test'],
                    file(params.modules_testdata_base_path + '/genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                ]
                input[2] = [
                    [ id: 'test'],
                    file(params.modules_testdata_base_path + '/genomics/sarscov2/genome/genome.fasta.fai', checkIfExists: true),
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.vcf.collect {
                        [file(it[1]).name, path(it[1]).vcf.summary]
                    },
                    process.out.tbi.collect { file(it[1]).name },
                    process.out.phased_vcf.collect {
                        [file(it[1]).name, path(it[1]).vcf.summary]
                    },
                    process.out.phased_tbi.collect { file(it[1]).name },
                    process.out.gvcf.collect {
                        [file(it[1]).name, path(it[1]).vcf.summary]
                    },
                    process.out.gtbi.collect { file(it[1]).name },
                    process.out.findAll { key, val -> key.startsWith('versions') })
                    .match()}
            )
        }

    }

    test("sarscov2 - bam - both") {
        def model
        setup {
            // params.modules_testdata_base_path is null outside the process string, so use the same env var and default as tests/config/nf-test.config
            def modules_testdata_base_path = System.getenv('NXF_MODULES_TESTDATA_BASE') ?: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
