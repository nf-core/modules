nextflow_process {

    name "Test Process HUMANN3_HUMANN"
    script "../main.nf"
    process "HUMANN3_HUMANN"
    tag "modules"
    tag "modules_nfcore"
    tag "humann3"
    tag "humann3/humann"
    tag "metaphlan"
    tag "metaphlan/metaphlan"

    test("humann3 sarscov2 - fastq") {
        def metaphlan_db
        def nucleotide_db
        def protein_db
        def utility_db
        setup {
            // params.modules_testdata_base_path is null outside the process string, so use the same env var and default as tests/config/nf-test.config
            def modules_testdata_base_path = System.getenv('NXF_MODULES_TESTDATA_BASE') ?: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
            metaphlan_db = extract(modules_testdata_base_path + 'delete_me/metaphlan4_database.tar.gz')
            nucleotide_db = extract('https://raw.githubusercontent.com/nf-core/test-datasets/funcprofiler/data/database/humann/v3/chocophlan_nfDEMO.tar.gz')
            protein_db = extract('https://raw.githubusercontent.com/nf-core/test-datasets/funcprofiler/data/database/humann/v3/uniref_nfDEMO.tar.gz')
            utility_db = extract('https://raw.githubusercontent.com/nf-core/test-datasets/funcprofiler/data/database/humann/v3/utility_nfDEMO.tar.gz')
            run("METAPHLAN_METAPHLAN", alias: "MPAHUMANN3") {
                script "../../../../nf-core/metaphlan/metaphlan/main.nf"
                process {
                    """
                    input[0] = channel.of([
                        [ id:'test', single_end:true ], // meta map
                        file( params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz',checkIfExists: true )
                    ])
                    input[1] = [ [ id: 'db' ], file('${metaphlan_db}') ]
                    input[2] = [ [:], [] ]
                    input[3] = false
                        """
                }
            }
        }

        when {
            process {
                """
                input[0]= channel.of([
                    [ id:'test', single_end:false, run_accession:"abc" ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
        ])
              input[1] = MPAHUMANN3.out.profile
              input[2] = file('${nucleotide_db}')
              input[3] = file('${protein_db}')
              input[4] = file('${utility_db}')
                 """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.pathabundance, process.out.pathcoverage, process.out.reactions, process.out.findAll { key, val -> key.startsWith('versions') }).match() }
            )
        }

    }

    test("humann3 sarscov2 - fastq - stub") {

        options "-stub"

        when {
            process {
                """
                input[0]= channel.of([
                    [ id:'test', single_end:false, run_accession:"abc" ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
        ])
              input[1] = [ [ id:'test', single_end:true ], [] ]
              input[2] = []
              input[3] = []
              input[4] = []
                 """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.pathabundance, process.out.pathcoverage, process.out.reactions, process.out.findAll { key, val -> key.startsWith('versions') }).match() }
            )
        }

    }
}
