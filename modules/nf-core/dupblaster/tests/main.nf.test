nextflow_process {

    name "Test Process DUPBLASTER"
    script "../main.nf"
    process "DUPBLASTER"
    config "./nextflow.config"

    tag "modules"
    tag "modules_nfcore"
    tag "dupblaster"

    test("sarscov2 - paired_end bam") {

        when {
            params {
                // The test reads have SRA names, without flowcell, lane and tile
                module_args = '--sequencing-duplicate-detection off'
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.bam', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    sanitizeOutput(process.out, readsMD5Keys:["bam",], unstableKeys:["pdf"])).match()
                }
            )
        }

    }

    test("sarscov2 - paired_end bam - stub") {

        options "-stub"

        when {
            params {
                // The test reads have SRA names, without flowcell, lane and tile
                module_args = '--sequencing-duplicate-detection off'
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.bam', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

}
