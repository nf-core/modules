nextflow_process {

    name "Test Process OPENMS_MAPRTTRANSFORMER"
    script "../main.nf"
    process "OPENMS_MAPRTTRANSFORMER"

    tag "modules"
    tag "modules_nfcore"
    tag "openms"
    tag "openms/maprttransformer"
    tag "openms/mapaligneridentification"

    setup {
        run("OPENMS_MAPALIGNERIDENTIFICATION") {
            script "../../mapaligneridentification/main.nf"
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    [
                        file(params.modules_testdata_base_path + 'proteomics/openms/HepG2_rep1_small.idXML', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'proteomics/openms/HepG2_rep2_small.idXML', checkIfExists: true)
                    ]
                ]
                """
            }
        }
    }

    test("proteomics - idxml - trafoxml") {

        when {
            process {
                """
                // Transform rep1 idXML with its own trafoXML (first -in file -> first trafoXML)
                input[0] = OPENMS_MAPALIGNERIDENTIFICATION.out.trafoxml.map { meta, trafos ->
                    [ meta,
                      file(params.modules_testdata_base_path + 'proteomics/openms/HepG2_rep1_small.idXML', checkIfExists: true),
                      trafos.find { it.name.startsWith('HepG2_rep1_small') } ]
                }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("proteomics - idxml - trafoxml - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = OPENMS_MAPALIGNERIDENTIFICATION.out.trafoxml.map { meta, trafos ->
                    [ meta,
                      file(params.modules_testdata_base_path + 'proteomics/openms/HepG2_rep1_small.idXML', checkIfExists: true),
                      trafos.find { it.name.startsWith('HepG2_rep1_small') } ]
                }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
