singularity {
    pullTimeout = 30.m
}

process {

    withName: 'LEAFCUTTER_DIFFERENTIALSPLICING' {
        ext.args = '--min_samples_per_group 2 --min_samples_per_intron 2'
        containerOptions = { workflow.containerEngine == 'singularity' ?
            '--env USER=nobody,PYTHONHASHSEED=0,CUBLAS_WORKSPACE_CONFIG=:4096:8' :
            '--env USER=nobody --env PYTHONHASHSEED=0 --env CUBLAS_WORKSPACE_CONFIG=:4096:8' }
    }

}
