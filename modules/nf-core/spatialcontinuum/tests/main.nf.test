nextflow_process {

    name "Test Process SPATIALCONTINUUM"
    script "../main.nf"
    process "SPATIALCONTINUUM"

    tag "modules"
    tag "modules_nfcore"
    tag "spatialcontinuum"

    test("clinical - sample - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test_sample' ],
                    'solid',
                    'mutated',
                    'mutated',
                    'dense'
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
