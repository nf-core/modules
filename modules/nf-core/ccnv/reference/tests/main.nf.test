nextflow_process {

    name "Test Process CCNV_REFERENCE"
    script "../main.nf"
    process "CCNV_REFERENCE"

    tag "modules"
    tag "modules_nfcore"
    tag "ccnv"
    tag "ccnv/reference"

    test("synthetic - cohort") {
        when {
            process {
                """
                input[0] = [
                    [ id:'cohort' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/ccnv/samplesheet_germline.yaml', checkIfExists: true),
                    [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/ccnv/samples/ctrl_f01.ccnv', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/ccnv/samples/ctrl_f02.ccnv', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/ccnv/samples/ctrl_f03.ccnv', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/ccnv/samples/ctrl_f04.ccnv', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/ccnv/samples/ctrl_f05.ccnv', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/ccnv/samples/ctrl_f06.ccnv', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/ccnv/samples/ctrl_m01.ccnv', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/ccnv/samples/ctrl_m02.ccnv', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/ccnv/samples/ctrl_m03.ccnv', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/ccnv/samples/ctrl_m04.ccnv', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/ccnv/samples/ctrl_m05.ccnv', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/ccnv/samples/ctrl_m06.ccnv', checkIfExists: true)
                    ],
                    [],
                    []
                ]
                input[1] = [
                    [ id: 'mappability' ],
                    []
                ]
                input[2] = [
                    [ id: 'gc' ],
                    [],
                    []
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

    test("synthetic - fasta") {
        when {
            process {
                """
                input[0] = [
                    [ id:'cohort' ],
                    [],
                    [],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/ccnv/synthetic_ref.fa', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/ccnv/synthetic_ref.fa.fai', checkIfExists: true)
                ]
                input[1] = [
                    [ id: 'mappability' ],
                    []
                ]
                input[2] = [
                    [ id: 'gc' ],
                    [],
                    []
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }


    test("synthetic - fasta - stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = [
                    [ id:'cohort' ],
                    [],
                    [],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/ccnv/synthetic_ref.fa', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/ccnv/synthetic_ref.fa.fai', checkIfExists: true)
                ]
                input[1] = [
                    [ id: 'mappability' ],
                    []
                ]
                input[2] = [
                    [ id: 'gc' ],
                    [],
                    []
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }
}
