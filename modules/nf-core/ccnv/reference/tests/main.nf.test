nextflow_process {

    name "Test Process CCNV_REFERENCE"
    script "../main.nf"
    process "CCNV_REFERENCE"

    tag "modules"
    tag "modules_nfcore"
    tag "ccnv"
    tag "ccnv/reference"

    test("synthetic - cohort") {
        when {
            process {
                """
                input[0] = [
                    [ id:'cohort' ],
                    file('https://raw.githubusercontent.com/matthdsm/ccnv-testdata/refs/heads/main/reference/synthetic_cohort/samplesheet_germline.yaml', checkIfExists: true),
                    [
                        file("https://github.com/matthdsm/ccnv-testdata/raw/refs/heads/main/reference/synthetic_cohort/samples/ctrl_f01.ccnv", checkIfExists: true),
                        file("https://github.com/matthdsm/ccnv-testdata/raw/refs/heads/main/reference/synthetic_cohort/samples/ctrl_f02.ccnv", checkIfExists: true),
                        file("https://github.com/matthdsm/ccnv-testdata/raw/refs/heads/main/reference/synthetic_cohort/samples/ctrl_f03.ccnv", checkIfExists: true),
                        file("https://github.com/matthdsm/ccnv-testdata/raw/refs/heads/main/reference/synthetic_cohort/samples/ctrl_f04.ccnv", checkIfExists: true),
                        file("https://github.com/matthdsm/ccnv-testdata/raw/refs/heads/main/reference/synthetic_cohort/samples/ctrl_f05.ccnv", checkIfExists: true),
                        file("https://github.com/matthdsm/ccnv-testdata/raw/refs/heads/main/reference/synthetic_cohort/samples/ctrl_f06.ccnv", checkIfExists: true),
                        file("https://github.com/matthdsm/ccnv-testdata/raw/refs/heads/main/reference/synthetic_cohort/samples/ctrl_m01.ccnv", checkIfExists: true),
                        file("https://github.com/matthdsm/ccnv-testdata/raw/refs/heads/main/reference/synthetic_cohort/samples/ctrl_m02.ccnv", checkIfExists: true),
                        file("https://github.com/matthdsm/ccnv-testdata/raw/refs/heads/main/reference/synthetic_cohort/samples/ctrl_m03.ccnv", checkIfExists: true),
                        file("https://github.com/matthdsm/ccnv-testdata/raw/refs/heads/main/reference/synthetic_cohort/samples/ctrl_m04.ccnv", checkIfExists: true),
                        file("https://github.com/matthdsm/ccnv-testdata/raw/refs/heads/main/reference/synthetic_cohort/samples/ctrl_m05.ccnv", checkIfExists: true),
                        file("https://github.com/matthdsm/ccnv-testdata/raw/refs/heads/main/reference/synthetic_cohort/samples/ctrl_m06.ccnv", checkIfExists: true)
                    ],
                    [],
                    []
                ]
                input[1] = [
                    [ id: 'mappability' ],
                    []
                ]
                input[2] = [
                    [ id: 'gc' ],
                    [],
                    []
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("synthetic - fasta") {
        when {
            process {
                """
                input[0] = [
                    [ id:'cohort' ],
                    [],
                    [],
                    file('https://raw.githubusercontent.com/matthdsm/ccnv-testdata/refs/heads/main/extract/sample_data/synthetic_ref.fa', checkIfExists: true),
                    file('https://raw.githubusercontent.com/matthdsm/ccnv-testdata/refs/heads/main/extract/sample_data/synthetic_ref.fa.fai', checkIfExists: true)
                ]
                input[1] = [
                    [ id: 'mappability' ],
                    []
                ]
                input[2] = [
                    [ id: 'gc' ],
                    [],
                    []
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }


    test("synthetic - fasta - stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = [
                    [ id:'cohort' ],
                    [],
                    [],
                    file('https://raw.githubusercontent.com/matthdsm/ccnv-testdata/refs/heads/main/extract/sample_data/synthetic_ref.fa', checkIfExists: true),
                    file('https://raw.githubusercontent.com/matthdsm/ccnv-testdata/refs/heads/main/extract/sample_data/synthetic_ref.fa.fai', checkIfExists: true)
                ]
                input[1] = [
                    [ id: 'mappability' ],
                    []
                ]
                input[2] = [
                    [ id: 'gc' ],
                    [],
                    []
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }
}
