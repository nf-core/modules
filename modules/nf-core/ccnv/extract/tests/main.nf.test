nextflow_process {

    name "Test Process CCNV_EXTRACT"
    script "../main.nf"
    process "CCNV_EXTRACT"

    tag "modules"
    tag "modules_nfcore"
    tag "ccnv"
    tag "ccnv/extract"

    test("synthetic - bam") {
        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file('https://github.com/matthdsm/ccnv-testdata/raw/refs/heads/main/extract/sample_data/paired_end.bam', checkIfExists: true),
                    file('https://github.com/matthdsm/ccnv-testdata/raw/refs/heads/main/extract/sample_data/paired_end.bam.bai', checkIfExists: true),
                ]
                input[1] = [
                    [:],
                    [],
                    []
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    sanitizeOutput(process.out, unstableKeys: ["ccnv"]),
                ).match() }
            )
        }

    }

    test("synthetic - cram") {
        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file('https://github.com/matthdsm/ccnv-testdata/raw/refs/heads/main/extract/sample_data/paired_end.cram', checkIfExists: true),
                    file('https://github.com/matthdsm/ccnv-testdata/raw/refs/heads/main/extract/sample_data/paired_end.cram.crai', checkIfExists: true),
                ]
                input[1] = [
                    [ id: 'reference' ],
                    file('https://raw.githubusercontent.com/matthdsm/ccnv-testdata/refs/heads/main/extract/sample_data/synthetic_ref.fa', checkIfExists: true),
                    file('https://raw.githubusercontent.com/matthdsm/ccnv-testdata/refs/heads/main/extract/sample_data/synthetic_ref.fa.fai', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ["ccnv"])).match() }
            )
        }

    }

    test("synthetic - bam - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                    []
                ]
                input[1] = [
                    [:],
                    [],
                    []
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ["ccnv"])).match() }
            )
        }

    }

}
