nextflow_process {

    name "Test Process CCNV_PREDICT"
    script "../main.nf"
    process "CCNV_PREDICT"

    tag "modules"
    tag "modules_nfcore"
    tag "ccnv"
    tag "ccnv/predict"

    test("synthetic - ccnv") {
        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    [],[],
                    file('https://github.com/matthdsm/ccnv-testdata/raw/refs/heads/main/predict/germline/synthetic/euploid_female.ccnv', checkIfExists: true)
                ]
                input[1] = [
                    [ id: 'cohort_ref'],
                    file("https://github.com/matthdsm/ccnv-testdata/raw/refs/heads/main/reference/synthetic_cohort/germline_ref_5kb.ccnv", checkIfExists: true),
                ]
                input[2] = [[:],[],[]]
                input[3] = [[:],[]]
                input[4] = [[:],[],[]]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }
    test("synthetic - bam - stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file('https://github.com/matthdsm/ccnv-testdata/raw/refs/heads/main/extract/sample_data/paired_end.bam', checkIfExists: true),
                    file('https://github.com/matthdsm/ccnv-testdata/raw/refs/heads/main/extract/sample_data/paired_end.bam.bai', checkIfExists: true),
                    []
                ]
                input[1] = [
                    [ id: 'cohort_ref'],
                    file("https://github.com/matthdsm/ccnv-testdata/raw/refs/heads/main/reference/synthetic_cohort/germline_ref_5kb.ccnv", checkIfExists: true),
                ]
                input[2] = [[:],[],[]]
                input[3] = [[:],[]]
                input[4] = [[:],[],[]]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }
}
