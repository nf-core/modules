nextflow_process {

    name "Test Process METAPHLAN_MAKEDB"
    script "../main.nf"
    process "METAPHLAN_MAKEDB"
    config "./nextflow.config"

    tag "modules"
    tag "modules_nfcore"
    tag "metaphlan"
    tag "metaphlan/makedb"

    test("metaphlan - toy index - download") {

        when {
            params {
                module_args = '--index mpa_vJan21_TOY_CHOCOPhlAnSGB_202103'
            }
            process {
                """
                input[0] = [ id: 'metaphlan_db' ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                // the database folder holds a mix of empty and non-empty files, so only its file names are snapshotted
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ["db"])).match() }
            )
        }
    }

    test("metaphlan - default index - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ id: 'metaphlan_db' ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }

    test("metaphlan - default index - long_reads - stub") {

        options "-stub"

        when {
            params {
                module_args = '--long_reads'
            }
            process {
                """
                input[0] = [ id: 'metaphlan_db' ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }
}
