nextflow_process {

    name "Test Process KRONA_KRONADB"
    script "../main.nf"
    process "KRONA_KRONADB"

    tag "modules"
    tag "modules_nfcore"
    tag "krona"
    tag "krona/kronadb"

    test("deprecated") {

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("WARNING: This module has been deprecated. Please use nf-core/modules/krona/ktupdatetaxonomy instead.") }
            )
        }
    }
}
