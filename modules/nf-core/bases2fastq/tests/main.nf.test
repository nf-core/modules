nextflow_process {

    name "Test Process BASES2FASTQ"
    script "../main.nf"
    process "BASES2FASTQ"

    tag "modules"
    tag "modules_nfcore"
    tag "bases2fastq"

    test("sim-data.tar.gz - bcl") {
        def run_dir
        setup {
            // params.modules_testdata_base_path is null outside the process string, so use the same env var and default as tests/config/nf-test.config
            def modules_testdata_base_path = System.getenv('NXF_MODULES_TESTDATA_BASE') ?: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
            run_dir = extract(modules_testdata_base_path + 'genomics/homo_sapiens/element/sim-data/sim-data.tar.gz').resolve('20230404-bases2fastq-sim-151-151-9-9')
        }
        when {
            process {
                """
                input[0] = [
                    [id:'sim-data'],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/element/sim-data/RunManifest.csv', checkIfExists:true),
                    file('${run_dir}')
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.metrics,
                    process.out.generated_run_manifest,
                    process.out.unassigned,
                    process.out.sample_fastq,
                    process.out.findAll { key, val -> key.startsWith("versions")},
                    file(process.out.qc_report[0][1]).name,
                    file(process.out.multiqc_report[0][1]).name,
                    file(process.out.run_stats[0][1]).name,
                    file(process.out.sample_json[0][1]).name,
                ).match()
                }
            )
        }

    }

    test("sim-data.tar.gz - bcl -stub") {
        options "-stub"
        when {
            process {
                """
                input[0]= [
                    [id: "sim-data"],
                    [],
                    []
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.metrics,
                    process.out.generated_run_manifest,
                    process.out.unassigned,
                    process.out.sample_fastq,
                    process.out.findAll { key, val -> key.startsWith("versions")},
                    file(process.out.qc_report[0][1]).name,
                    file(process.out.run_stats[0][1]).name,
                    file(process.out.sample_json[0][1]).name,
                ).match()
                }
            )
        }
    }
}
