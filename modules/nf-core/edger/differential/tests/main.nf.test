nextflow_process {

    name "Test Process EDGER_DIFFERENTIAL"
    script "../main.nf"
    process "EDGER_DIFFERENTIAL"

    tag "modules"
    tag "modules_nfcore"
    tag "edger"
    tag "edger/differential"

    test("mus_musculus - SRP254919 salmon gene counts - contrast variable") {

        config "./nextflow.config"

        when {
            params {
                module_args = '--round_digits 6'
            }
            process {
                """
                input[0] = Channel.of([
                    id: 'treatment_mCherry_hND6',
                    variable: 'treatment',
                    reference: 'hND6',
                    target: 'mCherry'
                ])
                .map { tuple(it, it.variable, it.reference, it.target, it.formula, it.comparison) }

                input[1] = Channel.of([
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/mus_musculus/rnaseq_expression/SRP254919.samplesheet.csv', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/mus_musculus/rnaseq_expression/SRP254919.salmon.merged.gene_counts.top1000cov.tsv', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    sanitizeOutput(process.out, unstableKeys: ["md_plot", "bcv_plot", "rdata", "session_info"]),
                    path(process.out.versions[0]).yaml
                ).match() }
            )
        }
    }

    test("mus_musculus - SRP254919 salmon gene counts - contrast variable - blocking") {

        config "./nextflow.config"

        when {
            params {
                module_args = '--blocking_variables sample_number --round_digits 6'
            }
            process {
                """
                input[0] = Channel.of([
                    id: 'treatment_mCherry_hND6',
                    variable: 'treatment',
                    reference: 'hND6',
                    target: 'mCherry'
                ])
                .map { tuple(it, it.variable, it.reference, it.target, it.formula, it.comparison) }

                input[1] = Channel.of([
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/mus_musculus/rnaseq_expression/SRP254919.samplesheet.csv', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/mus_musculus/rnaseq_expression/SRP254919.salmon.merged.gene_counts.top1000cov.tsv', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    sanitizeOutput(process.out, unstableKeys: ["md_plot", "bcv_plot", "rdata", "session_info"]),
                    path(process.out.versions[0]).yaml
                ).match() }
            )
        }
    }

    test("mus_musculus - SRP254919 salmon gene counts - formula + comparison") {

        config "./nextflow.config"

        when {
            params {
                module_args = '--round_digits 6'
            }
            process {
                """
                input[0] = Channel.of([
                    id: 'treatment_mCherry_hND6',
                    formula: '~ treatment',
                    comparison: 'treatmentmCherry'
                ])
                .map { tuple(it, it.variable, it.reference, it.target, it.formula, it.comparison) }

                input[1] = Channel.of([
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/mus_musculus/rnaseq_expression/SRP254919.samplesheet.csv', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/mus_musculus/rnaseq_expression/SRP254919.salmon.merged.gene_counts.top1000cov.tsv', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    sanitizeOutput(process.out, unstableKeys: ["md_plot", "bcv_plot", "rdata", "session_info"]),
                    path(process.out.versions[0]).yaml
                ).match() }
            )
        }
    }

    test("mus_musculus - SRP254919 salmon gene counts - contrast variable - LRT + filter_by_expr + subset to contrast samples") {

        config "./nextflow.config"

        when {
            params {
                module_args = '--test LRT --filter_by_expr TRUE --subset_to_contrast_samples TRUE --round_digits 6'
            }
            process {
                """
                input[0] = Channel.of([
                    id: 'treatment_mCherry_hND6',
                    variable: 'treatment',
                    reference: 'hND6',
                    target: 'mCherry'
                ])
                .map { tuple(it, it.variable, it.reference, it.target, it.formula, it.comparison) }

                input[1] = Channel.of([
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/mus_musculus/rnaseq_expression/SRP254919.samplesheet.csv', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/mus_musculus/rnaseq_expression/SRP254919.salmon.merged.gene_counts.top1000cov.tsv', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    sanitizeOutput(process.out, unstableKeys: ["md_plot", "bcv_plot", "rdata", "session_info"]),
                    path(process.out.versions[0]).yaml
                ).match() }
            )
        }
    }

    test("variancepartition_dream - formula + comparison - interaction") {

        config "./nextflow.config"

        when {
            params {
                module_args = '--sample_id_col sample --round_digits 6'
            }
            process {
                """
                input[0] = Channel.of([
                    id: 'genotype_WT_treatment_Treated',
                    formula: '~ genotype * treatment',
                    comparison: 'genotypeWT.treatmentTreated'
                ])
                .map { tuple(it, it.variable, it.reference, it.target, it.formula, it.comparison) }

                input[1] = Channel.of([
                    [ id:'test' ],
                    file("https://github.com/nf-core/test-datasets/raw/differentialabundance/modules_testdata/variancepartition_dream/metadata.tsv", checkIfExists: true),
                    file("https://github.com/nf-core/test-datasets/raw/differentialabundance/modules_testdata/variancepartition_dream/counts.tsv", checkIfExists: true)
                ])
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    sanitizeOutput(process.out, unstableKeys: ["md_plot", "bcv_plot", "rdata", "session_info"]),
                    path(process.out.versions[0]).yaml
                ).match() }
            )
        }
    }

    test("mus_musculus - SRP254919 salmon gene counts - contrast variable - stub") {

        config "./nextflow.config"
        options "-stub"


        when {
            process {
                """
                input[0] = Channel.of([
                    id: 'treatment_mCherry_hND6',
                    variable: 'treatment',
                    reference: 'hND6',
                    target: 'mCherry'
                ])
                .map { tuple(it, it.variable, it.reference, it.target, it.formula, it.comparison) }

                input[1] = Channel.of([
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/mus_musculus/rnaseq_expression/SRP254919.samplesheet.csv', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/mus_musculus/rnaseq_expression/SRP254919.salmon.merged.gene_counts.top1000cov.tsv', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    sanitizeOutput(process.out),
                    path(process.out.versions[0]).yaml
                ).match() }
            )
        }
    }

}
