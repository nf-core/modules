nextflow_process {

    name "Test Process EDGER_DIFFSPLICE"
    script "../main.nf"
    process "EDGER_DIFFSPLICE"
    config "./nextflow.config"

    tag "modules"
    tag "modules_nfcore"
    tag "edger"
    tag "edger/diffsplice"
    tag "subread"
    tag "subread/featurecounts"

    test("homo_sapiens - chrX - exon counts - condition - filter_by_expr") {

        when {
            params {
                module_args = '--feature_id_col exon_id --sample_id_col sample --filter_by_expr TRUE --round_digits 4'
            }
            process {
                """
                input[0] = channel.of(['id': 'condition_GBR_YRI', 'variable': 'condition', 'reference': 'GBR', 'target': 'YRI'])
                    .map { tuple(it, it.variable, it.reference, it.target, it.formula, it.comparison) }
                // Merges the per-sample dexseq/count tables into one exon by sample matrix
                input[1] = channel.of(['ERR188383', 'ERR188428', 'ERR188454', 'ERR204916']).map { samples ->
                    def tables = samples.collect { sample ->
                        file(params.modules_testdata_base_path + "delete_me/dexseq/exon/\${sample}.txt", checkIfExists: true)
                            .readLines()
                            .findAll { line -> !line.startsWith('_') }
                            .collect { line -> line.split('\\t') }
                    }
                    def lines = [ (['gene_id', 'exon_id'] + samples).join('\\t') ]
                    tables[0].eachWithIndex { row, i ->
                        lines << ( row[0].split(':') as List + tables.collect { table -> table[i][1] } ).join('\\t')
                    }
                    def matrix = file("\${workDir}/chrX.exon_counts.tsv")
                    matrix.text = lines.join('\\n') + '\\n'
                    [
                        [ id:'chrX' ],
                        file(params.modules_testdata_base_path + 'delete_me/dexseq/exon/chrX.samplesheet.csv', checkIfExists: true),
                        matrix
                    ]
                }
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ["plots", "bcv_plot", "rdata", "lrt", "session_info"])).match() },
                { assert path(process.out.session_info[0][1]).text.contains("edgeR_") }
            )
        }
    }

    test("homo_sapiens - chrX - featurecounts exon counts - condition - annotation columns") {

        setup {
            run("SUBREAD_FEATURECOUNTS") {
                script "../../../subread/featurecounts/main.nf"
                process {
                    """
                    input[0] = [
                        [ id:'chrX', single_end:false ],
                        [
                            file('https://github.com/nf-core/test-datasets/raw/rnasplice/chrX_subset/testdata/ERR188383.Aligned.out.bam', checkIfExists: true),
                            file('https://github.com/nf-core/test-datasets/raw/rnasplice/chrX_subset/testdata/ERR188428.Aligned.out.bam', checkIfExists: true),
                            file('https://github.com/nf-core/test-datasets/raw/rnasplice/chrX_subset/testdata/ERR188454.Aligned.out.bam', checkIfExists: true),
                            file('https://github.com/nf-core/test-datasets/raw/rnasplice/chrX_subset/testdata/ERR204916.Aligned.out.bam', checkIfExists: true)
                        ],
                        file(params.modules_testdata_base_path + 'delete_me/dexseq/exon/chrX.DEXSeq.gff.gz', checkIfExists: true)
                    ]
                    """
                }
            }
        }

        when {
            params {
                module_args = '--gene_id_col Geneid --feature_id_col Start --annotation_cols Chr;End;Strand;Length --count_col_suffix .Aligned.out.bam --sample_id_col sample --round_digits 4'
            }
            process {
                """
                input[0] = channel.of(['id': 'condition_GBR_YRI', 'variable': 'condition', 'reference': 'GBR', 'target': 'YRI'])
                    .map { tuple(it, it.variable, it.reference, it.target, it.formula, it.comparison) }
                input[1] = SUBREAD_FEATURECOUNTS.out.counts.map { _meta, counts ->
                    [
                        [ id:'chrX' ],
                        file(params.modules_testdata_base_path + 'delete_me/dexseq/exon/chrX.samplesheet.csv', checkIfExists: true),
                        counts
                    ]
                }
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ["plots", "bcv_plot", "rdata", "lrt", "session_info"])).match() }
            )
        }
    }

    test("homo_sapiens - chrX - transcript counts - condition - lrt") {

        when {
            params {
                module_args = '--gene_id_col gene_id --feature_id_col tx --sample_id_col sample --test_method lrt --round_digits 4'
            }
            process {
                """
                input[0] = channel.of(['id': 'condition_GBR_YRI', 'variable': 'condition', 'reference': 'GBR', 'target': 'YRI'])
                    .map { tuple(it, it.variable, it.reference, it.target, it.formula, it.comparison) }
                input[1] = channel.of([
                    [ id:'chrX' ],
                    file(params.modules_testdata_base_path + 'delete_me/dexseq/dtu/chrX.samplesheet.csv', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'delete_me/dexseq/dtu/chrX.transcript_counts.tsv', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ["plots", "bcv_plot", "rdata", "lrt", "session_info"])).match() }
            )
        }
    }

    test("homo_sapiens - chrX - transcript counts - formula") {

        when {
            params {
                module_args = '--gene_id_col gene_id --feature_id_col tx --sample_id_col sample --round_digits 4'
            }
            process {
                """
                input[0] = channel.of(['id': 'condition_formula', 'formula': '~ condition', 'comparison': 'conditionYRI'])
                    .map { tuple(it, it.variable, it.reference, it.target, it.formula, it.comparison) }
                input[1] = channel.of([
                    [ id:'chrX' ],
                    file(params.modules_testdata_base_path + 'delete_me/dexseq/dtu/chrX.samplesheet.csv', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'delete_me/dexseq/dtu/chrX.transcript_counts.tsv', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ["plots", "bcv_plot", "rdata", "lrt", "session_info"])).match() }
            )
        }
    }

    test("homo_sapiens - chrX - transcript counts - identical gene and feature columns - fails") {

        when {
            params {
                module_args = '--gene_id_col gene_id --feature_id_col gene_id --sample_id_col sample'
            }
            process {
                """
                input[0] = channel.of(['id': 'condition_GBR_YRI', 'variable': 'condition', 'reference': 'GBR', 'target': 'YRI'])
                    .map { tuple(it, it.variable, it.reference, it.target, it.formula, it.comparison) }
                input[1] = channel.of([
                    [ id:'chrX' ],
                    file(params.modules_testdata_base_path + 'delete_me/dexseq/dtu/chrX.samplesheet.csv', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'delete_me/dexseq/dtu/chrX.transcript_counts.tsv', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("gene_id_col and feature_id_col must be different columns") }
            )
        }
    }

    test("homo_sapiens - chrX - transcript counts - condition - stub") {

        options "-stub"

        when {
            params {
                module_args = ''
            }
            process {
                """
                input[0] = channel.of(['id': 'condition_GBR_YRI', 'variable': 'condition', 'reference': 'GBR', 'target': 'YRI'])
                    .map { tuple(it, it.variable, it.reference, it.target, it.formula, it.comparison) }
                input[1] = channel.of([
                    [ id:'chrX' ],
                    file(params.modules_testdata_base_path + 'delete_me/dexseq/dtu/chrX.samplesheet.csv', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'delete_me/dexseq/dtu/chrX.transcript_counts.tsv', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }
}
