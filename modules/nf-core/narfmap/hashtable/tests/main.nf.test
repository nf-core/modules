nextflow_process {

    name "Test Process NARFMAP_HASHTABLE"
    script "../main.nf"
    process "NARFMAP_HASHTABLE"
    tag "modules"
    tag "modules_nfcore"
    tag "narfmap"
    tag "narfmap/hashtable"

    test("sarscov2 - fasta") {

        when {

            process {
                """
                input[0] = [
                    [id:'test'],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                        sanitizeOutput(process.out, ignoreKeys: ["hashmap"]),
                        process.out.hashmap.collect { meta, hashmap -> [meta, file(hashmap).name] }
                    ).match()
                }
            )
        }

    }

    test("sarscov2 - fasta - stub") {

        options "-stub"
        when {

            process {
                """
                input[0] = [
                    [id:'test'],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                        sanitizeOutput(process.out, ignoreKeys: ["hashmap"]),
                        process.out.hashmap.collect { meta, hashmap -> [meta, file(hashmap).name] }
                    ).match()
                }
            )
        }

    }

    // TODO Add test using alt-masked bed file
    // TODO Fix link https://github.com/edmundmiller/narfmap#build-hash-table-using-an-alt-masked-bed-file

}
