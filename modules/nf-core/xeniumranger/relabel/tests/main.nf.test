nextflow_process {

    name "Test Process XENIUMRANGER_RELABEL"
    script "../main.nf"
    process "XENIUMRANGER_RELABEL"

    tag "modules"
    tag "modules_nfcore"
    tag "xeniumranger"
    tag "xeniumranger/relabel"

    def bundle
    setup {
        bundle = extract('https://raw.githubusercontent.com/nf-core/test-datasets/spatialxe/Xenium_V1_Protein_Human_Kidney_tiny_outs.zip')
    }

    test("xeniumranger relabel") {
        when {
            process {
                """
                input[0] = [
                    [id: "test_xeniumranger_relabel"],
                    file('${bundle}'),
                    file('${bundle}/gene_panel.json')
                ]
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert process.out.outs != null },
                { assert file(process.out.outs.get(0).get(1)).isDirectory() },
                { assert file(process.out.outs.get(0).get(1)).list().size() > 0 },
                { assert snapshot(process.out.versions_xeniumranger).match()},
                )
        }
    }

    test("xeniumranger relabel stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = [
                    [id: "test_xeniumranger_relabel"],
                    file('${bundle}'),
                    file('${bundle}/gene_panel.json')
                ]
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
