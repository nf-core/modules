nextflow_process {

    name "Test Process MCSTAGING_PHENOIMAGER2MC"
    script "../main.nf"
    process "MCSTAGING_PHENOIMAGER2MC"

    tag "modules"
    tag "modules_nfcore"
    tag "mcstaging"
    tag "mcstaging/phenoimager2mc"

    test("deprecated") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ], file('tiles') ]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("WARNING: This module has been deprecated.") }
            )
        }
    }
}
