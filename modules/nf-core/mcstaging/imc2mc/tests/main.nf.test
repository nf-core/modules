nextflow_process {

    name "Test Process MCSTAGING_IMC2MC"
    script "../main.nf"
    process "MCSTAGING_IMC2MC"

    tag "modules"
    tag "modules_nfcore"
    tag "mcstaging"
    tag "mcstaging/imc2mc"

    test("deprecated") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ], file('txtfile') ]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("WARNING: This module has been deprecated. Please use nf-core/modules/imc2mc") }
            )
        }
    }
}
