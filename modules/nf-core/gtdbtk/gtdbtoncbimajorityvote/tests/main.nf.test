nextflow_process {

    name "Test Process GTDBTK_GTDBTONCBIMAJORITYVOTE"
    script "../main.nf"
    process "GTDBTK_GTDBTONCBIMAJORITYVOTE"
    config './nextflow.config'

    tag "modules"
    tag "modules_nfcore"
    tag "gtdbtk"
    tag "gtdbtk/classifywf"
    tag "gtdbtk/gtdbtoncbimajorityvote"

    test("E. coli - genome fasta") {
        def gtdb_db
        setup {
            gtdb_db = extract('https://github.com/nf-core/test-datasets/raw/refs/heads/mag/databases/gtdbtk/gtdbtk_mockup_r232_20260507.tar.gz')

            run("GTDBTK_CLASSIFYWF") {
                script "../../classifywf/main.nf"
                process {
                """
                input[0] = [
                    [ id:'test', single_end:false, assembler:'SPADES' ],
                    [file(params.modules_testdata_base_path + 'genomics/prokaryotes/escherichia_coli/genome/genome.fa', checkIfExists: true)]
                ]
                input[1] = [ [ id:'mockup' ], file('${gtdb_db}') ]
                input[2] = false
                """
                }
            }
        }

        when {
            params {
                module_args_gtdbtk = "--extension fa --place_species"
            }

            process {
                """
                input[0] = GTDBTK_CLASSIFYWF.out.gtdb_outdir.map { meta, outfiles -> [meta, outfiles, meta.id ] }
                input[1] = [[id: "ar53"], file("https://data.gtdb.aau.ecogenomic.org/releases/release232/232.0/ar53_metadata_r232.tsv.gz", checkIfExists: true)]
                input[2] = [[id: "bac120"], file("https://data.gtdb.aau.ecogenomic.org/releases/release232/232.0/bac120_metadata_r232.tsv.gz", checkIfExists: true)]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }

    test("E. coli - genome fasta - stub") {

        options "-stub"

        when {
            params {
                module_args_gtdbtk = "--extension fa --place_species"
            }

            process {
                """
                input[0] = [ [ id:'test', single_end:false, assembler:'SPADES' ], [], 'test' ]
                input[1] = [ [ id:'ar53' ], [] ]
                input[2] = [ [ id:'bac120' ], [] ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }
}
