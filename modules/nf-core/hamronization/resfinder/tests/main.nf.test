nextflow_process {

    name "Test Process HAMRONIZATION_RESFINDER"
    script "../main.nf"
    process "HAMRONIZATION_RESFINDER"

    tag "modules"
    tag "modules_nfcore"
    tag "hamronization"
    tag "hamronization/resfinder"

    // TODO: no hay todavía un data_resfinder.json en nf-core/test-datasets.
    // Opción A: subirlo con un PR a test-datasets (rama "modules") y cambiar esta ruta.
    // Opción B: generarlo en un bloque setup {} con RESFINDER_RUN (ver resfinder/run/tests).
    test("hamronization/resfinder - json - tsv") {

        when {
            process {
                """
                input[0] = [
                    [ id:"test" ],
                    file(params.modules_testdata_base_path + 'genomics/prokaryotes/bacteroides_fragilis/hamronization/data_resfinder.json', checkIfExists: true)
                ]
                input[1] = 'tsv'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }

    test("hamronization/resfinder - json - tsv - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:"test" ],
                    file(params.modules_testdata_base_path + 'genomics/prokaryotes/bacteroides_fragilis/hamronization/data_resfinder.json', checkIfExists: true)
                ]
                input[1] = 'tsv'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }
}
