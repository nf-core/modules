nextflow_process {

    name "Test Process FOLDMASON_MSA2LDDTREPORT"
    script "../main.nf"
    process "FOLDMASON_MSA2LDDTREPORT"

    tag "modules"
    tag "modules_nfcore"
    tag "foldmason"
    tag "foldmason/msa2lddtreport"
    tag "foldmason/createdb"
    tag "famsa/guidetree"


    test("seatoxin") {

        def structures
        setup {
            structures = extract('https://raw.githubusercontent.com/nf-core/test-datasets/multiplesequencealign/testdata/af2_structures/seatoxin-ref.tar.gz').resolve('seatoxin-ref')

            run("FAMSA_GUIDETREE") {
                script "../../../../../modules/nf-core/famsa/guidetree/main.nf"
                process {
                    """
                    input[0] = [
                        [ id:'test_tree' ], // meta map
                        file(params.modules_testdata_base_path + "../../multiplesequencealign/testdata/setoxin-ref.fa", checkIfExists: true)
                    ]
                    """
                }
            }

            run("FOLDMASON_CREATEDB") {
                script "../../../../../modules/nf-core/foldmason/createdb/main.nf"
                process {
                    """
                    input[0] = [ [ id:'test' ], file('${structures}').listFiles().collect() ]
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] =[ [ id:'test' ], // meta map
                            file(params.modules_testdata_base_path + "../../multiplesequencealign/testdata/setoxin.ref", checkIfExists: true)
                            ]
                input[1] = FOLDMASON_CREATEDB.out.db.collect{ meta, db -> db }.map{ db -> [[ id: 'test'], db]}
                input[2] = [ [ id:'test' ], file('${structures}').listFiles().collect() ]
                input[3] = FAMSA_GUIDETREE.out.tree.collect{ meta, tree -> tree }.map{ tree -> [[ id: 'test_tree'], tree]}
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert file(process.out.html.get(0).get(1)).exists() },
                { assert snapshot(process.out.findAll { key, val -> key.startsWith('versions') }).match() }
            )
        }

    }

    test("seatoxin - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] =[ [ id:'test_tree' ], // meta map
                            file(params.modules_testdata_base_path + "../../multiplesequencealign/testdata/setoxin.ref", checkIfExists: true)
                            ]
                input[1] = [ [ id:'test' ], [] ]
                input[2] = [ [ id:'test' ], [] ]
                input[3] = [ [ id:'test_tree' ], [] ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert file(process.out.html.get(0).get(1)).exists() },
                { assert snapshot(process.out.findAll { key, val -> key.startsWith('versions') }).match() }
            )
        }

    }

}
