nextflow_process {

    name "Test Process FOLDMASON_CREATEDB"
    script "../main.nf"
    process "FOLDMASON_CREATEDB"

    tag "modules"
    tag "modules_nfcore"
    tag "foldmason"
    tag "foldmason/createdb"

    test("seatoxin") {

        def structures
        setup {
            structures = extract('https://raw.githubusercontent.com/nf-core/test-datasets/multiplesequencealign/testdata/af2_structures/seatoxin-ref.tar.gz').resolve('seatoxin-ref')
        }

        when {

            process {
                """
                    input[0] = [ [ id:'test' ], file('${structures}').listFiles().collect() ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success  },
                { assert snapshot(process.out).match() }
                )
        }

    }

    test("seatoxin - stub ") {

        options "-stub"

        when {

            process {
                """
                    input[0] = [ [ id:'test' ], [ file('dummy.pdb', checkIfExists: false) ] ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success  },
                { assert snapshot(sanitizeOutput(process.out)).match() }
                )
        }

    }

}
