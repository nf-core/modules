nextflow_process {

    name "Test Process FOLDMASON_EASYMSA"
    script "../main.nf"
    process "FOLDMASON_EASYMSA"

    tag "modules"
    tag "modules_nfcore"
    tag "foldmason"
    tag "foldmason/easymsa"
    tag "famsa"
    tag "famsa/guidetree"

    test("Test on seatoxin dataset - uncompressed") {

        def structures
        setup {
            structures = extract('https://raw.githubusercontent.com/nf-core/test-datasets/multiplesequencealign/testdata/af2_structures/seatoxin-ref.tar.gz').resolve('seatoxin-ref')
        }

        when {
            params {
            }
            process {
                """
                    input[0] = [ [ id:'test' ], file('${structures}').listFiles().collect() ]
                    input[1] = [[:],[]]
                    input[2] = false
                """
            }
        }

        then {
            assertAll(
                { assert process.success  },
                { assert snapshot(process.out).match() }
                )
        }
    }

    test("Test on seatoxin dataset - compressed") {

        def structures
        setup {
            structures = extract('https://raw.githubusercontent.com/nf-core/test-datasets/multiplesequencealign/testdata/af2_structures/seatoxin-ref.tar.gz').resolve('seatoxin-ref')
        }

        when {
            params {
            }
            process {
                """
                    input[0] = [ [ id:'test' ], file('${structures}').listFiles().collect() ]
                    input[1] = [[:],[]]
                    input[2] = true
                """
            }
        }

        then {
            assertAll(
                { assert process.success  },
                { assert snapshot(process.out).match() }
                )
        }
    }

    test("Test on seatoxin dataset - guide_tree") {

        def structures
        setup {
            structures = extract('https://raw.githubusercontent.com/nf-core/test-datasets/multiplesequencealign/testdata/af2_structures/seatoxin-ref.tar.gz').resolve('seatoxin-ref')

            run("FAMSA_GUIDETREE") {
                script "../../../../../modules/nf-core/famsa/guidetree/main.nf"
                process {
                    """
                    input[0] = [ [ id:'test_tree' ], // meta map
                                file(params.modules_testdata_base_path + "../../multiplesequencealign/testdata/setoxin-ref.fa", checkIfExists: true)
                                ]
                    """
                }
            }
        }

        when {
            params {
            }
            process {
                """
                    input[0] = [ [ id:'test' ], file('${structures}').listFiles().collect() ]
                    input[1] = FAMSA_GUIDETREE.out.tree.collect{ meta, tree -> tree }.map{ tree -> [[ id: 'test_tree'], tree]}
                    input[2] = false
                """
            }
        }

        then {
            assertAll(
                { assert process.success  },
                { assert snapshot(process.out).match() }
                )
        }
    }

    test("Stub run") {
        options "-stub"

        when {
            params {
            }
            process {
                """
                    input[0] = [ [ id:'test' ], [ file('dummy.pdb', checkIfExists: false) ] ]
                    input[1] = [[:],[]]
                    input[2] = false
                """
            }
        }

        then {
            assertAll(
                { assert process.success  },
                { assert snapshot(process.out).match() }
                )
        }
    }

}
