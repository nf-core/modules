nextflow_process {

    name "Test Process SAMTOOLS_GETRG"
    script "../main.nf"
    process "SAMTOOLS_GETRG"

    tag "modules"
    tag "modules_nfcore"
    tag "samtools"
    tag "samtools/getrg"

    test("deprecated") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ], file('input') ]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("WARNING: This module has been deprecated.") }
            )
        }
    }
}
