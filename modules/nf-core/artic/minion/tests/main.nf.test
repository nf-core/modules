nextflow_process {

    name "Test Process ARTIC_MINION"

    script "../main.nf"
    process "ARTIC_MINION"

    tag "modules"
    tag "modules_nfcore"
    tag "untar"
    tag "artic"
    tag "artic/minion"

    test("sarscov2 - fastq") {
        when {
            process {
                """
                input[0] = [
                    [id:'test',single_end:false],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/nanopore/fastq/test_2.fastq.gz', checkIfExists:true)
                ]
                input[1] = [[id: 'model'], [], "r941_prom_hac_g360+g422"]
                input[2] = [
                    [id: "SARS-CoV-2", version: "4.0.0"],
                    file('https://github.com/artic-network/primer-schemes/raw/master/nCoV-2019/V4/SARS-CoV-2.reference.fasta', checkIfExists:true),
                    file('https://github.com/artic-network/primer-schemes/raw/master/nCoV-2019/V4/SARS-CoV-2.primer.bed', checkIfExists:true)
                ]
                input[3] = []
                """
            }
        }
        then {
            def fileNames = process.out.results.collect { result ->
                def files = result[1]
                files.collect { filePath ->
                    def f = file(filePath)
                    f.directory ? f.listFiles().name : f.name
                }
            }
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.findAll { key, val -> key.startsWith('versions') },
                    fileNames,
                    process.out.bam.collect{ file(it[1]).name },
                    process.out.bai,
                    process.out.bam_primertrimmed.collect{ file(it[1]).name },
                    process.out.bai_primertrimmed,
                    process.out.fasta,
                    process.out.vcf.collect{ file(it[1]).name },
                    process.out.tbi,
                    process.out.json
                ).match() }
            )
        }
    }
    test("sarscov2 - fastq - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [id:'test',single_end:false],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/nanopore/fastq/test_2.fastq.gz', checkIfExists:true)
                ]
                input[1] = [[id: 'model'], [], "r941_prom_hac_g360+g422"]
                input[2] = [
                    [id: "SARS-CoV-2", version: "4.0.0"],
                    file('https://github.com/artic-network/primer-schemes/raw/master/nCoV-2019/V4/SARS-CoV-2.reference.fasta', checkIfExists:true),
                    file('https://github.com/artic-network/primer-schemes/raw/master/nCoV-2019/V4/SARS-CoV-2.primer.bed', checkIfExists:true)
                ]
                input[3] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }
}
