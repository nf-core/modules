nextflow_process {

    name "Test Process BIGSCAPE_BIGSCAPE"
    script "../main.nf"
    process "BIGSCAPE_BIGSCAPE"

    tag "modules"
    tag "modules_nfcore"
    tag "bigscape"
    tag "bigscape/bigscape"

    test("streptomyces_coelicolor - bigscape - cluster") {
        def gbk_dir
        setup {
            // params.modules_testdata_base_path is null outside the process string, so use the same env var and default as tests/config/nf-test.config
            def modules_testdata_base_path = System.getenv('NXF_MODULES_TESTDATA_BASE') ?: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
            gbk_dir = extract(modules_testdata_base_path + 'genomics/prokaryotes/streptomyces_coelicolor/fixtures_bigslice_gbk.tar.gz')
        }

        when {
            process {
                """
                input[0] = [ [ id:'test_gbk' ], file('${gbk_dir}') ]
                input[1] = file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/Pfam-A.hmm.gz', checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            def resultDir = file(process.out.output[0][1])
            assertAll(
                { assert resultDir.isDirectory() },
                { assert snapshot(
                    process.out.findAll { key, val -> key.startsWith("versions") }
                ).match() }
            )
        }

    }

    test("streptomyces_coelicolor - bigscape - cluster - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'test_gbk' ], [] ]
                input[1] = []
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

}
