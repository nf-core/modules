nextflow_process {
    name "Test Process CHECKM_QA"
    script "../main.nf"
    process "CHECKM_QA"

    tag "modules"
    tag "modules_nfcore"
    tag "checkm"
    tag "checkm/qa"
    tag "checkm/lineagewf"

    test("checkm - qa") {
        def checkm_db
        setup {
            checkm_db = extract('https://data.ace.uq.edu.au/public/CheckM_databases/checkm_data_2015_01_16.tar.gz')

            run("CHECKM_LINEAGEWF") {
                script "../../lineagewf/main.nf"
                process {
                    """
                    input[0] = [
                        [ id:'test', single_end:false ], // meta map
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fasta/contigs.fasta', checkIfExists: true)
                    ]
                    input[1] = 'fasta'
                    input[2] = file('${checkm_db}')
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = CHECKM_LINEAGEWF.out.checkm_output.join(CHECKM_LINEAGEWF.out.marker_file)
                                .map { v -> v + [[]] }
                input[1] = []
                input[2] = file('${checkm_db}')
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'test', single_end:false ], [], [], [] ]
                input[1] = []
                input[2] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
