nextflow_process {

    name "Test Process PRETEXTGRAPH"
    script "../main.nf"
    process "PRETEXTGRAPH"
    config "./nextflow.config"

    tag "modules"
    tag "modules_nfcore"
    tag "pretextgraph"
    tag "pretextmap"
    tag "bedtools/genomecov"

    setup {
        run("PRETEXTMAP") {
            script "../../pretextmap/main.nf"
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true)
                ]
                input[1] = [
                    [ id:'genome' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta.fai', checkIfExists: true)
                ]
                """
            }
        }
        run("BEDTOOLS_GENOMECOV") {
            script "../../bedtools/genomecov/main.nf"
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                    1
                ]
                input[1] = []
                input[2] = 'bedgraph'
                input[3] = true
                """
            }
        }
    }

    test("homo_sapiens - pretext - bedgraph - coverage") {

        when {
            process {
                """
                input[0] = PRETEXTMAP.out.pretext
                    .join(BEDTOOLS_GENOMECOV.out.genomecov)
                    .map { meta, pretext, bedgraph -> [ meta, pretext, bedgraph, 'coverage' ] }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("homo_sapiens - pretext - bedgraph - coverage - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = PRETEXTMAP.out.pretext
                    .join(BEDTOOLS_GENOMECOV.out.genomecov)
                    .map { meta, pretext, bedgraph -> [ meta, pretext, bedgraph, 'coverage' ] }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
