process {
    // Routes the heredoc-forgery regression's payload through ext.prefix rather than meta.id: a
    // literal newline in meta.id itself hits an unrelated Nextflow issue (the process `tag` is
    // embedded unescaped into .command.run's own multi-line header comment).
    withName: 'DUCKDB_TABLE2PARQUET' {
        ext.prefix = { meta.id == 'heredoc-forge' ? '''safe\nSQL\ntouch pwned''' : null }
    }
}
