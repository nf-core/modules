nextflow_process {

    name "Test Process BWAMEM2_INDEX"
    tag "modules_nfcore"
    tag "modules"
    tag "bwamem2"
    tag "bwamem2/index"
    script "../main.nf"
    process "BWAMEM2_INDEX"

    test("fasta") {

        when {
            process {
                """
                input[0] = [
                    [id: 'test'],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                ]
                input[1] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out) + [index_dir: process.out.index.collect { file(it[1]).name }]).match() }
            )
        }
    }
    test("fasta.gz") {

        when {
            process {
                """
                input[0] = [
                    [id: 'test'],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.gz', checkIfExists: true)
                ]
                input[1] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out) + [index_dir: process.out.index.collect { file(it[1]).name }]).match() }
            )
        }
    }

    test("fasta - input_dir") {

        when {
            process {
                """
                input[0] = [
                    [id: 'test'],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                ]
                input[1] = 'sarscov2'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out) + [index_dir: process.out.index.collect { file(it[1]).name }]).match() }
            )
        }
    }

    test("fasta - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [id: 'test'],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                ]
                input[1] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out) + [index_dir: process.out.index.collect { file(it[1]).name }]).match() }
            )
        }
    }
    test("fasta.gz - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [id: 'test'],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.gz', checkIfExists: true)
                ]
                input[1] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out) + [index_dir: process.out.index.collect { file(it[1]).name }]).match() }
            )
        }
    }
}
