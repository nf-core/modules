nextflow_process {

    name "Test Process BWAMEM3_MEM"
    script "../main.nf"
    process "BWAMEM3_MEM"
    config "./nextflow.config"

    tag "modules"
    tag "modules_nfcore"
    tag "bwamem3"
    tag "bwamem3/mem"
    tag "bwamem3/index"

    setup {
        run("BWAMEM3_INDEX") {
            script "../../index/main.nf"
            process {
                """
                input[0] = Channel.of([
                    [:], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                ])
                """
            }
        }
        run("BWAMEM3_INDEX", alias: "BWAMEM3_INDEX_METH") {
            script "../../index/main.nf"
            process {
                """
                input[0] = Channel.of([
                    [:], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                ])
                """
            }
        }
    }

    test("sarscov2 - fastq, index, fasta, false") {

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:true ], // meta map
                    [file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true)]
                ])
                input[1] = BWAMEM3_INDEX.out.index
                input[2] = Channel.of([[:], file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)])
                input[3] = false
                input[4] = ''
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out, readsMD5Keys: ["aligned"])).match() }
            )
        }
    }

    test("sarscov2 - fastq, index, fasta, true") {

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:true ], // meta map
                    [file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true)]
                ])
                input[1] = BWAMEM3_INDEX.out.index
                input[2] = Channel.of([[:], file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)])
                input[3] = true
                input[4] = ''
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out, readsMD5Keys: ["aligned"])).match() }
            )
        }
    }

    test("sarscov2 - [fastq1, fastq2], index, fasta, false") {

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:false ], // meta map
                    [
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                    ]
                ])
                input[1] = BWAMEM3_INDEX.out.index
                input[2] = Channel.of([[:], file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)])
                input[3] = false
                input[4] = ''
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out, readsMD5Keys: ["aligned"])).match() }
            )
        }
    }

    test("sarscov2 - [fastq1, fastq2], index, fasta, true") {

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:false ], // meta map
                    [
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                    ]
                ])
                input[1] = BWAMEM3_INDEX.out.index
                input[2] = Channel.of([[:], file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)])
                input[3] = true
                input[4] = ''
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out, readsMD5Keys: ["aligned"])).match() }
            )
        }
    }

    test("sarscov2 - [fastq1, fastq2], meth index, fasta, true") {

        when {
            params {
                module_args = ''
            }
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:false ], // meta map
                    [
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                    ]
                ])
                input[1] = BWAMEM3_INDEX_METH.out.index
                input[2] = Channel.of([[:], file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)])
                input[3] = true
                input[4] = ''
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out, readsMD5Keys: ["aligned"])).match() }
            )
        }
    }

    test("sarscov2 - fastq, meth index, fasta, true - taps") {

        when {
            params {
                module_args = '--meth=taps'
            }
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:true ], // meta map
                    [file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true)]
                ])
                input[1] = BWAMEM3_INDEX_METH.out.index
                input[2] = Channel.of([[:], file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)])
                input[3] = true
                input[4] = ''
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert bam(process.out.aligned[0][1]).getHeader().any { it.startsWith('@PG') && it.contains('--meth=taps') } },
                { assert bam(process.out.aligned[0][1]).getSamLines().with { lines -> !lines.isEmpty() && lines.every { it.contains('\tXM:Z:') } } },
                { assert snapshot(sanitizeOutput(process.out, readsMD5Keys: ["aligned"])).match() }
            )
        }
    }

    test("sarscov2 - [fastq1, fastq2], meth index, fasta, true - taps") {

        when {
            params {
                module_args = '--meth=taps'
            }
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:false ], // meta map
                    [
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                    ]
                ])
                input[1] = BWAMEM3_INDEX_METH.out.index
                input[2] = Channel.of([[:], file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)])
                input[3] = true
                input[4] = ''
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert bam(process.out.aligned[0][1]).getHeader().any { it.startsWith('@PG') && it.contains('--meth=taps') } },
                { assert bam(process.out.aligned[0][1]).getSamLines().with { lines -> !lines.isEmpty() && lines.every { it.contains('\tXM:Z:') } } },
                { assert snapshot(sanitizeOutput(process.out, readsMD5Keys: ["aligned"])).match() }
            )
        }
    }

    test("sarscov2 - [fastq1, fastq2], index, fasta, true, bai") {

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:false ], // meta map
                    [
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                    ]
                ])
                input[1] = BWAMEM3_INDEX.out.index
                input[2] = Channel.of([[:], file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)])
                input[3] = true
                input[4] = 'bai'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert new File(process.out.index[0][1]).name == 'test.bam.bai' },
                { assert new File(process.out.index[0][1]).bytes[0..3] == ('BAI\u0001'.bytes as List) },
                { assert snapshot(sanitizeOutput(process.out, readsMD5Keys: ["aligned"])).match() }
            )
        }
    }

    test("sarscov2 - [fastq1, fastq2], index, fasta, true, csi") {

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:false ], // meta map
                    [
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                    ]
                ])
                input[1] = BWAMEM3_INDEX.out.index
                input[2] = Channel.of([[:], file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)])
                input[3] = true
                input[4] = 'csi'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert new File(process.out.index[0][1]).name == 'test.bam.csi' },
                { assert snapshot(sanitizeOutput(process.out, readsMD5Keys: ["aligned"])).match() }
            )
        }
    }

    test("sarscov2 - [fastq1, fastq2], index, fasta, false, bai - unsorted fails") {

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:false ], // meta map
                    [
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                    ]
                ])
                input[1] = BWAMEM3_INDEX.out.index
                input[2] = Channel.of([[:], file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)])
                input[3] = false
                input[4] = 'bai'
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains('index_format requires sort_bam = true') }
            )
        }
    }

    test("sarscov2 - [fastq1, fastq2], index, fasta, true, bai - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:false ], // meta map
                    [
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                    ]
                ])
                input[1] = BWAMEM3_INDEX.out.index
                input[2] = Channel.of([[:], file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)])
                input[3] = true
                input[4] = 'bai'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }

    test("sarscov2 - [fastq1, fastq2], index, fasta, true - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:false ], // meta map
                    [
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                    ]
                ])
                input[1] = BWAMEM3_INDEX.out.index
                input[2] = Channel.of([[:], file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)])
                input[3] = true
                input[4] = ''
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }

}
