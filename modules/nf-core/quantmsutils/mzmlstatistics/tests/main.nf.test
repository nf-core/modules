nextflow_process {

    name "Test Process QUANTMSUTILS_MZMLSTATISTICS"
    script "../main.nf"
    process "QUANTMSUTILS_MZMLSTATISTICS"

    tag "modules"
    tag "modules_nfcore"
    tag "quantmsutils"
    tag "quantmsutils/mzmlstatistics"

    test("proteomics - mzML statistics") {
        def mzml_dir
        setup {
            // params.modules_testdata_base_path is null outside the process string, so use the same env var and default as tests/config/nf-test.config
            def modules_testdata_base_path = System.getenv('NXF_MODULES_TESTDATA_BASE') ?: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
            mzml_dir = extract(modules_testdata_base_path + 'proteomics/diann/RD139_Narrow_UPS1_0_1fmol_inj1.mzML.tar.gz')
        }

        when {
            process {
                """
                input[0] = [[id:'test_sample'], file('${mzml_dir}/RD139_Narrow_UPS1_0_1fmol_inj1.mzML')]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ["log", "ms_statistics"])).match() }
            )
        }
    }

    test("proteomics - mzML statistics - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [[id:'test_sample'], file('RD139_Narrow_UPS1_0_1fmol_inj1.mzML')]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }
}
