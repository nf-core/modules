nextflow_process {

    name "Test Process VEPYR_ANNOTATE"
    script "../main.nf"
    process "VEPYR_ANNOTATE"

    tag "modules"
    tag "modules_nfcore"
    tag "vepyr"
    tag "vepyr/annotate"

    // raw.githubusercontent.com serves blobs, not directory trees, so the cache
    // is published as an archive and extracted here; resolve('cache') drops its
    // single top-level directory, leaving the entity directories at the cache root.
    test("homo_sapiens - vcf") {
        def cache
        setup {
            // params.modules_testdata_base_path is null outside the process string, so use the same env var and default as tests/config/nf-test.config
            def modules_testdata_base_path = System.getenv('NXF_MODULES_TESTDATA_BASE') ?: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
            cache = extract(modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/cache.tar.gz').resolve('cache')
        }

        when {
            process {
                """
                input[0] = channel.of([
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/input.vcf.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/input.vcf.gz.tbi', checkIfExists: true)
                ])
                input[1] = [ [ id:'116_GRCh38_ensembl' ], file('${cache}') ]
                input[2] = channel.value([
                    [ id:'GRCh38' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/reference.fa.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/reference.fa.gz.fai', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/reference.fa.gz.gzi', checkIfExists: true)
                ])
                input[3] = 116
                input[4] = [[], []]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out, variantsMD5Keys: ["vcf"], unstableKeys: ["tbi"])).match() }
            )
        }
    }

    test("homo_sapiens - vcf - no index") {
        def cache
        setup {
            // params.modules_testdata_base_path is null outside the process string, so use the same env var and default as tests/config/nf-test.config
            def modules_testdata_base_path = System.getenv('NXF_MODULES_TESTDATA_BASE') ?: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
            cache = extract(modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/cache.tar.gz').resolve('cache')
        }

        when {
            process {
                """
                input[0] = channel.of([
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/input.vcf.gz', checkIfExists: true),
                    []
                ])
                input[1] = [ [ id:'116_GRCh38_ensembl' ], file('${cache}') ]
                input[2] = channel.value([
                    [ id:'GRCh38' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/reference.fa.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/reference.fa.gz.fai', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/reference.fa.gz.gzi', checkIfExists: true)
                ])
                input[3] = 116
                input[4] = [[], []]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out, variantsMD5Keys: ["vcf"], unstableKeys: ["tbi"])).match() }
            )
        }
    }

    test("homo_sapiens - vcf - stub") {
        options "-stub"

        when {
            process {
                """
                input[0] = channel.of([
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/input.vcf.gz', checkIfExists: true),
                    []
                ])
                input[1] = channel.value([[ id:'cache' ], []])
                input[2] = channel.value([[ id:'GRCh38' ], [], [], []])
                input[3] = []
                input[4] = [[], []]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }

    test("homo_sapiens - vcf - no fasta - fails") {

        when {
            process {
                """
                input[0] = channel.of([
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/input.vcf.gz', checkIfExists: true),
                    []
                ])
                input[1] = channel.value([[ id:'cache' ], []])
                input[2] = channel.value([[ id:'GRCh38' ], [], [], []])
                input[3] = []
                input[4] = [[], []]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("VEPYR_ANNOTATE requires a reference FASTA") }
            )
        }
    }
}
