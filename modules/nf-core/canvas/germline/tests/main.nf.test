nextflow_process {

    name "Test Process CANVAS_GERMLINE"
    script "../main.nf"
    process "CANVAS_GERMLINE"
    config "./nextflow.config"

    tag "modules"
    tag "modules_nfcore"
    tag "canvas/germline"
    tag "canvas"

    setup {
        run("BCFTOOLS_REHEADER") {
            script "../../../bcftools/reheader/main.nf"
            process {
                """
                input[0] = [
                    [ id : 'testN' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/vcf/NA12878_GIAB.chr22.vcf.gz', checkIfExists: true),
                    [],
                    []
                ]
                input[1] = [ [], [] ]
                """
            }
        }
    }

    test("homo_sapiens - [ [bam,bai], vcf, [], fasta, xml, bed ]") {
        when {
            process {
                """
                input[0] = [
                    [ id:'testN' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test.paired_end.sorted.bam.bai', checkIfExists: true)
                ]
                input[1] = BCFTOOLS_REHEADER.out.vcf
                input[2] = [ [], [] ]
                input[3] = [
                    [ id: 'GRCh38' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true)
                ]
                input[4] = [
                    [ id: 'GRCh38' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/GenomeSize.xml', checkIfExists: true)
                ]
                input[5] = channel.of("chr22\t0\t1").collectFile(name: 'test_filter.bed', newLine:true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

