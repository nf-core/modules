nextflow_process {

    name "Test Process BUSCO_GENERATEPLOT"
    script "../main.nf"
    process "BUSCO_GENERATEPLOT"

    tag "modules"
    tag "modules_nfcore"
    tag "busco"
    tag "busco/generateplot"

    test("deprecated") {

        when {
            process {
                """
                input[0] = file('short_summary_txt')
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("WARNING: This module has been deprecated.") }
            )
        }
    }
}
