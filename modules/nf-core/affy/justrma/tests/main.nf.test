nextflow_process {

    name "Test Process AFFY_JUSTRMA"
    script "../main.nf"
    process "AFFY_JUSTRMA"

    tag "modules"
    tag "modules_nfcore"
    tag "affy"
    tag "affy/justrma"

    test("homo_sapiens genome affy_array [celfiles]") {
        def celfiles
        setup {
            // params.modules_testdata_base_path is null outside the process string, so use the same env var and default as tests/config/nf-test.config
            def modules_testdata_base_path = System.getenv('NXF_MODULES_TESTDATA_BASE') ?: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
            celfiles = extract(modules_testdata_base_path + 'genomics/homo_sapiens/array_expression/GSE38751_RAW.tar')
        }

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/array_expression/GSE38751.csv', checkIfExists: true),
                    file('${celfiles}')
                ]
                input[1] = [[],[]]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.expression,
                    file(process.out.rds.get(0).get(1)).name,
                    process.out.findAll { key, val -> key.startsWith('versions') },
                    path(process.out.versions_affy[0]).yaml
                ).match()}
            )
        }

    }

    test("homo_sapiens genome affy_array [celfiles] - annotation") {
        config "./nextflow.config"

        def celfiles
        setup {
            // params.modules_testdata_base_path is null outside the process string, so use the same env var and default as tests/config/nf-test.config
            def modules_testdata_base_path = System.getenv('NXF_MODULES_TESTDATA_BASE') ?: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
            celfiles = extract(modules_testdata_base_path + 'genomics/homo_sapiens/array_expression/GSE38751_RAW.tar')
        }

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/array_expression/GSE38751.csv', checkIfExists: true),
                    file('${celfiles}')
                ]
                input[1] = [[],[]]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.expression,
                    process.out.annotation,
                    file(process.out.rds.get(0).get(1)).name,
                    process.out.findAll { key, val -> key.startsWith('versions') },
                    path(process.out.versions_affy[0]).yaml
                ).match() }
            )
        }

    }

    test("homo_sapiens genome affy_array [celfiles] - stub") {

        options "-stub"
        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/array_expression/GSE38751.csv', checkIfExists: true),
                    []
                ]
                input[1] = [[],[]]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }
}
