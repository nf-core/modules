nextflow_process {

    name "Test Process DEXSEQ_COUNT"
    script "../main.nf"
    process "DEXSEQ_COUNT"
    config "./nextflow.config"

    tag "modules"
    tag "modules_nfcore"
    tag "dexseq"
    tag "dexseq/count"
    tag "dexseq/prepareannotation"

    setup {
        run("DEXSEQ_PREPAREANNOTATION") {
            script "../../prepareannotation/main.nf"
            process {
                """
                input[0] = [
                    [ id:'genome' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.gtf', checkIfExists: true)
                ]
                input[1] = 0
                """
            }
        }
    }

    test("homo_sapiens - paired_end - bam") {

        when {
            params {
                module_args = '--stranded no'
            }
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test.rna.paired_end.sorted.bam', checkIfExists: true)
                ]
                input[1] = DEXSEQ_PREPAREANNOTATION.out.gff
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.counts[0][1]).readLines().contains('ENSG00000239435:001\t71') },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

    test("homo_sapiens - paired_end - bam - reverse stranded") {

        when {
            params {
                module_args = '--stranded reverse --minaqual 10'
            }
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test.rna.paired_end.sorted.bam', checkIfExists: true)
                ]
                input[1] = DEXSEQ_PREPAREANNOTATION.out.gff
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

    test("homo_sapiens - single_end - bam") {

        when {
            params {
                module_args = '--stranded no'
            }
            process {
                """
                input[0] = [
                    [ id:'test', single_end:true ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test.rna.paired_end.sorted.bam', checkIfExists: true)
                ]
                input[1] = DEXSEQ_PREPAREANNOTATION.out.gff
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.counts[0][1]).readLines().contains('ENSG00000239435:001\t132') },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

    test("homo_sapiens - paired_end - bam - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test.rna.paired_end.sorted.bam', checkIfExists: true)
                ]
                input[1] = DEXSEQ_PREPAREANNOTATION.out.gff
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

}
