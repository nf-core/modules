nextflow_process {

    name "Test Process DEXSEQ_DTU"
    script "../main.nf"
    process "DEXSEQ_DTU"
    config "./nextflow.config"

    tag "modules"
    tag "modules_nfcore"
    tag "dexseq"
    tag "dexseq/dtu"

    test("homo_sapiens - chrX - GBR vs YRI") {

        when {
            process {
                """
                input[0] = [ [ id:'GBR_vs_YRI' ], 'condition', 'YRI', 'GBR' ]
                input[1] = [
                    [ id:'study' ],
                    file(params.modules_testdata_base_path + 'delete_me/dexseq/dtu/chrX.samplesheet.csv', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'delete_me/dexseq/dtu/chrX.transcript_counts.tsv', checkIfExists: true)
                ]
                """
            }
        }

        then {
            // The fitted values differ in the last digits between the OpenBLAS kernels selected for each CPU
            def rounded = { f -> path(f).readLines().collect { l -> l.split('\t', -1).collect { v -> v.isNumber() ? String.format(Locale.ROOT, '%.6f', v as double) : v }.join('\t') }.join('\n').md5() }
            assertAll(
                { assert process.success },
                { assert path(process.out.results[0][1]).readLines()[0].split('\t').contains('log2fold_GBR_YRI') },
                { assert path(process.out.gene_qvalues[0][1]).readLines().tail().count { l -> l.split('\t')[1] != 'NA' && (l.split('\t')[1] as double) < 0.05 } == 23 },
                { assert snapshot(
                    sanitizeOutput(process.out, unstableKeys: ["results", "gene_qvalues", "dataset_rds", "results_rds", "gene_qvalues_rds", "session_info"]),
                    rounded(process.out.results[0][1]),
                    rounded(process.out.gene_qvalues[0][1])
                ).match() }
            )
        }

    }

    test("homo_sapiens - chrX - GBR vs YRI - blocking") {

        when {
            process {
                """
                input[0] = [ [ id:'GBR_vs_YRI', blocking:'batch' ], 'condition', 'YRI', 'GBR' ]
                input[1] = channel.of(
                    'sample,condition,batch',
                    'ERR188383,GBR,1',
                    'ERR188428,GBR,2',
                    'ERR188454,YRI,1',
                    'ERR204916,YRI,2'
                )
                    .collectFile(name: 'samplesheet.csv', newLine: true, sort: false)
                    .map { samplesheet ->
                        [
                            [ id:'study' ],
                            samplesheet,
                            file(params.modules_testdata_base_path + 'delete_me/dexseq/dtu/chrX.transcript_counts.tsv', checkIfExists: true)
                        ]
                    }
                """
            }
        }

        then {
            // The fitted values differ in the last digits between the OpenBLAS kernels selected for each CPU
            def rounded = { f -> path(f).readLines().collect { l -> l.split('\t', -1).collect { v -> v.isNumber() ? String.format(Locale.ROOT, '%.6f', v as double) : v }.join('\t') }.join('\n').md5() }
            def command_err = path(process.out.results[0][1]).parent.resolve('.command.err').text
            assertAll(
                { assert process.success },
                { assert path(process.out.results[0][1]).readLines()[0].split('\t').contains('log2fold_GBR_YRI') },
                { assert command_err.contains("Full model: ~sample + exon + batch:exon + condition:exon") },
                { assert snapshot(
                    sanitizeOutput(process.out, unstableKeys: ["results", "gene_qvalues", "dataset_rds", "results_rds", "gene_qvalues_rds", "session_info"]),
                    rounded(process.out.results[0][1]),
                    rounded(process.out.gene_qvalues[0][1])
                ).match() }
            )
        }

    }

    test("homo_sapiens - chrX - GBR vs YRI - blocking one level and confounded") {

        when {
            process {
                """
                input[0] = [ [ id:'GBR_vs_YRI', blocking:'lane;batch' ], 'condition', 'YRI', 'GBR' ]
                input[1] = channel.of(
                    'sample,condition,lane,batch',
                    'ERR188383,GBR,1,A',
                    'ERR188428,GBR,1,A',
                    'ERR188454,YRI,1,B',
                    'ERR204916,YRI,1,B'
                )
                    .collectFile(name: 'samplesheet.csv', newLine: true, sort: false)
                    .map { samplesheet ->
                        [
                            [ id:'study' ],
                            samplesheet,
                            file(params.modules_testdata_base_path + 'delete_me/dexseq/dtu/chrX.transcript_counts.tsv', checkIfExists: true)
                        ]
                    }
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert (process.stdout + process.stderr).join('\n').contains("Blocking variable 'lane' has one level in this contrast") },
                { assert (process.stdout + process.stderr).join('\n').contains("Blocking variables batch are confounded with 'condition'") }
            )
        }

    }

    test("homo_sapiens - chrX - GBR vs YRI - blocking missing column") {

        when {
            process {
                """
                input[0] = [ [ id:'GBR_vs_YRI', blocking:'donor' ], 'condition', 'YRI', 'GBR' ]
                input[1] = channel.of(
                    'sample,condition,batch',
                    'ERR188383,GBR,1',
                    'ERR188428,GBR,2',
                    'ERR188454,YRI,1',
                    'ERR204916,YRI,2'
                )
                    .collectFile(name: 'samplesheet.csv', newLine: true, sort: false)
                    .map { samplesheet ->
                        [
                            [ id:'study' ],
                            samplesheet,
                            file(params.modules_testdata_base_path + 'delete_me/dexseq/dtu/chrX.transcript_counts.tsv', checkIfExists: true)
                        ]
                    }
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert (process.stdout + process.stderr).join('\n').contains("Column 'donor' is not in the sample sheet") }
            )
        }

    }

    test("homo_sapiens - chrX - GBR vs YRI - blocking no residual degrees of freedom") {

        when {
            process {
                """
                input[0] = [ [ id:'GBR_vs_YRI', blocking:'donor' ], 'condition', 'YRI', 'GBR' ]
                input[1] = channel.of(
                    'sample,condition,donor',
                    'ERR188383,GBR,A',
                    'ERR188428,GBR,B',
                    'ERR188454,YRI,A',
                    'ERR204916,YRI,C'
                )
                    .collectFile(name: 'samplesheet.csv', newLine: true, sort: false)
                    .map { samplesheet ->
                        [
                            [ id:'study' ],
                            samplesheet,
                            file(params.modules_testdata_base_path + 'delete_me/dexseq/dtu/chrX.transcript_counts.tsv', checkIfExists: true)
                        ]
                    }
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert (process.stdout + process.stderr).join('\n').contains("Blocking variables donor leave no residual degrees of freedom in this contrast") }
            )
        }

    }

    test("homo_sapiens - chrX - GBR vs YRI - blocking varies within a sample") {

        when {
            process {
                """
                input[0] = [ [ id:'GBR_vs_YRI', blocking:'batch' ], 'condition', 'YRI', 'GBR' ]
                input[1] = channel.of(
                    'sample,condition,batch',
                    'ERR188383,GBR,1',
                    'ERR188383,GBR,2',
                    'ERR188428,GBR,2',
                    'ERR188454,YRI,1',
                    'ERR204916,YRI,2'
                )
                    .collectFile(name: 'samplesheet.csv', newLine: true, sort: false)
                    .map { samplesheet ->
                        [
                            [ id:'study' ],
                            samplesheet,
                            file(params.modules_testdata_base_path + 'delete_me/dexseq/dtu/chrX.transcript_counts.tsv', checkIfExists: true)
                        ]
                    }
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert (process.stdout + process.stderr).join('\n').contains("Blocking variables with different values in rows of the same sample: batch") }
            )
        }

    }

    test("homo_sapiens - chrX - GBR vs YRI - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'GBR_vs_YRI' ], 'condition', 'YRI', 'GBR' ]
                input[1] = [
                    [ id:'study' ],
                    file(params.modules_testdata_base_path + 'delete_me/dexseq/dtu/chrX.samplesheet.csv', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'delete_me/dexseq/dtu/chrX.transcript_counts.tsv', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

}
