    test("homo_sapiens - chrX - GBR vs YRI - blocking varies within a sample") {

        when {
            params {
                module_args = '--n_plot 0'
            }
            process {
                """
                input[0] = [ [ id:'GBR_vs_YRI', blocking:'batch' ], 'condition', 'YRI', 'GBR' ]
                input[1] = channel.of(
                    'sample,condition,batch',
                    'ERR188383,GBR,1',
                    'ERR188383,GBR,2',
                    'ERR188428,GBR,2',
                    'ERR188454,YRI,1',
                    'ERR204916,YRI,2'
                )
                    .collectFile(name: 'samplesheet.csv', newLine: true, sort: false)
                    .map { samplesheet ->
                        [
                            [ id:'study' ],
                            samplesheet,
                            ['ERR188383', 'ERR188428', 'ERR188454', 'ERR204916'].collect { id ->
                                file(params.modules_testdata_base_path + "delete_me/dexseq/exon/\${id}.txt", checkIfExists: true)
                            }
                        ]
                    }
                input[2] = [
                    [ id:'chrX' ],
                    file(params.modules_testdata_base_path + 'delete_me/dexseq/exon/chrX.DEXSeq.gff.gz', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert (process.stdout + process.stderr).join('\n').contains("Blocking variables with different values in rows of the same sample: batch") }
            )
        }

    }

    test("homo_sapiens - chrX - GBR vs YRI - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'GBR_vs_YRI' ], 'condition', 'YRI', 'GBR' ]
                input[1] = [
                    [ id:'study' ],
                    file(params.modules_testdata_base_path + 'delete_me/dexseq/exon/chrX.samplesheet.csv', checkIfExists: true),
                    ['ERR188383', 'ERR188428', 'ERR188454', 'ERR204916'].collect { id ->
                        file(params.modules_testdata_base_path + "delete_me/dexseq/exon/\${id}.txt", checkIfExists: true)
                    }
                ]
                input[2] = [
                    [ id:'chrX' ],
                    file(params.modules_testdata_base_path + 'delete_me/dexseq/exon/chrX.DEXSeq.gff.gz', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

}
