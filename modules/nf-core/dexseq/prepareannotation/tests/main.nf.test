nextflow_process {

    name "Test Process DEXSEQ_PREPAREANNOTATION"
    script "../main.nf"
    process "DEXSEQ_PREPAREANNOTATION"
    config "./nextflow.config"

    tag "modules"
    tag "modules_nfcore"
    tag "dexseq"
    tag "dexseq/prepareannotation"

    test("homo_sapiens - gtf") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.gtf', checkIfExists: true)
                ]
                input[1] = 0
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                // Aggregate genes join the IDs of the merged genes with '+'
                { assert path(process.out.gff[0][1]).text =~ /gene_id "[^"]*\+[^"]*"/ },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

    test("homo_sapiens - gtf - no aggregation") {

        when {
            params {
                module_args = '-r no'
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.gtf', checkIfExists: true)
                ]
                input[1] = 0
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert !(path(process.out.gff[0][1]).text =~ /gene_id "[^"]*\+[^"]*"/) },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

    test("homo_sapiens - gtf - no seed") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.gtf', checkIfExists: true)
                ]
                input[1] = []
                """
            }
        }

        then {
            // Without a hash seed the order of the aggregate gene IDs changes between runs
            assertAll(
                { assert process.success },
                { assert path(process.out.gff[0][1]).text =~ /gene_id "[^"]*\+[^"]*"/ },
                { assert snapshot(
                    file(process.out.gff[0][1]).name,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("homo_sapiens - gtf - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.gtf', checkIfExists: true)
                ]
                input[1] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

}
