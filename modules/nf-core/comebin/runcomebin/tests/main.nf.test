nextflow_process {

    name "Test Process COMEBIN_RUNCOMEBIN"
    script "../main.nf"
    process "COMEBIN_RUNCOMEBIN"

    tag "modules"
    tag "modules_nfcore"
    tag "comebin"
    tag "comebin/runcomebin"

    test("metagenome - binning") {

        config "./nextflow.config"

        when {

            process {
                """
                input[0] = channel.of([
                    [id: "test"],
                    file("https://raw.githubusercontent.com/dialvarezs/nfcore-test-datasets/binning-dataset/data/genomics/prokaryotes/metagenome/binning/contigs.fasta.gz", checkIfExists: true),
                    file("https://raw.githubusercontent.com/dialvarezs/nfcore-test-datasets/binning-dataset/data/genomics/prokaryotes/metagenome/binning/s1.sorted.bam", checkIfExists: true),
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.bins.get(0).get(1).size() >= 1 },
                { assert snapshot(
                    sanitizeOutput(process.out,
                        // bin contents depend on BLAS and OpenMP thread pools, which COMEBin
                        // does not control, so they differ between machines
                        unstableKeys: ["tsv"],
                        ignoreKeys: ["bins", "embeddings", "covembeddings", "log"])
                ).match() }
            )
        }

    }

    test("metagenome - binning - stub") {

        options "-stub"

        when {

            process {
                """
                input[0] = channel.of([
                    [id: "test"],
                    file("https://raw.githubusercontent.com/dialvarezs/nfcore-test-datasets/binning-dataset/data/genomics/prokaryotes/metagenome/binning/contigs.fasta.gz", checkIfExists: true),
                    file("https://raw.githubusercontent.com/dialvarezs/nfcore-test-datasets/binning-dataset/data/genomics/prokaryotes/metagenome/binning/s1.sorted.bam", checkIfExists: true),
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

}
