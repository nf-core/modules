process {
    withName: 'COMEBIN_RUNCOMEBIN' {
        accelerator = 1
        // COMEBin trains on a single device; serialise tasks so concurrent
        // processes do not contend for the same GPU under Singularity
        maxForks    = 1
        // COMEBin has no default random seed, and its clustering also varies with the
        // thread count, so both are pinned to keep the snapshot stable across machines
        cpus        = 2
        ext.args    = '-s 1'
    }
}
