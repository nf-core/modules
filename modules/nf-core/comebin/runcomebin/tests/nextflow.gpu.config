process {
    withName: 'COMEBIN_RUNCOMEBIN' {
        accelerator = 1
        // COMEBin uses one device, so serialise to avoid GPU contention
        maxForks    = 1
        // pinned for reproducibility: COMEBin has no default seed, and clustering varies with threads
        cpus        = 2
        ext.args    = '-s 1'
    }
}
