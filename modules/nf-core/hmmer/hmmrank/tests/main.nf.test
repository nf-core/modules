// nf-core modules test hmmer/hmmrank
nextflow_process {

    name "Test Process HMMER_HMMRANK"
    script "../main.nf"
    process "HMMER_HMMRANK"
    config "./nextflow.config"

    tag "modules"
    tag "modules_nfcore"
    tag "hmmer"
    tag "hmmer/hmmfetch"
    tag "hmmer/hmmsearch"
    tag "hmmer/formattsv"
    tag "duckdb/table2parquet"
    tag "hmmer/hmmrank"

    setup {
        run("HMMER_HMMFETCH") {
            script "../../hmmfetch/main.nf"
            process {
                """
                input[0] = Channel.fromList([
                    tuple([ id: 'arc16s' ], file("https://raw.githubusercontent.com/tseemann/barrnap/0.9/db/arc.hmm", checkIfExists: true)),
                    tuple([ id: 'bac16s' ], file("https://raw.githubusercontent.com/tseemann/barrnap/0.9/db/bac.hmm", checkIfExists: true))
                ])
                input[1] = Channel.of('16S_rRNA').first()
                input[2] = []
                input[3] = []
                """
            }
        }
        run("HMMER_HMMSEARCH") {
            script "../../hmmsearch/main.nf"
            process {
                """
                input[0] = HMMER_HMMFETCH.out.hmm.map {
                    [ it[0], it[1], file(params.phyloplace_testdata_base_path + 'domain_16s.fna'), false, true, true ]
                }
                """
            }
        }
        run("HMMER_FORMATTSV", alias: "FORMATTSV_16S_TBLOUT") {
            script "../../formattsv/main.nf"
            process {
                """
                input[0] = HMMER_HMMSEARCH.out.target_summary
                    .map { meta, tbl -> [ meta.id, tbl ] }
                    .collect(flat: false)
                    .map { pairs -> [ [ id: '16S-test' ], pairs.collect { it[0] }, pairs.collect { it[1] } ] }
                input[1] = 'tblout'
                """
            }
        }
        run("HMMER_FORMATTSV", alias: "FORMATTSV_16S_DOMTBLOUT") {
            script "../../formattsv/main.nf"
            process {
                """
                input[0] = HMMER_HMMSEARCH.out.domain_summary
                    .map { meta, domtbl -> [ meta.id, domtbl ] }
                    .collect(flat: false)
                    .map { pairs -> [ [ id: '16S-test' ], pairs.collect { it[0] }, pairs.collect { it[1] } ] }
                input[1] = 'domtblout'
                """
            }
        }
        // Curated excerpts of a real search of the NrdJ and NrdJm1 profiles against GTDB r226
        // representatives, used by the two tests below. Five targets, nine (target, profile)
        // pairs, chosen to cover the domain layouts the coordinate arithmetic has to handle: a
        // single domain, several overlapping domains, several disjoint domains, and domains that
        // overlap in profile coordinates while lying far apart on the target sequence.
        run("HMMER_FORMATTSV", alias: "FORMATTSV_NRDJ_TBLOUT") {
            script "../../formattsv/main.nf"
            process {
                """
                input[0] = [
                    [ id: 'nrdj' ],
                    [ 'NrdJ', 'NrdJm1' ],
                    [
                        file(params.phyloplace_testdata_base_path + 'hmmrank/NrdJ.tbl.gz', checkIfExists: true),
                        file(params.phyloplace_testdata_base_path + 'hmmrank/NrdJm1.tbl.gz', checkIfExists: true)
                    ]
                ]
                input[1] = 'tblout'
                """
            }
        }
        run("HMMER_FORMATTSV", alias: "FORMATTSV_NRDJ_DOMTBLOUT") {
            script "../../formattsv/main.nf"
            process {
                """
                input[0] = [
                    [ id: 'nrdj' ],
                    [ 'NrdJ', 'NrdJm1' ],
                    [
                        file(params.phyloplace_testdata_base_path + 'hmmrank/NrdJ.domtbl.gz', checkIfExists: true),
                        file(params.phyloplace_testdata_base_path + 'hmmrank/NrdJm1.domtbl.gz', checkIfExists: true)
                    ]
                ]
                input[1] = 'domtblout'
                """
            }
        }
        // One HMM file may hold several models, in which case the whole file is searched in one
        // go and both tables carry rows for several query names under one file-derived profile:
        // one header, then every model's data rows, then one footer -- not two runs' worth of
        // output (each with its own header and footer) simply concatenated, which is a different
        // and stranger shape hmmsearch itself never actually produces. Built here by keeping the
        // first fixture's header and both fixtures' data rows only (comment lines, i.e. anything
        // starting with '#', dropped from both), so the expected table (in the test below that
        // uses this) is the same as the NrdJ/NrdJm1 test, keyed on the query name rather than the
        // profile. An immediately-invoked closure, not a `def`-bound one: `setup { run(...) {
        // process { ... } } }` blocks don't share a script scope the way a plain test's `when {
        // process { ... } }` does, so a `def` here would not be visible by the time it's called on
        // a later line.
        run("HMMER_FORMATTSV", alias: "FORMATTSV_MULTIMODEL_TBLOUT") {
            script "../../formattsv/main.nf"
            process {
                """
                input[0] = [
                    [ id: 'nrdjboth' ],
                    [ 'nrdj' ],
                    [ { name, srcs ->
                          def lines = srcs.collect { src -> new java.util.zip.GZIPInputStream(file(src, checkIfExists: true).newInputStream()).withStream { it.text.readLines() } }
                          def header = lines[0].findAll { it.startsWith('#') }
                          def data = lines.collect { ls -> ls.findAll { !it.startsWith('#') } }.flatten()
                          def out = file("\${workDir}/multimodel/\${name}")
                          out.parent.mkdirs()
                          new java.util.zip.GZIPOutputStream(out.newOutputStream()).withStream { os -> os.write((header + data).join('\\n').getBytes('UTF-8')) }
                          out
                      }('NrdJboth.tbl.gz', [
                          params.phyloplace_testdata_base_path + 'hmmrank/NrdJ.tbl.gz',
                          params.phyloplace_testdata_base_path + 'hmmrank/NrdJm1.tbl.gz'
                      ]) ]
                ]
                input[1] = 'tblout'
                """
            }
        }
        run("HMMER_FORMATTSV", alias: "FORMATTSV_MULTIMODEL_DOMTBLOUT") {
            script "../../formattsv/main.nf"
            process {
                """
                input[0] = [
                    [ id: 'nrdjboth' ],
                    [ 'nrdj' ],
                    [ { name, srcs ->
                          def lines = srcs.collect { src -> new java.util.zip.GZIPInputStream(file(src, checkIfExists: true).newInputStream()).withStream { it.text.readLines() } }
                          def header = lines[0].findAll { it.startsWith('#') }
                          def data = lines.collect { ls -> ls.findAll { !it.startsWith('#') } }.flatten()
                          def out = file("\${workDir}/multimodel/\${name}")
                          out.parent.mkdirs()
                          new java.util.zip.GZIPOutputStream(out.newOutputStream()).withStream { os -> os.write((header + data).join('\\n').getBytes('UTF-8')) }
                          out
                      }('NrdJboth.domtbl.gz', [
                          params.phyloplace_testdata_base_path + 'hmmrank/NrdJ.domtbl.gz',
                          params.phyloplace_testdata_base_path + 'hmmrank/NrdJm1.domtbl.gz'
                      ]) ]
                ]
                input[1] = 'domtblout'
                """
            }
        }
        // seq2 has a tblout hit but deliberately no matching domtblout row, to exercise the
        // "no domain records behind this hit" case: hmmsearch's per-sequence and per-domain
        // thresholds are independent, so this is a real, expected shape, not corrupted input.
        run("HMMER_FORMATTSV", alias: "FORMATTSV_NA_TBLOUT") {
            script "../../formattsv/main.nf"
            process {
                """
                def tblout1 = File.createTempFile('profileNA', '.tbl')
                tblout1.text = '''#                                                                           --- full sequence ---- --- best 1 domain ---- --- domain number estimation ----
# target name                    accession  query name           accession    E-value  score  bias   E-value  score  bias   exp reg clu  ov env dom rep inc description of target
#            ------------------- ---------- -------------------- ---------- --------- ------ ----- --------- ------ -----   --- --- --- --- --- --- --- --- ---------------------
seq1                               -          model_A               PF00001       1e-10   50.0   0.1      2e-10   49.0   0.1   1.0   1   0   0   1   1   1   1 has a domain match
seq2                               -          model_A               PF00001       2e-10   49.0   0.1      3e-10   48.0   0.1   1.0   1   0   0   1   1   1   1 no domain match
'''
                input[0] = [ [ id: 'na-test' ], [ 'P' ], [ file(tblout1.toString()) ] ]
                input[1] = 'tblout'
                """
            }
        }
        run("HMMER_FORMATTSV", alias: "FORMATTSV_NA_DOMTBLOUT") {
            script "../../formattsv/main.nf"
            process {
                """
                def domtblout1 = File.createTempFile('profileNA', '.domtbl')
                domtblout1.text = '''#                                                                            --- full sequence --- -------------- this domain -------------   hmm coord   ali coord   env coord
# target name        accession   tlen query name           accession   qlen  E-value  score  bias   #  of  c-Evalue  i-Evalue  score  bias  from    to  from    to  from    to  acc description of target
#------------------- ---------- ----- -------------------- ---------- ----- --------- ------ ----- --- --- --------- --------- ------ ----- ----- ----- ----- ----- ----- ----- ---- ---------------------
seq1                               -   100 model_A               PF00001   100      1e-10   50.0   0.1   1   1     1e-10      1e-10   50.0   0.1     1    50     1    50     1    50 0.95 has a domain match
'''
                input[0] = [ [ id: 'na-test' ], [ 'P' ], [ file(domtblout1.toString()) ] ]
                input[1] = 'domtblout'
                """
            }
        }
        // Two domains sharing the same hmm_from (a tied start, e.g. repeat domains that all begin
        // at profile position 1) exercises the *_prev/*_isl tie-break: both window steps must
        // order ties the same way, or a tied row's prev_cummax and its running island count can
        // end up computed against two different relative positions.
        run("HMMER_FORMATTSV", alias: "FORMATTSV_TIE_TBLOUT") {
            script "../../formattsv/main.nf"
            process {
                """
                def tieTblout1 = File.createTempFile('profileTie', '.tbl')
                tieTblout1.text = '''#                                                                           --- full sequence ---- --- best 1 domain ---- --- domain number estimation ----
# target name                    accession  query name           accession    E-value  score  bias   E-value  score  bias   exp reg clu  ov env dom rep inc description of target
#            ------------------- ---------- -------------------- ---------- --------- ------ ----- --------- ------ -----   --- --- --- --- --- --- --- --- ---------------------
seq1                               -          model_A               PF00001       1e-10   50.0   0.1      2e-10   49.0   0.1   3.0   3   0   0   3   3   3   1 tied domain starts
'''
                input[0] = [ [ id: 'tie-test' ], [ 'P' ], [ file(tieTblout1.toString()) ] ]
                input[1] = 'tblout'
                """
            }
        }
        run("HMMER_FORMATTSV", alias: "FORMATTSV_TIE_DOMTBLOUT") {
            script "../../formattsv/main.nf"
            process {
                """
                def tieDomtblout1 = File.createTempFile('profileTie', '.domtbl')
                tieDomtblout1.text = '''#                                                                            --- full sequence --- -------------- this domain -------------   hmm coord   ali coord   env coord
# target name        accession   tlen query name           accession   qlen  E-value  score  bias   #  of  c-Evalue  i-Evalue  score  bias  from    to  from    to  from    to  acc description of target
#------------------- ---------- ----- -------------------- ---------- ----- --------- ------ ----- --- --- --------- --------- ------ ----- ----- ----- ----- ----- ----- ----- ---- ---------------------
seq1                               -   200 model_A               PF00001   200      1e-10   50.0   0.1   1   3     1e-10      1e-10   50.0   0.1     1     3     1     3     1     3 0.95 first domain
seq1                               -   200 model_A               PF00001   200      1e-10   50.0   0.1   2   3     1e-10      1e-10   50.0   0.1     5   100     5   100     5   100 0.95 tied start, far end
seq1                               -   200 model_A               PF00001   200      1e-10   50.0   0.1   3   3     1e-10      1e-10   50.0   0.1     5     6     5     6     5     6 0.95 tied start, near end
'''
                input[0] = [ [ id: 'tie-test' ], [ 'P' ], [ file(tieDomtblout1.toString()) ] ]
                input[1] = 'domtblout'
                """
            }
        }
        run("DUCKDB_TABLE2PARQUET", alias: "PARQUET_TBLOUT") {
            script "../../../duckdb/table2parquet/main.nf"
            process {
                """
                input[0] = FORMATTSV_16S_TBLOUT.out.tsv.mix(FORMATTSV_NRDJ_TBLOUT.out.tsv, FORMATTSV_MULTIMODEL_TBLOUT.out.tsv, FORMATTSV_NA_TBLOUT.out.tsv, FORMATTSV_TIE_TBLOUT.out.tsv)
                """
            }
        }
        run("DUCKDB_TABLE2PARQUET", alias: "PARQUET_DOMTBLOUT") {
            script "../../../duckdb/table2parquet/main.nf"
            process {
                """
                input[0] = FORMATTSV_16S_DOMTBLOUT.out.tsv.mix(FORMATTSV_NRDJ_DOMTBLOUT.out.tsv, FORMATTSV_MULTIMODEL_DOMTBLOUT.out.tsv, FORMATTSV_NA_DOMTBLOUT.out.tsv, FORMATTSV_TIE_DOMTBLOUT.out.tsv)
                """
            }
        }
    }

    test("hmmrank - 16S") {
        when {
            process {
                """
                input[0] = PARQUET_TBLOUT.out.parquet
                    .filter { meta, parquet -> meta.id == '16S-test' }
                    .map { meta, parquet -> [ meta, parquet, [] ] }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    sanitizeOutput(process.out)
                ).match() }
            )
        }
    }

    test("hmmrank - 16S with domain coordinates") {
        when {
            process {
                """
                input[0] = PARQUET_TBLOUT.out.parquet
                    .filter { meta, parquet -> meta.id == '16S-test' }
                    .join(PARQUET_DOMTBLOUT.out.parquet.filter { meta, parquet -> meta.id == '16S-test' })
                """
            }
        }

        then {
            // read the output only inside the assertions, so a failed process is reported as
            // such instead of throwing out of this block and hiding its log
            assertAll(
                { assert process.success },
                // the coordinate columns are present and populated
                { assert path(process.out.hmmrank[0][1]).linesGzip[0].split('\t').toList().containsAll([
                    'tlen', 'qlen',
                    'hmm_from', 'hmm_to', 'hmm_len', 'hmm_n_islands',
                    'ali_from', 'ali_to', 'ali_len', 'ali_n_islands',
                    'env_from', 'env_to', 'env_len', 'env_n_islands'
                ]) },
                { assert path(process.out.hmmrank[0][1]).linesGzip.size() > 1 },
                { def rows = path(process.out.hmmrank[0][1]).linesGzip
                  def header = rows[0].split('\t') as List
                  def hmmLens = rows[1..-1].collect { it.split('\t')[header.indexOf('hmm_len')] }
                  // NA is a legitimate value: hmmsearch reports a sequence on the per-sequence
                  // threshold, so a hit can be ranked with no domain records behind it at all.
                  // any() as well as every(), since all-NA is what a broken join looks like
                  assert hmmLens.every { it.isInteger() || it == 'NA' }
                  assert hmmLens.any { it.isInteger() } },
                { assert snapshot(
                    sanitizeOutput(process.out)
                ).match() }
            )
        }
    }

    test("hmmrank - domain coordinates against a known table") {
        when {
            process {
                """
                input[0] = PARQUET_TBLOUT.out.parquet
                    .filter { meta, parquet -> meta.id == 'nrdj' }
                    .join(PARQUET_DOMTBLOUT.out.parquet.filter { meta, parquet -> meta.id == 'nrdj' })
                """
            }
        }

        then {
            def cols = [
                'accno', 'profile',
                'hmm_from', 'hmm_to', 'hmm_len', 'hmm_n_islands',
                'ali_from', 'ali_to', 'ali_len', 'ali_n_islands',
                'env_from', 'env_to', 'env_len', 'env_n_islands',
                'tlen', 'qlen'
            ]
            // One row per (target, profile), coordinates being the union of that pair's domains.
            def expected = [
                'AACBMDAH_04658 NrdJ   11  95  68 2  57  238  67 2  40  242 128 2  805 407',
                'AACBMDAH_04658 NrdJm1  1 397 397 1  14  803 400 2  14  805 425 2  805 748',
                'AACBMDAH_04659 NrdJm1 513 748 236 1   1  620 239 2   1  620 249 2  626 748',
                'AAGAFPGM_00302 NrdJ   12 406 379 3 176  724 377 5 156  725 489 5  780 407',
                'AAGAFPGM_00302 NrdJm1  6 711 588 4 134  735 555 4 129  770 615 2  780 748',
                'DPHPGHLN_02900 NrdJ   62 384 306 2 205 1379 327 4 190 1397 401 4 1460 407',
                'DPHPGHLN_02900 NrdJm1  1 747 747 1  14 1454 752 3  14 1455 791 3 1460 748',
                'MNMMFBCN_00658 NrdJ   11 386 353 3  84  718 374 5  67  732 485 4  798 407',
                'MNMMFBCN_00658 NrdJm1  1 748 748 1  42  792 751 1  42  792 751 1  798 748'
            ].collect { it.split(/ +/).join(' ') }.sort()

            // read the output only inside the assertion, so a failed process is reported as
            // such instead of throwing out of this block and hiding its log
            assertAll(
                { assert process.success },
                { def rows = path(process.out.hmmrank[0][1]).linesGzip
                  def header = rows[0].split('\t') as List
                  assert rows[1..-1].collect { line ->
                      def f = line.split('\t')
                      cols.collect { f[header.indexOf(it)] }.join(' ')
                  }.sort() == expected }
            )
        }
    }

    test("hmmrank - several models in one table") {
        when {
            process {
                """
                input[0] = PARQUET_TBLOUT.out.parquet
                    .filter { meta, parquet -> meta.id == 'nrdjboth' }
                    .join(PARQUET_DOMTBLOUT.out.parquet.filter { meta, parquet -> meta.id == 'nrdjboth' })
                """
            }
        }

        then {
            def cols = [
                'accno', 'profile_desc',
                'hmm_from', 'hmm_to', 'hmm_len', 'hmm_n_islands',
                'ali_from', 'ali_to', 'ali_len', 'ali_n_islands',
                'env_from', 'env_to', 'env_len', 'env_n_islands',
                'tlen', 'qlen'
            ]
            def expected = [
                'AACBMDAH_04658 NrdJ   11  95  68 2  57  238  67 2  40  242 128 2  805 407',
                'AACBMDAH_04658 NrdJm1  1 397 397 1  14  803 400 2  14  805 425 2  805 748',
                'AACBMDAH_04659 NrdJm1 513 748 236 1   1  620 239 2   1  620 249 2  626 748',
                'AAGAFPGM_00302 NrdJ   12 406 379 3 176  724 377 5 156  725 489 5  780 407',
                'AAGAFPGM_00302 NrdJm1  6 711 588 4 134  735 555 4 129  770 615 2  780 748',
                'DPHPGHLN_02900 NrdJ   62 384 306 2 205 1379 327 4 190 1397 401 4 1460 407',
                'DPHPGHLN_02900 NrdJm1  1 747 747 1  14 1454 752 3  14 1455 791 3 1460 748',
                'MNMMFBCN_00658 NrdJ   11 386 353 3  84  718 374 5  67  732 485 4  798 407',
                'MNMMFBCN_00658 NrdJm1  1 748 748 1  42  792 751 1  42  792 751 1  798 748'
            ].collect { it.split(/ +/).join(' ') }.sort()

            assertAll(
                { assert process.success },
                // one row per (target, model): no multiplication from the shared profile name
                { assert path(process.out.hmmrank[0][1]).linesGzip.size() == expected.size() + 1 },
                { def rows = path(process.out.hmmrank[0][1]).linesGzip
                  def header = rows[0].split('\t') as List
                  assert rows[1..-1].collect { line ->
                      def f = line.split('\t')
                      cols.collect { f[header.indexOf(it)] }.join(' ')
                  }.sort() == expected }
            )
        }
    }

    // A hit with no matching domtblout row is a real, expected shape (hmmsearch's per-sequence
    // and per-domain thresholds are independent), not corrupted input -- its coordinate columns
    // must come out as the literal string "NA" (matching readr::write_tsv's own NA rendering, so
    // downstream consumers that compare against/filter on that literal token keep working),
    // never a silently-empty field, which is indistinguishable from a genuinely empty string
    // value and is what DuckDB's COPY writes for a SQL NULL without an explicit NULLSTR.
    test("hmmrank - domain coordinates - a hit with no domain match renders as NA, not empty") {
        when {
            process {
                """
                input[0] = PARQUET_TBLOUT.out.parquet
                    .filter { meta, parquet -> meta.id == 'na-test' }
                    .join(PARQUET_DOMTBLOUT.out.parquet.filter { meta, parquet -> meta.id == 'na-test' })
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { def rows = path(process.out.hmmrank[0][1]).linesGzip
                  def header = rows[0].split('\t') as List
                  def byAccno = rows[1..-1].collectEntries { line -> def f = line.split('\t'); [ (f[header.indexOf('accno')]): f ] }
                  assert byAccno['seq1'][header.indexOf('hmm_len')] == '50'
                  assert byAccno['seq2'][header.indexOf('hmm_len')] == 'NA' }
            )
        }
    }

    // Domains (1,3), (5,100) and (5,6) share a tied hmm_from of 5. The correct merge is two
    // islands, [1,3] and [5,100] (the third domain nests inside the second), for hmm_len 99 --
    // reproduced against a real database (duckdb 1.5.5) landing on hmm_len 102 instead, by
    // reviewer @piplus2 on nf-core/modules#12966, before *_prev/*_isl ordered by (from, to)
    // instead of from alone.
    test("hmmrank - domain coordinates - tied domain starts merge into the correct islands") {
        when {
            process {
                """
                input[0] = PARQUET_TBLOUT.out.parquet
                    .filter { meta, parquet -> meta.id == 'tie-test' }
                    .join(PARQUET_DOMTBLOUT.out.parquet.filter { meta, parquet -> meta.id == 'tie-test' })
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { def rows = path(process.out.hmmrank[0][1]).linesGzip
                  def header = rows[0].split('\t') as List
                  def f = rows[1].split('\t')
                  assert f[header.indexOf('hmm_from')] == '1'
                  assert f[header.indexOf('hmm_to')] == '100'
                  assert f[header.indexOf('hmm_len')] == '99'
                  assert f[header.indexOf('hmm_n_islands')] == '2' }
            )
        }
    }

    // meta.id/task.ext.prefix are not under this module's control -- a sample id containing an
    // apostrophe (not an unreasonable real id) must not corrupt the generated SQL, since a single
    // quote is SQL's own string-literal delimiter.
    test("hmmrank - meta.id containing an apostrophe doesn't break the generated SQL") {
        when {
            process {
                """
                input[0] = PARQUET_TBLOUT.out.parquet
                    .filter { meta, parquet -> meta.id == 'nrdj' }
                    .map { meta, parquet -> [ [ id: "O'Brien" ], parquet, [] ] }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.hmmrank[0][1].toString().tokenize('/').last() == "O'Brien.hmmrank.tsv.gz" },
                { assert path(process.out.hmmrank[0][1]).linesGzip.size() > 1 }
            )
        }
    }

    // `$(touch pwned)` surviving verbatim in the output filename proves it wasn't executed --
    // a real expansion would vanish (touch has no stdout).
    test("hmmrank - meta.id containing shell metacharacters doesn't get executed") {
        when {
            process {
                """
                input[0] = PARQUET_TBLOUT.out.parquet
                    .filter { meta, parquet -> meta.id == 'nrdj' }
                    .map { meta, parquet -> [ [ id: 'test\$(touch pwned)`echo also_pwned`' ], parquet, [] ] }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.hmmrank[0][1].toString().tokenize('/').last() == 'test\$(touch pwned)`echo also_pwned`.hmmrank.tsv.gz' },
                { assert path(process.out.hmmrank[0][1]).linesGzip.size() > 1 },
                { assert !new File(process.out.hmmrank[0][1].toString()).parentFile.toPath().resolve('pwned').toFile().exists() }
            )
        }
    }

    // A newline followed by the heredoc's own delimiter must not let a trailing shell command
    // escape it -- the delimiter is randomized per task specifically to block this. The payload
    // rides in ext.prefix (see tests/nextflow.config), not meta.id itself: a literal newline in
    // meta.id would also hit an unrelated Nextflow issue in how it embeds the process `tag` into
    // .command.run's own header comment, unrelated to this module's own defense.
    test("hmmrank - ext.prefix containing a newline and the heredoc delimiter") {
        when {
            process {
                """
                input[0] = PARQUET_TBLOUT.out.parquet
                    .filter { meta, parquet -> meta.id == 'nrdj' }
                    .map { meta, parquet -> [ [ id: 'heredoc-forge' ], parquet, [] ] }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.hmmrank[0][1].toString().tokenize('/').last() == '''safe\nSQL\ntouch pwned.hmmrank.tsv.gz''' },
                { assert path(process.out.hmmrank[0][1]).linesGzip.size() > 1 },
                { assert !new File(process.out.hmmrank[0][1].toString()).parentFile.toPath().resolve('pwned').toFile().exists() }
            )
        }
    }

    test("hmmrank - 16S -- stub") {
        options "-stub"

        when {
            process {
                """
                input[0] = PARQUET_TBLOUT.out.parquet
                    .filter { meta, parquet -> meta.id == '16S-test' }
                    .map { meta, parquet -> [ meta, parquet, [] ] }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    sanitizeOutput(process.out)
                ).match() }
            )
        }
    }
}
