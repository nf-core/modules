params {
    phyloplace_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/phyloplace/testdata/'
}

// DUCKDB_TABLE2PARQUET is run twice per meta in these tests (once for the tblout table, once
// for the domtblout table); without distinct prefixes both default to "${meta.id}.parquet" and
// collide as HMMER_HMMRANK inputs.
process {
    withName: 'PARQUET_TBLOUT' {
        ext.prefix = { "${meta.id}.tblout" }
    }
    withName: 'PARQUET_DOMTBLOUT' {
        ext.prefix = { "${meta.id}.domtblout" }
    }
    // Routes the heredoc-forgery regression's payload through ext.prefix rather than meta.id: a
    // literal newline in meta.id itself hits an unrelated Nextflow issue (the process `tag` is
    // embedded unescaped into .command.run's own multi-line header comment).
    withName: 'HMMER_HMMRANK' {
        ext.prefix = { meta.id == 'heredoc-forge' ? '''safe\nSQL\ntouch pwned''' : null }
    }
}
