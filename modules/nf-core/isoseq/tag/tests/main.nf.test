nextflow_process {

    name "Test Process ISOSEQ_TAG"
    script "../main.nf"
    process "ISOSEQ_TAG"

    tag "modules"
    tag "modules_nfcore"
    tag "isoseq"
    tag "isoseq/tag"

    test("isoseq tag - bam") {
        when {
            process {
                """
                input[0] = [
                    [ id:'mini'], // meta map
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/pacbio/bam/mini.5p--3p.bam', checkIfExists: true)
                    ]
                input[1] = "T-12U-16B"
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                // readsMD5Keys can't be used here: htsjdk's default strict validation rejects
                // this PacBio BAM (nonzero MAPQ on an unmapped read), so bam() is called directly
                // with stringency: "silent" instead.
                { assert snapshot(
                    bam(process.out.bam[0][1], stringency: "silent").getHeader(),
                    bam(process.out.bam[0][1], stringency: "silent").getReadsMD5(),
                    process.out.pbi.collect { file(it[1]).getName() }, // unstable
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("isoseq tag - bam - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'mini'], // meta map
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/pacbio/bam/mini.5p--3p.bam', checkIfExists: true)
                    ]
                input[1] = "T-12U-16B"
                """
            }
        }

        then {
            assertAll(
                { assert process.success },

                { assert process.out.bam[0][1] ==~ ".*/mini.flt.bam" },
                { assert process.out.pbi[0][1] ==~ ".*/mini.flt.bam.pbi" },

                { assert snapshot(process.out).match() }
            )
        }

    }

}
