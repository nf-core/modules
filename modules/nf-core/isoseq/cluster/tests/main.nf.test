nextflow_process {

    name "Test Process ISOSEQ_CLUSTER"
    script "../main.nf"
    process "ISOSEQ_CLUSTER"

    tag "modules"
    tag "modules_nfcore"
    tag "isoseq"
    tag "isoseq/cluster"

    test("deprecated") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ], file('bam') ]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("WARNING: This module has been deprecated.") }
            )
        }
    }
}
