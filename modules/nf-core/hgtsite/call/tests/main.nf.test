nextflow_process {

    name "Test Process HGTSITE_CALL"
    script "../main.nf"
    process "HGTSITE_CALL"

    tag "modules"
    tag "modules_nfcore"
    tag "hgtsite"
    tag "hgtsite/call"
    tag "untar"
    tag "kraken2"
    tag "kraken2/kraken2"

    // There is no per-read classification file in nf-core/test-datasets, so the
    // test makes one by running Kraken2 on the same reads the alignment holds.
    // The reads are aligned to the SARS-CoV-2 genome, so SARS-CoV-2 is the host
    // here and its taxid, 2697049, is what gets passed as the host.
    setup {
        run("UNTAR") {
            script "../../../untar/main.nf"
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/db/kraken2.tar.gz', checkIfExists: true)
                ]
                """
            }
        }

        run("KRAKEN2_KRAKEN2") {
            script "../../../kraken2/kraken2/main.nf"
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ],
                    [
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                    ]
                ]
                input[1] = UNTAR.out.untar.map { it[1] }
                input[2] = false
                input[3] = true
                """
            }
        }
    }

    test("sarscov2 - bam - classifications") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.bam', checkIfExists: true),
                    []
                ]
                input[1] = KRAKEN2_KRAKEN2.out.classified_reads_assignment
                input[2] = 2697049
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                // The table is written whether or not any site passes, and always
                // carries its header, so this holds on any input.
                { assert path(process.out.tsv.get(0).get(1)).readLines()[0].startsWith("chrom\tstart\tend") },
                { assert snapshot(process.out.versions_hgtsite).match("versions") }
            )
        }
    }

    test("sarscov2 - bam - classifications - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.bam', checkIfExists: true),
                    []
                ]
                input[1] = KRAKEN2_KRAKEN2.out.classified_reads_assignment
                input[2] = 2697049
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
