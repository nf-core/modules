nextflow_process {

    name "Test Process BIGSLICE_BIGSLICE"
    script "../main.nf"
    process "BIGSLICE_BIGSLICE"
    config "./nextflow.config"

    tag "modules"
    tag "modules_nfcore"
    tag "bigslice"
    tag "bigslice/bigslice"

    test("streptomyces_coelicolor - bigslice - gbk") {

        def gbk_dir
        def hmmdb
        setup {
            // params.modules_testdata_base_path is null outside the process string, so use the same env var and default as tests/config/nf-test.config
            def modules_testdata_base_path = System.getenv('NXF_MODULES_TESTDATA_BASE') ?: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
            gbk_dir = extract(modules_testdata_base_path + 'genomics/prokaryotes/streptomyces_coelicolor/fixtures_bigslice_gbk.tar.gz')
            hmmdb = extract('https://github.com/medema-group/bigslice/releases/download/v2.0.0rc/bigslice-models.2022-11-30.tar.gz')
        }

        when {
            process {
                """
                // Flatten the GBK directory into a list of individual GBK files with meta
                input[0] = channel.of([ [ id:'test_gbk' ], file('${gbk_dir}') ]).map { meta, dir ->
                    def gbk_files = []
                    dir.eachFileRecurse { if (it.name.endsWith('.gbk')) gbk_files << it }
                    [ meta, gbk_files ]
                }
                input[1] = file('${hmmdb}')
                input[2] = false
                """
            }
        }

        then {
            assert process.success
            def resultDir = file(process.out.output[0][1])
            def allNames = []
            def tmpFaCount = 0
            resultDir.eachFileRecurse { f ->
                if (!f.isDirectory()) {
                    def rel = resultDir.toPath().relativize(f.toPath()).toString()
                    if (rel.startsWith('tmp/') || rel.startsWith('tmp\\')) {
                        if (f.name.endsWith('.fa')) tmpFaCount++
                    } else {
                        allNames.add(f.name)
                    }
                }
            }
            assertAll(
                { assert resultDir.isDirectory() },
                { assert tmpFaCount > 0 },
                { assert snapshot(
                    allNames.sort(),
                    process.out.findAll { key, val -> key.startsWith("versions")}
                ).match() }
            )
        }

    }

    test("streptomyces_coelicolor - bigslice - gbk - export_tsv") {

        def gbk_dir
        def hmmdb
        setup {
            // params.modules_testdata_base_path is null outside the process string, so use the same env var and default as tests/config/nf-test.config
            def modules_testdata_base_path = System.getenv('NXF_MODULES_TESTDATA_BASE') ?: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
            gbk_dir = extract(modules_testdata_base_path + 'genomics/prokaryotes/streptomyces_coelicolor/fixtures_bigslice_gbk.tar.gz')
            hmmdb = extract('https://github.com/medema-group/bigslice/releases/download/v2.0.0rc/bigslice-models.2022-11-30.tar.gz')
        }

        when {
            process {
                """
                // Flatten the GBK directory into a list of individual GBK files with meta
                input[0] = channel.of([ [ id:'test_gbk' ], file('${gbk_dir}') ]).map { meta, dir ->
                    def gbk_files = []
                    dir.eachFileRecurse { if (it.name.endsWith('.gbk')) gbk_files << it }
                    [ meta, gbk_files ]
                }
                input[1] = file('${hmmdb}')
                input[2] = true
                """
            }
        }

        then {
            assert process.success
            def resultDir = file(process.out.output[0][1])
            def allNames = []
            def tmpFaCount = 0
            resultDir.eachFileRecurse { f ->
                if (!f.isDirectory()) {
                    def rel = resultDir.toPath().relativize(f.toPath()).toString()
                    if (rel.startsWith('tmp/') || rel.startsWith('tmp\\')) {
                        if (f.name.endsWith('.fa')) tmpFaCount++
                    } else {
                        allNames.add(f.name)
                    }
                }
            }
            assertAll(
                { assert resultDir.isDirectory() },
                { assert tmpFaCount > 0 },
                { assert file(process.out.tsv[0][1]).isDirectory() },
                { assert snapshot(
                    allNames.sort(),
                    process.out.findAll { key, val -> key.startsWith("versions")}
                ).match() }
            )
        }

    }

    test("streptomyces_coelicolor - bigslice - gbk - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'test_gbk' ], [] ]
                input[1] = []
                input[2] = false
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out,
                    process.out.findAll { key, val -> key.startsWith("versions")}
                ).match() }
            )
        }

    }

}
