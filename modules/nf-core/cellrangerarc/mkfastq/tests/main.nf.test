nextflow_process {

    name "Test Process CELLRANGERARC_MKFASTQ"

    script "../main.nf"
    config "./nextflow.config"
    process "CELLRANGERARC_MKFASTQ"

    tag "modules"
    tag "modules_nfcore"
    tag "cellrangerarc"
    tag "cellrangerarc/mkfastq"

    test("cellrangerarc_mkfastq - simple atac") {
        def bcl_dir
        setup {
            bcl_dir = extract('https://cf.10xgenomics.com/supp/cell-arc/cellranger-arc-tiny-bcl-atac-1.0.0.tar.gz').resolve('cellranger-arc-tiny-bcl-atac-1.0.0')
        }
        when {
            process {
                """
                input[0] = [ [id: "test"], file('${bcl_dir}') ]
                input[1] = file("https://cf.10xgenomics.com/supp/cell-arc/cellranger-arc-tiny-bcl-atac-simple-1.0.0.csv", checkIfExists:true)
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.fastq[0][1].collect{ [file(it).name, path(it).fastq.getNumberOfRecords()] },
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }
    }

    test("cellrangerarc_mkfastq - simple gex") {
        def bcl_dir
        setup {
            bcl_dir = extract('https://cf.10xgenomics.com/supp/cell-arc/cellranger-arc-tiny-bcl-gex-1.0.0.tar.gz').resolve('cellranger-arc-tiny-bcl-gex-1.0.0')
        }
        when {
            process {
                """
                input[0] = [ [id: "test"], file('${bcl_dir}') ]
                input[1] = file("https://cf.10xgenomics.com/supp/cell-arc/cellranger-arc-tiny-bcl-gex-simple-1.0.0.csv", checkIfExists:true)
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.fastq[0][1].collect{ [file(it).name, path(it).fastq.getNumberOfRecords()] },
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }
    }

