process {
    withName: 'CELLRANGERARC_MKFASTQ' {
        cpus = 1 // WARNING !! Pay attention to the number of threads used in the process this might affect the results
        // The CI runner has ~13.4 GB free, so 10x mrp cannot reserve --localmem=15 and waits forever
        memory = '12.GB'
    }
}
