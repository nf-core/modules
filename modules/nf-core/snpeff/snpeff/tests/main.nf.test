nextflow_process {

    name "Test Process SNPEFF_SNPEFF"
    script "../main.nf"
    process "SNPEFF_SNPEFF"
    config "./nextflow.config"
    tag "modules"
    tag "modules_nfcore"
    tag "modules_snpeff"
    tag "snpeff"
    tag "snpeff/snpeff"

    test("SNPEFF annotate without a canonical transcript list") {

        when {
            process {
                """
                snpeff_cache = Channel.of([
                    [ id:'WBcel235.105' ],
                    file('s3://annotation-cache/snpeff_cache/WBcel235.105/')
                ]).collect()

                input[0] = Channel.of([
                    [ id:'test' ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test.vcf', checkIfExists: true)
                ])
                input[1] = params.snpeff_db
                input[2] = snpeff_cache
                input[3] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    sanitizeOutput(process.out, unstableKeys: ["report", "summary_html"]),
                    path(process.out.report[0][3]).readLines().size(),
                    path(process.out.summary_html[0][3]).readLines().size()
                ).match() }
            )
        }
    }

    test("SNPEFF annotate with a canonical transcript list") {

        when {
            process {
                """
                snpeff_cache = Channel.of([
                    [ id:'WBcel235.105' ],
                    file('s3://annotation-cache/snpeff_cache/WBcel235.105/')
                ]).collect()

                canon_list = Channel.of('WBGene00003779\tY75B8A.2a.1').collectFile(name: 'canon_list.txt', newLine: true)

                input[0] = Channel.of([
                    [ id:'test' ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test.vcf', checkIfExists: true)
                ])
                input[1] = params.snpeff_db
                input[2] = snpeff_cache
                input[3] = canon_list
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    sanitizeOutput(process.out, unstableKeys: ["report", "summary_html"]),
                    path(process.out.report[0][3]).readLines().size(),
                    path(process.out.summary_html[0][3]).readLines().size()
                ).match() }
            )
        }
    }

    test("SNPEFF annotate without a canonical transcript list - stub") {

        options "-stub"

        when {
            process {
                """
                snpeff_cache = Channel.of([
                    [ id:'WBcel235.105' ],
                    file("${projectDir}")
                ]).collect()

                input[0] = Channel.of([
                    [ id:'test' ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test.vcf', checkIfExists: true)
                ])
                input[1] = params.snpeff_db
                input[2] = snpeff_cache
                input[3] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }
}
