nextflow_process {

    name "Test Process SPOLIGOTYPER"
    script "../main.nf"
    process "SPOLIGOTYPER"

    tag "modules"
    tag "modules_nfcore"
    tag "spoligotyper"

    // nf-core test data has no M. tuberculosis complex genome: these tests check that the module runs and
    // writes its outputs ("MTBC not detected" is the expected result).
    test("sarscov2 - fasta") {
        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:true ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                ]
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                // Stable checks for the unstable channels: json and pdf embed run timestamps
                { assert path(process.out.tsv[0][1]).text.contains('MTBC not detected') },
                { assert path(process.out.json[0][1]).text.contains('MTBC not detected') },
                { assert file(process.out.pdf[0][1]).length() > 0 },
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ["json", "pdf"])).match() }
            )
        }
    }

    test("sarscov2 - paired-end fastq") {
        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ],
                    [
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                    ]
                ]
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                // Stable checks for the unstable channels: json and pdf embed run timestamps
                { assert path(process.out.tsv[0][1]).text.contains('fastq') },
                { assert path(process.out.json[0][1]).text.contains('fastq') },
                { assert file(process.out.pdf[0][1]).length() > 0 },
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ["json", "pdf"])).match() }
            )
        }
    }

    test("sarscov2 - fasta - stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:true ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                ]
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }
}
