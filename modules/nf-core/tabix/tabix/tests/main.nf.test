nextflow_process {

    name "Test Process TABIX_TABIX"
    script "../main.nf"
    process "TABIX_TABIX"

    tag "modules"
    tag "modules_nfcore"
    tag "tabix"
    tag "tabix/tabix"

    test("deprecated") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ], file('tab'), file('tai'), file('regions') ]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("WARNING: This module has been deprecated. Please use nf-core/modules/htslib/bgziptabix instead.") }
            )
        }
    }
}
