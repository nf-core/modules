nextflow_process {

    name "Test Process TABIX_BGZIP"
    script "../main.nf"
    process "TABIX_BGZIP"

    tag "modules"
    tag "modules_nfcore"
    tag "tabix"
    tag "tabix/bgzip"

    test("deprecated") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ], file('input') ]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("WARNING: This module has been deprecated.") }
            )
        }
    }
}
