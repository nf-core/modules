        when {
            params {
                module_args = ''
            }
            process {
                """
                input[0] = [ [ id:'test' ], [], [], [ file('normal1.bam'), file('normal2.bam') ], [ file('normal1.bam.bai'), file('normal2.bam.bai') ] ]
                input[1] = [ [:], file('genome.fasta'), [] ]
                input[2] = [ [:], [] ]
                input[3] = [ [:], [] ]
                input[4] = true
                """
