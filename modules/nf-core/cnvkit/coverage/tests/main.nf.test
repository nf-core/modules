nextflow_process {

    name "Test Process CNVKIT_COVERAGE"
    script "../main.nf"
    process "CNVKIT_COVERAGE"



    tag "modules"
    tag "modules_nfcore"
    tag "cnvkit"
    tag "cnvkit/coverage"

    test("test-cnvkit-coverage - bam") {

        when {

            process {
                """
                input[0] = [
                    [ id: 'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true ),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test.paired_end.sorted.bam.bai', checkIfExists: true)
                ]

                input[1] = [
                    [ id: 'intervals' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.bins_10kb_annotated.bed', checkIfExists: true)
                ]

                input[2] = [ [:], [], [] ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out
                ).match() }
            )
        }
    }

    test("test-cnvkit-coverage - cram") {

            when {

                process {
                    """
                    input[0] = [
                        [ id: 'test' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/cram/test.paired_end.sorted.cram', checkIfExists: true ),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/cram/test.paired_end.sorted.cram.crai', checkIfExists: true)
                    ]

                    input[1] = [
                        [ id: 'intervals' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.bins_10kb_annotated.bed', checkIfExists: true)
                    ]

                    input[2] = [
                        [ id : 'reference' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta.fai', checkIfExists: true)
                    ]
                    """
                }
            }

            then {
                assert process.success
                assertAll(
                    { assert snapshot(
                        process.out
                    ).match() }
                )
            }
        }





    test("test-cnvkit-coverage - bam - stub") {

        options "-stub"

        when {
            process {
                """

               input[0] = [
                    [ id: 'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true ),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test.paired_end.sorted.bam.bai', checkIfExists: true)
                ]

                input[1] = [
                    [ id: 'intervals' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.bins_10kb_annotated.bed', checkIfExists: true)
                ]

                input[2] = [ [:], [], [] ]

                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out
                ).match() }
            )
        }

    }
    test("test-cnvkit-coverage - cram - stub") {

            options "-stub"

             when {

                process {
                    """
                    input[0] = [
                        [ id: 'test' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/cram/test.paired_end.sorted.cram', checkIfExists: true ),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/cram/test.paired_end.sorted.cram.crai', checkIfExists: true)
                    ]

                    input[1] = [
                        [ id: 'intervals' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.bins_10kb_annotated.bed', checkIfExists: true)
                    ]

                    input[2] = [
                        [ id : 'reference' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta.fai', checkIfExists: true)
                    ]
                    """
                }
            }

            then {
                assert process.success
                assertAll(
                    { assert snapshot(
                        process.out
                    ).match() }
                )
            }

        }
}
