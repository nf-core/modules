nextflow_process {

    name "Test Process METAMAPS_MAPDIRECTLY"
    script "../main.nf"
    process "METAMAPS_MAPDIRECTLY"

    tag "modules"
    tag "modules_nfcore"
    tag "metamaps"
    tag "metamaps/mapdirectly"

    test("sarscov2_nanopore_mapdirectly") {
        def db
        setup {
            // params.modules_testdata_base_path is null outside the process string, so use the same env var and default as tests/config/nf-test.config
            def modules_testdata_base_path = System.getenv('NXF_MODULES_TESTDATA_BASE') ?: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
            db = extract(modules_testdata_base_path + 'genomics/sarscov2/genome/db/metamaps_db.tar.gz').resolve('metamaps_db')
        }

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/nanopore/fastq/test.fastq.gz', checkIfExists: true)
                ]
                input[1] = file('${db}')
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out, unstableKeys:["classification_res"])).match() }
            )
        }
    }

    test("sarscov2_nanopore_mapdirectly - stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/nanopore/fastq/test.fastq.gz', checkIfExists: true)
                ]
                input[1] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }
}
