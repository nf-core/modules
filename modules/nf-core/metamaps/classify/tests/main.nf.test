nextflow_process {

    name "Test Process METAMAPS_CLASSIFY"
    script "../main.nf"
    process "METAMAPS_CLASSIFY"

    tag "modules"
    tag "modules_nfcore"
    tag "metamaps"
    tag "metamaps/mapdirectly"
    tag "metamaps/classify"

    test("sarscov2_nanopore_classify") {
        def db
        setup {
            // params.modules_testdata_base_path is null outside the process string, so use the same env var and default as tests/config/nf-test.config
            def modules_testdata_base_path = System.getenv('NXF_MODULES_TESTDATA_BASE') ?: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
            db = extract(modules_testdata_base_path + 'genomics/sarscov2/genome/db/metamaps_db.tar.gz').resolve('metamaps_db')
            run("METAMAPS_MAPDIRECTLY") {
                script "../../../metamaps/mapdirectly/main.nf"
                process {
                    """
                    input[0] = [
                        [ id:'test' ],
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/nanopore/fastq/test_2.fastq.gz', checkIfExists: true)
                    ]
                    input[1] = file('${db}')
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = METAMAPS_MAPDIRECTLY.out.classification_res
                    .join(METAMAPS_MAPDIRECTLY.out.meta_file)
                    .join(METAMAPS_MAPDIRECTLY.out.meta_unmappedreadsLengths)
                    .join(METAMAPS_MAPDIRECTLY.out.para_file)
                input[1] = file('${db}')
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

    test("sarscov2_nanopore_classify - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'test' ], [], [], [], [] ]
                input[1] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }
}
