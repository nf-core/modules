nextflow_process {

    name "Test Process FAIRBIOHEADERS_VALIDATE"
    script "../main.nf"
    process "FAIRBIOHEADERS_VALIDATE"

    tag "modules"
    tag "modules_nfcore"
    tag "fairbioheaders"
    tag "fairbioheaders/validate"

    test("sarscov2 - fhr - yaml") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/fairbioheaders/genome.fhr.yaml', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.report[0][1]).readLines() == ['file: genome.fhr.yaml', 'FHR metadata is valid.'] },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

    test("sarscov2 - fhr - json") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/fairbioheaders/genome.fhr.json', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.report[0][1]).readLines() == ['file: genome.fhr.json', 'FHR metadata is valid.'] },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

    test("sarscov2 - fhp - yaml") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/fairbioheaders/proteome_test.fhp.yaml', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.report[0][1]).readLines() == ['file: proteome_test.fhp.yaml', 'FHP metadata is valid.'] },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

    test("candidatus_portiera_aleyrodidarum - fhgff3 - yaml") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/prokaryotes/candidatus_portiera_aleyrodidarum/genome/fairbioheaders/test1.fhgff3.yaml', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.report[0][1]).readLines() == ['file: test1.fhgff3.yaml', 'FHGFF3 metadata is valid.'] },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

    test("sarscov2 - fhr - yaml - missing required field - fails") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/fairbioheaders/genome.missing_genome.fhr.yaml', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert (process.stdout + process.stderr).any { line -> line.contains("'genome' is a required property") } }
            )
        }

    }

    test("sarscov2 - fhp - yaml - unsupported schema version - fails") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/fairbioheaders/proteome_test.unsupported_schema.fhp.yaml', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert (process.stdout + process.stderr).any { line -> line.contains("unsupported schema version") } }
            )
        }

    }

    test("sarscov2 - fhr - yaml - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/fairbioheaders/genome.fhr.yaml', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

}
