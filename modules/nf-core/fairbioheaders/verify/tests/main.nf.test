    test("candidatus_portiera_aleyrodidarum - gff3 - fhgff3") {

        setup {
            run("FAIRBIOHEADERS_COMBINE") {
                script "../../combine/main.nf"
                process {
                    """
                    input[0] = [
                        [ id:'test' ],
                        file(params.modules_testdata_base_path + 'genomics/prokaryotes/candidatus_portiera_aleyrodidarum/genome/fairbioheaders/test1.fhgff3.yaml', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/prokaryotes/candidatus_portiera_aleyrodidarum/genome/gff/test1.gff', checkIfExists: true)
                    ]
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = FAIRBIOHEADERS_COMBINE.out.sequence
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.report[0][1]).readLines() == ['file: test.gff', 'Checksum verified.'] },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

    test("sarscov2 - fasta - fhr - spaced names") {

        setup {
            run("FAIRBIOHEADERS_COMBINE") {
                script "../../combine/main.nf"
                process {
                    """
                    input[0] = [
                        [ id:'test' ],
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/fairbioheaders/genome.fhr.yaml', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                    ]
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = FAIRBIOHEADERS_COMBINE.out.sequence
                    .map { meta, fasta -> fasta.text }
                    .collectFile(name: 'test sample.fasta')
                    .map { fasta -> [ [ id:'test sample' ], fasta ] }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.report[0][1].endsWith('/test sample.verify.txt') },
                { assert path(process.out.report[0][1]).readLines() == ['file: test sample.fasta', 'Checksum verified.'] },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

    test("sarscov2 - fasta - fhr - changed after combine - fails") {

        setup {
            run("FAIRBIOHEADERS_COMBINE") {
                script "../../combine/main.nf"
                process {
                    """
                    input[0] = [
                        [ id:'test' ],
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/fairbioheaders/genome.fhr.yaml', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                    ]
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = FAIRBIOHEADERS_COMBINE.out.sequence
                    .map { meta, fasta -> fasta.text + '>extra\\nACGT\\n' }
                    .collectFile(name: 'changed.fhr.fasta')
                    .map { fasta -> [ [ id:'test' ], fasta ] }
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert (process.stdout + process.stderr).any { line -> line.contains('Checksum verification failed') } }
            )
        }

    }

    test("sarscov2 - fasta - no header - fails") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert (process.stdout + process.stderr).any { line -> line.contains('No ;~ FHR metadata header found') } }
            )
        }

    }

    test("sarscov2 - fasta - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

    test("sarscov2 - fasta - spaced names - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = channel.of(file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true).text)
                    .collectFile(name: 'test sample.fasta')
                    .map { fasta -> [ [ id:'test sample' ], fasta ] }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.report[0][1].endsWith('/test sample.verify.txt') },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

}
