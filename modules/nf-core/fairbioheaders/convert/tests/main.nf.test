                        file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.gz', checkIfExists: true)
                    ]
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = FAIRBIOHEADERS_COMBINE.out.sequence
                input[1] = 'yaml'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.metadata[0][1]).readLines().contains('checksum: y9Z0ZrzbkFheJkGACktCGI8+ZgD/tNbq56C3MbOEWyI=') },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

