nextflow_process {

    name "Test Process FAIRBIOHEADERS_CONVERT"
    script "../main.nf"
    process "FAIRBIOHEADERS_CONVERT"

    tag "modules"
    tag "modules_nfcore"
    tag "fairbioheaders"
    tag "fairbioheaders/convert"
    tag "fairbioheaders/combine"

    test("sarscov2 - fasta - fhr - yaml") {

        setup {
            run("FAIRBIOHEADERS_COMBINE") {
                script "../../combine/main.nf"
                process {
                    """
                    input[0] = [
                        [ id:'test' ],
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/fairbioheaders/genome.fhr.yaml', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                    ]
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = FAIRBIOHEADERS_COMBINE.out.sequence
                input[1] = 'yaml'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.metadata[0][1]).readLines().contains('checksum: y9Z0ZrzbkFheJkGACktCGI8+ZgD/tNbq56C3MbOEWyI=') },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

    test("sarscov2 - fasta.gz - fhr - yaml") {

        setup {
            run("FAIRBIOHEADERS_COMBINE") {
                script "../../combine/main.nf"
                process {
                    """
                    input[0] = [
                        [ id:'test' ],
