nextflow_process {

    name "Test Process FAIRBIOHEADERS_COMBINE"
    script "../main.nf"
    process "FAIRBIOHEADERS_COMBINE"

    tag "modules"
    tag "modules_nfcore"
    tag "fairbioheaders"
    tag "fairbioheaders/combine"

    // Minimal metadata of each header type; combine replaces the placeholder checksum.
    // The author is ORCID's documented example iD.
    def fhr = '''\
schema: https://w3id.org/fair-bioheaders/fhr/v0.4.0
schemaVersion: '2.0'
genome: SARS-CoV-2 test genome
taxon:
  name: Severe acute respiratory syndrome coronavirus 2
  uri: https://identifiers.org/taxonomy:2697049
version: '1'
metadataAuthor:
  - name: Josiah Carberry
    uri: https://orcid.org/0000-0002-1825-0097
assemblyAuthor:
  - name: Josiah Carberry
    uri: https://orcid.org/0000-0002-1825-0097
dateCreated: '2020-01-01'
masking: unknown
checksum: AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
'''

    def fhp = '''\
schema: https://w3id.org/fair-bioheaders/fhp/v0.4.0
schemaVersion: '1.0'
proteome: SARS-CoV-2 test proteome
sourceType: database
taxon:
  name: Severe acute respiratory syndrome coronavirus 2
  uri: https://identifiers.org/taxonomy:2697049
version: '1'
metadataAuthor:
  - name: Josiah Carberry
    uri: https://orcid.org/0000-0002-1825-0097
dateCreated: '2020-01-01'
checksum: AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
'''

    def fhgff3 = '''\
schema: https://w3id.org/fair-bioheaders/fhgff3/v0.4.0
schemaVersion: '1.0'
annotation: Candidatus Portiera aleyrodidarum test annotation
taxon:
  name: Candidatus Portiera aleyrodidarum
  uri: https://identifiers.org/taxonomy:235282
version: '1'
metadataAuthor:
  - name: Josiah Carberry
    uri: https://orcid.org/0000-0002-1825-0097
dateCreated: '2020-01-01'
derivedFrom:
  - headerType: FHR
    checksum: 8kMW7cFzWbKkOLt0tgS3srVGNuzqNuoGaVqAimI8A2c=
    relationship: annotates
checksum: AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
'''

    test("sarscov2 - fasta - fhr") {

        when {
            process {
                """
                input[0] = channel.of('''${fhr}''')
                    .collectFile(name: 'test.fhr.yaml')
                    .map { yaml -> [
                        [ id:'test' ],
                        yaml,
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                    ] }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert file(process.out.fasta[0][1]).name == 'test.fhr.fasta' },
                { assert path(process.out.fasta[0][1]).readLines()[0] == ';~schema: https://w3id.org/fair-bioheaders/fhr/v0.4.0' },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

    test("sarscov2 - fasta.gz - fhr") {

        when {
            process {
                """
                input[0] = channel.of('''${fhr}''')
                    .collectFile(name: 'test.fhr.yaml')
                    .map { yaml -> [
                        [ id:'test' ],
                        yaml,
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.gz', checkIfExists: true)
                    ] }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert file(process.out.fasta[0][1]).name == 'test.fhr.fasta.gz' },
                { assert path(process.out.fasta[0][1]).linesGzip[0] == ';~schema: https://w3id.org/fair-bioheaders/fhr/v0.4.0' },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

    test("sarscov2 - gfa - fhr") {

        when {
            process {
                """
                input[0] = channel.of('''${fhr}''')
                    .collectFile(name: 'test.fhr.yaml')
                    .map { yaml -> [
                        [ id:'test' ],
                        yaml,
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/gfa/assembly.gfa', checkIfExists: true)
                    ] }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.gfa[0][1]).readLines()[0] == '#~schema: https://w3id.org/fair-bioheaders/fhr/v0.4.0' },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

    test("sarscov2 - faa - fhp") {

        when {
            process {
                """
                input[0] = channel.of('''${fhp}''')
                    .collectFile(name: 'test.fhp.yaml')
                    .map { yaml -> [
                        [ id:'test' ],
                        yaml,
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/proteome_test.faa', checkIfExists: true)
                    ] }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert file(process.out.fasta[0][1]).name == 'test.fhp.fasta' },
                { assert path(process.out.fasta[0][1]).readLines()[0] == ';~schema: https://w3id.org/fair-bioheaders/fhp/v0.4.0' },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

    test("candidatus_portiera_aleyrodidarum - gff3 - fhgff3") {

        when {
            process {
                """
                input[0] = channel.of('''${fhgff3}''')
                    .collectFile(name: 'test.fhgff3.yaml')
                    .map { yaml -> [
                        [ id:'test' ],
                        yaml,
                        file(params.modules_testdata_base_path + 'genomics/prokaryotes/candidatus_portiera_aleyrodidarum/genome/gff/test1.gff', checkIfExists: true)
                    ] }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.gff3[0][1]).readLines()[0] == '##gff-version 3' },
                { assert path(process.out.gff3[0][1]).readLines()[1] == '#~schema: https://w3id.org/fair-bioheaders/fhgff3/v0.4.0' },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

    test("sarscov2 - gfa - fhp - fails") {

        when {
            process {
                """
                input[0] = channel.of('''${fhp}''')
                    .collectFile(name: 'test.fhp.yaml')
                    .map { yaml -> [
                        [ id:'test' ],
                        yaml,
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/gfa/assembly.gfa', checkIfExists: true)
                    ] }
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert (process.stdout + process.stderr).any { line -> line.contains('FHP metadata is incompatible with GFA') } }
            )
        }

    }

    test("sarscov2 - fai - unsupported extension - fails") {

        when {
            process {
                """
                input[0] = channel.of('''${fhr}''')
                    .collectFile(name: 'test.fhr.yaml')
                    .map { yaml -> [
                        [ id:'test' ],
                        yaml,
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.fai', checkIfExists: true)
                    ] }
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert (process.stdout + process.stderr).any { line -> line.contains('unsupported sequence file extension: genome.fasta.fai') } }
            )
        }

    }

    test("sarscov2 - fasta - fhr - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = channel.of('''${fhr}''')
                    .collectFile(name: 'test.fhr.yaml')
                    .map { yaml -> [
                        [ id:'test' ],
                        yaml,
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                    ] }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

    test("sarscov2 - fasta.gz - fhr - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = channel.of('''${fhr}''')
                    .collectFile(name: 'test.fhr.yaml')
                    .map { yaml -> [
                        [ id:'test' ],
                        yaml,
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.gz', checkIfExists: true)
                    ] }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

}
