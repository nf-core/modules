nextflow_process {

    name "Test Process FAIRBIOHEADERS_COMBINE"
    script "../main.nf"
    process "FAIRBIOHEADERS_COMBINE"

    tag "modules"
    tag "modules_nfcore"
    tag "fairbioheaders"
    tag "fairbioheaders/combine"

    test("sarscov2 - fasta - fhr") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/fairbioheaders/genome.fhr.yaml', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

    test("sarscov2 - fasta.gz - fhr") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/fairbioheaders/genome.fhr.yaml', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.gz', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

    test("sarscov2 - gfa - fhr") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/fairbioheaders/genome.fhr.yaml', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/gfa/assembly.gfa', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

    test("sarscov2 - faa - fhp") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/fairbioheaders/proteome_test.fhp.yaml', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/proteome_test.faa', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

    test("candidatus_portiera_aleyrodidarum - gff3 - fhgff3") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/prokaryotes/candidatus_portiera_aleyrodidarum/genome/fairbioheaders/test1.fhgff3.yaml', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/prokaryotes/candidatus_portiera_aleyrodidarum/genome/gff/test1.gff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

    test("sarscov2 - gfa - fhp - fails") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/fairbioheaders/proteome_test.fhp.yaml', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/gfa/assembly.gfa', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert (process.stdout + process.stderr).any { line -> line.contains('FHP metadata is incompatible with GFA') } }
            )
        }

    }

    test("sarscov2 - fasta - fhr - unsafe prefix - fails") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test\$(touch PWNED)' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/fairbioheaders/genome.fhr.yaml', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert (process.stdout + process.stderr).any { line -> line.contains("Unsafe output name") } }
            )
        }

    }

    test("sarscov2 - fasta - fhr - unsafe extension - fails") {

        when {
            process {
                """
                def fasta = workflow.workDir.resolve('genome.\$(touch PWNED)')
                fasta.text = file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true).text
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/fairbioheaders/genome.fhr.yaml', checkIfExists: true),
                    fasta
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert (process.stdout + process.stderr).any { line -> line.contains("Unsafe output name") } }
            )
        }

    }

    test("sarscov2 - fasta - fhr - ids with brackets and non-ASCII letters") {

        when {
            process {
                """
                input[0] = channel.of(
                    [ [ id:'sample(1)' ], file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/fairbioheaders/genome.fhr.yaml', checkIfExists: true), file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true) ],
                    [ [ id:'Müller_01' ], file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/fairbioheaders/genome.fhr.yaml', checkIfExists: true), file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true) ]
                )
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.sequence.collect { meta, sequence -> file(sequence).name }.sort() == [ 'Müller_01.fasta', 'sample(1).fasta' ] }
            )
        }

    }

    test("sarscov2 - fasta - fhr - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/fairbioheaders/genome.fhr.yaml', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

    test("sarscov2 - fasta.gz - fhr - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/fairbioheaders/genome.fhr.yaml', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.gz', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

    test("sarscov2 - fasta - fhr - unsafe prefix - fails - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test\$(touch PWNED)' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/fairbioheaders/genome.fhr.yaml', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert (process.stdout + process.stderr).any { line -> line.contains("Unsafe output name") } }
            )
        }

    }

    test("sarscov2 - fasta - fhr - unsafe extension - fails - stub") {

        options "-stub"

        when {
            process {
                """
                def fasta = workflow.workDir.resolve('genome.\$(touch PWNED)')
                fasta.text = file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true).text
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/fairbioheaders/genome.fhr.yaml', checkIfExists: true),
                    fasta
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert (process.stdout + process.stderr).any { line -> line.contains("Unsafe output name") } }
            )
        }

    }

}
