nextflow_process {

    name "Test Process AGAT_SPFILTERFEATUREFROMKILLLIST"
    script "../main.nf"
    process "AGAT_SPFILTERFEATUREFROMKILLLIST"

    tag "modules"
    tag "modules_nfcore"
    tag "agat"
    tag "agat/spfilterfeaturefromkilllist"

    test("sarscov2 - gff3") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.gff3', checkIfExists: true)
                ]

                input[1] = channel.of("unknown_transcript_1").collectFile(name: 'kill.list.txt')

                input[2] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

    test("sarscov2 - gff3 - config") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.gff3', checkIfExists: true)
                ]

                input[1] = channel.of("unknown_transcript_1").collectFile(name: 'kill.list.txt')

                input[2] = file('https://raw.githubusercontent.com/NBISweden/AGAT/refs/tags/v1.6.1/share/agat_config.yaml', checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

    test("sarscov2 - gff3 - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.gff3', checkIfExists: true)
                ]

                input[1] = channel.of("unknown_transcript_1").collectFile(name: 'kill.list.txt')

                input[2] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

}
