nextflow_process {

    name "Test Process AMULETY_ANTIBERTY"
    script "../main.nf"
    process "AMULETY_ANTIBERTY"

    tag "modules"
    tag "modules_nfcore"
    tag "amulety"
    tag "amulety/antiberty"

    test("deprecated") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ], file('tsv') ]
                input[1] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("WARNING: This module has been deprecated.") }
            )
        }
    }
}
