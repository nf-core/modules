nextflow_process {

    name "Test Process INSITUGAME"
    script "../main.nf"
    process "INSITUGAME"

    tag "modules"
    tag "modules_nfcore"
    tag "insitugame"

    test("spatial - tsv") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + "spatial_omics/insitugame/insitugame.tsv", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            def results = new groovy.json.JsonSlurper().parse(file(process.out.results[0][1]))
            def table = file(process.out.tables[0][1]).readLines()
            assertAll(
                { assert results.status == "completed" },
                { assert results.payoff_matrix_3x3.size() == 3 },
                { assert results.payoff_matrix_3x3.every { it.size() == 3 } },
                { assert results.payoff_matrix_3x3.flatten().every { it instanceof Number } },
                { assert results.nash_game_type },
                { assert results.nash_equilibria },
                { assert results.diagnostic_metrics },
                { assert table[0] == "focal_phenotype,T_S,T_R,S_CAF" },
                { assert table.size() == 4 },
                { assert snapshot(sanitizeOutput(process.out)).match() },
            )
        }

    }

    test("spatial - tsv.gz") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test_gz' ],
                    file(params.modules_testdata_base_path + "spatial_omics/insitugame/insitugame.tsv.gz", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            def results = new groovy.json.JsonSlurper().parse(file(process.out.results[0][1]))
            def table = file(process.out.tables[0][1]).readLines()
            assertAll(
                { assert results.status == "completed" },
                { assert results.payoff_matrix_3x3.size() == 3 },
                { assert results.payoff_matrix_3x3.every { it.size() == 3 } },
                { assert results.payoff_matrix_3x3.flatten().every { it instanceof Number } },
                { assert results.nash_game_type },
                { assert results.nash_equilibria },
                { assert results.diagnostic_metrics },
                { assert table[0] == "focal_phenotype,T_S,T_R,S_CAF" },
                { assert table.size() == 4 },
                { assert snapshot(sanitizeOutput(process.out)).match() },
            )
        }

    }

    test("spatial - tsv - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + "spatial_omics/insitugame/insitugame.tsv", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

}
