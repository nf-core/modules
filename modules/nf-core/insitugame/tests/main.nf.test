nextflow_process {

    name "Test Process INSITUGAME"
    script "../main.nf"
    process "INSITUGAME"

    tag "modules"
    tag "modules_nfcore"
    tag "insitugame"

    test("spatial - tsv") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'generic/tsv/expression.tsv', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out.results,
                    process.out.tables,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("spatial - tsv - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'generic/tsv/expression.tsv', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
