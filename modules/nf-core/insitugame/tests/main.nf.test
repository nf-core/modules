nextflow_process {

    name "Test Process INSITUGAME"
    script "../main.nf"
    process "INSITUGAME"

    tag "modules"
    tag "modules_nfcore"
    tag "insitugame"

    test("spatial - tsv") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + "spatial_omics/insitugame/insitugame.tsv", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            def outputs = [
                results: process.out.results.collect { meta, output_file -> [meta, file(output_file).name] },
                tables: process.out.tables.collect { meta, output_file -> [meta, file(output_file).name] },
                versions_insitugame: process.out.versions_insitugame,
            ]
            assertAll(
                { assert snapshot(outputs).match() },
            )
        }

    }

    test("spatial - tsv.gz") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test_gz' ],
                    file(params.modules_testdata_base_path + "spatial_omics/insitugame/insitugame.tsv.gz", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            def outputs = [
                results: process.out.results.collect { meta, output_file -> [meta, file(output_file).name] },
                tables: process.out.tables.collect { meta, output_file -> [meta, file(output_file).name] },
                versions_insitugame: process.out.versions_insitugame,
            ]
            assertAll(
                { assert snapshot(outputs).match() },
            )
        }

    }

    test("spatial - csv") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test_csv' ],
                    file(params.modules_testdata_base_path + "spatial_omics/insitugame/insitugame.csv", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            def outputs = [
                results: process.out.results.collect { meta, output_file -> [meta, file(output_file).name] },
                tables: process.out.tables.collect { meta, output_file -> [meta, file(output_file).name] },
                versions_insitugame: process.out.versions_insitugame,
            ]
            assertAll(
                { assert snapshot(outputs).match() },
            )
        }

    }

    test("spatial - tsv - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + "spatial_omics/insitugame/insitugame.tsv", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            def outputs = [
                results: process.out.results.collect { meta, output_file -> [meta, file(output_file).name] },
                tables: process.out.tables.collect { meta, output_file -> [meta, file(output_file).name] },
                versions_insitugame: process.out.versions_insitugame,
            ]
            assertAll(
                { assert snapshot(outputs).match() }
            )
        }

    }

}
