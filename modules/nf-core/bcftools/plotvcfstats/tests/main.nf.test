nextflow_process {

    name "Test Process BCFTOOLS_PLOTVCFSTATS"
    script "../main.nf"
    process "BCFTOOLS_PLOTVCFSTATS"

    tag "modules"
    tag "modules_nfcore"
    tag "bcftools"
    tag "bcftools/plotvcfstats"
    tag "bcftools/stats"

    setup {

        run("BCFTOOLS_STATS") {
            script "../../stats/main.nf"
            process {
                """
                input[0] = [
                    [ id: "test" ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test.vcf.gz', checkIfExists: true), []]
                input[1] = [[:],[]]
                input[2] = [[:],[]]
                input[3] = [[:],[]]
                input[4] = [[:],[]]
                input[5] = [[:],[]]
                """
            }
        }
    }


    test("sarscov2 - bcftools") {

        when {
            process {
                """
                input[0] = BCFTOOLS_STATS.out.stats
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ['plot_pdf', 'images_pdf', 'images_png'], unstablePatterns:["**/*.log", "**/*.pdf"])).match() }
            )
        }

    }


    test("sarscov2 - bcftools - only individual pdf") {
        config "./individual_pdf.config"

        when {
            process {
                """
                input[0] = BCFTOOLS_STATS.out.stats
                """
            }

        }


        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ['plot_pdf', 'images_pdf', 'images_png'], unstablePatterns:["**/*.log", "**/*.pdf"])).match() }
            )
        }
    }

    test("sarscov2 - bcftools - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = BCFTOOLS_STATS.out.stats
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
