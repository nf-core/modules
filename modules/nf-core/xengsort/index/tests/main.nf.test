nextflow_process {

    name "Test Process XENGSORT_INDEX"
    script "../main.nf"
    process "XENGSORT_INDEX"
    config "./nextflow.config"

    tag "modules"
    tag "modules_nfcore"
    tag "xengsort"
    tag "xengsort/index"

    test("homo_sapiens - sarscov2 - default") {

        when {
            params {
                module_args = '-k 25'
            }
            process {
                """
                input[0] = [
                    [ id:'host' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true)
                ]
                input[1] = [
                    [ id:'graft' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                ]
                input[2] = 1000000
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ["hash", "info"])).match() }
            )
        }

    }

    test("homo_sapiens - sarscov2 - bisulfite") {

        when {
            params {
                module_args = '-k 25 --bisulfite'
            }
            process {
                """
                input[0] = [
                    [ id:'host' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true)
                ]
                input[1] = [
                    [ id:'graft' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                ]
                input[2] = 2000000
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ["hash", "info"])).match() }
            )
        }

    }

    test("homo_sapiens - sarscov2 - stub") {

        options "-stub"

        when {
            params {
                module_args = '-k 25'
            }
            process {
                """
                input[0] = [
                    [ id:'host' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true)
                ]
                input[1] = [
                    [ id:'graft' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                ]
                input[2] = 10000
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

}
