nextflow_process {

    name "Test Process HMTNOTE_ANNOTATE"
    script "../main.nf"
    process "HMTNOTE_ANNOTATE"

    tag "modules"
    tag "modules_nfcore"
    tag "hmtnote"
    tag "hmtnote/annotate"

    test("deprecated") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ], file('vcf') ]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("WARNING: This module has been deprecated.") }
            )
        }
    }
}
