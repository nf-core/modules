nextflow_process {

    name "Test Process MULTIQCSAV"
    script "../main.nf"
    process "MULTIQCSAV"

    tag "modules"
    tag "modules_nfcore"
    tag "multiqcsav"

    config "./nextflow.config"

    test("NovaSeq6000") {
        def run_dir
        setup {
            // params.modules_testdata_base_path is null outside the process string, so use the same env var and default as tests/config/nf-test.config
            def modules_testdata_base_path = System.getenv('NXF_MODULES_TESTDATA_BASE') ?: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
            run_dir = extract(modules_testdata_base_path + 'genomics/sarscov2/illumina/bcl/200624_A00834_0183_BHMTFYDRXX.tar.gz').resolve('200624_A00834_0183_BHMTFYDRXX')
        }

        when {
            process {
                """
                ch_sav_in = Channel.of([ [ id: 'NovaSeq6000' ], file('${run_dir}') ]).map{ meta, untar ->

                    def xml = []
                    untar.eachFileRecurse { file ->
                        if (file.fileName.toString() == 'RunInfo.xml') {
                            xml << file
                        }
                    }

                    def interop = []
                    untar.eachFileRecurse { file ->
                        if (file.parent.name == 'InterOp' && file.fileName.toString().endsWith(".bin")) {
                            interop << file
                        }
                    }

                    return [
                        meta,
                        xml,
                        interop,
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastqc/test_fastqc.zip', checkIfExists: true),
                        file("https://raw.githubusercontent.com/nf-core/seqinspector/1.0.0/assets/multiqc_config.yml", checkIfExists: true),
                        [],
                        [],
                        []
                    ]
                }

                input[0] = ch_sav_in
                """
            }
        }

        then {
            assert process.success
            assert snapshot(
                sanitizeOutput(process.out).collectEntries { key, val ->
                        // sanitizeOutput already expanded the data and plots directories into file lists
                        if (key == "data") {
                            return [key, val.collect { [it[1].collect { file(it.toString()).name }] }]
                        }
                        else if (key == "plots") {
                            return [key, val.collect { meta, plots -> ["pdf", "png", "svg"].collectMany { ext ->
                                [ext, plots.flatten().findAll { file(it.toString()).parentFile.name == ext }.collect { file(it.toString()).name }]
                            } }]
                        }
                        else if (key == "report") {
                            return [key, file(val[0][1].toString()).name]
                        }
                        return [key, val]
                    }
            ).match()
        }
    }

    test("NovaSeq6000 - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                        [id:'stub'],
                        [],
                        [],
                        [],
                        [],
                        [],
                        [],
                        []
                    ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }
}
