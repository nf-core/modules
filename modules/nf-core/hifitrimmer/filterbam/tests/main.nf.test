nextflow_process {

    name "Test Process HIFITRIMMER_FILTERBAM"
    script "../main.nf"
    process "HIFITRIMMER_FILTERBAM"

    tag "modules"
    tag "modules_nfcore"
    tag "hifitrimmer"
    tag "hifitrimmer/filterbam"

    test("deprecated") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ], file('input'), file('bed') ]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("WARNING: This module has been deprecated.") }
            )
        }
    }
}
