nextflow_process {


    name "Test Process HIFITRIMMER_TRIM"
    script "../main.nf"
    process "HIFITRIMMER_TRIM"

    tag "modules"
    tag "modules_nfcore"
    tag "hifitrimmer"
    tag "hifitrimmer/trim"

    config './nextflow.config'

    test("hifi_trimmer trim test - input bam - output cram") {

        when {
            params {
                trim_args    = "-f cram"
            }
            process {
                """
                input[0] = Channel.of(
                    [
                        [ id:'test_bam' ], // meta map
                        file(params.modules_testdata_base_path + '/genomics/eukaryotes/Pipistrellus_nathusii/genome/test.bam', checkIfExists: true),
                        file(params.modules_testdata_base_path + '/delete_me/hifitrimmer/test.bed.gz', checkIfExists: true)
                    ]
                )
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    bam(process.out.cram.get(0).get(1), stringency: "silent").getReadsMD5(),
                    process.out.findAll { key, val -> key.startsWith("versions") }
                    ).match()
                }
            )
        }
    }

    test("hifi_trimmer trim test - input bam - output sam") {

        when {
            params {
                trim_args    = "-f sam"
            }
            process {
                """
                input[0] = Channel.of(
                    [
                        [ id:'test_bam' ], // meta map
                        file(params.modules_testdata_base_path + '/genomics/eukaryotes/Pipistrellus_nathusii/genome/test.bam', checkIfExists: true),
                        file(params.modules_testdata_base_path + '/delete_me/hifitrimmer/test.bed.gz', checkIfExists: true)
                    ]
