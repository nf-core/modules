nextflow_process {

    name "Test Process DEEPTOOLS_COMPUTEMATRIXOPERATIONS"
    script "../main.nf"
    process "DEEPTOOLS_COMPUTEMATRIXOPERATIONS"
    config "./nextflow.config"

    tag "modules"
    tag "modules_nfcore"
    tag "deeptools"
    tag "deeptools/computematrix"
    tag "deeptools/computematrixoperations"


    test("sarscov2 - mat - filterStrand") {

        when {

            params {
                module_args  = "filterStrand"
                module_args2 = "--strand +"
            }

            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/deeptools/test.computeMatrix.mat.gz', checkIfExists: true),
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

    test("sarscov2 - mat - filterStrand - stub") {

        options "-stub"

        when {

            params {
                module_args = "filterStrand"
                module_args2 = "--strand +"
            }

            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/deeptools/test.computeMatrix.mat.gz', checkIfExists: true),
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

}
