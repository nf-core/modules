    test("sarscov2 - fastq - single-end - input named as output") {

        setup {
            run("DEACON_INDEX") {
                script "../../index/main.nf"
                process {
                    """
                    input[0] = [
                        [ id:'test', single_end:true ],
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                    ]
                    """
                }
            }
        }

        when {
            process {
                """
                filter_fastq_ch = channel.of('reads')
                    .collectFile(name: 'test.fq.gz')
                    .map { reads -> [ [ id:'test', single_end:true ], reads ] }
                input[0] = DEACON_INDEX.out.index.join(filter_fastq_ch)
                """
            }
        }

        then {
            assert process.failed
            assertAll(
                { assert process.errorReport.contains("Input and output names are the same") }
            )
        }

    }

    test("sarscov2 - fastq - paired-end - input named as output") {

        setup {
            run("DEACON_INDEX") {
                script "../../index/main.nf"
                process {
                    """
                    input[0] = [
                        [ id:'test', single_end:false ], // single_end:false to join paired reads channel
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                    ]
                    """
                }
            }
        }

        when {
            process {
                """
                filter_fastq_ch = channel.of('reads')
                    .collectFile(name: 'test_1.fq.gz')
                    .combine(channel.of('reads').collectFile(name: 'test_2.fq.gz'))
                    .map { reads_1, reads_2 -> [ [ id:'test', single_end:false ], [ reads_1, reads_2 ] ] }
                input[0] = DEACON_INDEX.out.index.join(filter_fastq_ch)
                """
            }
        }

        then {
            assert process.failed
            assertAll(
                { assert process.errorReport.contains("Input and output names are the same") }
            )
        }

    }

