nextflow_process {

    name "Test Process DEACON_INDEXUNION"
    script "../main.nf"
    process "DEACON_INDEXUNION"

    tag "modules"
    tag "modules_nfcore"
    tag "deacon"
    tag "deacon/index"
    tag "deacon/indexunion"

    setup {
        run("DEACON_INDEX", alias: "DEACON_INDEX_1") {
            script "../../index/main.nf"
            process {
                """
                input[0] = [
                    [ id:'test-1' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                ]
                """
            }
        }

        run("DEACON_INDEX", alias: "DEACON_INDEX_2") {
            script "../../index/main.nf"
            process {
                """
                input[0] = [
                    [ id:'test-2' ],
                    file(params.modules_testdata_base_path + 'genomics/prokaryotes/escherichia_coli/genome/genome.fa.gz', checkIfExists: true)
                ]
                """
            }
        }

        run("DEACON_INDEX", alias: "DEACON_INDEX_3") {
            script "../../index/main.nf"
            process {
                """
                input[0] = [
                    [ id:'test-3' ],
                    file(params.modules_testdata_base_path + 'genomics/prokaryotes/plasmids/pUTI89/pUTI89.fna.gz', checkIfExists: true)
                ]
                """
            }
        }
    }

    test("sarscov2, escherichia_coli - 2 indexes") {

        when {
            process {
                """
                input[0] = DEACON_INDEX_1.out.index.map { meta, idx -> [[id: 'test-union'], idx] }
                    .mix(DEACON_INDEX_2.out.index.map { meta, idx -> [[id: 'test-union'], idx] })
                    .groupTuple()
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }

    test("sarscov2, escherichia_coli, plasmid - 3 indexes") {

        when {
            process {
                """
                input[0] = DEACON_INDEX_1.out.index.map { meta, idx -> [[id: 'test-union'], idx] }
                    .mix(DEACON_INDEX_2.out.index.map { meta, idx -> [[id: 'test-union'], idx] })
                    .mix(DEACON_INDEX_3.out.index.map { meta, idx -> [[id: 'test-union'], idx] })
                    .groupTuple()
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }

    test("index union - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test-union' ],
                    [
                        file('index1.idx'),
                        file('index2.idx')
                    ]
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }
}
