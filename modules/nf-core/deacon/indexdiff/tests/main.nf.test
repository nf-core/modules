nextflow_process {

    name "Test Process DEACON_INDEXDIFF"
    script "../main.nf"
    process "DEACON_INDEXDIFF"

    tag "modules"
    tag "modules_nfcore"
    tag "deacon"
    tag "deacon/index"
    tag "deacon/indexdiff"

    test("sarscov2 - genome index - transcriptome fasta") {

        setup {
            run("DEACON_INDEX") {
                script "../../index/main.nf"
                process {
                    """
                    input[0] = [
                        [ id:'test' ],
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                    ]
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = DEACON_INDEX.out.index
                input[1] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/transcriptome.fasta', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

    test("sarscov2 - contigs index - genome fasta gzipped") {

        setup {
            run("DEACON_INDEX") {
                script "../../index/main.nf"
                process {
                    """
                    input[0] = [
                        [ id:'test' ],
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fasta/contigs.fasta', checkIfExists: true)
                    ]
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = DEACON_INDEX.out.index
                input[1] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.gz', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

    test("homo_sapiens - genome index - transcriptome index") {

        setup {
            run("DEACON_INDEX", alias: "DEACON_INDEX_1") {
                script "../../index/main.nf"
                process {
                    """
                    input[0] = [
                        [ id:'test-idx' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true)
                    ]
                    """
                }
            }

            run("DEACON_INDEX", alias: "DEACON_INDEX_2") {
                script "../../index/main.nf"
                process {
                    """
                    input[0] = [
                        [ id:'test-diff' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/transcriptome.fasta', checkIfExists: true)
                    ]
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = DEACON_INDEX_1.out.index
                input[1] = DEACON_INDEX_2.out.index
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

    test("sarscov2 - genome index - transcriptome fasta - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test-index' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                ]
                input[1] = [
                    [ id:'test-diff' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/transcriptome.fasta', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }
}
