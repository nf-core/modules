nextflow_process {

    name "Test Process CELLTYPIST"
    script "../main.nf"
    config "./nextflow.config"
    process "CELLTYPIST"

    tag "modules"
    tag "modules_nfcore"
    tag "celltypist"

    test("homo sapiens - pbmc3k - h5ad") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/pbmc3k_celltypist_query.h5ad', checkIfExists: true),
                    [],
                    [],
                    []
                ]
                input[1] = [
                    [ id:'pbmc3k_model' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/celltypist/pbmc3k_celltypist_model.pkl', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    sanitizeOutput(process.out, unstableKeys: ["predicted_labels", "decision_matrix", "probability_matrix"]),
                    ["predicted_labels", "decision_matrix", "probability_matrix"].collect { ch -> new File(process.out[ch][0][1].toString()).readLines().size() }
                ).match() }
            )
        }

    }

    test("homo sapiens - pbmc3k - h5ad - over-clustering and majority voting") {

        when {
            params {
                module_args = '--majority-voting'
            }
            process {
                """
                def clusters = file("\${launchDir}/over_clustering.txt")
                clusters.text = (0..<300).collect { i -> "cluster" + (i % 5) }.join("\\n") + "\\n"

                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/pbmc3k_celltypist_query.h5ad', checkIfExists: true),
                    clusters,
                    [],
                    []
                ]
                input[1] = [
                    [ id:'pbmc3k_model' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/celltypist/pbmc3k_celltypist_model.pkl', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    sanitizeOutput(process.out, unstableKeys: ["predicted_labels", "decision_matrix", "probability_matrix"]),
                    ["predicted_labels", "decision_matrix", "probability_matrix"].collect { ch -> new File(process.out[ch][0][1].toString()).readLines().size() }
                ).match() }
            )
        }

    }

    test("homo sapiens - pbmc3k - h5ad - xlsx and plots") {

        when {
            params {
                module_args = '--xlsx --plot-results'
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/pbmc3k_celltypist_query.h5ad', checkIfExists: true),
                    [],
                    [],
                    []
                ]
                input[1] = [
                    [ id:'pbmc3k_model' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/celltypist/pbmc3k_celltypist_model.pkl', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert process.out.xlsx.size() == 1 },
                { assert process.out.plots[0][1].size() >= 1 },
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ["xlsx", "plots"])).match() }
            )
        }

    }

    test("homo sapiens - pbmc3k - h5ad - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/pbmc3k_celltypist_query.h5ad', checkIfExists: true),
                    [],
                    [],
                    []
                ]
                input[1] = [
                    [ id:'pbmc3k_model' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/celltypist/pbmc3k_celltypist_model.pkl', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assert snapshot(sanitizeOutput(process.out)).match()
        }

    }

}
