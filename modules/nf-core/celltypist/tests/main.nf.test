nextflow_process {

    name "Test Process CELLTYPIST"
    script "../main.nf"
    process "CELLTYPIST"

    tag "modules"
    tag "modules_nfcore"
    tag "celltypist"

    test("homo sapiens - pbmc3k - h5ad") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/pbmc3k_celltypist_query.h5ad', checkIfExists: true)
                ]
                input[1] = [
                    [ id:'pbmc3k_model' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/celltypist/pbmc3k_celltypist_model.pkl', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                // One header line plus one line per cell (300 cells in the query file).
                // The scores are floating point values that can differ in the last digits
                // between platforms, so the content is not compared by checksum.
                { assert new File(process.out.predicted_labels[0][1].toString()).readLines().size() == 301 },
                { assert new File(process.out.decision_matrix[0][1].toString()).readLines().size() == 301 },
                { assert new File(process.out.probability_matrix[0][1].toString()).readLines().size() == 301 },
                { assert snapshot(process.out.versions_celltypist).match() }
            )
        }

    }

    test("homo sapiens - pbmc3k - h5ad - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/pbmc3k_celltypist_query.h5ad', checkIfExists: true)
                ]
                input[1] = [
                    [ id:'pbmc3k_model' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/celltypist/pbmc3k_celltypist_model.pkl', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

}
