nextflow_process {

    name "Test Process RUNDBCAN_CAZYMEANNOTATION"
    script "../main.nf"
    process "RUNDBCAN_CAZYMEANNOTATION"

    tag "modules"
    tag "modules_nfcore"
    tag "rundbcan"
    tag "rundbcan/cazymeannotation"
    tag "untar"

    test("bacteroides_fragilis - faa") {

        setup {
            run("UNTAR") {
                script "../../../untar/main.nf"
                process {
                    """
                    input[0] = [
                        [],
                        file(params.modules_testdata_base_path + 'genomics/prokaryotes/bacteroides_fragilis/genome/db/dbcan.tar.gz', checkIfExists: true)
                    ]
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = [
                    [id:'test'],
                    file(params.modules_testdata_base_path + 'genomics/prokaryotes/bacteroides_fragilis/genome/region_2500000-3000000.faa.gz', checkIfExists: true)
                ]
                input[1] = UNTAR.out.untar.map { _meta, db -> db }
                """
            }
        }

        then {
            def overview = path(process.out.cazyme_annotation[0][1]).readLines()
            assertAll(
                { assert process.success },
                { assert overview.size() == 58 },
                { assert overview.any { it.startsWith('WP_005784055.1\t') && it.endsWith('\tGH127_e5\tpectin') } },
                { assert path(process.out.dbcanhmm_results[0][1]).text.contains('GH76') },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }

    test("bacteroides_fragilis - faa - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [[id: 'stub'], file('stub')]
                input[1] = file('stub_db')
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }
}
