nextflow_process {

    name "Test Process RUNDBCAN_CAZYMEANNOTATION"
    script "../main.nf"
    process "RUNDBCAN_CAZYMEANNOTATION"

    tag "modules"
    tag "modules_nfcore"
    tag "rundbcan"
    tag "rundbcan/cazymeannotation"

    test("bacteroides_fragilis - faa") {

        def dbcan_db
        setup {
            // params.modules_testdata_base_path is null outside the process string, so use the same env var and default as tests/config/nf-test.config
            def modules_testdata_base_path = System.getenv('NXF_MODULES_TESTDATA_BASE') ?: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
            dbcan_db = extract(modules_testdata_base_path + 'genomics/prokaryotes/bacteroides_fragilis/genome/db/dbcan.tar.gz').resolve('dbcan_db')
        }

        when {
            process {
                """
                input[0] = [
                    [id:'test'],
                    file(params.modules_testdata_base_path + 'genomics/prokaryotes/bacteroides_fragilis/genome/region_2500000-3000000.faa.gz', checkIfExists: true)
                ]
                input[1] = file('${dbcan_db}')
                """
            }
        }

        then {
            def overview = path(process.out.cazyme_annotation[0][1]).readLines()
            assertAll(
                { assert process.success },
                { assert overview.size() == 58 },
                { assert overview.any { it.startsWith('WP_005784055.1\t') && it.endsWith('\tGH127_e5\tpectin') } },
                { assert path(process.out.dbcanhmm_results[0][1]).text.contains('GH76') },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }

    test("bacteroides_fragilis - faa - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [[id: 'stub'], file('stub')]
                input[1] = file('stub_db')
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }
}
