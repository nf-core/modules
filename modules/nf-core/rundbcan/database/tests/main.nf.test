nextflow_process {

    name "Test Process RUNDBCAN_DATABASE"
    script "../main.nf"
    process "RUNDBCAN_DATABASE"

    tag "modules"
    tag "modules_nfcore"
    tag "rundbcan"
    tag "rundbcan/database"

    test("rundbcan - database - basic") {

        when {
            process {
                """
                """
            }
        }

        then {
            assert process.success
            assert path(process.out.dbcan_db.get(0)).exists()
            // Keep in sync with the mini database the annotation module tests untar
            assert new File(process.out.dbcan_db.get(0).toString()).list().toList().sort() == [
                'CAZy.dmnd', 'PUL.dmnd', 'STP.hmm', 'TCDB.dmnd', 'TF.dmnd', 'TF.hmm',
                'dbCAN-PUL', 'dbCAN-PUL.xlsx', 'dbCAN-sub.hmm', 'dbCAN.hmm',
                'fam-substrate-mapping.tsv', 'peptidase_db.dmnd', 'sulfatlas_db.dmnd'
            ]
            assertAll(
                { assert snapshot(
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }
    }

    test("rundbcan - database - stub") {

        options "-stub"

        when {
            process {
                """
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    file(process.out.dbcan_db.get(0)).name,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }
    }
}
