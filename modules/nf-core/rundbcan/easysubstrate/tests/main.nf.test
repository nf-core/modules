nextflow_process {

    name "Test Process RUNDBCAN_EASYSUBSTRATE"
    script "../main.nf"
    process "RUNDBCAN_EASYSUBSTRATE"

    tag "modules"
    tag "modules_nfcore"
    tag "rundbcan"
    tag "rundbcan/easysubstrate"
    tag "untar"

    test("bacteroides_fragilis - faa, gff") {

        setup {
            run("UNTAR") {
                script "../../../untar/main.nf"
                process {
                    """
                    input[0] = [
                        [],
                        file(params.modules_testdata_base_path + 'genomics/prokaryotes/bacteroides_fragilis/genome/db/dbcan.tar.gz', checkIfExists: true)
                    ]
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = [
                    [id:'test'],
                    file(params.modules_testdata_base_path + 'genomics/prokaryotes/bacteroides_fragilis/genome/region_2500000-3000000.faa.gz', checkIfExists: true)
                ]
                input[1] = [
                    [id:'test'],
                    file(params.modules_testdata_base_path + 'genomics/prokaryotes/bacteroides_fragilis/genome/region_2500000-3000000.gff', checkIfExists: true),
                    'NCBI_prok'
                ]
                input[2] = UNTAR.out.untar.map { _meta, db -> db }
                """
            }
        }

        then {
            def substrates = path(process.out.substrate_prediction[0][1]).readLines()
            def cgc_faa = path(process.out.cgc_faa[0][1]).readLines()
            def pul_blast = path(process.out.pul_blast[0][1]).readLines()
            def tf_diamond = path(process.out.diamond_out_tf[0][1]).readLines()
            def peptidase = path(process.out.diamond_out_peptidase[0][1]).readLines()
            def sulfatase = path(process.out.diamond_out_sulfatase[0][1]).readLines()
            assertAll(
                { assert process.success },
                { assert substrates.size() == 11 },
                { assert substrates.any { it.startsWith('NZ_CP069563.1|CGC10\tPUL0420\tpectin\t') } },
                { assert substrates.any { it.startsWith('NZ_CP069563.1|CGC14\tPUL0328\txylan\t') } },
                { assert cgc_faa.count { it.startsWith('>') } == 122 },
                { assert cgc_faa.contains('>NZ_CP069563.1|CGC1|WP_005784783.1|TC|8.A.46 WP_005784783.1') },
                { assert pul_blast.size() == 992 },
                { assert pul_blast.any { it.startsWith('NZ_CP069563.1|CGC1|WP_005784783.1|TC|8.A.46\tPUL0467_8:PUL0467:AAO76737.1:TC:8.A.46.3.4\t') } },
                { assert tf_diamond.any { it.startsWith('ARGR_PSEAE\t329\tWP_005813432.1\t335\t') } },
                { assert peptidase.any { it.startsWith('M28.UPA\t225\tWP_008769399.1\t333\t') } },
                { assert sulfatase.any { it.startsWith('S1_27\t4331\tWP_008769404.1\t1061\t') } },
                // run_dbcan writes substrate predictions in varying row order
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ['substrate_prediction', 'synteny_pdf']), substrates.sort(false)).match() }
            )
        }
    }

    test("bacteroides_fragilis - faa, gff - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [[id: 'stub'], file('stub')]
                input[1] = [[id: 'stub'], file('stub.gff'), 'NCBI_prok']
                input[2] = file('stub_db')
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }
}
