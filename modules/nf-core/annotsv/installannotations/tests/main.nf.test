nextflow_process {

    name "Test Process ANNOTSV_INSTALLANNOTATIONS"
    script "../main.nf"
    process "ANNOTSV_INSTALLANNOTATIONS"

    tag "modules"
    tag "modules_nfcore"
    tag "annotsv"
    tag "annotsv/installannotations"

    test("both versions supplied - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    3.5,
                    2406
                ]
                """
            }
        }

        then {
            assert process.success
            assert snapshot(sanitizeOutput(process.out)).match()
        }

    }

        test("both versions empty - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    null,
                    null
                ]
                """
            }
        }

        then {
            assert process.success
            assert snapshot(sanitizeOutput(process.out)).match()
        }

    }

    test("annotsv version empty - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    null,
                    2406
                ]
                """
            }
        }

        then {
            assert process.failed
        }

    }

    test("exomiser version empty - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    3.5,
                    null
                ]
                """
            }
        }

        then {
            assert process.failed
        }

    }

}
