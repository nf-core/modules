nextflow_process {

    config "./nextflow.config"

    name "Test Process ANNOTSV_ANNOTSV"
    script "../main.nf"
    process "ANNOTSV_ANNOTSV"

    tag "modules"
    tag "modules_nfcore"
    tag "annotsv"
    tag "annotsv/annotsv"

    test("homo_sapiens - empty sv_vcf, annotations") {

        when {
            process {
                """
                // AnnotSV stops before it reads the annotations when the VCF has no records, so an empty directory is enough
                def annotations = file("${workDir}/annotations")
                annotations.mkdirs()
                input[0] = Channel.of(
                        '##fileformat=VCFv4.2',
                        '##contig=<ID=chr1,length=10000>',
                        '#CHROM\\tPOS\\tID\\tREF\\tALT\\tQUAL\\tFILTER\\tINFO'
                    )
                    .collectFile(name: 'empty.vcf', newLine: true, sort: false)
                    .map { [[ id:'test' ], it, [], []] }
                input[1] = [
                    [ id:'annotations' ],
                    annotations
                ]
                input[2] = [[],[]]
                input[3] = [[],[]]
                input[4] = [[],[]]
                """
            }
        }

        then {
            assert process.success
            assert snapshot(
                [
                    tsv: file(process.out.tsv[0][1]).name,
                    tsv_lines: path(process.out.tsv[0][1]).readLines().size(),
                    unannotated_tsv: process.out.unannotated_tsv,
                    vcf: process.out.vcf,
                    versions: process.out.versions_annotsv
                ]
            ).match()
        }

    }

    test("homo_sapiens - sv_vcf, sv_tbi, snv_vcf, annotations - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/illumina/vcf/sv_query.vcf.gz"),
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/illumina/vcf/sv_query.vcf.gz.tbi"),
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/illumina/gatk/haplotypecaller_calls/test2_haplotc.vcf.gz")
                ]
                input[1] = [
                    [ id:'annotations' ],
                    []
                ]
                input[2] = Channel.of('GENE1', 'GENE2', 'GENE3')
                    .collectFile(name:'gene_candidates.txt')
                    .map { [[ id:'genes' ], it] }
                input[3] = [
                    [ id:'false_positives' ],
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/illumina/gatk/haplotypecaller_calls/test_haplotcaller.cnn.vcf.gz")
                ]
                input[4] = Channel.of('GENE1 GENE2 GENE3')
                    .collectFile(name:'gene_transcripts.txt')
                    .map { [[ id:'gene_transcripts'], it] }
                """
            }
        }

        then {
            assert process.success
            assert snapshot(sanitizeOutput(process.out)).match()
        }

    }

}
