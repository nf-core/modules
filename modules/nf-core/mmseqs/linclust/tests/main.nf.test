nextflow_process {

    name "Test Process MMSEQS_LINCLUST"
    script "../main.nf"
    process "MMSEQS_LINCLUST"
    tag "modules"
    tag "modules_nfcore"
    tag "mmseqs"
    tag "mmseqs/linclust"

    test("Should cluster an mmseqs database") {

        config "./nextflow.config"

        def db
        setup {
            // params.modules_testdata_base_path is null outside the process string, so use the same env var and default as tests/config/nf-test.config
            def modules_testdata_base_path = System.getenv('NXF_MODULES_TESTDATA_BASE') ?: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
            db = extract(modules_testdata_base_path + 'genomics/sarscov2/genome/db/mmseqs.tar.gz').resolve('mmseqs')
        }

        when {
            params {
                module_args   = '--remove-tmp-files 1 -v 0'
                module_prefix = 'test_output_cluster'
            }
            process {
                """
                input[0] = [ [id:'test'], file('${db}') ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.db_cluster.size() == 1 },
                {
                    def all_files = file(process.out.db_cluster[0][1]).listFiles()
                    // Linclust2 (default since MMseqs2 19) writes one result part per available CPU, regardless of --threads,
                    // so the numbered parts are checked for presence only
                    def part_files = all_files.findAll { it.name ==~ /test_output_cluster\.\d+/ }
                    assert part_files.size() > 0
                    def all_file_names = (all_files - part_files).collect { it.name }.toSorted()
                    def stable_file_names = [
                        'test_output_cluster.dbtype',
                        'test_output_cluster.index'
                    ]
                    def stable_files = all_files.findAll { it.name in stable_file_names }.toSorted()

                    assert snapshot(
                        all_file_names,
                        stable_files,
                        process.out.findAll { key, val -> key.startsWith("versions") }
                    ).match()
                }
            )
        }
    }

    test("Should cluster an mmseqs database - stub") {

        config "./nextflow.config"
        options "-stub"

        when {
            params {
                module_prefix = 'test_output_cluster'
            }
            process {
                """
                input[0] = [ [id:'test'], [] ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
