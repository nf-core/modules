nextflow_process {

    name "Test Process MMSEQS_CREATETSV"
    script "../main.nf"
    process "MMSEQS_CREATETSV"

    tag "modules"
    tag "modules_nfcore"
    tag "mmseqs"
    tag "mmseqs/createtsv"
    tag "mmseqs/taxonomy"
    tag "mmseqs/createdb"
    tag "mmseqs/databases"

    test("mmseqs/createtsv - bacteroides_fragilis - taxonomy") {
        setup {
            run("MMSEQS_CREATEDB") {
                script "../../createdb/main.nf"
                process {
                    """
                    input[0] = [
                        [ id:'test_query', single_end:false ],
                        file(params.modules_testdata_base_path + 'genomics/prokaryotes/bacteroides_fragilis/genome/genome.fna.gz', checkIfExists: true)
                        ]
                    """
                }
            }
            run("MMSEQS_DATABASES") {
                script "../../databases/main.nf"
                process {
                    """
                    input[0] = 'SILVA'
                    """
                }
            }
            run("MMSEQS_TAXONOMY") {
                script "../../taxonomy/main.nf"
                config "./taxonomy.nextflow.config"
                process {
                    """
                    input[0] = MMSEQS_CREATEDB.out.db
                    input[1] = MMSEQS_DATABASES.out.database
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = MMSEQS_TAXONOMY.out.db_taxonomy
                input[1] = [[:],[]]
                input[2] = MMSEQS_CREATEDB.out.db
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("mmseqs/createtsv - sarscov2 - cluster") {
        def db
        setup {
            // params.modules_testdata_base_path is null outside the process string, so use the same env var and default as tests/config/nf-test.config
            def modules_testdata_base_path = System.getenv('NXF_MODULES_TESTDATA_BASE') ?: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
            db = extract(modules_testdata_base_path + 'genomics/sarscov2/genome/db/mmseqs.tar.gz').resolve('mmseqs')
        }

        config  "./cluster.nextflow.config"

        when {

            process {
                """
                input[0] = [ [ id:'test_query', single_end:true ], file('${db}') ]
                input[1] = [ [ id:'test_query', single_end:true ], file('${db}') ]
                input[2] = [ [ id:'test_query', single_end:true ], file('${db}') ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("mmseqs/createtsv - sarscov2 - cluster - stub") {

        options "-stub"
        config  "./cluster.nextflow.config"

        when {

            process {
                """
                input[0] = [ [ id:'test_query', single_end:true ], [] ]
                input[1] = [ [ id:'test_query', single_end:true ], [] ]
                input[2] = [ [ id:'test_query', single_end:true ], [] ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
