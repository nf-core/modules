nextflow_process {

    name "Test Process MMSEQS_TSV2EXPROFILEDB"
    script "../main.nf"
    process "MMSEQS_TSV2EXPROFILEDB"

    tag "modules"
    tag "modules_nfcore"
    tag "mmseqs"
    tag "mmseqs/tsv2exprofiledb"

    test("sarscov2 - db") {
        def db
        setup {
            // params.modules_testdata_base_path is null outside the process string, so use the same env var and default as tests/config/nf-test.config
            def modules_testdata_base_path = System.getenv('NXF_MODULES_TESTDATA_BASE') ?: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
            db = extract(modules_testdata_base_path + 'genomics/sarscov2/genome/db/mmseqs.tar.gz').resolve('mmseqs')
        }

        when {
            process {
                """
                input[0] = file('${db}')
                """
            }
        }

        then {
            // Many files are validly empty due to small test data, so just list names, and check a couple of expected files with contents
            assertAll(
                { assert process.success },
                { assert snapshot(
                    path(process.out.db_exprofile[0]).list().find { it.getFileName().toString() == "mmseqs.tsv" },
                    path(process.out.db_exprofile[0]).list().find { it.getFileName().toString() == "mmseqs" },
                    path(process.out.db_exprofile[0]).list().find { it.getFileName().toString() == "mmseqs_seq.index" },
                    path(process.out.db_exprofile[0]).list().sort().collect { it.getFileName().toString() },
                    process.out.findAll { key, val -> key.startsWith("versions") }
                ).match() }
            )
        }
    }

    test("sarscov2 - db - stub") {
        def db
        setup {
            db = new File("${launchDir}/mmseqs")
            db.mkdirs()
        }

        options "-stub"

        when {
            process {
                """
                input[0] = file('${db}')
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
