nextflow_process {

    name "Test Process EUKCC_SINGLE"
    script "../main.nf"
    process "EUKCC_SINGLE"
    config "./nextflow.config"

    tag "modules"
    tag "modules_nfcore"
    tag "eukcc"
    tag "eukcc/single"
    tag "untar"

    setup {
        run("UNTAR") {
            script "../../../untar/main.nf"
            process {
                """
                input[0] = [
                    [ id:'eukcc_db' ],
                    file(params.modules_testdata_base_path + 'genomics/eukaryotes/metagenome/qc/eukcc2_db_tiny_fungi.tar.gz', checkIfExists: true)
                ]
                """
            }
        }
    }

    test("fungi - fasta") {

        when {
            params {
                module_args = '--clade fungi'
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/genome/genome.fa', checkIfExists: true)
                ]
                input[1] = UNTAR.out.untar.map { meta, db -> db }
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    path(process.out.tsv[0][1]).readLines().collect { it.split('\t').drop(1).join('\t') },
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() },
                { assert path(process.out.log[0][1]).text.contains('Wrote output to') }
            )
        }

    }

    test("fungi - faa - extra") {

        when {
            params {
                module_args = '--clade fungi --AA --extra'
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'proteomics/database/yeast_UPS.fasta', checkIfExists: true)
                ]
                input[1] = UNTAR.out.untar.map { meta, db -> db }
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    path(process.out.tsv[0][1]).readLines().collect { it.split('\t').drop(1).join('\t') },
                    process.out.marker_table,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() },
                { assert path(process.out.log[0][1]).text.contains('Wrote output to') }
            )
        }

    }

    test("fungi - fasta - stub") {

        options "-stub"

        when {
            params {
                module_args = '--clade fungi'
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/genome/genome.fa', checkIfExists: true)
                ]
                input[1] = UNTAR.out.untar.map { meta, db -> db }
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
