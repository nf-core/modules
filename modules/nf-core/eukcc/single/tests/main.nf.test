nextflow_process {

    name "Test Process EUKCC_SINGLE"
    script "../main.nf"
    process "EUKCC_SINGLE"
    config "./nextflow.config"

    tag "modules"
    tag "modules_nfcore"
    tag "eukcc"
    tag "eukcc/single"
    tag "untar"

    setup {
        run("UNTAR") {
            script "../../../untar/main.nf"
            process {
                """
                input[0] = [
                    [ id:'eukcc_db' ],
                    file('https://ftp.ebi.ac.uk/pub/databases/metagenomics/eukcc/eukcc2_db_tiny_fungi.tar.gz', checkIfExists: true)
                ]
                """
            }
        }
    }

    test("fungi - fasta") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file('https://ftp.ncbi.nlm.nih.gov/genomes/all/GCF/000/280/035/GCF_000280035.1_ASM28003v2/GCF_000280035.1_ASM28003v2_genomic.fna.gz', checkIfExists: true)
                ]
                input[1] = UNTAR.out.untar.map { meta, db -> db }
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    path(process.out.tsv[0][1]).readLines().collect { it.split('\t').drop(1).join('\t') },
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() },
                { assert path(process.out.log[0][1]).text.contains('Wrote output to') }
            )
        }

    }

    test("fungi - fasta - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file('https://ftp.ncbi.nlm.nih.gov/genomes/all/GCF/000/280/035/GCF_000280035.1_ASM28003v2/GCF_000280035.1_ASM28003v2_genomic.fna.gz', checkIfExists: true)
                ]
                input[1] = UNTAR.out.untar.map { meta, db -> db }
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
