nextflow_workflow {

    name "Test Subworkflow FASTQ_EXTRACT_KRAKEN_KRAKENTOOLS"
    script "../main.nf"
    config "./nextflow.config"
    workflow "FASTQ_EXTRACT_KRAKEN_KRAKENTOOLS"

    tag "subworkflows"
    tag "subworkflows_nfcore"
    tag "subworkflows/fastq_extract_kraken_krakentools"
    tag "kraken2"
    tag "kraken2/kraken2"
    tag "krakentools"
    tag "krakentools/extractkrakenreads"

    def db
    setup {
        // params.modules_testdata_base_path is null outside the process string, so use the same env var and default as tests/config/nf-test.config
        def modules_testdata_base_path = System.getenv('NXF_MODULES_TESTDATA_BASE') ?: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
        db = extract(modules_testdata_base_path + 'genomics/sarscov2/genome/db/kraken2.tar.gz').resolve('kraken2')
    }

    test("sarscov2 illumina single end [fastq]") {
        when {
            params{
                extract_kraken_reads_args = ""
            }
            workflow {
                """
                input[0] = [
                    [ id:'test', single_end:true ],
                    [ file(
                        params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz',
                        checkIfExists: true
                    )]
                ]
                input[1] = file('${db}')
                input[2] = 2697049
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(sanitizeOutput(workflow.out)).match() }
            )
        }
    }

    test("sarscov2 illumina paired end with fastq output [fastq]") {
        when {
            params{
                extract_kraken_reads_args = "--fastq-output"
            }
            workflow {
                """
                input[0] = [
                    [ id:'test', single_end:false ],
                    [
                        file(
                            params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz',
                            checkIfExists: true
                        ),
                        file(
                            params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz',
                            checkIfExists: true
                        )

                    ]
                ]
                input[1] = file('${db}')
                input[2] = 2697049
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(sanitizeOutput(workflow.out)).match() }
            )
        }
    }

    test("sarscov2 illumina paired end with parents [fastq]") {
        when {
            params{
                extract_kraken_reads_args = "--include-parents"
            }
            workflow {
                """
                input[0] = [
                    [ id:'test', single_end:false ],
                    [
                        file(
                            params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz',
                            checkIfExists: true
                        ),
                        file(
                            params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz',
                            checkIfExists: true
                        )

                    ]
                ]
                input[1] = file('${db}')
                input[2] = '2697049 694009'
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(sanitizeOutput(workflow.out)).match() }
            )
        }
    }
}
