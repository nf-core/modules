nextflow_workflow {

    name "Test Subworkflow BAM_SOMATIC_VARIANT_CALLING_GATK"
    script "../main.nf"
    workflow "BAM_SOMATIC_VARIANT_CALLING_GATK"

    tag "subworkflows"
    tag "subworkflows_nfcore"
    tag "subworkflows/bam_somatic_variant_calling_gatk"

    tag "gatk4"
    tag "gatk4/mutect2"
    tag "gatk4/learnreadorientationmodel"
    tag "gatk4/getpileupsummaries"
    tag "gatk4/calculatecontamination"
    tag "gatk4/filtermutectcalls"

    config "./nextflow.config"

