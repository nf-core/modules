/*
 * Nextflow matches `withName` as a full-string regex against the fully
 * qualified process name, so the leading `.*` is required for these blocks to
 * apply inside a consumer pipeline as well as standalone.
 */
process {
    withName: '.*ORFTABLE_FASTA_GTF_BUILDORFCATALOGUE:BEDTOOLS_GETFASTA' {
        ext.prefix = { "${meta.id}.catalogue.nt" }
        ext.args   = '-split -s -nameOnly'
    }
    withName: '.*ORFTABLE_FASTA_GTF_BUILDORFCATALOGUE:SEQKIT_TRANSLATE' {
        ext.prefix = { "${meta.id}.catalogue.aa" }
        ext.args   = '--trim'
    }
    withName: '.*ORFTABLE_FASTA_GTF_BUILDORFCATALOGUE:MMSEQS_EASYCLUSTER' {
        ext.args = '--min-seq-id 0.9 -c 0.8 --cov-mode 0'
    }
}
