params {
    npcs               = 8
    use_approx         = false
    algorithm          = "kmeans"
    n_clusters         = 3
    dbscan_eps         = 0.5
    dbscan_min_samples = 5
}

process {
    withName: 'BEAGLE5_BEAGLE' {
        ext.args = 'seed=1'
    }

    withName: 'PLINK2_VCF' {
        ext.args = '--seed 1'
    }

    withName: 'PLINK2_PCA' {
        ext.args = '--seed 1'
    }

    withName: 'GAWK_EIGENVEC_TO_TSV' {
        ext.suffix = 'tsv'
    }
}
