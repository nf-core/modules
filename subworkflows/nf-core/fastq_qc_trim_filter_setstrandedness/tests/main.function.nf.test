nextflow_function {

    name "Test Functions"
    script "../main.nf"

    //
    // Test function for deriving strandedness from Salmon numbers
    //

    test("Test Function getSalmonInferredStrandedness unstranded") {

        function "getSalmonInferredStrandedness"

        when {
            function {
                """
                import groovy.json.JsonOutput

                // Define the JSON contents for the test
                def json_contents = JsonOutput.toJson([
                    "strand_mapping_bias": 0.5,
                    "num_assigned_fragments": 200,
                    "IU": 0,
                    "U": 0
                ])
                def jsonFile = file("${workDir}/salmonUnstranded.json")
                jsonFile.write(json_contents)

                input[0] = jsonFile
                input[1] = 0.8
                input[2] = 0.1
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert snapshot(function.result).match() }
            )
        }

    }

    test("Test Function getSalmonInferredStrandedness forward") {

        function "getSalmonInferredStrandedness"

        when {
            function {
                """
                import groovy.json.JsonOutput

                def json_contents = JsonOutput.toJson([
                    "strand_mapping_bias": 1.0,
                    "num_assigned_fragments": 100,
                    "IU": 0,
                    "U": 0
                ])
                def jsonFile = file("${workDir}/salmonForward.json")
                jsonFile.write(json_contents)

                input[0] = jsonFile
                input[1] = 0.8
                input[2] = 0.1
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert snapshot(function.result).match() }
            )
        }

    }

    test("Test Function getSalmonInferredStrandedness reverse") {

        function "getSalmonInferredStrandedness"

        when {
            function {
                """
                import groovy.json.JsonOutput

                def json_contents = JsonOutput.toJson([
                    "strand_mapping_bias": 0.0,
                    "num_assigned_fragments": 100,
                    "IU": 0,
                    "U": 0
                ])
                def jsonFile = file("${workDir}/salmonReverse.json")
                jsonFile.write(json_contents)

                input[0] = jsonFile
                input[1] = 0.8
                input[2] = 0.1
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert snapshot(function.result).match() }
            )
        }

    }

    test("Test Function undeterminedStrandednessMessage with inconclusive strand evidence") {

        function "undeterminedStrandednessMessage"

        when {
            function {
                """
                input[0] = 'test'
                input[1] = [inferred_strandedness: 'undetermined', forwardFragments: 65.0, reverseFragments: 35.0, unstrandedFragments: 0.0]
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result.contains("sample 'test'") },
                { assert function.result.contains("65.0% were forward and 35.0% reverse") },
                { assert function.result.contains("genomic DNA contamination") },
                { assert function.result.contains("Set strandedness explicitly in the samplesheet") }
            )
        }
    }

    test("Test Function undeterminedStrandednessMessage with no assigned fragments") {

        function "undeterminedStrandednessMessage"

        when {
            function {
                """
                input[0] = 'test'
                input[1] = [inferred_strandedness: 'undetermined', forwardFragments: Double.NaN, reverseFragments: Double.NaN, unstrandedFragments: Double.NaN]
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result.contains("Salmon assigned no fragments") },
                { assert !function.result.contains("%") },
                { assert function.result.contains("Set strandedness explicitly in the samplesheet") }
            )
        }
    }
}
