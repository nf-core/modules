params {
    aligner            = "bismark"
    cytosine_report    = false
    skip_deduplication = false
    bismark_args       = null
}

process {
    withName: BISMARK_ALIGN {
        ext.args = { params.bismark_args ?: (params.aligner == 'bismark_hisat' ? ' --hisat2' : ' --bowtie2') }
    }

    withName: BWAMEM3_INDEX {
        ext.args = '--meth'
    }

    withName: SAMTOOLS_SORT {
        ext.prefix = { "${meta.id}.sorted" }
    }
}
