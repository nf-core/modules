process {
    withName: ".*FASTA_INDEX_METHYLSEQ:BISMARK_GENOMEPREPARATION_HISAT" {
        ext.args = ' --hisat2'
    }
    withName: ".*FASTA_INDEX_METHYLSEQ:BISMARK_GENOMEPREPARATION_BOWTIE" {
        ext.args = ' --bowtie2'
    }
    withName: ".*BWAMEM3_INDEX" {
        ext.args = '--meth'
    }
}
