nextflow_workflow {

    name "Test Subworkflow BAM_TAPS_CONVERSION"
    script "../main.nf"
    workflow "BAM_TAPS_CONVERSION"

    tag "subworkflows"
    tag "subworkflows_nfcore"
    tag "subworkflows/bam_taps_conversion"
    tag "rastair"
    tag "taps"
    tag "methylation"
    tag "rastair/mbias"
    tag "rastair/mbiasparser"
    tag "rastair/call"
    tag "rastair/methylkit"
    tag "rastair2"
    tag "rastair2/mbias"
    tag "rastair2/call"
    tag "bcftools"
    tag "bcftools/stats"

    test("sarscov2 paired-end methylated [bam] / sarscov2 genome [fasta]") {

        when {
            workflow {
                """
                // Define the input channels required by the BAM_TAPS_CONVERSION workflow
                input[0] = channel.of([
                    [ id:'test' ],
				    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.methylated.sorted.bam', checkIfExists: true),
                ])
                input[1] = channel.of([
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + "genomics/sarscov2/illumina/bam/test.paired_end.methylated.sorted.bam.bai", checkIfExists: true)
                ])
                input[2] = channel.of([
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + "genomics/sarscov2/genome/genome.fasta", checkIfExists: true)
                ])
                input[3] = channel.of([
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + "genomics/sarscov2/genome/genome.fasta.fai", checkIfExists: true)
                ])
                input[4] = false
                input[5] = []
                """
            }
        }

        then {
            assert workflow.success
            assertAll(
                { assert snapshot(workflow.out).match() }
            )
        }
    }

    test("sarscov2 - two samples [ bam, bai ], one reference [ fasta, fai ] value channel - rastair2") {

        when {
            workflow {
                """
                input[0] = channel.of(
                    [ [ id:'test1' ], file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.methylated.sorted.bam', checkIfExists: true) ],
                    [ [ id:'test2' ], file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.methylated.sorted.bam', checkIfExists: true) ]
                )
                input[1] = channel.of(
                    [ [ id:'test1' ], file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.methylated.sorted.bam.bai', checkIfExists: true) ],
                    [ [ id:'test2' ], file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.methylated.sorted.bam.bai', checkIfExists: true) ]
                )
                input[2] = channel.value([ [ id:'genome' ], file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true) ])
                input[3] = channel.value([ [ id:'genome' ], file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.fai', checkIfExists: true) ])
                input[4] = true
                input[5] = []
                """
            }
        }

        then {
            assert workflow.success
            assertAll(
                { assert workflow.out.mbias.size() == 0 && workflow.out.call.size() == 0 && workflow.out.methylkit.size() == 0 },
                { assert workflow.out.vcf.collect { meta, vcf -> meta.id }.sort() == ['test1', 'test2'] },
                { assert workflow.out.vcf.every { meta, vcf -> path(vcf).linesGzip.any { line -> line.startsWith('##rastairCommand=') && line.contains('--nOT') && line.contains('--nOB') } } },
                { assert snapshot(
                    workflow.out.vcf.collect { meta, vcf -> [ meta, path(vcf).linesGzip.findAll { line -> !line.startsWith('##') }.join('\n').md5() ] }.sort { entry -> entry[0].id },
                    workflow.out.vcf_tbi.collect { meta, tbi -> [ meta, file(tbi).name ] }.sort { entry -> entry[0].id },
                    workflow.out.bed.sort { entry -> entry[0].id },
                    workflow.out.bed_tbi.collect { meta, tbi -> [ meta, file(tbi).name ] }.sort { entry -> entry[0].id },
                    workflow.out.bcftools_stats.collect { meta, stats -> [ meta, file(stats).name ] }.sort { entry -> entry[0].id },
                    workflow.out.mbias_html.collect { meta, html -> [ meta, file(html).name ] }.sort { entry -> entry[0].id },
                    workflow.out.mbias_cutoffs.sort { entry -> entry[0].id }
                ).match() }
            )
        }
    }

    test("sarscov2 - paired-end and single-end [ bam, bai ] - rastair2") {

        when {
            workflow {
                """
                input[0] = channel.of(
                    [ [ id:'paired', single_end:false ], file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.methylated.sorted.bam', checkIfExists: true) ],
                    [ [ id:'single', single_end:true ], file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.single_end.sorted.bam', checkIfExists: true) ]
                )
                input[1] = channel.of(
                    [ [ id:'paired', single_end:false ], file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.methylated.sorted.bam.bai', checkIfExists: true) ],
                    [ [ id:'single', single_end:true ], file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.single_end.sorted.bam.bai', checkIfExists: true) ]
                )
                input[2] = channel.value([ [ id:'genome' ], file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true) ])
                input[3] = channel.value([ [ id:'genome' ], file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.fai', checkIfExists: true) ])
                input[4] = true
                input[5] = []
                """
            }
        }

        then {
            assert workflow.success
            def command = { id -> path(workflow.out.vcf.find { meta, vcf -> meta.id == id }[1]).linesGzip.find { line -> line.startsWith('##rastairCommand=') } }
            assertAll(
                { assert workflow.out.mbias_html.collect { meta, html -> meta.id } == ['paired'] },
                { assert command('paired').contains('--nOT') },
                { assert !command('single').contains('--nOT') && command('single').contains('--unpaired') },
                { assert snapshot(
                    workflow.out.vcf.collect { meta, vcf -> [ meta, path(vcf).linesGzip.findAll { line -> !line.startsWith('##') }.join('\n').md5() ] }.sort { entry -> entry[0].id },
                    workflow.out.bed.sort { entry -> entry[0].id },
                    workflow.out.mbias_cutoffs
                ).match() }
            )
        }
    }

    test("sarscov2 - [ bam, bai ], [ fasta, fai ] - rastair 0.8 - manual trims") {

        when {
            workflow {
                """
                input[0] = channel.of([ [ id:'test' ], file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.methylated.sorted.bam', checkIfExists: true) ])
                input[1] = channel.of([ [ id:'test' ], file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.methylated.sorted.bam.bai', checkIfExists: true) ])
                input[2] = channel.of([ [ id:'test' ], file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true) ])
                input[3] = channel.of([ [ id:'test' ], file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.fai', checkIfExists: true) ])
                input[4] = false
                input[5] = [ '0,0,10,0', '0,0,10,0' ]
                """
            }
        }

        then {
            assert workflow.success
            assertAll(
                { assert workflow.out.mbias.size() == 0 },
                { assert snapshot(
                    workflow.out.call,
                    workflow.out.methylkit
                ).match() }
            )
        }
    }

    test("sarscov2 - [ bam, bai ], [ fasta, fai ] - rastair2 - manual trims") {

        when {
            workflow {
                """
                input[0] = channel.of([ [ id:'test' ], file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.methylated.sorted.bam', checkIfExists: true) ])
                input[1] = channel.of([ [ id:'test' ], file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.methylated.sorted.bam.bai', checkIfExists: true) ])
                input[2] = channel.value([ [ id:'genome' ], file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true) ])
                input[3] = channel.value([ [ id:'genome' ], file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.fai', checkIfExists: true) ])
                input[4] = true
                input[5] = [ '0,0,10,0', '0,0,10,0' ]
                """
            }
        }

        then {
            assert workflow.success
            assertAll(
                { assert workflow.out.mbias_html.size() == 0 && workflow.out.mbias_cutoffs.size() == 0 },
                { assert path(workflow.out.vcf[0][1]).linesGzip.any { line -> line.startsWith('##rastairCommand=') && line.contains('--nOT 0,0,10,0') && line.contains('--nOB 0,0,10,0') } },
                { assert snapshot(
                    path(workflow.out.vcf[0][1]).linesGzip.findAll { line -> !line.startsWith('##') }.join('\n').md5(),
                    workflow.out.bed
                ).match() }
            )
        }
    }

    test("sarscov2 - [ bam, bai ], [ fasta, fai ] - invalid trims - fails") {

        when {
            workflow {
                """
                input[0] = channel.of([ [ id:'test' ], file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.methylated.sorted.bam', checkIfExists: true) ])
                input[1] = channel.of([ [ id:'test' ], file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.methylated.sorted.bam.bai', checkIfExists: true) ])
                input[2] = channel.of([ [ id:'test' ], file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true) ])
                input[3] = channel.of([ [ id:'test' ], file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.fai', checkIfExists: true) ])
                input[4] = true
                input[5] = [ '0,0,10' ]
                """
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains('trims must be [] or [ nOT, nOB ]') } || workflow.errorReport?.contains('trims must be')
        }
    }

    test("sarscov2 - [ bam, bai ], per-sample reference [ fasta, fai ] as in methylseq - rastair2 - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = channel.of([ [ id:'test' ], file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.methylated.sorted.bam', checkIfExists: true) ])
                input[1] = channel.of([ [ id:'test' ], file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.methylated.sorted.bam.bai', checkIfExists: true) ])
                input[2] = channel.of([ [ id:'test' ], file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true) ])
                input[3] = channel.of([ [ id:'test' ], file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.fai', checkIfExists: true) ])
                input[4] = true
                input[5] = []
                """
            }
        }

        then {
            assert workflow.success
            assertAll(
                { assert snapshot(workflow.out).match() }
            )
        }
    }
}
