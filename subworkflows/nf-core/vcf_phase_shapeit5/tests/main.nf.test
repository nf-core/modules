nextflow_workflow {

    name "Test Workflow VCF_PHASE_SHAPEIT5"
    config "./nextflow.config"
    script "../main.nf"
    workflow "VCF_PHASE_SHAPEIT5"

    tag "subworkflows"
    tag "subworkflows_nfcore"
    tag "subworkflows/vcf_phase_shapeit5"
    tag "vcf_phase_shapeit5"

    tag "glimpse2/chunk"
    tag "glimpse2"
    tag "shapeit5/phasecommon"
    tag "shapeit5/ligate"
    tag "shapeit5"
    tag "bcftools/index"
    tag "bcftools"

    tag "bcftools/view"
    tag "bcftools/pluginfilltags"

    test("homo_sapiens - target - no chunks, no ref, no scaffold, no map - two chromosomes in two vcf") {
        tag "test0"
        when {
            params {
                glimpse2_chunk_args = "--window-mb 0.1 --window-cm 0.1 --window-count 100 --buffer-mb 0.01 --buffer-cm 0.01 --buffer-count 10"
                bcftools_pluginfilltags_args = ""
                bcftools_pluginfilltags_args2 = ""
                bcftools_view_args = ""
            }
            workflow {
                """
                input[0] = channel.of(
                [
                    [id:'test', chr: "22"],
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr22.vcf.gz", checkIfExists:true),
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr22.vcf.gz.csi", checkIfExists:true),
                    [], // empty pedigree
                ],[
                    [id:'test', chr: "21"],
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr21.vcf.gz", checkIfExists:true),
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr21.vcf.gz.csi", checkIfExists:true),
                    [], // empty pedigree
                ])
                input[1] = channel.of([[panelid:'test', chr: "22"], []], [[panelid:'test', chr: "21"], []]) // Chunks
                input[2] = channel.of([[panelid:'test', chr: "22"], [], []], [[panelid:'test', chr: "21"], [], []]) // Ref
                input[3] = channel.of([[panelid:'test', chr: "22"], [], []], [[panelid:'test', chr: "21"], [], []]) // Scaffold
                input[4] = channel.of(
                    [[chr: "22"], "chr22:16570000-16610000", []],
                    [[chr: "21"], "chr21:16570000-16610000", []]
                ) // Region to chunk + Genetic map
                input[5] = true // Perform chunks
                input[6] = "recursive" // chunk_model
                input[7] = true
                """
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(sanitizeOutput(workflow.out, unstableKeys:["vcf_index"])).match() } // BCF file not readable
            )
        }
    }

    test("homo_sapiens - target - no chunks, no ref, no scaffold, no map - two chromosomes in one vcf") {
        tag "test1"
        setup {
            run("BCFTOOLS_CONCAT") {
                script "../../../../modules/nf-core/bcftools/concat/main.nf"
                process {
                    """
                    input[0] = channel.of([
                        [id:'test'],
                        [
                            file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr22.vcf.gz", checkIfExists:true),
                            file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr21.vcf.gz", checkIfExists:true)
                        ], [
                            file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr22.vcf.gz.csi", checkIfExists:true),
                            file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr21.vcf.gz.csi", checkIfExists:true)
                        ]
                    ])
                    """
                }
            }
        }
        when {
            params {
                glimpse2_chunk_args = "--window-mb 0.1 --window-cm 0.1 --window-count 100 --buffer-mb 0.01 --buffer-cm 0.01 --buffer-count 10"
                bcftools_pluginfilltags_args = ""
                bcftools_pluginfilltags_args2 = ""
                bcftools_view_args = ""
            }
            workflow {
                """
                input[0] = BCFTOOLS_CONCAT.out.vcf
                    .join(BCFTOOLS_CONCAT.out.index)
                    .combine(channel.of([[]]))
                input[1] = channel.of([[panelid:'ref_panel', chr: "22"], []], [[panelid:'ref_panel', chr: "21"], []]) // Chunks
                input[2] = channel.of([[panelid:'ref_panel', chr: "22"], [], []], [[panelid:'ref_panel', chr: "21"], [], []]) // Ref
                input[3] = channel.of([[panelid:'ref_panel', chr: "22"], [], []], [[panelid:'ref_panel', chr: "21"], [], []]) // Scaffold
                input[4] = channel.of(
                    [[chr: "22"], "chr22:16570000-16610000", []],
                    [[chr: "21"], "chr21:16570000-16610000", []]
                ) // Region to chunk + Genetic map
                input[5] = true // Perform chunks
                input[6] = "recursive" // chunk_model
                input[7] = false
                """
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(sanitizeOutput(workflow.out, unstableKeys:["vcf_index"])).match() } // BCF file not readable
            )
        }
    }

    test("homo_sapiens - target, ref, chunks - no scaffold - two chromosomes in two vcf") {
        tag "test2"
        setup {
            run("BCFTOOLS_VIEW") {
                script "../../../../modules/nf-core/bcftools/view/main.nf"
                process {
                    """
                    input[0] = channel.of(
                    [
                        [id:'NA12878', chr:"chr22"],
                        file(params.modules_testdata_base_path + "genomics/homo_sapiens/illumina/vcf/NA12878.chr21_22.1X.glimpse2.vcf.gz", checkIfExists: true),
                        file(params.modules_testdata_base_path + "genomics/homo_sapiens/illumina/vcf/NA12878.chr21_22.1X.glimpse2.vcf.gz.csi", checkIfExists: true),
                    ],[
                        [id:'NA12878', chr:"chr21"],
                        file(params.modules_testdata_base_path + "genomics/homo_sapiens/illumina/vcf/NA12878.chr21_22.1X.glimpse2.vcf.gz", checkIfExists: true),
                        file(params.modules_testdata_base_path + "genomics/homo_sapiens/illumina/vcf/NA12878.chr21_22.1X.glimpse2.vcf.gz.csi", checkIfExists: true)
                    ],[
                        [id:'NA19401', chr:"chr22"],
                        file(params.modules_testdata_base_path + "genomics/homo_sapiens/illumina/vcf/NA19401.chr21_22.1X.glimpse2.vcf.gz", checkIfExists: true),
                        file(params.modules_testdata_base_path + "genomics/homo_sapiens/illumina/vcf/NA19401.chr21_22.1X.glimpse2.vcf.gz.csi", checkIfExists: true),
                    ],[
                        [id:'NA19401', chr:"chr21"],
                        file(params.modules_testdata_base_path + "genomics/homo_sapiens/illumina/vcf/NA19401.chr21_22.1X.glimpse2.vcf.gz", checkIfExists: true),
                        file(params.modules_testdata_base_path + "genomics/homo_sapiens/illumina/vcf/NA19401.chr21_22.1X.glimpse2.vcf.gz.csi", checkIfExists: true)
                    ])
                    input[1] = []
                    input[2] = []
                    input[3] = []
                    """
                }
            }

            run("BCFTOOLS_PLUGINFILLTAGS") {
                script "../../../../modules/nf-core/bcftools/pluginfilltags/main.nf"
                process {
                    """
                    input[0] = BCFTOOLS_VIEW.out.vcf
                        .join(BCFTOOLS_VIEW.out.index)
                    input[1] = []
                    input[2] = []
                    input[3] = []
                    """
                }
            }
        }
        when {
            params {
                glimpse2_chunk_args = ""
                bcftools_pluginfilltags_args = "--write-index"
                bcftools_pluginfilltags_args2 = "-t AC,AN"
                bcftools_view_args = "-Oz -e 'GT=\"./.\"||GT=\".\"' --write-index"
            }
            workflow {
                """
                input[0] = BCFTOOLS_PLUGINFILLTAGS.out.vcf
                    .join(BCFTOOLS_PLUGINFILLTAGS.out.index)
                    .combine(channel.of([[]]))
                input[1] = channel.of(
                    [[panel_id:'1000GP', chr:"chr22"], "chr22:16570065-16597215"],
                    [[panel_id:'1000GP', chr:"chr22"], "chr22:16587172-16609999"],
                    [[panel_id:'1000GP', chr:"chr21"], "chr21:16570065-16597215"],
                    [[panel_id:'1000GP', chr:"chr21"], "chr21:16587172-16609999"]
                )
                input[2] = channel.of(
                [
                    [panel_id:'1000GP', chr:"chr22"],
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr22.vcf.gz", checkIfExists:true),
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr22.vcf.gz.csi", checkIfExists:true)
                ],[
                    [panel_id:'1000GP', chr:"chr21"],
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr21.vcf.gz", checkIfExists:true),
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr21.vcf.gz.csi", checkIfExists:true)
                ])
                input[3] = channel.of(
                    [[panel_id:'1000GP', chr:"chr22"], [], []],
                    [[panel_id:'1000GP', chr:"chr21"], [], []]
                )
                input[4] = channel.of(
                [
                    [panel_id:'1000GP', chr:"chr22"],
                    [], // no regions needed as chunks are provided
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/genome/genetic_map/genome.GRCh38.chr22.glimpse.map", checkIfExists:true)
                ],[
                    [panel_id:'1000GP', chr:"chr21"],
                    [], // no regions needed as chunks are provided
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/genome/genetic_map/genome.GRCh38.chr21.glimpse.map", checkIfExists:true)
                ])
                input[5] = false // Perform chunks
                input[6] = "recursive" // chunk_model
                input[7] = true
                """
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.out.vcf_index.collect{[
                        it[0],
                        path(it[1]).getFileName().toString(),
                        path(it[2]).getFileName().toString(),
                        path(it[1]).vcf.summary,
                        path(it[1]).vcf.header.getGenotypeSamples().sort(),
                        path(it[1]).vcf.variantsMD5
                    ]},
                    workflow.out.chunks
                ).match() }
            )
        }
    }

    test("homo_sapiens - target, ref, chunks - no scaffold - two chromosomes in one vcf") {
        tag "test3"
        setup {
            run("BCFTOOLS_VIEW") {
                script "../../../../modules/nf-core/bcftools/view/main.nf"
                process {
                    """
                    input[0] = channel.of([
                        [id:'NA12878'],
                        file(params.modules_testdata_base_path + "genomics/homo_sapiens/illumina/vcf/NA12878.chr21_22.1X.glimpse2.vcf.gz", checkIfExists: true),
                        file(params.modules_testdata_base_path + "genomics/homo_sapiens/illumina/vcf/NA12878.chr21_22.1X.glimpse2.vcf.gz.csi", checkIfExists: true),
                    ], [
                        [id:'NA19401'],
                        file(params.modules_testdata_base_path + "genomics/homo_sapiens/illumina/vcf/NA19401.chr21_22.1X.glimpse2.vcf.gz", checkIfExists: true),
                        file(params.modules_testdata_base_path + "genomics/homo_sapiens/illumina/vcf/NA19401.chr21_22.1X.glimpse2.vcf.gz.csi", checkIfExists: true),
                    ])
                    input[1] = []
                    input[2] = []
                    input[3] = []
                    """
                }
            }

            run("BCFTOOLS_PLUGINFILLTAGS") {
                script "../../../../modules/nf-core/bcftools/pluginfilltags/main.nf"
                process {
                    """
                    input[0] = BCFTOOLS_VIEW.out.vcf
                        .join(BCFTOOLS_VIEW.out.index)
                    input[1] = []
                    input[2] = []
                    input[3] = []
                    """
                }
            }
        }
        when {
            params {
                glimpse2_chunk_args = ""
                bcftools_pluginfilltags_args = "--write-index"
                bcftools_pluginfilltags_args2 = "-t AC,AN"
                bcftools_view_args = "-Oz -e 'GT=\"./.\"||GT=\".\"' --write-index"
            }
            workflow {
                """
                input[0] = BCFTOOLS_PLUGINFILLTAGS.out.vcf
                    .join(BCFTOOLS_PLUGINFILLTAGS.out.index)
                    .combine(channel.of([[]]))
                input[1] = channel.of(
                    [[panelid:'1000GP', chr:"chr22"], "chr22:16570065-16597215"],
                    [[panelid:'1000GP', chr:"chr22"], "chr22:16587172-16609999"],
                    [[panelid:'1000GP', chr:"chr21"], "chr21:16570065-16597215"],
                    [[panelid:'1000GP', chr:"chr21"], "chr21:16587172-16609999"]
                )
                input[2] = channel.of(
                [
                    [panelid:'1000GP', chr:"chr22"],
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr22.vcf.gz", checkIfExists:true),
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr22.vcf.gz.csi", checkIfExists:true)
                ],[
                    [panelid:'1000GP', chr:"chr21"],
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr21.vcf.gz", checkIfExists:true),
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr21.vcf.gz.csi", checkIfExists:true)
                ])
                input[3] = channel.of(
                    [[panelid:'1000GP', chr:"chr22"], [], []],
                    [[panelid:'1000GP', chr:"chr21"], [], []]
                )
                input[4] = channel.of(
                [
                    [panelid:'1000GP', chr:"chr22"],
                    [], // no regions needed as chunks are provided
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/genome/genetic_map/genome.GRCh38.chr22.glimpse.map", checkIfExists:true)
                ],[
                    [panelid:'1000GP', chr:"chr21"],
                    [], // no regions needed as chunks are provided
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/genome/genetic_map/genome.GRCh38.chr21.glimpse.map", checkIfExists:true)
                ])
                input[5] = false // Perform chunks
                input[6] = "recursive" // chunk_model
                input[7] = false
                """
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.out.vcf_index.collect{[
                        it[0],
                        path(it[1]).getFileName().toString(),
                        path(it[2]).getFileName().toString(),
                        path(it[1]).vcf.summary,
                        path(it[1]).vcf.header.getGenotypeSamples().sort(),
                        path(it[1]).vcf.variantsMD5
                    ]},
                    workflow.out.chunks
                ).match() }
            )
        }
    }

    test("homo_sapiens - target - no error -- stub") {
        options "-stub"
        when {
            params {
                glimpse2_chunk_args = ""
                bcftools_pluginfilltags_args = "--write-index"
                bcftools_pluginfilltags_args2 = "-t AC,AN"
                bcftools_view_args = ""
            }
            workflow {
                """
                input[0] = channel.of([
                    [id:'test', chr: "22"],
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr22.vcf.gz", checkIfExists:true),
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr22.vcf.gz.csi", checkIfExists:true),
                    []
                ])
                input[1] = channel.of([[id:'test', chr: "22"], "chr22:16570065-16597215"]) // Chunks
                input[2] = channel.of([[id:'test', chr: "22"], [], []]) // Ref
                input[3] = channel.of([[id:'test', chr: "22"], [], []]) // Scaffold
                input[4] = channel.of([[id:'test', chr: "22"], [], []]) // Region + Genetic map
                input[5] = false // Perform chunks
                input[6] = "recursive" // chunk_model
                input[7] = true
                """
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(sanitizeOutput(workflow.out)).match() }
            )
        }
    }

    test("homo_sapiens - target - error: empty channel -- stub") {
        options "-stub"
        when {
            params {
                glimpse2_chunk_args = ""
                bcftools_pluginfilltags_args = "--write-index"
                bcftools_pluginfilltags_args2 = "-t AC,AN"
                bcftools_view_args = ""
            }
            workflow {
                """
                input[0] = channel.of([
                    [id:'test', chr: "22"],
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr22.vcf.gz", checkIfExists:true),
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr22.vcf.gz.csi", checkIfExists:true),
                    []
                ])
                input[1] = channel.of([[id:'test', chr: "22"], []]) // Chunks
                input[2] = channel.of([[id:'test', chr: "21"], [], []]) // Ref wrong chr result in empty channel
                input[3] = channel.of([[id:'test', chr: "22"], [], []]) // Scaffold
                input[4] = channel.of([[id:'test', chr: "22"], "chr22:16570065-16609999", []]) // Region to chunk + Genetic map
                input[5] = true // Perform chunks
                input[6] = "recursive" // chunk_model
                input[7] = true
                """
            }
        }
        then {
            assertAll(
                { assert workflow.failed },
                { assert workflow.errorMessage.contains("ERROR: join operation resulted in an empty channel.") }
            )
        }
    }

    test("homo_sapiens - target - error: chunks provided and chunk is true -- stub") {
        options "-stub"
        when {
            params {
                glimpse2_chunk_args = ""
                bcftools_pluginfilltags_args = "--write-index"
                bcftools_pluginfilltags_args2 = "-t AC,AN"
                bcftools_view_args = ""
            }
            workflow {
                """
                input[0] = channel.of([
                    [id:'test', chr: "22"],
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr22.vcf.gz", checkIfExists:true),
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr22.vcf.gz.csi", checkIfExists:true),
                    []
                ])
                input[1] = channel.of([[id:'test', chr: "22"], "chr22:16570065-16597215"]) // Chunks provided
                input[2] = channel.of([[id:'test', chr: "22"], [], []]) // Ref
                input[3] = channel.of([[id:'test', chr: "22"], [], []]) // Scaffold
                input[4] = channel.of([[id:'test', chr: "22"], [], []]) // Region + Genetic map
                input[5] = true // Perform chunks
                input[6] = "recursive" // chunk_model
                input[7] = true
                """
            }
        }
        then {
            assertAll(
                { assert workflow.failed },
                { assert workflow.errorMessage.contains("ERROR: Cannot provide pre-defined chunks (regionin) when chunk=true.") }
            )
        }
    }

    test("homo_sapiens - target - error: chunks not provided and chunk is false -- stub") {
        options "-stub"
        when {
            params {
                glimpse2_chunk_args = ""
                bcftools_pluginfilltags_args = "--write-index"
                bcftools_pluginfilltags_args2 = "-t AC,AN"
                bcftools_view_args = ""
            }
            workflow {
                """
                input[0] = channel.of([
                    [id:'test', chr: "22"],
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr22.vcf.gz", checkIfExists:true),
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr22.vcf.gz.csi", checkIfExists:true),
                    []
                ])
                input[1] = channel.of([[id:'test', chr: "22"], []]) // Chunks provided
                input[2] = channel.of([[id:'test', chr: "22"], [], []]) // Ref
                input[3] = channel.of([[id:'test', chr: "22"], [], []]) // Scaffold
                input[4] = channel.of([[id:'test', chr: "22"], "chr22:16570065-16609999", []]) // Region to chunk + Genetic map
                input[5] = false // Perform chunks
                input[6] = "recursive" // chunk_model
                input[7] = true
                """
            }
        }
        then {
            assertAll(
                { assert workflow.failed },
                { assert workflow.errorMessage.contains("ERROR: ch_chunks channel is empty. Please provide a valid channel or set chunk parameter to true.") }
            )
        }
    }
}
