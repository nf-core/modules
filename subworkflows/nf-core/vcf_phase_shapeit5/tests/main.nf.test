nextflow_workflow {

    name "Test Workflow VCF_PHASE_SHAPEIT5"
    config "./nextflow.config"
    script "../main.nf"
    workflow "VCF_PHASE_SHAPEIT5"

    tag "subworkflows"
    tag "subworkflows_nfcore"
    tag "subworkflows/vcf_phase_shapeit5"
    tag "vcf_phase_shapeit5"

    tag "glimpse2/chunk"
    tag "glimpse2"
    tag "shapeit5/phasecommon"
    tag "shapeit5/ligate"
    tag "shapeit5"
    tag "bcftools/index"
    tag "bcftools"

    tag "bcftools/view"
    tag "bcftools/concat"
    tag "bcftools/pluginfilltags"

    test("homo_sapiens - target - no chunks, no ref, no scaffold, no map - two chromosomes in two vcf") {
        when {
            params {
                glimpse2_chunk_args = "--window-mb 0.1 --window-cm 0.1 --window-count 100 --buffer-mb 0.01 --buffer-cm 0.01 --buffer-count 10"
                bcftools_pluginfilltags_args = ""
                bcftools_pluginfilltags_args2 = ""
                bcftools_view_args = ""
            }
            workflow {
                """
                input[0] = channel.of(
                [
                    [id:'test', chr: "22", panelid:'panel', scaffoldid:'scaffold'],
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr22.vcf.gz", checkIfExists:true),
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr22.vcf.gz.csi", checkIfExists:true),
                    [], // empty pedigree
                    [], [], // empty ref
                    [], [], // empty scaffold
                    "chr22:16570000-16610000", [], // region but no chunks
                    []
                ],[
                    [id:'test', chr: "21", panelid:'panel', scaffoldid:'scaffold'],
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr21.vcf.gz", checkIfExists:true),
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr21.vcf.gz.csi", checkIfExists:true),
                    [], // empty pedigree
                    [], [], // empty ref
                    [], [], // empty scaffold
                    "chr21:16570000-16610000", [], // region but no chunks
                    [],
                ])
                input[1] = "recursive" // chunk_model
                """
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(sanitizeOutput(workflow.out, unstableKeys:["vcf_index"])).match() } // BCF file not readable
            )
        }
    }

    test("homo_sapiens - target - no chunks, no ref, no scaffold, no map - two chromosomes in one vcf") {
        setup {
            run("BCFTOOLS_CONCAT") {
                script "../../../../modules/nf-core/bcftools/concat/main.nf"
                process {
                    """
                    input[0] = channel.of([
                        [ id:'test' ],
                        [
                            file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr22.vcf.gz", checkIfExists:true),
                            file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr21.vcf.gz", checkIfExists:true)
                        ], [
                            file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr22.vcf.gz.csi", checkIfExists:true),
                            file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr21.vcf.gz.csi", checkIfExists:true)
                        ]
                    ])
                    """
                }
            }
        }
        when {
            params {
                glimpse2_chunk_args = "--window-mb 0.1 --window-cm 0.1 --window-count 100 --buffer-mb 0.01 --buffer-cm 0.01 --buffer-count 10"
                bcftools_pluginfilltags_args = ""
                bcftools_pluginfilltags_args2 = ""
                bcftools_view_args = ""
            }
            workflow {
                """
                ch_resource = channel.of(
                    [[chr: "22", panelid:'ref_panel', scaffoldid:'scaffold'], [], [], [], [], "chr22:16570000-16610000", [], []],
                    [[chr: "21", panelid:'ref_panel', scaffoldid:'scaffold'], [], [], [], [], "chr21:16570000-16610000", [], []]
                )
                input[0] = BCFTOOLS_CONCAT.out.vcf
                    .join(BCFTOOLS_CONCAT.out.index)
                    .combine(ch_resource)
                    .map{ meta, vcf, index, metaR, ref, refindex, scaffold, scaffoldindex, region, gmap, chunks -> [
                        meta + metaR, vcf, index, [], ref, refindex, scaffold, scaffoldindex, region, gmap, chunks
                    ]}
                input[1] = "recursive" // chunk_model
                """
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(sanitizeOutput(workflow.out, unstableKeys:["vcf_index"])).match() } // BCF file not readable
            )
        }
    }

    test("homo_sapiens - target, ref, chunks - no scaffold - two chromosomes in two vcf") {
        setup {
            run("BCFTOOLS_VIEW") {
                script "../../../../modules/nf-core/bcftools/view/main.nf"
                process {
                    """
                    input[0] = channel.of(
                    [
                        [id:'NA12878', chr:"chr22"],
                        file(params.modules_testdata_base_path + "genomics/homo_sapiens/illumina/vcf/NA12878.chr21_22.1X.glimpse2.vcf.gz", checkIfExists: true),
                        file(params.modules_testdata_base_path + "genomics/homo_sapiens/illumina/vcf/NA12878.chr21_22.1X.glimpse2.vcf.gz.csi", checkIfExists: true),
                    ],[
                        [id:'NA12878', chr:"chr21"],
                        file(params.modules_testdata_base_path + "genomics/homo_sapiens/illumina/vcf/NA12878.chr21_22.1X.glimpse2.vcf.gz", checkIfExists: true),
                        file(params.modules_testdata_base_path + "genomics/homo_sapiens/illumina/vcf/NA12878.chr21_22.1X.glimpse2.vcf.gz.csi", checkIfExists: true)
                    ],[
                        [id:'NA19401', chr:"chr22"],
                        file(params.modules_testdata_base_path + "genomics/homo_sapiens/illumina/vcf/NA19401.chr21_22.1X.glimpse2.vcf.gz", checkIfExists: true),
                        file(params.modules_testdata_base_path + "genomics/homo_sapiens/illumina/vcf/NA19401.chr21_22.1X.glimpse2.vcf.gz.csi", checkIfExists: true),
                    ],[
                        [id:'NA19401', chr:"chr21"],
                        file(params.modules_testdata_base_path + "genomics/homo_sapiens/illumina/vcf/NA19401.chr21_22.1X.glimpse2.vcf.gz", checkIfExists: true),
                        file(params.modules_testdata_base_path + "genomics/homo_sapiens/illumina/vcf/NA19401.chr21_22.1X.glimpse2.vcf.gz.csi", checkIfExists: true)
                    ])
                    input[1] = []
                    input[2] = []
                    input[3] = []
                    """
                }
            }

            run("BCFTOOLS_PLUGINFILLTAGS") {
                script "../../../../modules/nf-core/bcftools/pluginfilltags/main.nf"
                process {
                    """
                    input[0] = BCFTOOLS_VIEW.out.vcf
                        .join(BCFTOOLS_VIEW.out.index)
                    input[1] = []
                    input[2] = []
                    input[3] = []
                    """
                }
            }
        }
        when {
            params {
                glimpse2_chunk_args = ""
                bcftools_pluginfilltags_args = "--write-index"
                bcftools_pluginfilltags_args2 = "-t AC,AN"
                bcftools_view_args = "-Oz -e 'GT=\"./.\"||GT=\".\"' --write-index"
            }
            workflow {
                """
                ch_input_vcf = BCFTOOLS_PLUGINFILLTAGS.out.vcf
                    .join(BCFTOOLS_PLUGINFILLTAGS.out.index)
                    .map{ meta, vcf, index -> [meta.subMap("chr"), meta, vcf, index]}
                ch_resource = channel.of(
                [
                    [chr: "chr22"],
                    [panel_id:'1000GP', chr:"chr22"],
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr22.vcf.gz", checkIfExists:true),
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr22.vcf.gz.csi", checkIfExists:true),
                    [], [],
                    [],
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/genome/genetic_map/genome.GRCh38.chr22.glimpse.map", checkIfExists:true),
                    ["chr22:16570065-16597215", "chr22:16587172-16609999"]
                ],[
                    [chr: "chr21"],
                    [panel_id:'1000GP', chr:"chr21"],
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr21.vcf.gz", checkIfExists:true),
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr21.vcf.gz.csi", checkIfExists:true),
                    [], [],
                    [],
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/genome/genetic_map/genome.GRCh38.chr21.glimpse.map", checkIfExists:true),
                    ["chr21:16570065-16597215", "chr21:16587172-16609999"]
                ])
                ch_all = ch_input_vcf
                    .combine(ch_resource, by: 0)
                input[0] = ch_all
                    .map{ metaCommon, meta, vcf, index, metaR, ref, refindex, scaffold, scaffoldindex, region, gmap, chunks -> [
                        metaR + meta, vcf, index, [], ref, refindex, scaffold, scaffoldindex, region, gmap, chunks
                    ]}
                input[1] = "recursive" // chunk_model
                """
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.out.vcf_index.collect{[
                        it[0],
                        path(it[1]).getFileName().toString(),
                        path(it[2]).getFileName().toString(),
                        path(it[1]).vcf.summary,
                        path(it[1]).vcf.header.getGenotypeSamples().sort(),
                        path(it[1]).vcf.variantsMD5
                    ]},
                    workflow.out.chunks
                ).match() }
            )
        }
    }

    test("homo_sapiens - target, ref, one chunk only - no scaffold - two chromosomes in two vcf") {
        setup {
            run("BCFTOOLS_VIEW") {
                script "../../../../modules/nf-core/bcftools/view/main.nf"
                process {
                    """
                    input[0] = channel.of(
                    [
                        [id:'NA12878', chr:"chr22"],
                        file(params.modules_testdata_base_path + "genomics/homo_sapiens/illumina/vcf/NA12878.chr21_22.1X.glimpse2.vcf.gz", checkIfExists: true),
                        file(params.modules_testdata_base_path + "genomics/homo_sapiens/illumina/vcf/NA12878.chr21_22.1X.glimpse2.vcf.gz.csi", checkIfExists: true),
                    ],[
                        [id:'NA12878', chr:"chr21"],
                        file(params.modules_testdata_base_path + "genomics/homo_sapiens/illumina/vcf/NA12878.chr21_22.1X.glimpse2.vcf.gz", checkIfExists: true),
                        file(params.modules_testdata_base_path + "genomics/homo_sapiens/illumina/vcf/NA12878.chr21_22.1X.glimpse2.vcf.gz.csi", checkIfExists: true)
                    ],[
                        [id:'NA19401', chr:"chr22"],
                        file(params.modules_testdata_base_path + "genomics/homo_sapiens/illumina/vcf/NA19401.chr21_22.1X.glimpse2.vcf.gz", checkIfExists: true),
                        file(params.modules_testdata_base_path + "genomics/homo_sapiens/illumina/vcf/NA19401.chr21_22.1X.glimpse2.vcf.gz.csi", checkIfExists: true),
                    ],[
                        [id:'NA19401', chr:"chr21"],
                        file(params.modules_testdata_base_path + "genomics/homo_sapiens/illumina/vcf/NA19401.chr21_22.1X.glimpse2.vcf.gz", checkIfExists: true),
                        file(params.modules_testdata_base_path + "genomics/homo_sapiens/illumina/vcf/NA19401.chr21_22.1X.glimpse2.vcf.gz.csi", checkIfExists: true)
                    ])
                    input[1] = []
                    input[2] = []
                    input[3] = []
                    """
                }
            }

            run("BCFTOOLS_PLUGINFILLTAGS") {
                script "../../../../modules/nf-core/bcftools/pluginfilltags/main.nf"
                process {
                    """
                    input[0] = BCFTOOLS_VIEW.out.vcf
                        .join(BCFTOOLS_VIEW.out.index)
                    input[1] = []
                    input[2] = []
                    input[3] = []
                    """
                }
            }
        }
        when {
            params {
                glimpse2_chunk_args = ""
                bcftools_pluginfilltags_args = "--write-index"
                bcftools_pluginfilltags_args2 = "-t AC,AN"
                bcftools_view_args = "-Oz -e 'GT=\"./.\"||GT=\".\"' --write-index"
            }
            workflow {
                """
                ch_input_vcf = BCFTOOLS_PLUGINFILLTAGS.out.vcf
                    .join(BCFTOOLS_PLUGINFILLTAGS.out.index)
                    .map{ meta, vcf, index -> [meta.subMap("chr"), meta, vcf, index]}
                ch_resource = channel.of(
                [
                    [chr: "chr22"],
                    [panel_id:'1000GP', chr:"chr22"],
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr22.vcf.gz", checkIfExists:true),
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr22.vcf.gz.csi", checkIfExists:true),
                    [], [],
                    [],
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/genome/genetic_map/genome.GRCh38.chr22.glimpse.map", checkIfExists:true),
                    ["chr22:16570065-16597215"]
                ],[
                    [chr: "chr21"],
                    [panel_id:'1000GP', chr:"chr21"],
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr21.vcf.gz", checkIfExists:true),
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr21.vcf.gz.csi", checkIfExists:true),
                    [], [],
                    [],
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/genome/genetic_map/genome.GRCh38.chr21.glimpse.map", checkIfExists:true),
                    ["chr21:16570065-16597215"]
                ])
                ch_all = ch_input_vcf
                    .combine(ch_resource, by: 0)
                input[0] = ch_all
                    .map{ metaCommon, meta, vcf, index, metaR, ref, refindex, scaffold, scaffoldindex, region, gmap, chunks -> [
                        metaR + meta, vcf, index, [], ref, refindex, scaffold, scaffoldindex, region, gmap, chunks
                    ]}
                input[1] = "recursive" // chunk_model
                """
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(sanitizeOutput(workflow.out, unstableKeys:["vcf_index"])).match() } // BCF file not readable
            )
        }
    }

    test("homo_sapiens - target - no error -- stub") {
        options "-stub"
        when {
            params {
                glimpse2_chunk_args = ""
                bcftools_pluginfilltags_args = "--write-index"
                bcftools_pluginfilltags_args2 = "-t AC,AN"
                bcftools_view_args = ""
            }
            workflow {
                """
                input[0] = channel.of([
                    [id:'test', chr: "22"],
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr22.vcf.gz", checkIfExists:true),
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr22.vcf.gz.csi", checkIfExists:true),
                    [],
                    [], [],
                    [], [],
                    [], [],
                    ["chr22:16570065-16597215"]
                ])
                input[1] = "recursive" // chunk_model
                """
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(sanitizeOutput(workflow.out)).match() }
            )
        }
    }

    test("homo_sapiens - target - error: chunks not a list -- stub") {
        options "-stub"
        when {
            params {
                glimpse2_chunk_args = ""
                bcftools_pluginfilltags_args = "--write-index"
                bcftools_pluginfilltags_args2 = "-t AC,AN"
                bcftools_view_args = ""
            }
            workflow {
                """
                input[0] = channel.of([
                    [id:'test', chr: "22"],
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr22.vcf.gz", checkIfExists:true),
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr22.vcf.gz.csi", checkIfExists:true),
                    [],
                    [], [],
                    [], [],
                    [], [],
                    "chr22:16570065-16597215"
                ])
                input[1] = "recursive" // chunk_model
                """
            }
        }
        then {
            assert workflow.failed
            assert workflow.stdout.join("\n").contains("ERROR ~ Not a valid transpose element at index: 10")
        }
    }

    test("homo_sapiens - target - error: wrong input channel size -- stub") {
        options "-stub"
        when {
            params {
                glimpse2_chunk_args = ""
                bcftools_pluginfilltags_args = ""
                bcftools_pluginfilltags_args2 = ""
                bcftools_view_args = ""
            }
            workflow {
                """
                input[0] = channel.of([
                    [id:'test', chr: "22"],
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr22.vcf.gz", checkIfExists:true),
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr22.vcf.gz.csi", checkIfExists:true),
                    [], [],
                    [], [],
                    [], [],
                    ["chr22:16570065-16597215"]
                ])
                input[1] = "" // chunk_model
                """
            }
        }
        then {
            assert workflow.failed
            assert workflow.stdout.join("\n").contains("ERROR ~ Input channel must contain exactly 11 elements, but got 10.")
        }
    }

    test("homo_sapiens - target - error: empty index -- stub") {
        options "-stub"
        when {
            params {
                glimpse2_chunk_args = ""
                bcftools_pluginfilltags_args = ""
                bcftools_pluginfilltags_args2 = ""
                bcftools_view_args = ""
            }
            workflow {
                """
                input[0] = channel.of([
                    [id:'test', chr: "22"],
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/popgen/1000GP.chr22.vcf.gz", checkIfExists:true),
                    [],
                    [],
                    [], [],
                    [], [],
                    [], [],
                    ["chr22:16570065-16597215"]
                ])
                input[1] = "" // chunk_model
                """
            }
        }
        then {
            assert workflow.failed
            assert workflow.stdout.join("\n").contains("ERROR ~ Third element of input channel must be a non-empty index file path")
        }
    }
}
