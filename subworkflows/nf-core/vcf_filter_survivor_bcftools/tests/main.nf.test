nextflow_workflow {

    name "Test Subworkflow VCF_FILTER_SURVIVOR_BCFTOOLS"
    script "../main.nf"
    workflow "VCF_FILTER_SURVIVOR_BCFTOOLS"
    config "./nextflow.config"

    tag "subworkflows"
    tag "subworkflows_nfcore"
    tag "subworkflows/vcf_filter_survivor_bcftools"
    tag "survivor/filter"
    tag "bcftools/filter"
    tag "htslib/bgziptabix"

    test("homo sapiens - vcf") {

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test' ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gvcf/test.genome.vcf', checkIfExists: true),
                    []
                ])
                input[1] = -1
                input[2] = -1
                input[3] = 0
                input[4] = -1
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.out.versions.collect { it instanceof String ? path(it).yaml : it },
                    file(workflow.out.tbi[0][1]).name,
                    path(workflow.out.vcf[0][1]).vcf.variantsMD5,
                    path(workflow.out.vcf[0][1]).vcf.summary,
                ).match() }
            )
        }
    }

    test("homo sapiens - vcf - bed") {

        when {
            workflow {
                """
                input[0] = Channel.of('chr22\t1960\t1985')
                    .collectFile(name: 'regions.bed', newLine: true)
                    .map { bed -> [
                        [ id:'test' ], // meta map
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gvcf/test.genome.vcf', checkIfExists: true),
                        bed
                    ] }
                input[1] = -1
                input[2] = -1
                input[3] = 0
                input[4] = -1
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.out.versions.collect { it instanceof String ? path(it).yaml : it },
                    file(workflow.out.tbi[0][1]).name,
                    path(workflow.out.vcf[0][1]).vcf.variantsMD5,
                    path(workflow.out.vcf[0][1]).vcf.summary,
                ).match() }
            )
        }
    }

    test("homo sapiens - vcf - bed - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of('chr22\t1960\t1985')
                    .collectFile(name: 'regions.bed', newLine: true)
                    .map { bed -> [
                        [ id:'test' ], // meta map
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gvcf/test.genome.vcf', checkIfExists: true),
                        bed
                    ] }
                input[1] = -1
                input[2] = -1
                input[3] = 0
                input[4] = -1
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }
}
