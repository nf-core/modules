nextflow_workflow {

    name "Test Subworkflow VCF_FILTER_SURVIVOR_BCFTOOLS"
    script "../main.nf"
    workflow "VCF_FILTER_SURVIVOR_BCFTOOLS"
    config "./nextflow.config"

    tag "subworkflows"
    tag "subworkflows_nfcore"
    tag "subworkflows/vcf_filter_survivor_bcftools"
    tag "survivor/filter"
    tag "bcftools/filter"
    tag "htslib/bgziptabix"

    test("homo sapiens - sv vcf gz - survivor bcftools") {

        when {
            workflow {
                """
                input[0] = channel.of([
                    [ id:'test' ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/vcf/sv_query.vcf.gz', checkIfExists: true),
                    []
                ])
                input[1] = 1000
                input[2] = -1
                input[3] = 0
                input[4] = -1
                input[5] = [ 'survivor', 'bcftools' ]
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    file(workflow.out.tbi[0][1]).name,
                    path(workflow.out.vcf[0][1]).vcf.variantsMD5,
                    path(workflow.out.vcf[0][1]).vcf.summary,
                ).match() }
            )
        }
    }

    test("homo sapiens - sv vcf - survivor") {

        when {
            workflow {
                """
                input[0] = channel.of([
                    [ id:'test' ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/vcf/gridss.somatic.vcf', checkIfExists: true),
                    []
                ])
                input[1] = 1000
                input[2] = -1
                input[3] = 0
                input[4] = -1
                input[5] = [ 'survivor' ]
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    file(workflow.out.tbi[0][1]).name,
                    path(workflow.out.vcf[0][1]).vcf.variantsMD5,
                    path(workflow.out.vcf[0][1]).vcf.summary,
                ).match() }
            )
        }
    }

    test("homo sapiens - sv vcf gz - bcftools") {

        when {
            workflow {
                """
                input[0] = channel.of([
                    [ id:'test' ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/vcf/sv_query.vcf.gz', checkIfExists: true),
                    []
                ])
                input[1] = -1
                input[2] = -1
                input[3] = 0
                input[4] = -1
                input[5] = [ 'bcftools' ]
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    file(workflow.out.tbi[0][1]).name,
                    path(workflow.out.vcf[0][1]).vcf.variantsMD5,
                    path(workflow.out.vcf[0][1]).vcf.summary,
                ).match() }
            )
        }
    }

    test("homo sapiens - sv vcf gz - bed - survivor bcftools") {

        when {
            workflow {
                """
                input[0] = channel.of('chr22\t16000000\t17500000')
                    .collectFile(name: 'regions.bed', newLine: true)
                    .map { bed -> [
                        [ id:'test' ], // meta map
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/vcf/sv_query.vcf.gz', checkIfExists: true),
                        bed
                    ] }
                input[1] = 1000
                input[2] = -1
                input[3] = 0
                input[4] = -1
                input[5] = [ 'survivor', 'bcftools' ]
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    file(workflow.out.tbi[0][1]).name,
                    path(workflow.out.vcf[0][1]).vcf.variantsMD5,
                    path(workflow.out.vcf[0][1]).vcf.summary,
                ).match() }
            )
        }
    }

    test("homo sapiens - sv vcf gz - survivor bcftools - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = channel.of([
                    [ id:'test' ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/vcf/sv_query.vcf.gz', checkIfExists: true),
                    []
                ])
                input[1] = 1000
                input[2] = -1
                input[3] = 0
                input[4] = -1
                input[5] = [ 'survivor', 'bcftools' ]
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }
}
