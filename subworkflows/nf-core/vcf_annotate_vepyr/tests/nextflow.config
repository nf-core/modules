params {
    bcftools_norm_args = '--multiallelics -both --do-not-normalize --output-type z --write-index=tbi'
    hf_download_args = '--repo-type dataset'
}

process {
    // Leave ext.prefix unset to exercise the distinct default output names.
    withName: 'BCFTOOLS_NORM' {
        ext.args = { params.bcftools_norm_args }
    }
    withName: 'HUGGINGFACE_DOWNLOAD' {
        ext.args = { params.hf_download_args }
    }
}
