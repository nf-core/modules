nextflow_workflow {

    name "Test Subworkflow VCF_ANNOTATE_VEPYR"
    script "../main.nf"
    workflow "VCF_ANNOTATE_VEPYR"

    tag "subworkflows"
    tag "subworkflows_nfcore"
    tag "subworkflows/vcf_annotate_vepyr"
    tag "bcftools"
    tag "bcftools/norm"
    tag "vepyr"
    tag "vepyr/annotate"
    tag "untar"
    tag "huggingface"
    tag "huggingface/download"

    test("homo_sapiens - vcf - normalise") {

        config "./nextflow.config"

        // raw.githubusercontent.com serves blobs, not directory trees, so the cache
        // is published as an archive and extracted here.
        setup {
            run("UNTAR") {
                script "modules/nf-core/untar/main.nf"
                process {
                    """
                    input[0] = channel.of([
                        [ id:'116_GRCh38_ensembl' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/cache.tar.gz', checkIfExists: true)
                    ])
                    """
                }
            }
            run("BCFTOOLS_NORM", alias: "BCFTOOLS_JOIN_MULTIALLELICS") {
                script "modules/nf-core/bcftools/norm/main.nf"
                process {
                    """
                    input[0] = channel.of([
                        [ id:'joined' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/input.vcf.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/input.vcf.gz.tbi', checkIfExists: true)
                    ])
                    input[1] = channel.value([
                        [ id:'GRCh38' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/reference.fa.gz', checkIfExists: true)
                    ])
                    """
                }
            }
        }

        when {
            workflow {
                """
                input[0] = BCFTOOLS_JOIN_MULTIALLELICS.out.vcf.map { _meta, vcf -> [ [ id:'test' ], vcf, [] ] }
                input[1] = UNTAR.out.untar.collect()
                input[2] = channel.value([
                    [ id:'GRCh38' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/reference.fa.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/reference.fa.gz.fai', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/reference.fa.gz.gzi', checkIfExists: true)
                ])
                input[3] = 116
                input[4] = [[], []]
                input[5] = true
                input[6] = ''
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert !workflow.trace.tasks().any { it.name.contains('HUGGINGFACE_DOWNLOAD') } },
                { assert workflow.out.vcf_tbi.size() == 1 },
                { assert file(workflow.out.vcf_tbi[0][2]).exists() },
                { assert workflow.trace.tasks().collect { it.name.tokenize(' ')[0] }.toSet().containsAll(['VCF_ANNOTATE_VEPYR:BCFTOOLS_NORM', 'VCF_ANNOTATE_VEPYR:VEPYR_ANNOTATE']) },
                // Setup joins input.vcf.gz back into 986 records, 14 of them multiallelic.
                { assert path(workflow.out.vcf_tbi[0][1]).vcf.variants.size() == 1000 },
                { assert path(workflow.out.vcf_tbi[0][1]).vcf.variants.every { it.alternateAlleles.size() == 1 } },
                { assert snapshot(
                    workflow.out.vcf_tbi.collect { meta, vcf, tbi -> [ meta, file(vcf).name + ",variantsMD5:" + path(vcf).vcf.variantsMD5, file(tbi).name ] }
                ).match() }
            )
        }
    }

    test("homo_sapiens - vcf - normalise without index") {

        config "./nextflow.config"

        setup {
            run("UNTAR") {
                script "modules/nf-core/untar/main.nf"
                process {
                    """
                    input[0] = channel.of([
                        [ id:'116_GRCh38_ensembl' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/cache.tar.gz', checkIfExists: true)
                    ])
                    """
                }
            }
            run("BCFTOOLS_NORM", alias: "BCFTOOLS_JOIN_MULTIALLELICS") {
                script "modules/nf-core/bcftools/norm/main.nf"
                process {
                    """
                    input[0] = channel.of([
                        [ id:'joined' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/input.vcf.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/input.vcf.gz.tbi', checkIfExists: true)
                    ])
                    input[1] = channel.value([
                        [ id:'GRCh38' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/reference.fa.gz', checkIfExists: true)
                    ])
                    """
                }
            }
        }

        when {
            params {
                bcftools_norm_args = '--multiallelics -both --do-not-normalize --output-type z'
            }
            workflow {
                """
                input[0] = BCFTOOLS_JOIN_MULTIALLELICS.out.vcf.map { _meta, vcf -> [ [ id:'test' ], vcf, [] ] }
                input[1] = UNTAR.out.untar.collect()
                input[2] = channel.value([
                    [ id:'GRCh38' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/reference.fa.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/reference.fa.gz.fai', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/reference.fa.gz.gzi', checkIfExists: true)
                ])
                input[3] = 116
                input[4] = [[], []]
                input[5] = true
                input[6] = ''
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert !workflow.trace.tasks().any { it.name.contains('HUGGINGFACE_DOWNLOAD') } },
                { assert workflow.out.vcf_tbi.size() == 1 },
                { assert file(workflow.out.vcf_tbi[0][2]).exists() },
                { assert workflow.trace.tasks().collect { it.name.tokenize(' ')[0] }.toSet().containsAll(['VCF_ANNOTATE_VEPYR:BCFTOOLS_NORM', 'VCF_ANNOTATE_VEPYR:VEPYR_ANNOTATE']) },
                // Setup joins input.vcf.gz back into 986 records, 14 of them multiallelic.
                { assert path(workflow.out.vcf_tbi[0][1]).vcf.variants.size() == 1000 },
                { assert path(workflow.out.vcf_tbi[0][1]).vcf.variants.every { it.alternateAlleles.size() == 1 } },
                { assert snapshot(
                    workflow.out.vcf_tbi.collect { meta, vcf, tbi -> [ meta, file(vcf).name + ",variantsMD5:" + path(vcf).vcf.variantsMD5, file(tbi).name ] }
                ).match() }
            )
        }
    }

    test("homo_sapiens - vcf - no normalise") {

        setup {
            run("UNTAR") {
                script "modules/nf-core/untar/main.nf"
                process {
                    """
                    input[0] = channel.of([
                        [ id:'116_GRCh38_ensembl' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/cache.tar.gz', checkIfExists: true)
                    ])
                    """
                }
            }
        }

        when {
            workflow {
                """
                input[0] = channel.of([
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/input.vcf.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/input.vcf.gz.tbi', checkIfExists: true)
                ])
                input[1] = UNTAR.out.untar.collect()
                input[2] = channel.value([
                    [ id:'GRCh38' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/reference.fa.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/reference.fa.gz.fai', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/reference.fa.gz.gzi', checkIfExists: true)
                ])
                input[3] = 116
                input[4] = [[], []]
                input[5] = false
                input[6] = []
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert !workflow.trace.tasks().any { it.name.contains('HUGGINGFACE_DOWNLOAD') } },
                { assert workflow.out.vcf_tbi.size() == 1 },
                { assert file(workflow.out.vcf_tbi[0][2]).exists() },
                { assert !workflow.trace.tasks().any { it.name.startsWith('VCF_ANNOTATE_VEPYR:BCFTOOLS_NORM') } },
                { assert snapshot(
                    workflow.out.vcf_tbi.collect { meta, vcf, tbi -> [ meta, file(vcf).name + ",variantsMD5:" + path(vcf).vcf.variantsMD5, file(tbi).name ] }
                ).match() }
            )
        }
    }

    test("homo_sapiens - vcf - Hugging Face cache shared across samples") {

        config "./nextflow.config"

        when {
            params {
                hf_download_args = "--revision 15a048f0585a7a40d2d40cb1c2f7806638ee500b --include '*/chr22.parquet' --include '*/chrom_manifest.json'"
            }
            workflow {
                """
                input[0] = channel.of('test', 'test2').map { id -> [
                    [ id:id ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/input.vcf.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/input.vcf.gz.tbi', checkIfExists: true)
                ] }
                input[1] = [[], []]
                input[2] = channel.value([
                    [ id:'GRCh38' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/reference.fa.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/reference.fa.gz.fai', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/reference.fa.gz.gzi', checkIfExists: true)
                ])
                input[3] = 116
                input[4] = [[], []]
                input[5] = true
                input[6] = 'biodatageeks/vepyr_116_GRCh38_ensembl'
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.vcf_tbi.size() == 2 },
                { assert workflow.out.vcf_tbi.every { meta, vcf, tbi -> file(tbi).exists() } },
                { assert workflow.trace.tasks().count { it.name.contains('HUGGINGFACE_DOWNLOAD') } == 1 },
                { assert workflow.trace.tasks().count { it.name.contains('BCFTOOLS_NORM') } == 2 },
                { assert workflow.trace.tasks().count { it.name.contains('VEPYR_ANNOTATE') } == 2 },
                { assert snapshot(
                    workflow.out.vcf_tbi.collect { meta, vcf, tbi -> [ meta, file(vcf).name + ",variantsMD5:" + path(vcf).vcf.variantsMD5, file(tbi).name ] }.sort { it[0].id }
                ).match() }
            )
        }
    }

    test("homo_sapiens - vcf - Hugging Face cache - stub") {

        config "./nextflow.config"

        options "-stub"

        when {
            workflow {
                """
                input[0] = channel.of([
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/input.vcf.gz', checkIfExists: true),
                    []
                ])
                input[1] = [[], []]
                input[2] = channel.value([
                    [ id:'GRCh38' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/reference.fa.gz', checkIfExists: true),
                    [],
                    []
                ])
                input[3] = 116
                input[4] = [[], []]
                input[5] = true
                input[6] = 'biodatageeks/vepyr_116_GRCh38_ensembl'
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.vcf_tbi.size() == 1 },
                { assert file(workflow.out.vcf_tbi[0][2]).exists() },
                { assert workflow.trace.tasks().count { it.name.contains('HUGGINGFACE_DOWNLOAD') } == 1 },
                { assert snapshot(workflow.out).match() }
            )
        }
    }

    test("homo_sapiens - vcf - normalise - stub") {

        config "./nextflow.config"

        options "-stub"

        setup {
            run("UNTAR") {
                script "modules/nf-core/untar/main.nf"
                process {
                    """
                    input[0] = channel.of([
                        [ id:'116_GRCh38_ensembl' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/cache.tar.gz', checkIfExists: true)
                    ])
                    """
                }
            }
        }

        when {
            workflow {
                """
                input[0] = channel.of([
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/input.vcf.gz', checkIfExists: true),
                    []
                ])
                input[1] = UNTAR.out.untar.collect()
                input[2] = channel.value([
                    [ id:'GRCh38' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/reference.fa.gz', checkIfExists: true),
                    [],
                    []
                ])
                input[3] = []
                input[4] = [[], []]
                input[5] = true
