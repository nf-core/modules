    test("homo_sapiens - vcf - cache and Hugging Face repo - fails") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = channel.of([
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/input.vcf.gz', checkIfExists: true),
                    []
                ])
                input[1] = channel.value([
                    [ id:'cache' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/cache.tar.gz', checkIfExists: true)
                ])
                input[2] = channel.value([
                    [ id:'GRCh38' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/reference.fa.gz', checkIfExists: true),
                    [],
                    []
                ])
                input[3] = []
                input[4] = [[], []]
                input[5] = false
                input[6] = 'biodatageeks/vepyr_116_GRCh38_ensembl'
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert workflow.stdout.any { it.contains('set either ch_cache or val_hf_repo, not both') } }
            )
        }
    }

    test("homo_sapiens - vcf - no cache - fails") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = channel.of([
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/input.vcf.gz', checkIfExists: true),
                    []
                ])
                input[1] = [[], []]
                input[2] = channel.value([
                    [ id:'GRCh38' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/reference.fa.gz', checkIfExists: true),
                    [],
                    []
                ])
                input[3] = []
                input[4] = [[], []]
                input[5] = false
                input[6] = ''
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert workflow.stdout.any { it.contains('no cache given, set ch_cache or val_hf_repo') } }
            )
        }
    }
}
