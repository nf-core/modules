nextflow_workflow {

    name "Test Workflow QUANT_TXIMPORT_SUMMARIZEDEXPERIMENT"
    script "../main.nf"
    config "./nextflow.config"
    workflow "QUANT_TXIMPORT_SUMMARIZEDEXPERIMENT"

    tag "subworkflows"
    tag "subworkflows_nfcore"
    tag "subworkflows/quant_tximport_summarizedexperiment"

    tag "custom/tx2gene"
    tag "tximeta/tximport"
    tag "summarizedexperiment/summarizedexperiment"

    test("salmon") {
        def salmon
        setup {
            // params.modules_testdata_base_path is null outside the process string, so use the same env var and default as tests/config/nf-test.config
            def modules_testdata_base_path = System.getenv('NXF_MODULES_TESTDATA_BASE') ?: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
            salmon = extract(modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/salmon_results.tar.gz')
        }

        when {
            workflow {
                """
                input[0] = [
                    [ id: 'samplesheet' ],
                    file(params.modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/samplesheet.csv', checkIfExists: true)
                ]
                input[1] = channel.fromPath('${salmon}/*', type: 'dir').map { dir -> [ [ id: dir.name ], dir ] }
                input[2] = channel.of(file(params.modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/genome_gfp.gtf', checkIfExists: true))
                input[3] = 'gene_id'
                input[4] = 'gene_name'
                input[5] = 'salmon'
                input[6] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                        file(workflow.out.merged_gene_rds[0][1]).name,
                        file(workflow.out.merged_transcript_rds[0][1]).name,
                        workflow.out.counts_gene,
                        workflow.out.counts_gene_length_scaled,
                        workflow.out.counts_gene_scaled,
                        workflow.out.lengths_gene,
                        workflow.out.lengths_transcript,
                        workflow.out.tpm_gene,
                        workflow.out.tpm_transcript,
                        workflow.out.counts_transcript,
                        workflow.out.counts_transcript_scaled,
                        workflow.out.counts_transcript_dtu_scaled,
                        workflow.out.tx2gene,
                        workflow.out.tx2gene_augmented
                    ).match()
                }
            )
        }
    }

    test("salmon - transcript absent from GTF") {
        def salmon
        setup {
            // params.modules_testdata_base_path is null outside the process string, so use the same env var and default as tests/config/nf-test.config
            def modules_testdata_base_path = System.getenv('NXF_MODULES_TESTDATA_BASE') ?: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
            salmon = extract(modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/salmon_results.tar.gz')
        }

        when {
            workflow {
                """
                input[0] = [
                    [ id: 'samplesheet' ],
                    file(params.modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/samplesheet.csv', checkIfExists: true)
                ]
                // Append a row for a transcript absent from the GTF to each sample's quant.sf,
                // simulating e.g. a spike-in or a transcript_fasta sequence not derived from the
                // GTF. Regression test for SE_TRANSCRIPT_UNIFIED failing on exactly this case.
                // The copy keeps the original directory basename (tximport derives sample
                // identity from it, not from meta.id) - only the parent changes.
                input[1] = channel.fromPath('${salmon}').flatMap { dir ->
                    def entries = []
                    dir.toFile().eachDir { d ->
                        def copyDir = file("\${workDir}/\${d.name}_orphan/\${d.name}")
                        copyDir.mkdirs()
                        file("\${copyDir}/quant.sf").text = new File(d, 'quant.sf').text + "ORPHAN_TX_FIXTURE\\t500\\t450.000\\t0.000000\\t0.000\\n"
                        entries << [[ id: d.name ], copyDir]
                    }
                    entries
                }
                input[2] = channel.of(file(params.modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/genome_gfp.gtf', checkIfExists: true))
                input[3] = 'gene_id'
                input[4] = 'gene_name'
                input[5] = 'salmon'
                input[6] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // Present in transcript-level output (with its identity self-mapping)...
                { assert file(workflow.out.counts_transcript[0][1]).text.contains('ORPHAN_TX_FIXTURE') },
                { assert file(workflow.out.tx2gene_augmented[0][1]).text.contains('ORPHAN_TX_FIXTURE') },
                // ...but excluded from gene-level output, since it isn't a real gene.
                { assert !file(workflow.out.counts_gene[0][1]).text.contains('ORPHAN_TX_FIXTURE') }
            )
        }
    }

    test("kallisto") {
        def kallisto
        setup {
            // params.modules_testdata_base_path is null outside the process string, so use the same env var and default as tests/config/nf-test.config
            def modules_testdata_base_path = System.getenv('NXF_MODULES_TESTDATA_BASE') ?: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
