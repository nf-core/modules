params {
    module_args = ''
}

process {
    withName: 'BWAMEM3_INDEX_METH' {
        ext.args = '--meth'
    }
    withName: 'BWAMEM3_MEM' {
        ext.args   = { "${params.module_args} -R '@RG\\tID:${meta.id}\\tSM:${meta.id}\\tLB:${meta.id}\\tPL:ILLUMINA'" }
        ext.prefix = { "${meta.id}.sorted" }
    }
    withName: 'PICARD_MARKDUPLICATES' {
        ext.args   = "--ASSUME_SORTED true --VALIDATION_STRINGENCY LENIENT --PROGRAM_RECORD_ID 'null' --TMP_DIR tmp"
        ext.prefix = { "${meta.id}.deduped.sorted" }
    }
}
